# Copy thanh .env roi dien key. KHONG commit file .env.
CETRIX_API_KEY=
CETRIX_BASE_URL=https://agent.cetrix.app/v1
CETRIX_MODEL=
# Duong dan toi python trong .venv cua autocad-mcp-nndk (do install.ps1 tao)
MCP_PYTHON=C:\Users\TEN_BAN\autocad-mcp-nndk\.venv\Scripts\python.exe
AUTOCAD_MCP_BACKEND=auto
AUTOCAD_MCP_IPC_TIMEOUT=30
# Mac dinh TAT: cam model chay AutoLISP tuy y. Chi bat khi ban da doc mcp_dispatch.lsp.
ALLOW_EXECUTE_LISP=false
