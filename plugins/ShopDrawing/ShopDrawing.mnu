ID_SD_SDSET [SDSET (lenh tat TYLE): Thiet lap ty le, layer, text style, dimstyle]
ID_SD_TB_SDSET [SDSET (lenh tat TYLE): Thiet lap ty le, layer, text style, dimstyle]
ID_SD_SDKHUNG [SDKHUNG (lenh tat KHG): Khung ban ve A0-A4 + khung ten]
