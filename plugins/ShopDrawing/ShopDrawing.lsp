;; ---- SDCHUAN -------------------------------------------------------------------
(defun sd:lay-dev (l / ed r)
  (if (setq ed (entget (tblobjname "LAYER" (car l))))
    (progn
      (if (/= (abs (cdr (assoc 62 ed))) (cadr l)) (setq r (cons (strcat "mau " (itoa (abs (cdr (assoc 62 ed)))) " -> " (itoa (cadr l))) r)))
      (if (/= (strcase (cdr (assoc 6 ed))) (strcase (sd:ltype (caddr l)))) (setq r (cons (strcat "net " (cdr (assoc 6 ed)) " -> " (sd:ltype (caddr l))) r)))
      (if (/= (cdr (assoc 370 ed)) (cadddr l)) (setq r (cons (strcat "lw " (itoa (cdr (assoc 370 ed))) " -> " (itoa (cadddr l))) r)))
      (reverse r))
    (list "chua co")))

(defun sd:lay-fix (l / ed)
  (if (not (tblsearch "LAYER" (car l)))
    (apply 'sd:make-layer l)
    (progn
      (setq ed (entget (tblobjname "LAYER" (car l))))
      (setq ed (subst (cons 62 (if (minusp (cdr (assoc 62 ed))) (- (cadr l)) (cadr l))) (assoc 62 ed) ed)
            ed (subst (cons 6 (sd:ltype (caddr l))) (assoc 6 ed) ed)
            ed (if (assoc 370 ed) (subst (cons 370 (cadddr l)) (assoc 370 ed) ed) (append ed (list (cons 370 (cadddr l))))))
      (entmod ed))))

;; Dem doi tuong trong Model theo bo loc
(defun sd:cnt (flt / ss) (if (setq ss (ssget "_X" flt)) (sslength ss) 0))

;; Xuat file mau: chep layer SD-*, text style SD-TEXT, dimstyle SD-*, block khung SD-KHUNG-* sang ban ve trong (ObjectDBX)
(defun sd:dwt-export (fn / doc dbx r objs n)
  (setq doc (sd:doc) n 0
        dbx (vl-catch-all-apply 'vla-GetInterfaceObject
                                (list (vlax-get-acad-object) (strcat "ObjectDBX.AxDbDocument." (substr (getvar "ACADVER") 1 2)))))
  (if (vl-catch-all-error-p dbx)
    (strcat "khong tao duoc ObjectDBX: " (vl-catch-all-error-message dbx))
    (progn
      (setq r (vl-catch-all-apply
                '(lambda ()
                   (foreach c (list (list (vla-get-Layers doc) "SD-*" (vla-get-Layers dbx))
                                    (list (vla-get-TextStyles doc) "SD-*" (vla-get-TextStyles dbx))
                                    (list (vla-get-DimStyles doc) "SD-*" (vla-get-DimStyles dbx))
                                    (list (vla-get-Blocks doc) "SD-KHUNG-*" (vla-get-Blocks dbx)))
                     (setq objs nil)
                     (vlax-for o (car c) (if (wcmatch (strcase (vla-get-Name o)) (cadr c)) (setq objs (cons o objs))))
                     (if objs
                       (progn
                         (vla-CopyObjects doc (vlax-make-variant (vlax-safearray-fill (vlax-make-safearray vlax-vbObject (cons 0 (1- (length objs)))) objs))
                                          (caddr c))
                         (setq n (+ n (length objs))))))
                   (vla-SaveAs dbx fn))
                nil))
      (vl-catch-all-apply 'vlax-release-object (list dbx))
      (if (vl-catch-all-error-p r) (vl-catch-all-error-message r) n))))

(defun c:SDCHUAN (/ op dev nd l n0 nt nd2 lays fn r st nc ss i e ed)
  (sd:begin)
  (if (not (sd:dlg "Chuan ban ve + file mau (SDCHUAN)"
                   (list (list "op" "Thao tac" 'kw "Kiemtra"
                               '(("Kiemtra" . "Kiem tra layer / chu / kich thuoc theo chuan SD")
                                 ("Apdung" . "Ap dung chuan: dat lai layer, text style, dimstyle")
                                 ("Xuatdwt" . "Xuat file mau .dwt (layer, style, dimstyle, khung ten)")))
                         (list "txt" "Chuyen moi chu (TEXT / MTEXT) sang style SD-TEXT" 'tog nil nil '("op" "Apdung"))
                         (list "fn" "File mau (.dwt)" 'str (strcat (getvar "DWGPREFIX") "ShopDrawing.dwt") nil '("op" "Xuatdwt")))))
    (exit))
  (setq op (sd:v "op"))
  (cond
    ((= op "Kiemtra")
     (setq nd 0)
     (foreach l *SD:LAYERS*
       (if (setq dev (sd:lay-dev l))
         (progn (setq nd (1+ nd)) (princ (strcat "\n  [!] " (car l) ": " (sd:join dev ", "))))))
     (setq n0 (sd:cnt '((8 . "0") (410 . "Model")))
           nt (- (sd:cnt '((0 . "TEXT,MTEXT"))) (sd:cnt (list '(0 . "TEXT,MTEXT") (cons 7 (sd:tstyle)))))
           nd2 (- (sd:cnt '((0 . "DIMENSION"))) (sd:cnt '((0 . "DIMENSION") (3 . "SD-*")))))
     (vlax-for y (vla-get-Layers (sd:doc))
       (if (not (wcmatch (strcase (vla-get-Name y)) "SD-*,0,DEFPOINTS,*|*")) (setq lays (cons (vla-get-Name y) lays))))
     (princ (strcat "\n[SD] Layer SD lech chuan: " (itoa nd) "; doi tuong tren layer 0 (Model): " (itoa n0)
                    "; chu khong dung SD-TEXT: " (itoa nt) "; kich thuoc khong dung dimstyle SD: " (itoa nd2)
                    "; layer ngoai chuan: " (itoa (length lays))
                    (if lays (strcat " (" (sd:join (sd:head (min 8 (length lays)) (reverse lays)) ", ") (if (> (length lays) 8) "..." "") ")") "")
                    (if (> (+ nd nt nd2) 0) ". Chay SDCHUAN -> Apdung de sua." "."))))
    ((= op "Apdung")
     (foreach l *SD:LAYERS* (sd:lay-fix l))
     (setq st (sd:tstyle) nc 0)
     (sd:use-dimstyle (sd:sc))
     (if (and (sd:v "txt") (setq ss (ssget "_X" '((0 . "TEXT,MTEXT")))))
       (progn (setq i 0)
              (repeat (sslength ss)
                (setq e (ssname ss i) ed (entget e) i (1+ i))
                (if (/= (cdr (assoc 7 ed)) st) (progn (entmod (subst (cons 7 st) (assoc 7 ed) ed)) (setq nc (1+ nc)))))))
     (princ (strcat "\n[SD] Da dat lai " (itoa (length *SD:LAYERS*)) " layer SD theo chuan, text style " st
                    ", dimstyle SD-1-" (itoa (fix (sd:sc))) (if (sd:v "txt") (strcat "; doi style " (itoa nc) " chu") "") ".")))
    (t
     (setq fn (sd:v "fn"))
     (if (not (wcmatch (strcase fn) "*.DWT")) (setq fn (strcat fn ".dwt")))
     (setq r (sd:dwt-export fn))
     (if (numberp r)
       (princ (strcat "\n[SD] Da xuat file mau " fn " (" (itoa r) " layer / style / dimstyle / khung ten). "
                      "Dung: QNEW / NEW chon file nay, hoac Options -> Files -> Template Settings."))
       (princ (strcat "\n[SD] Loi xuat file mau: " r)))))
  (sd:finish))

;; ---- SDTKBLOCK -----------------------------------------------------------------
(defun sd:bk-name (o) (cond ((sd:prop o 'EffectiveName)) ((vla-get-Name o))))
(defun sd:bk-val (v)
  (cond ((numberp v) (sd:num (/ (fix (+ (* v 100.0) (if (minusp v) -0.5 0.5))) 100.0)))
        ((= (type v) 'STR) v)
        ((= (type v) 'variant) (sd:bk-val (vlax-variant-value v)))
        (t "")))
;; Tham so block dong: (("Ten" . "gia tri") ...) bo Origin
(defun sd:bk-dyn (o / r)
  (if (and (vlax-property-available-p o 'IsDynamicBlock) (eq (vla-get-IsDynamicBlock o) :vlax-true))
    (foreach p (vlax-invoke o 'GetDynamicBlockProperties)
      (if (/= (strcase (vla-get-PropertyName p)) "ORIGIN")
        (setq r (cons (cons (vla-get-PropertyName p) (sd:bk-val (vla-get-Value p))) r)))))
  (reverse r))
;; Thuoc tinh: (("TAG" . "gia tri") ...)
(defun sd:bk-att (o / r)
  (if (eq (vla-get-HasAttributes o) :vlax-true)
    (foreach a (vlax-invoke o 'GetAttributes) (setq r (cons (cons (strcase (vla-get-TagString a)) (vla-get-TextString a)) r))))
  (reverse r))
(defun sd:kv-str (l) (sd:join (mapcar '(lambda (x) (strcat (car x) "=" (cdr x))) l) "; "))

(defun sd:bk-collect (ss grp / i o key r old dyn att)
  (setq i 0)
  (repeat (sslength ss)
    (setq o (vlax-ename->vla-object (ssname ss i)) i (1+ i)
          dyn (if (/= grp "Ten") (sd:bk-dyn o)) att (if (= grp "Day") (sd:bk-att o))
          key (list (sd:bk-name o) dyn att))
    (if (setq old (assoc key r)) (setq r (subst (cons key (1+ (cdr old))) old r)) (setq r (cons (cons key 1) r))))
  (mapcar '(lambda (k) (nth k r))
          (vl-sort-i r '(lambda (a b) (if (= (strcase (car (car a))) (strcase (car (car b))))
                                        (< (vl-prin1-to-string (cdr (car a))) (vl-prin1-to-string (cdr (car b))))
                                        (< (strcase (car (car a))) (strcase (car (car b)))))))))

(defun sd:bk-csv (rows / fn f tags line)
  (foreach r rows (foreach a (caddr (car r)) (if (not (member (car a) tags)) (setq tags (append tags (list (car a)))))))
  (setq fn (sd:csv-name "_ThongKeBlock.csv"))
  (if (setq f (sd:open fn "w"))
    (progn
      (write-line (sd:join (append '("STT" "Ten block" "Tham so dong") tags '("So luong")) ",") f)
      (setq line 0)
      (foreach r rows
        (setq line (1+ line))
        (write-line (sd:join (append (list (itoa line) (sd:cde-q (car (car r))) (sd:cde-q (sd:kv-str (cadr (car r)))))
                                     (mapcar '(lambda (tg) (sd:cde-q (cond ((cdr (assoc tg (caddr (car r))))) ("")))) tags)
                                     (list (itoa (cdr r))))
                             ",")
                    f))
      (princ (strcat "\n[SD] Da xuat: " (sd:close f))))))

;; Gan gia tri: thuoc tinh (tag mau) hoac tham so block dong (ten) -> T neu gan duoc
(defun sd:bk-set (o kind nm val / ok r)
  (if (= kind "Thuoctinh")
    (if (eq (vla-get-HasAttributes o) :vlax-true)
      (foreach a (vlax-invoke o 'GetAttributes)
        (if (wcmatch (strcase (vla-get-TagString a)) (strcase nm)) (progn (vla-put-TextString a val) (setq ok t)))))
    (if (and (vlax-property-available-p o 'IsDynamicBlock) (eq (vla-get-IsDynamicBlock o) :vlax-true))
      (foreach p (vlax-invoke o 'GetDynamicBlockProperties)
        (if (and (not ok) (= (strcase (vla-get-PropertyName p)) (strcase nm)) (eq (vla-get-ReadOnly p) :vlax-false))
          (progn
            (setq r (vl-catch-all-apply
                      '(lambda (/ cur)
                         (setq cur (vla-get-Value p))
                         (vla-put-Value p (vlax-make-variant (if (numberp (vlax-variant-value cur)) (atof val) val)
                                                             (vlax-variant-type cur))))
                      nil))
            (if (not (vl-catch-all-error-p r)) (setq ok t)))))))
  ok)

(defun c:SDTKBLOCK (/ op flt ss rows pt n i o lst ok trows val pa pb)
  (sd:begin)
  (if (not (sd:dlg "Thong ke / gan thuoc tinh block (SDTKBLOCK)"
                   (list (list "op" "Thao tac" 'kw "Thongke"
                               '(("Thongke" . "Thong ke block + thuoc tinh -> bang, CSV") ("Gan" . "Gan gia tri hang loat")))
                         (list "ten" "Ten block (* ? = mau, ca block dong)" 'str "*")
                         (list "pv" "Pham vi" 'kw "Chon" '(("Chon" . "Chon tren ban ve") ("Tatca" . "Toan bo Model")) nil '("op" "Thongke"))
                         (list "grp" "Gop theo" 'kw "Day"
                               '(("Ten" . "Ten block") ("TenTT" . "Ten + trang thai / tham so dong") ("Day" . "Ten + tham so dong + thuoc tinh"))
                               nil '("op" "Thongke"))
                         (list "bang" "Ve bang thong ke" 'tog t nil '("op" "Thongke"))
                         (list "csv" "Xuat CSV (moi thuoc tinh 1 cot)" 'tog t nil '("op" "Thongke"))
                         (list "kind" "Gan vao" 'kw "Thuoctinh" '(("Thuoctinh" . "Thuoc tinh (tag)") ("Thamso" . "Tham so block dong (VD Visibility1, Distance1)")) nil '("op" "Gan"))
                         (list "nm" "Tag / ten tham so" 'str "" nil '("op" "Gan"))
                         (list "val" "Gia tri ({n} = so thu tu trai -> phai, tren -> duoi)" 'str "" nil '("op" "Gan")))))
    (exit))
  (setq op (sd:v "op") flt '((0 . "INSERT")))
  (if (and (= op "Thongke") (= (sd:v "pv") "Tatca"))
    (setq ss (ssget "_X" '((0 . "INSERT") (410 . "Model"))))
    (progn (princ "\nChon cac block: ") (setq ss (ssget flt))))
  ;; loc theo ten hieu dung (block dong co ten an danh *U..)
  (if ss
    (progn (setq i 0 lst (ssadd))
           (repeat (sslength ss)
             (if (wcmatch (strcase (sd:bk-name (vlax-ename->vla-object (ssname ss i)))) (strcase (sd:v "ten")))
               (ssadd (ssname ss i) lst))
             (setq i (1+ i)))
           (setq ss (if (> (sslength lst) 0) lst))))
  (cond
    ((null ss) (princ "\n[SD] Khong co block nao khop."))
    ((= op "Thongke")
     (setq rows (sd:bk-collect ss (sd:v "grp")))
     (setq n 0)
     (foreach r rows
       (setq n (1+ n))
       (princ (strcat "\n  " (itoa n) ". " (car (car r)) (if (cadr (car r)) (strcat " [" (sd:kv-str (cadr (car r))) "]") "")
                      (if (caddr (car r)) (strcat " {" (sd:kv-str (caddr (car r))) "}") "") " : " (itoa (cdr r)))))
     (princ (strcat "\n[SD] " (itoa (sslength ss)) " block, " (itoa (length rows)) " nhom."))
     (if (sd:v "csv") (sd:bk-csv rows))
     (if (and (sd:v "bang") (setq pt (sd:getpt "\nDiem chen bang (goc trai tren) <bo qua>: " nil)))
       (progn
         (setq n 0 trows nil)
         (foreach r rows
           (setq n (1+ n)
                 trows (cons (list "R" (list (itoa n) (car (car r)) (sd:kv-str (cadr (car r))) (sd:kv-str (caddr (car r))) (itoa (cdr r))) nil) trows)))
         (sd:table2 pt "B\\U+1EA2NG TH\\U+1ED0NG K\\U+00CA BLOCK / THI\\U+1EBET B\\U+1ECA"
                    '(("STT" 10) ("T\\U+00CAN BLOCK" 36) ("TR\\U+1EA0NG TH\\U+00C1I / THAM S\\U+1ED0" 50) ("THU\\U+1ED8C T\\U+00CDNH" 70) ("SL" 12))
                    (reverse trows) -1 (sd:sc)))))
    ((= (vl-string-trim " " (sd:v "nm")) "") (princ "\n[SD] Chua nhap tag / ten tham so."))
    (t
     ;; thu tu: tren -> duoi, trai -> phai
     (setq i 0 lst nil)
     (repeat (sslength ss) (setq lst (cons (ssname ss i) lst) i (1+ i)))
     (setq lst (mapcar '(lambda (k) (nth k lst))
                       (vl-sort-i lst '(lambda (a b / pa pb)
                                         (setq pa (cdr (assoc 10 (entget a))) pb (cdr (assoc 10 (entget b))))
                                         (if (equal (cadr pa) (cadr pb) (* 2.0 (sd:sc))) (< (car pa) (car pb)) (> (cadr pa) (cadr pb))))))
           n 0 i 0)
     (foreach e lst
       (setq i (1+ i) val (sd:v "val"))
       (while (vl-string-search "{n}" val) (setq val (vl-string-subst (itoa i) "{n}" val)))
       (if (sd:bk-set (vlax-ename->vla-object e) (sd:v "kind") (vl-string-trim " " (sd:v "nm")) val) (setq n (1+ n))))
     (princ (strcat "\n[SD] Da gan " (itoa n) " / " (itoa (length lst)) " block"
                    (if (< n (length lst)) " (block con lai khong co tag / tham so do, hoac tham so chi doc)." ".")))))
  (sd:finish))

;; ---- SDXREF --------------------------------------------------------------------
;; Duong dan tuong doi tu thu muc base (co \ cuoi) toi file fn; nil neu khac o dia
(defun sd:relpath (base fn / a b r)
  (setq a (vl-remove "" (sd:split (strcase base) "\\")) b (sd:split fn "\\"))
  (if (and a b (= (car a) (strcase (car b))))
    (progn
      (while (and a (cdr b) (= (car a) (strcase (car b)))) (setq a (cdr a) b (cdr b)))
      (setq r "")
      (repeat (length a) (setq r (strcat r "..\\")))
      (strcat (if (= r "") ".\\" r) (sd:join b "\\")))))

;; Tim file ten nm trong thu muc d va thu muc con (sau toi da lv cap)
(defun sd:findin (d nm lv / r)
  (cond ((findfile (strcat d "\\" nm)))
        ((> lv 0)
         (foreach s (vl-remove "." (vl-remove ".." (vl-directory-files d nil -1)))
           (if (not r) (setq r (sd:findin (strcat d "\\" s) nm (1- lv)))))
         r)))

;; Trang thai Xref: (ten duong-dan file-tim-thay da-nap)
(defun sd:xr-info (b / nm p f fl)
  (setq nm (vla-get-Name b) p (vla-get-Path b)
        fl (cdr (assoc 70 (tblsearch "BLOCK" nm)))
        f (cond ((findfile p)) ((findfile (strcat (getvar "DWGPREFIX") p)))))
  (list nm p f (and fl (= 32 (logand 32 fl)))))

(defun c:SDXREF (/ doc base xs n nl nf nr nrel f rel nm trows pt)
  (sd:begin)
  (if (not (sd:dlg "Quan ly Xref (SDXREF)"
                   (list (list "note" "Xref: ban ve tham chieu ngoai (mat bang kien truc, luoi truc, ban ve bo mon khac)" 'note nil)
                         (list "rel" "Doi duong dan tuyet doi -> tuong doi (de chep ca thu muc du an)" 'tog t)
                         (list "tim" "Tim lai Xref mat duong dan trong thu muc ban ve (3 cap thu muc con)" 'tog t)
                         (list "nap" "Nap lai tat ca Xref" 'tog t)
                         (list "bang" "Ve bang bao cao" 'tog nil))))
    (exit))
  (setq doc (sd:doc) base (getvar "DWGPREFIX") n 0 nl 0 nf 0 nr 0 nrel 0)
  (vlax-for b (vla-get-Blocks doc)
    (if (eq (vla-get-IsXRef b) :vlax-true) (setq xs (cons b xs))))
  (if (null xs)
    (princ "\n[SD] Ban ve khong co Xref.")
    (progn
      (foreach b (reverse xs)
        (setq f (sd:xr-info b) nm (car f) n (1+ n))
        ;; tim lai file mat
        (if (and (not (caddr f)) (sd:v "tim")
                 (setq rel (sd:findin (vl-string-right-trim "\\" base) (strcat (vl-filename-base (cadr f)) (cond ((vl-filename-extension (cadr f))) (".dwg"))) 3)))
          (if (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-put-Path (list b rel))))
            (setq nf (1+ nf) f (sd:xr-info b))))
        ;; tuong doi
        (if (and (sd:v "rel") (caddr f) (wcmatch (cadr f) "?:\\*,\\\\*")
                 (setq rel (sd:relpath base (caddr f)))
                 (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-put-Path (list b rel)))))
          (setq nrel (1+ nrel) f (sd:xr-info b)))
        (if (and (sd:v "nap") (caddr f) (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-Reload (list b)))))
          (setq nr (1+ nr) f (sd:xr-info b)))
        (if (cadddr f) (setq nl (1+ nl)))
        (princ (strcat "\n  " nm ": " (cond ((cadddr f) "da nap") ((caddr f) "chua nap") (t "KHONG TIM THAY")) " | " (cadr f)
                       (if (wcmatch (cadr f) "?:\\*,\\\\*") " (tuyet doi)" (if (wcmatch (cadr f) "*\\*") " (tuong doi)" " (khong duong dan)"))))
        (setq trows (cons (list "R" (list nm (cond ((cadddr f) "\\U+0110\\U+00C3 N\\U+1EA0P") ((caddr f) "CH\\U+01AFA N\\U+1EA0P") (t "KH\\U+00D4NG T\\U+00CCM TH\\U+1EA4Y")) (cadr f)) nil) trows)))
      (princ (strcat "\n[SD] " (itoa n) " Xref: " (itoa nl) " da nap, " (itoa (- n nl)) " chua nap / mat"
                     (if (> nf 0) (strcat "; tim lai " (itoa nf)) "") (if (> nrel 0) (strcat "; doi tuong doi " (itoa nrel)) "")
                     (if (> nr 0) (strcat "; nap lai " (itoa nr)) "")
                     "."))
      (if (and (sd:v "bang") (setq pt (sd:getpt "\nDiem chen bang (goc trai tren) <bo qua>: " nil)))
        (sd:table2 pt "DANH S\\U+00C1CH XREF" '(("T\\U+00CAN XREF" 40) ("TR\\U+1EA0NG TH\\U+00C1I" 28) ("\\U+0110\\U+01AF\\U+1EDCNG D\\U+1EAAN" 110)) (reverse trows) -1 (sd:sc)))))
  (sd:finish))

;; ---- SDDMBV --------------------------------------------------------------------
;; Khung ten trong 1 layout: INSERT co thuoc tinh, nhieu thuoc tinh khop mau nhat
(defun sd:dm-tb (lname pats / ss i e best bn k)
  (if (setq ss (ssget "_X" (list '(0 . "INSERT") '(66 . 1) (cons 410 lname))))
    (progn (setq i 0 bn -1)
           (repeat (sslength ss)
             (setq e (ssname ss i) i (1+ i)
                   k (length (vl-remove nil (mapcar '(lambda (p) (sd:lo-attr-get e p)) pats))))
             (if (> k bn) (setq best e bn k)))))
  best)

(defun c:SDDMBV (/ pats lays fr old sh rows i e nm tl sc rv trows pt f n)
  (sd:begin)
  (if (not (sd:dlg "Danh muc ban ve - Sheet List (SDDMBV)"
                   (list (list "src" "To ban ve" 'kw "Layout"
                               '(("Layout" . "Moi Layout 1 to (theo thu tu tab)") ("Khung" . "Khung ten trong Model (thiet lap SDIN / SDTAOLAYOUT)")))
                         (list "tsh" "Tag so hieu" 'str "SHEET*,SOHIEU*,SOBV*,SO_TO*,SOTO*,DOCNO*")
                         (list "tti" "Tag ten ban ve" 'str "TITLE*,TENBV*,TEN_BV*,TENBANVE*")
                         (list "tsc" "Tag ty le" 'str "SCALE*,TYLE*,TY_LE*")
                         (list "trv" "Tag phien ban" 'str "REV*,PHIENBAN*,LANSUA*")
                         (list "csv" "Xuat CSV" 'tog t))))
    (exit))
  (setq pats (list (sd:v "tsh") (sd:v "tti") (sd:v "tsc") (sd:v "trv")) i 0)
  (if (= (sd:v "src") "Layout")
    (progn
      (vlax-for l (vla-get-Layouts (sd:doc)) (if (/= (vla-get-ModelType l) :vlax-true) (setq lays (cons l lays))))
      (foreach l (sd:sort lays '(lambda (a b) (< (vla-get-TabOrder a) (vla-get-TabOrder b))))
        (setq nm (vla-get-Name l) e (sd:dm-tb nm pats))
        (setq rows (cons (list (cond ((sd:lo-attr-get e (car pats))) (nm)) (cond ((sd:lo-attr-get e (cadr pats))) (nm))
                               (cond ((sd:lo-attr-get e (caddr pats))) ("")) (cond ((sd:lo-attr-get e (cadddr pats))) ("")))
                         rows))))
    (progn
      (setq old (cond ((vlax-ldata-get "SD" "TLO")) ((vlax-ldata-get "SD" "INHL")) ('()))
            fr (if (and (cdr (assoc "key" old)) (/= (cdr (assoc "key" old)) ""))
                 (sd:in-order (sd:in-frames (cond ((cdr (assoc "mode" old))) ("Block")) (cdr (assoc "key" old)) nil)
                              (cond ((cdr (assoc "order" old))) ("Hang")))))
      (foreach f fr
        (setq i (1+ i) e (nth 3 f))
        (setq rows (cons (list (cond ((sd:lo-attr-get e (car pats))) ((itoa i))) (cond ((sd:lo-attr-get e (cadr pats))) ((strcat "Khung " (itoa i))))
                               (cond ((sd:lo-attr-get e (caddr pats))) ("")) (cond ((sd:lo-attr-get e (cadddr pats))) ("")))
                         rows)))))
  (setq rows (reverse rows))
  (if (null rows)
    (princ (if (= (sd:v "src") "Layout") "\n[SD] Ban ve chua co Layout." "\n[SD] Chua co khung ten: chay SDIN hoac SDTAOLAYOUT de khai bao khung."))
    (progn
      (setq n 0)
      (foreach r rows
        (setq n (1+ n) trows (cons (list "R" (cons (itoa n) r) nil) trows)))
      (princ (strcat "\n[SD] Danh muc " (itoa n) " to ban ve."))
      (if (and (sd:v "csv") (setq f (sd:open (setq nm (sd:csv-name "_DanhMucBanVe.csv")) "w")))
        (progn
          (write-line "STT,So hieu,Ten ban ve,Ty le,Phien ban" f)
          (setq n 0)
          (foreach r rows (setq n (1+ n)) (write-line (sd:join (cons (itoa n) (mapcar 'sd:cde-q r)) ",") f))
          (princ (strcat "\n[SD] Da xuat: " (sd:close f)))))
      (if (setq pt (sd:getpt "\nDiem chen bang danh muc (goc trai tren) <bo qua>: " nil))
        (sd:table2 pt "DANH M\\U+1EE4C B\\U+1EA2N V\\U+1EBC" '(("STT" 12) ("S\\U+1ED0 HI\\U+1EC6U" 50) ("T\\U+00CAN B\\U+1EA2N V\\U+1EBC" 90) ("T\\U+1EF6 L\\U+1EC6" 20) ("PHI\\U+00CAN B\\U+1EA2N" 22))
                   (reverse trows) -1 (sd:sc)))))
  (sd:finish))

;;; ==========================================================================
;;;  SDLOC - Loc / tim nhanh doi tuong theo bieu thuc dieu kien (y tuong OneFilter cua DiRoots)
;;;    Bieu thuc: dieu kien noi bang & (VA), | (HOAC; & uu tien hon |)
;;;    Dieu kien: <truong><phep so sanh><gia tri>
;;;      truong : loai layer mau net block chu dai dientich bankinh cao (do cao Z) kg (khong gian / layout)
;;;               att:TAG (thuoc tinh block) dyn:TEN (tham so block dong)
;;;               ck (cau kien SD) d (duong kinh thep) sh (so hieu thep) sl (so thanh) tang (tang cau kien)
;;;      phep   : = <> > < >= <= ~ (chua, khong phan biet hoa thuong); = <> dung mau * ? # , cho chu
;;;    VD: loai=INSERT & block=VAN* & att:CONGSUAT>=5 | layer=SD-THEP* & d>=20
;;;    Truong khong co (VD ck cua doi tuong thuong) duoc coi la chuoi rong: ck= tim doi tuong chua gan cau kien
;;;  Ket qua: chon (grip), dem theo layer / loai, co lap (ISOLATEOBJECTS), doi layer, xuat CSV
;;; ==========================================================================
(setq *SD:LOCOPS* '(">=" "<=" "<>" "=" ">" "<" "~"))
(setq *SD:LOCF* '("loai" "layer" "mau" "net" "block" "chu" "dai" "dientich" "bankinh" "cao" "kg" "ck" "d" "sh" "sl" "tang"))

;; Phan tich 1 dieu kien -> (truong phep gia-tri) hoac chuoi loi
(defun sd:loc-cond (s / i best p op f)
  (setq s (vl-string-trim " \t" s))
  (foreach o *SD:LOCOPS*
    (if (and (setq p (vl-string-search o s)) (or (null best) (< p (car best)) (and (= p (car best)) (> (strlen o) (strlen (cadr best))))))
      (setq best (list p o))))
  (if (null best)
    (strcat "thieu phep so sanh trong '" s "'")
    (progn
      (setq p (car best) op (cadr best)
            f (strcase (vl-string-trim " " (substr s 1 p)) t))
      (if (or (member f *SD:LOCF*) (wcmatch f "att:?*,dyn:?*"))
        (list f op (vl-string-trim " " (substr s (+ p (strlen op) 1))))
        (strcat "truong '" f "' khong co (dung: " (sd:join *SD:LOCF*  " ") " att:TAG dyn:TEN)")))))

;; Bieu thuc -> ((dk dk ...) ...) nhom HOAC cua cac nhom VA; hoac chuoi loi
(defun sd:loc-parse (s / r g c err)
  (foreach og (sd:split s "|")
    (setq g nil)
    (foreach a (sd:split og "&")
      (if (/= (vl-string-trim " \t" a) "")
        (if (= (type (setq c (sd:loc-cond a))) 'STR) (if (not err) (setq err c)) (setq g (cons c g)))))
    (if g (setq r (cons (reverse g) r))))
  (cond (err) ((null r) "bieu thuc rong") (t (reverse r))))

;; Gia tri truong cua doi tuong (nil = khong co)
(defun sd:loc-get (e ed f / o x tg)
  (cond
    ((= f "loai") (cdr (assoc 0 ed)))
    ((= f "layer") (cdr (assoc 8 ed)))
    ((= f "mau") (cond ((cdr (assoc 62 ed))) (256)))
    ((= f "net") (cond ((cdr (assoc 6 ed))) ("BYLAYER")))
    ((= f "kg") (cond ((cdr (assoc 410 ed))) ("Model")))
    ((= f "chu") (cond ((= (cdr (assoc 0 ed)) "MTEXT") (sd:mt-plain (vla-get-TextString (vlax-ename->vla-object e))))
                       ((member (cdr (assoc 0 ed)) '("TEXT" "ATTRIB" "ATTDEF")) (cdr (assoc 1 ed)))))
    ((= f "cao") (caddr (cdr (assoc 10 ed))))
    ((= f "bankinh") (cdr (assoc 40 (if (member (cdr (assoc 0 ed)) '("CIRCLE" "ARC")) ed))))
    ((= f "dai")
     (if (not (vl-catch-all-error-p (setq x (vl-catch-all-apply '(lambda () (vlax-curve-getDistAtParam e (vlax-curve-getEndParam e))) nil))))
       x))
    ((= f "dientich") (if (vlax-property-available-p (setq o (vlax-ename->vla-object e)) 'Area) (sd:prop o 'Area)))
    ((= f "block") (if (= (cdr (assoc 0 ed)) "INSERT") (sd:bk-name (vlax-ename->vla-object e))))
    ((wcmatch f "att:*")
     (if (= (cdr (assoc 0 ed)) "INSERT")
       (progn (setq tg (strcase (substr f 5)))
              (cdr (assoc tg (sd:bk-att (vlax-ename->vla-object e)))))))
    ((wcmatch f "dyn:*")
     (if (= (cdr (assoc 0 ed)) "INSERT")
       (progn (setq tg (strcase (substr f 5)))
              (cdr (car (vl-member-if '(lambda (a) (= (strcase (car a)) tg)) (sd:bk-dyn (vlax-ename->vla-object e))))))))
    ((= f "ck") (cond ((setq x (cadr (assoc -3 (entget e '("SD_CK"))))) (cdr (cadr x)))
                      ((setq x (cadr (assoc -3 (entget e '("SD_KL"))))) (cdr (cadr x)))))
    ((= f "tang") (if (setq x (cadr (assoc -3 (entget e '("SD_KL"))))) (cdr (nth 7 x))))
    ((member f '("d" "sh" "sl"))
     (if (setq x (cadr (assoc -3 (entget e '("SD_REBAR")))))
       (cdr (nth (cdr (assoc f '(("sh" . 1) ("sl" . 2) ("d" . 3)))) x))))))

;; So sanh gia tri v voi dieu kien (op, t)
(defun sd:loc-cmp (v op tv / a b)
  (cond
    ((and (null v) (setq v "") nil))
    ((and (setq b (distof tv 2)) (setq a (if (numberp v) v (distof v 2))))
     (cond ((= op "=") (equal a b 1e-6)) ((= op "<>") (not (equal a b 1e-6)))
           ((= op ">") (> a b)) ((= op "<") (< a b)) ((= op ">=") (>= a b)) ((= op "<=") (<= a b))
           (t (vl-string-search (strcase tv) (strcase (if (numberp v) (sd:num v) v))))))
    (t
     (setq a (strcase (if (numberp v) (sd:num v) v)) b (strcase tv))
     (cond ((= op "=") (wcmatch a b)) ((= op "<>") (not (wcmatch a b)))
           ((= op "~") (vl-string-search b a))
           ((= op ">") (> a b)) ((= op "<") (< a b)) ((= op ">=") (>= a b)) ((= op "<=") (<= a b))))))

;; Doi tuong khop bieu thuc?
(defun sd:loc-match (e ed groups)
  (vl-some '(lambda (g) (vl-every '(lambda (c) (sd:loc-cmp (sd:loc-get e ed (car c)) (cadr c) (caddr c))) g)) groups))

;; Bieu thuc da dung (nho giua cac ban ve, toi da 10)
(defun sd:loc-hist (/ s) (if (setq s (getenv "ShopDrawingLoc")) (vl-remove "" (sd:split s "^^"))))
(defun sd:loc-save (x / h)
  (setq h (cons x (vl-remove x (sd:loc-hist))))
  (setenv "ShopDrawingLoc" (sd:join (if (> (length h) 10) (sd:head 10 h) h) "^^")))

(setq *SD:LOCMAU*
  '(("Tunhap" . "(tu nhap bieu thuc ben duoi)")
    ("Ganday" . "Bieu thuc dung gan nhat")
    ("Thep20" . "Ky hieu thep duong kinh >= 20: d>=20")
    ("Lay0" . "Doi tuong tren layer 0: layer=0")
    ("Churong" . "Chu rong: loai=TEXT,MTEXT & chu=")
    ("Ngan" . "Doan rat ngan < 1: loai=LINE,LWPOLYLINE,ARC & dai<1")
    ("Mauroi" . "Mau gan cung (khong ByLayer): mau<>256 & mau<>0")
    ("Chuack" . "Ky hieu thep chua gan cau kien: d>0 & ck=")))
(setq *SD:LOCEXP*
  '(("Thep20" . "d>=20") ("Lay0" . "layer=0") ("Churong" . "loai=TEXT,MTEXT & chu=")
    ("Ngan" . "loai=LINE,LWPOLYLINE,ARC & dai<1") ("Mauroi" . "mau<>256 & mau<>0")
    ("Chuack" . "d>0 & ck=")))

(defun c:SDLOC (/ imp mau ex gr ss i e ed res n byl lay f cols line keys v)
  (setq imp (ssget "_I"))
  (sd:begin)
  (if (not (sd:dlg "Loc doi tuong theo dieu kien (SDLOC)"
                   (list (list "note" "Truong: loai layer mau net block chu dai dientich bankinh cao kg att:TAG dyn:TEN ck d sh sl tang" 'note nil)
                         (list "note" "Phep: = <> > < >= <= ~(chua); & = VA, | = HOAC. VD: block=VAN* & att:CS>=5 | d>=20" 'note nil)
                         (list "mau" "Bo loc" 'kw "Tunhap" *SD:LOCMAU*)
                         (list "ex" "Bieu thuc" 'str (cond ((car (sd:loc-hist))) ("layer=SD-THEP* & dai>=1000")) nil '("mau" "Tunhap"))
                         (list "pv" "Pham vi" 'kw (if imp "Hientai" "Tatca")
                               '(("Tatca" . "Toan bo khong gian hien hanh") ("Chon" . "Chon vung tren ban ve") ("Hientai" . "Trong cac doi tuong dang chon (loc tiep)")))
                         (list "lam" "Ket qua" 'kw "Chon"
                               '(("Chon" . "Chon (hien grip) de sua / xoa / copy") ("Dem" . "Chi dem theo layer + loai")
                                 ("Coplap" . "Co lap (an doi tuong khac)") ("Doilayer" . "Chuyen sang layer") ("CSV" . "Xuat danh sach CSV")))
                         (list "lay" "Layer dich" 'str (getvar "CLAYER") nil '("lam" "Doilayer")))))
    (exit))
  (setq mau (sd:v "mau")
        ex  (cond ((= mau "Tunhap") (sd:v "ex")) ((= mau "Ganday") (car (sd:loc-hist))) ((cdr (assoc mau *SD:LOCEXP*)))))
  (setq gr (if ex (sd:loc-parse ex) "chua co bieu thuc"))
  (cond
    ((= (type gr) 'STR) (princ (strcat "\n[SD] Loi bieu thuc: " gr)))
    (t
     (if (= mau "Tunhap") (sd:loc-save ex))
     (setq ss (cond ((= (sd:v "pv") "Hientai") imp)
                    ((= (sd:v "pv") "Chon") (princ "\nChon vung can loc: ") (ssget))
                    (t (ssget "_X" (list (cons 410 (if (= (getvar "CVPORT") 1) (getvar "CTAB") "Model")))))))
     (setq res (ssadd) i 0)
     (if ss
       (repeat (sslength ss)
         (setq e (ssname ss i) ed (entget e) i (1+ i))
         (if (sd:loc-match e ed gr) (ssadd e res))))
     (setq n (sslength res))
     ;; dem theo layer + loai
     (setq i 0)
     (repeat n
       (setq ed (entget (ssname res i)) i (1+ i)
             lay (strcat (cdr (assoc 8 ed)) " | " (cdr (assoc 0 ed))))
       (if (setq f (assoc lay byl)) (setq byl (subst (cons lay (1+ (cdr f))) f byl)) (setq byl (cons (cons lay 1) byl))))
     (setq byl (sd:sort byl '(lambda (a b) (> (cdr a) (cdr b)))))
     (princ (strcat "\n[SD] Bieu thuc: " ex))
     (princ (strcat "\n[SD] Tim thay " (itoa n) " / " (itoa (if ss (sslength ss) 0)) " doi tuong."))
     (setq i 0)
     (foreach x byl (if (< i 15) (princ (strcat "\n  " (car x) " : " (itoa (cdr x))))) (setq i (1+ i)))
     (if (> i 15) (princ (strcat "\n  ... va " (itoa (- i 15)) " nhom khac")))
     (if (> n 0)
       (cond
         ((= (sd:v "lam") "Chon") (setq *SD:LOCSS* res))
         ((= (sd:v "lam") "Coplap") (command "_.ISOLATEOBJECTS" res "") (princ "\n[SD] Bo co lap: UNISOLATEOBJECTS."))
         ((= (sd:v "lam") "Doilayer")
          (setq lay (vl-string-trim " " (sd:v "lay")))
          (if (not (tblsearch "LAYER" lay)) (sd:make-layer lay 7 "Continuous" -3))
          (setq i 0)
          (repeat n (setq ed (entget (ssname res i)) i (1+ i)) (entmod (subst (cons 8 lay) (assoc 8 ed) ed)))
          (princ (strcat "\n[SD] Da chuyen " (itoa n) " doi tuong sang layer " lay ".")))
         ((= (sd:v "lam") "CSV")
          (setq keys (vl-remove-if '(lambda (k) (member k '("loai" "layer"))) (mapcar 'car (apply 'append gr))))
          (setq cols nil) (foreach k keys (if (not (member k cols)) (setq cols (append cols (list k)))))
          (if (setq f (sd:open (setq line (sd:csv-name "_Loc.csv")) "w"))
            (progn
              (write-line (sd:join (append '("Handle" "Loai" "Layer") cols) ",") f)
              (setq i 0)
              (repeat n
                (setq e (ssname res i) ed (entget e) i (1+ i))
                (write-line (sd:join (append (list (cdr (assoc 5 ed)) (cdr (assoc 0 ed)) (sd:cde-q (cdr (assoc 8 ed))))
                                             (mapcar '(lambda (k / v) (setq v (sd:loc-get e ed k))
                                                        (sd:cde-q (cond ((numberp v) (sd:num v)) (v) (""))))
                                                     cols))
                                     ",")
                            f))
              (princ (strcat "\n[SD] Da xuat: " (sd:close f))))))))))
  (sd:finish)
  ;; chon sau khi ket thuc lenh de grip con hien
  (if *SD:LOCSS* (progn (sssetfirst nil *SD:LOCSS*) (setq *SD:LOCSS* nil)))
  (princ))

