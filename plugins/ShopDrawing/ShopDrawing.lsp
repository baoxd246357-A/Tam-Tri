;;; --------------------------------------------------------------------------
;; TCVN 5574:2018: Rbt (MPa) theo cap do ben be tong, Rs (MPa) theo mac thep
(setq *SD:RBT* '(("B15" . 0.75) ("B20" . 0.90) ("B25" . 1.05) ("B30" . 1.15)
                 ("B35" . 1.30) ("B40" . 1.40))
      *SD:RS*  '(("CB240-T" . 210.0) ("CB300-V" . 260.0) ("CB400-V" . 350.0)
                 ("CB500-V" . 435.0)))

(defun sd:cfg (key def) (cond ((vlax-ldata-get "SD" key)) (def)))
(defun sd:cfg-put (key v) (vlax-ldata-put "SD" key v) v)

;; Lam tron len boi so cua step
(defun sd:ceil (x step) (* step (fix (+ (/ x step) 0.999999))))

;; Chieu dai noi chong thep (mm), TCVN 5574:2018 muc 10.3.6:
;;   l0,an = Rs.As / (Rbond.us) = Rs.d / (4.Rbond),  Rbond = eta1.eta2.Rbt
;;   eta1 = 2.5 thep van (CB300-V tro len), 1.5 thep tron (CB240-T)
;;   eta2 = 1.0 khi d <= 32, 0.9 khi d = 36, 40
;;   l_lap = alpha.l0,an, alpha = 1.2 vung keo, 0.9 vung nen
;;   va khong nho hon: keo 20d va 250 mm, nen 15d va 200 mm
;; Neu LAPK > 0: l_lap = LAPK x d (vd 40d).
(defun sd:lap (d / k thep rbt rs e1 e2 l0 nen)
  (setq k (sd:cfg "LAPK" 0.0))
  (if (> k 0)
    (sd:ceil (* k d) 50.0)
    (progn
      (setq thep (sd:cfg "THEP" "CB400-V")
            rbt  (cond ((cdr (assoc (sd:cfg "BETONG" "B25") *SD:RBT*))) (1.05))
            rs   (cond ((cdr (assoc thep *SD:RS*))) (350.0))
            e1   (if (= thep "CB240-T") 1.5 2.5)
            e2   (if (> d 32.0) 0.9 1.0)
            l0   (/ (* rs d) (* 4.0 e1 e2 rbt))
            nen  (= (sd:cfg "VUNG" "Keo") "Nen"))
      (sd:ceil (if nen
                 (max (* 0.9 l0) (* 15.0 d) 200.0)
                 (max (* 1.2 l0) (* 20.0 d) 250.0))
               50.0))))

(defun sd:lapinfo (/ k)
  (setq k (sd:cfg "LAPK" 0.0))
  (if (> k 0)
    (strcat (sd:num k) "d")
    (strcat "TCVN 5574:2018, " (sd:cfg "BETONG" "B25") ", " (sd:cfg "THEP" "CB400-V")
            ", vung " (if (= (sd:cfg "VUNG" "Keo") "Nen") "nen" "keo"))))

;; Chia thanh thang dai hon cay thuong pham thanh cac doan cat (da cong lap).
;; Tra ve nil neu khong can noi.
(defun sd:splice (L d / ls lap m p r)
  (setq ls (sd:cfg "STOCK" 11700.0) lap (sd:lap d))
  (if (and (> L ls) (> ls (* 2 lap)))
    (progn
      (setq m (fix (+ (/ (- L lap) (- ls lap)) 0.999999)))
      (if (= (sd:cfg "NOIKIEU" "Cay") "Deu")
        (progn
          (setq p (min ls (sd:ceil (/ (+ L (* (1- m) lap)) m) 10.0)))
          (repeat m (setq r (cons p r))))
        (progn
          (repeat (1- m) (setq r (cons ls r)))
          (setq r (append r (list (- L (* (1- m) (- ls lap))))))))
      r)))

;; Gom phan tu trung: (a a b) -> ((a . 2) (b . 1)), giu thu tu
(defun sd:group (lst / r e)
  (foreach x lst
    (if (setq e (assoc x r))
      (setq r (subst (cons x (1+ (cdr e))) e r))
      (setq r (cons (cons x 1) r))))
  (reverse r))

;; (11700 11700 5300) -> "11700x2 + 5300"
(defun sd:pcs-str (lst mul)
  (sd:join (mapcar '(lambda (g) (strcat (sd:num (car g))
                                        (if (> (cdr g) 1) (strcat mul (itoa (cdr g))) "")))
                   (sd:group lst))
           " + "))

(defun sd:nums->str (lst) (if lst (sd:join (mapcar 'sd:num lst) ",") ""))
(defun sd:str->nums (s) (if s (mapcar 'atof (vl-remove "" (sd:split s ",")))))
(defun sd:repeat (x n / r) (repeat n (setq r (cons x r))) r)
(defun sd:replace-nth (i v lst / j)
  (setq j -1)
  (mapcar '(lambda (x) (if (= (setq j (1+ j)) i) v x)) lst))

