              '("dp" "Tudong" "Tatca"))))

(defun c:SDCOT (/ ts name b h a nb nh d ds s o x0 yb yt dy i p tot g)
  (sd:begin)
  (setq ts (float *SD:DETSCALE*))
  (if (not (sd:dlg "Mat cat cot BTCT (SDCOT)"
                   (list (list "name" "Ten cot" 'str (cond (*SD:CNAME*) ("C1")))
                         (list "b" "Canh b - theo X (mm)" 'real (cond (*SD:CB*) (300.0)))
                         (list "h" "Canh h - theo Y (mm)" 'real (cond (*SD:CH*) (400.0)))
                         (list "a" "Lop bao ve (mm)" 'real 25.0)
                         (list "nb" "So thanh canh b (ke ca thanh goc)" 'int 3)
                         (list "nh" "So thanh canh h (ke ca thanh goc)" 'int 3)
                         (list "d" "Duong kinh thep doc (mm)" 'real 18.0)
                         (list "ds" "Duong kinh dai (mm)" 'real 8.0)
                         (list "s" "Buoc dai (mm)" 'real 200.0)
                         (car (sd:tie-fields)) (cadr (sd:tie-fields)))))
    (exit))
  (setq name (sd:v "name") b (sd:v "b") h (sd:v "h") a (sd:v "a") nb (max 2 (sd:v "nb")) nh (max 2 (sd:v "nh"))
        d (sd:v "d") ds (sd:v "ds") s (sd:v "s"))
  (setq *SD:CNAME* name *SD:CB* b *SD:CH* h)
  (if (setq o (sd:getpt "\nDiem chen (goc trai duoi): " nil))
    (progn
      (sd:sec-common o b h a ds s ts (strcat "M\\U+1EB6T C\\U+1EAET " name))
      (setq x0 (+ a ds (/ d 2.0)) yb x0 yt (- h x0))
      (sd:barrow o b a ds nb d yb)
      (setq p (sd:barrow o b a ds nb d yt))
      (if (> nh 2)
        (progn
          (setq dy (/ (- yt yb) (1- nh)) i 1)
          (repeat (- nh 2)
            (sd:dot (sd:p+ o x0 (+ yb (* i dy))) d "SD-THEP-CHU")
            (sd:dot (sd:p+ o (- b x0) (+ yb (* i dy))) d "SD-THEP-CHU")
            (setq i (1+ i)))))
      (setq tot (+ (* 2 nb) (* 2 (- nh 2))) i 0)
      (sd:tagL p (sd:p+ o (* -6 ts) (+ h (* 6 ts)))
               (strcat (itoa tot) "%%c" (sd:num d)) ts)
      ;; dai phu: ghi chu ben phai mat cat (duoi ngang nam ngoai tiet dien)
      (foreach g (sd:col-ties o b h a ds nb nh d (sd:v "dp") (sd:v "lp") t)
        (setq p (strcat (if (> (nth 2 g) 1) (strcat (itoa (nth 2 g)) "x") "") "%%c" (sd:num ds) "a" (sd:num s)
                        (if (= (car g) "Mot") " MOC C" " DAI PHU")))
        (sd:tagL (sd:p+ o (car (nth 3 g)) (cadr (nth 3 g)))
                 (sd:p+ o (+ b (* 14 ts) (* ts (max 12.0 (* 1.8 (strlen p))))) (- (* 0.35 h) (* i 6 ts)))
                 p ts)
        (setq i (1+ i)))
      (sd:use-dimstyle *SD:SCALE*)))
  (sd:finish))

