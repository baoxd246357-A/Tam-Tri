;; ---- SDDIENTICH - dem + tong dien tich theo layer ---------------------------------
(defun c:SDDIENTICH (/ ss i e o a lay rec res tot sk dvm k pt n)
  (sd:begin)
  (if (not (sd:dlg "Tong dien tich (SDDIENTICH)"
                   (list (list "note" "Polyline kin, tron, elip, spline kin, hatch (da tru dao), region; doi tuong ho bi bo qua" 'note nil)
                         (list "dv" "Don vi ban ve" 'kw "mm" '(("mm" . "mm (hien thi m2)") ("m" . "m (giu nguyen)")))
                         (list "nhan" "Gan nhan dien tich tu cap nhat (FIELD) len tung doi tuong" 'tog nil)
                         (list "ghi" "Ghi tong dien tich len ban ve" 'tog t))))
    (exit))
  (setq dvm (= (sd:v "dv") "mm") k (if dvm 1e-6 1.0))
  (princ "\nChon doi tuong can tinh dien tich: ")
  (if (setq ss (ssget '((0 . "LWPOLYLINE,POLYLINE,CIRCLE,ELLIPSE,SPLINE,HATCH,REGION"))))
    (progn
      (setq i 0 tot 0.0 sk 0 n 0)
      (repeat (sslength ss)
        (setq e (ssname ss i) i (1+ i) o (vlax-ename->vla-object e)
              a (if (sd:nl-prop o "Dientich") (sd:prop o 'Area)))
        (if (numberp a)
          (progn
            (setq tot (+ tot a) n (1+ n) lay (cdr (assoc 8 (entget e))))
            (if (setq rec (assoc lay res))
              (setq res (subst (list lay (1+ (cadr rec)) (+ (caddr rec) a)) rec res))
              (setq res (cons (list lay 1 a) res)))
            (if (and (sd:v "nhan") (setq pt (sd:nl-place o "Dientich")))
              (sd:nl-make (car pt) 0.0 (sd:nl-tpl "S = {} m\\U+00B2" (sd:nl-field o "Area" (sd:nl-fmt "Dientich" dvm 2))) (* 2.5 (sd:sc)) nil)))
          (setq sk (1+ sk))))
      (princ "\n----------------------------------------------")
      (foreach r (sd:sort res '(lambda (a b) (< (car a) (car b))))
        (princ (strcat "\n" (car r) ": " (itoa (cadr r)) " doi tuong, S = " (sd:rtos (* k (caddr r)) 3) (if dvm " m2" ""))))
      (princ (strcat "\nTONG: " (itoa n) " doi tuong, S = " (sd:rtos (* k tot) 3) (if dvm " m2" "")
                     (if (> sk 0) (strcat "  (bo qua " (itoa sk) " doi tuong ho / loi)") "")))
      (princ "\n----------------------------------------------")
      (if (sd:v "nhan") (vla-Regen (sd:doc) acActiveViewport))
      (if (and (sd:v "ghi") (setq pt (sd:getpt "\nDiem ghi tong dien tich <Enter bo qua>: " nil)))
        (sd:text pt (strcat "S = " (sd:rtos (* k tot) 2) (if dvm " m\\U+00B2" "")) (* 2.5 (sd:sc)) "L" "SD-CHU"))))
  (sd:finish))

;; ---- SDCHUGIUA - tao / can chu 1 dong giua 2 diem, xoay theo 2 diem -------------
;; Goc doc duoc (chu khong lon nguoc)
(defun sd:read-ang (a)
  (setq a (rem (+ a (* 2 pi)) (* 2 pi)))
  (if (and (> a (+ (/ pi 2) 1e-9)) (<= a (+ (* 1.5 pi) 1e-9))) (- a pi) a))
;; Diem dat chu: trung diem p1 p2, lech vuong goc dz
(defun sd:mid-off (p1 p2 dz / a m)
  (setq a (sd:read-ang (angle p1 p2)) m (mapcar '(lambda (x y) (/ (+ x y) 2.0)) p1 p2))
  (list (polar (list (car m) (cadr m) 0.0) (+ a (/ pi 2)) dz) a))

(defun c:SDCHUGIUA (/ op h dz p1 p2 pm e ed s n)
  (sd:begin)
  (if (not (sd:dlg "Chu giua 2 diem (SDCHUGIUA)"
                   (list (list "op" "Thao tac" 'kw "Tao" '(("Tao" . "Tao chu moi giua 2 diem") ("Canh" . "Can chu co san vao giua 2 diem")))
                         (list "s" "Noi dung chu" 'str (cond (*SD:CGS*) ("TEXT")) nil '("op" "Tao"))
                         (list "h" "Chieu cao chu (mm tren giay)" 'real 2.5)
                         (list "vt" "Vi tri" 'kw "Tren" '(("Tren" . "Phia tren duong noi 2 diem") ("Giua" . "Dung tren duong noi"))))))
    (exit))
  (setq op (sd:v "op") h (* (sd:v "h") (sd:sc)) dz (if (= (sd:v "vt") "Tren") (* 0.9 h) 0.0) n 0 *SD:CGS* (sd:v "s"))
  (while (and (or (= op "Tao")
                  (setq e (car (entsel (strcat "\nChon chu (TEXT) can can <ket thuc>: ")))))
              (or (= op "Tao") (= (cdr (assoc 0 (entget e))) "TEXT")
                  (progn (princ "\n[SD] Chi can duoc TEXT 1 dong.") nil))
              (setq p1 (sd:getpt (if (= op "Tao") "\nDiem thu nhat <ket thuc>: " "\nDiem thu nhat: ") nil))
              (setq p2 (sd:getpt "\nDiem thu hai: " p1)))
    (setq pm (sd:mid-off p1 p2 dz))
    (if (= op "Tao")
      (progn
        (entmake (list '(0 . "TEXT") '(8 . "SD-CHU") (cons 7 (sd:tstyle)) (cons 10 (car pm)) (cons 11 (car pm))
                       (cons 40 h) (cons 1 (sd:v "s")) (cons 50 (cadr pm)) '(72 . 1) '(73 . 2)))
        (setq n (1+ n)))
      (progn
        (setq ed (entget e))
        (foreach g (list (cons 10 (car pm)) (cons 11 (car pm)) (cons 50 (cadr pm)) '(72 . 1) '(73 . 2))
          (setq ed (if (assoc (car g) ed) (subst g (assoc (car g) ed) ed) (append ed (list g)))))
        (entmod ed)
        (setq n (1+ n)))))
  (princ (strcat "\n[SD] " (if (= op "Tao") "Da tao " "Da can ") (itoa n) " chu."))
  (sd:finish))

;; ---- SDLAYOUT - quan ly Layout (hop thoai): mo, len / xuong, sap xep, them, chep, doi ten, doi ten hang loat, xoa
(defun sd:lays (/ r)
  (vlax-for l (vla-get-Layouts (sd:doc)) (if (/= (vla-get-ModelType l) :vlax-true) (setq r (cons l r))))
  (sd:sort r '(lambda (a b) (< (vla-get-TabOrder a) (vla-get-TabOrder b)))))
(defun sd:lay-exists (nm) (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-Item (list (vla-get-Layouts (sd:doc)) nm)))))
(defun sd:lay-order (lst / i) (setq i 0) (foreach l lst (vla-put-TabOrder l (setq i (1+ i)))))

(defun sd:lay-dcl (/ fn f)
  (setq fn (vl-filename-mktemp "sdlay" nil ".dcl"))
  (if (setq f (open fn "w"))
    (progn
      (foreach l '("sdlay : dialog { label = \"Quan ly Layout (SDLAYOUT)\";"
                   "  : row {"
                   "    : list_box { key = \"lst\"; width = 44; height = 20; }"
                   "    : column { fixed_height = true;"
                   "      : button { key = \"mo\"; label = \"Mo layout\"; }"
                   "      : button { key = \"len\"; label = \"Len\"; }"
                   "      : button { key = \"xuong\"; label = \"Xuong\"; }"
                   "      : button { key = \"az\"; label = \"Sap xep A-Z\"; }"
                   "      : button { key = \"moi\"; label = \"Them moi\"; }"
                   "      : button { key = \"chep\"; label = \"Sao chep\"; }"
                   "      : button { key = \"ten\"; label = \"Doi ten\"; }"
                   "      : button { key = \"hl\"; label = \"Doi ten hang loat\"; }"
                   "      : button { key = \"xoa\"; label = \"Xoa\"; }"
                   "    }"
                   "  }"
                   "  : edit_box { key = \"nm\"; label = \"Ten moi / tien to (hang loat):\"; edit_width = 32; }"
                   "  : text { key = \"msg\"; width = 64; }"
                   "  : button { key = \"cancel\"; label = \"Dong\"; is_cancel = true; fixed_width = true; alignment = centered; }"
                   "}")
        (write-line l f))
      (close f)
      fn)))

(defun c:SDLAYOUT (/ doc fn id res lays l nm i act msg tmp)
  (sd:begin)
  (setq doc (sd:doc) fn (sd:lay-dcl) i 0 msg "Chon layout roi bam lenh; nhap dup = mo layout." act t)
  (while act
    (setq lays (sd:lays) i (min i (max 0 (1- (length lays)))) res 0)
    (if (and fn (setq id (load_dialog fn)) (> id 0) (new_dialog "sdlay" id))
      (progn
        (start_list "lst")
        (mapcar 'add_list (mapcar '(lambda (x) (strcat (if (< (vla-get-TabOrder x) 10) "0" "") (itoa (vla-get-TabOrder x)) "   " (vla-get-Name x)
                                                         (if (= (vla-get-Name x) (getvar "CTAB")) "   (dang mo)" "")))
                                  lays))
        (end_list)
        (set_tile "lst" (itoa i))
        (set_tile "nm" (if (nth i lays) (vla-get-Name (nth i lays)) ""))
        (set_tile "msg" msg)
        (action_tile "lst" "(setq *SD:LI* (atoi $value)) (set_tile \"nm\" (vla-get-Name (nth *SD:LI* (sd:lays)))) (if (= $reason 4) (progn (setq *SD:LN* (get_tile \"nm\")) (done_dialog 2)))")
        (foreach b '(("mo" . 2) ("len" . 3) ("xuong" . 4) ("az" . 5) ("moi" . 6) ("chep" . 7) ("ten" . 8) ("hl" . 9) ("xoa" . 10))
          (action_tile (car b) (strcat "(setq *SD:LI* (atoi (get_tile \"lst\")) *SD:LN* (get_tile \"nm\")) (done_dialog " (itoa (cdr b)) ")")))
        (setq res (start_dialog))
        (unload_dialog id))
      (princ "\n[SD] Khong mo duoc hop thoai."))
    (setq i (cond (*SD:LI*) (0)) l (nth i lays) nm (vl-string-trim " " (cond (*SD:LN*) (""))) *SD:LI* nil *SD:LN* nil)
    (cond
      ((< res 2) (setq act nil))
      ((and (null l) (/= res 6)) (setq msg "Ban ve chua co layout: dung Them moi."))
      ((= res 2) (setvar "CTAB" (vla-get-Name l)) (setq act nil))
      ((= res 3) (if (> i 0) (progn (sd:lay-order (append (sd:head (1- i) lays) (list l (nth (1- i) lays)) (cddr (member (nth (1- i) lays) lays))))
                                    (setq i (1- i) msg "Da chuyen len."))))
      ((= res 4) (if (< i (1- (length lays)))
                   (progn (sd:lay-order (append (sd:head i lays) (list (nth (1+ i) lays) l) (cddr (member l lays))))
                          (setq i (1+ i) msg "Da chuyen xuong."))))
      ((= res 5) (sd:lay-order (mapcar '(lambda (k) (nth k lays)) (vl-sort-i (mapcar 'vla-get-Name lays) 'sd:fl<)))
                 (setq msg "Da sap xep theo ten (tu nhien: BV-2 truoc BV-10)."))
      ((= res 6) (setq nm (sd:lo-safe (if (or (= nm "") (sd:lay-exists nm)) (strcat "Layout" (itoa (1+ (length lays)))) nm)))
                 (if (vl-catch-all-error-p (vl-catch-all-apply 'vla-Add (list (vla-get-Layouts doc) nm)))
                   (setq msg (strcat "Khong tao duoc " nm))
                   (setq msg (strcat "Da them " nm) i (length lays))))
      ((= res 7) (setq nm (sd:lo-safe (if (or (= nm "") (sd:lay-exists nm)) (strcat (vla-get-Name l) " (2)") nm)))
                 (command "_.LAYOUT" "_C" (vla-get-Name l) nm)
                 (setq msg (if (sd:lay-exists nm) (strcat "Da sao chep thanh " nm) "Khong sao chep duoc.") i (1- (length (sd:lays)))))
      ((= res 8) (cond ((or (= nm "") (= nm (vla-get-Name l))) (setq msg "Nhap ten moi vao o ben duoi."))
                       ((sd:lay-exists nm) (setq msg (strcat "Da co layout " nm)))
                       ((vl-catch-all-error-p (vl-catch-all-apply 'vla-put-Name (list l (sd:lo-safe nm)))) (setq msg "Ten khong hop le."))
                       (t (setq msg (strcat "Da doi ten thanh " (sd:lo-safe nm))))))
      ((= res 9) (setq tmp 0)
                 (foreach x lays (vl-catch-all-apply 'vla-put-Name (list x (strcat "~sdtmp" (itoa (setq tmp (1+ tmp)))))))
                 (setq tmp 0)
                 (foreach x lays (vla-put-Name x (sd:lo-safe (strcat (if (= nm "") "BV-" nm) (sd:lo-pad (setq tmp (1+ tmp)) (max 2 (strlen (itoa (length lays)))))))))
                 (setq msg (strcat "Da doi ten " (itoa tmp) " layout theo thu tu tab.")))
      ((= res 10) (if (= (vla-get-Name l) (getvar "CTAB")) (setvar "CTAB" "Model"))
                  (setq nm (vla-get-Name l))
                  (setq msg (if (vl-catch-all-error-p (vl-catch-all-apply 'vla-Delete (list l))) (strcat "Khong xoa duoc " nm) (strcat "Da xoa " nm " (U de hoan tac sau khi dong)."))))))
  (if fn (vl-file-delete fn))
  (sd:finish))

;; ---- SDDIMTAY - kich thuoc ghi tay (text override) --------------------------------
;; Kich thuoc ghi de: chu khac rong va khong chua <> (gia tri do)
(defun sd:dim-hand-p (ed / s) (setq s (cdr (assoc 1 ed))) (and s (/= s "") (not (vl-string-search "<>" s))))
;; So trong chu ghi de (bo %%c, tien to chu) -> so hoac nil
(defun sd:dim-num (s / i c r)
  (setq r "" i 1)
  (while (<= i (strlen s))
    (setq c (substr s i 1) i (1+ i))
    (if (or (wcmatch c "#") (and (= c ".") (/= r ""))) (setq r (strcat r c))))
  (if (/= r "") (atof r)))

(defun c:SDDIMTAY (/ op ss i e ed s m v tol sel n nl res xd col)
  (sd:begin)
  (regapp "SD_DIMTAY")
  (if (not (sd:dlg "Kich thuoc ghi tay (SDDIMTAY)"
                   (list (list "note" "Kich thuoc co gia tri go tay (text override) thay cho gia tri do that" 'note nil)
                         (list "op" "Thao tac" 'kw "Danhdau"
                               '(("Danhdau" . "To mau do de nhan biet") ("Bodanhdau" . "Bo to mau (tra mau cu)")
                                 ("Khoiphuc" . "Khoi phuc gia tri do that (xoa ghi de)") ("Chon" . "Chon de xem / sua") ("Xoa" . "Xoa kich thuoc ghi tay")))
                         (list "loc" "Pham vi kich thuoc ghi tay" 'kw "Tatca" '(("Tatca" . "Moi kich thuoc ghi tay") ("Lech" . "Chi khi so ghi lech so do > dung sai")))
                         (list "tol" "Dung sai (don vi ve)" 'real 1.0 nil '("loc" "Lech"))
                         (list "pv" "Pham vi" 'kw "Tatca" '(("Tatca" . "Khong gian hien hanh") ("Chon" . "Chon tren ban ve"))))))
    (exit))
  (setq op (sd:v "op") tol (sd:v "tol") n 0 nl 0)
  (setq ss (if (= (sd:v "pv") "Chon")
             (progn (princ "\nChon kich thuoc: ") (ssget '((0 . "DIMENSION"))))
             (ssget "_X" (list '(0 . "DIMENSION") (cons 410 (if (= (getvar "CVPORT") 1) (getvar "CTAB") "Model")))))
        sel (ssadd) i 0)
  (if ss
    (repeat (sslength ss)
      (setq e (ssname ss i) ed (entget e '("SD_DIMTAY")) i (1+ i))
      (cond
        ((= op "Bodanhdau")
         (if (setq xd (cadr (assoc -3 ed)))
           (progn (setq col (cdr (cadr xd)))
                  (entmod (append (vl-remove (assoc -3 ed) (if (assoc 62 ed) (subst (cons 62 col) (assoc 62 ed) ed) (append ed (list (cons 62 col)))))
                                  (list (list -3 (list "SD_DIMTAY")))))
                  (setq n (1+ n)))))
        ((sd:dim-hand-p ed)
         (setq s (cdr (assoc 1 ed)) m (cdr (assoc 42 ed)) v (sd:dim-num s))
         (if (and v m (> (abs (- v m)) tol)) (setq nl (1+ nl)))
         (if (or (= (sd:v "loc") "Tatca") (null v) (null m) (> (abs (- v m)) tol))
           (progn
             (setq n (1+ n) res (cons (list s m) res))
             (cond
               ((= op "Danhdau")
                (if (not (assoc -3 ed))
                  (entmod (append (if (assoc 62 ed) (subst '(62 . 1) (assoc 62 ed) ed) (append ed '((62 . 1))))
                                  (list (list -3 (list "SD_DIMTAY" (cons 1070 (cond ((cdr (assoc 62 ed))) (256))))))))))
               ((= op "Khoiphuc")
                (setq ed (subst '(1 . "") (assoc 1 ed) ed))
                (if (setq xd (cadr (assoc -3 ed)))
                  (setq ed (append (vl-remove (assoc -3 ed) (if (assoc 62 ed) (subst (cons 62 (cdr (cadr xd))) (assoc 62 ed) ed) ed))
                                   (list (list -3 (list "SD_DIMTAY"))))))
                (entmod ed))
               ((= op "Xoa") (entdel e))
               (t (ssadd e sel)))))))))
  (princ (strcat "\n[SD] " (if ss (itoa (sslength ss)) "0") " kich thuoc; "
                 (cond ((= op "Bodanhdau") (strcat "bo to mau " (itoa n)))
                       (t (strcat (itoa n) " ghi tay" (if (> nl 0) (strcat " (" (itoa nl) " lech so do > " (sd:num tol) ")") "")
                                  (cond ((= op "Danhdau") " -> to do. Bo to: SDDIMTAY -> Bodanhdau.")
                                        ((= op "Khoiphuc") " -> da tra ve gia tri do.")
                                        ((= op "Xoa") " -> da xoa.") (t " -> dang chon.")))))))
  (setq i 0)
  (foreach r (reverse res) (if (< i 10) (princ (strcat "\n  ghi \"" (car r) "\"  do " (if (cadr r) (sd:rtos (cadr r) 1) "?")))) (setq i (1+ i)))
  (sd:finish)
  (if (> (sslength sel) 0) (sssetfirst nil sel))
  (princ))

;; ---- SDTHUTU - thu tu ve theo layer (duoi -> tren) ----------------------------------
(defun c:SDTHUTU (/ lst ss n sp)
  (sd:begin)
  (if (not (sd:dlg "Thu tu ve theo layer (SDTHUTU)"
                   (list (list "note" "Danh sach layer tu DUOI len TREN, cach nhau dau ; (moi muc dung mau * ? ,)" 'note nil)
                         (list "ds" "Thu tu layer" 'str (cond ((getenv "ShopDrawingThuTu"))
                                                               ("SD-HATCH;SD-GACH*;SD-OSAN;SD-BETONG;SD-CF-*;SD-GIAO;SD-KHUAT;SD-THEP*;SD-KICHTHUOC;SD-KYHIEU;SD-CHU")))
                         (list "hatch" "Sau do dua moi hatch xuong duoi cung (HATCHTOBACK)" 'tog nil)
                         (list "chu" "Sau cung dua chu + kich thuoc len tren cung (TEXTTOFRONT)" 'tog t))))
    (exit))
  (setenv "ShopDrawingThuTu" (sd:v "ds"))
  (setq lst (vl-remove "" (mapcar '(lambda (x) (vl-string-trim " " x)) (sd:split (sd:v "ds") ";")))
        sp (if (= (getvar "CVPORT") 1) (getvar "CTAB") "Model") n 0)
  (foreach p lst
    (if (setq ss (ssget "_X" (list (cons 8 p) (cons 410 sp))))
      (progn (command "_.DRAWORDER" ss "" "_F") (setq n (+ n (sslength ss))))))
  (if (sd:v "hatch") (vl-catch-all-apply 'vl-cmdf '("_.HATCHTOBACK")))
  (if (sd:v "chu") (vl-catch-all-apply 'vl-cmdf '("_.TEXTTOFRONT" "_A")))
  (princ (strcat "\n[SD] Da sap thu tu ve " (itoa n) " doi tuong theo " (itoa (length lst)) " muc layer (muc sau nam tren muc truoc)."))
  (sd:finish))

