;; Quy cach thanh thep (khong gom so hieu, so luong): (d hinh-dang (kich-thuoc) L (doan-cat)) lam tron mm
(defun sd:bt-key (xd / r)
  (setq r (sd:xd->rec xd))
  (list (sd:rtos (nth 2 r) 0) (nth 5 r) (mapcar '(lambda (x) (sd:rtos x 0)) (nth 6 r))
        (sd:rtos (nth 3 r) 0) (mapcar '(lambda (x) (sd:rtos x 0)) (nth 7 r))))
(defun sd:bt-kstr (k) (strcat "D" (car k) " " (cadr k) " L=" (nth 3 k)))

;; Ky hieu thep trong ban ve: ((ename xd cau-kien quy-cach) ...)
(defun sd:bt-tags (/ ss i e xd ck r)
  (setq i 0)
  (if (setq ss (ssget "_X" '((0 . "CIRCLE") (-3 ("SD_REBAR")))))
    (repeat (sslength ss)
      (setq e (ssname ss i) i (1+ i) xd (mapcar 'cdr (cdadr (assoc -3 (entget e '("SD_REBAR"))))))
      (if (not (sd:tm-orphan-p xd))
        (setq ck (cdr (cadr (cadr (assoc -3 (entget e '("SD_CK"))))))
              r  (cons (list e xd (cond (ck) ("")) (sd:bt-key xd)) r)))))
  (reverse r))

;; Them gia tri v vao danh sach cua khoa k trong alist (khong trung)
(defun sd:bt-add (k v al / o)
  (if (setq o (assoc k al))
    (if (member v (cdr o)) al (subst (append o (list v)) o al))
    (cons (list k v) al)))

;; Kiem tra: so hieu mang >1 quy cach / quy cach mang >1 so hieu (trong pham vi). -> (thong-bao ky-hieu-loi)
(defun sd:bt-check (tags per / m1 m2 msg bad sc)
  (foreach t1 tags
    (setq sc (if per (caddr t1) ""))
    (setq m1 (sd:bt-add (list sc (car (cadr t1))) (cadddr t1) m1)
          m2 (sd:bt-add (list sc (cadddr t1)) (car (cadr t1)) m2)))
  (foreach x m1
    (if (cddr x)
      (setq msg (cons (strcat "So hieu " (cadr (car x)) (if per (strcat " (CK " (car (car x)) ")") "")
                              " co " (itoa (length (cdr x))) " quy cach: " (sd:join (mapcar 'sd:bt-kstr (cdr x)) " / "))
                      msg)
            bad (append bad (vl-remove-if-not '(lambda (t1) (and (= (car (cadr t1)) (cadr (car x)))
                                                                 (or (not per) (= (caddr t1) (car (car x))))))
                                              tags)))))
  (foreach x m2
    (if (cddr x)
      (setq msg (cons (strcat "Cung quy cach " (sd:bt-kstr (cadr (car x))) (if per (strcat " (CK " (car (car x)) ")") "")
                              " mang " (itoa (length (cdr x))) " so hieu: " (sd:join (cdr x) ", "))
                      msg)
            bad (append bad (vl-remove-if-not '(lambda (t1) (and (equal (cadddr t1) (cadr (car x)))
                                                                 (or (not per) (= (caddr t1) (car (car x))))))
                                              tags)))))
  (list (reverse msg) bad))

;; So sanh nhom (pham vi quy-cach thu-tu-CK): pham vi, thu tu CK, D giam, L giam
(defun sd:bt< (a b / da db)
  (setq da (atof (car (cadr a))) db (atof (car (cadr b))))
  (cond ((/= (car a) (car b)) (sd:fl< (car a) (car b)))
        ((/= (caddr a) (caddr b)) (sd:fl< (caddr a) (caddr b)))
        ((/= da db) (> da db))
        ((/= (atof (nth 3 (cadr a))) (atof (nth 3 (cadr b)))) (> (atof (nth 3 (cadr a))) (atof (nth 3 (cadr b)))))
        (t (< (vl-prin1-to-string (cadr a)) (vl-prin1-to-string (cadr b))))))

;; Ke hoach danh so -> ((nhom . so-hieu-moi) ...); nhom = (pham-vi quy-cach thu-tu-ck)
(defun sd:bt-plan (tags per byck start pre / gs g o sc n cur r)
  (foreach t1 tags
    (setq sc (if per (caddr t1) "") g (list sc (cadddr t1)))
    (if (setq o (assoc g gs))
      (if (and byck (sd:fl< (caddr t1) (cadr o))) (setq gs (subst (list g (caddr t1)) o gs)))
      (setq gs (cons (list g (caddr t1)) gs))))
  (setq gs (mapcar '(lambda (x) (list (car (car x)) (cadr (car x)) (if byck (cadr x) ""))) gs))
  (setq gs (mapcar '(lambda (k) (nth k gs)) (vl-sort-i gs 'sd:bt<)))
  (setq n (1- start))
  (foreach x gs
    (if (and per (/= (car x) cur)) (setq n (1- start) cur (car x)))
    (setq n (1+ n) r (cons (cons (list (car x) (cadr x)) (strcat pre (itoa n))) r)))
  (reverse r))

;; Chu so hieu trong vong tron: TEXT can giua dat dung tam vong tron
(defun sd:bt-pkey (sp p) (strcat sp "|" (rtos (car p) 2 2) "," (rtos (cadr p) 2 2)))
(defun sd:bt-texts (/ ss i ed r)
  (setq i 0)
  (if (setq ss (ssget "_X" '((0 . "TEXT") (72 . 1) (73 . 2))))
    (repeat (sslength ss)
      (setq ed (entget (ssname ss i)) i (1+ i)
            r (cons (cons (sd:bt-pkey (cond ((cdr (assoc 410 ed))) ("Model")) (cdr (assoc 11 ed))) (cdr (assoc -1 ed))) r))))
  r)

(defun sd:bt-apply (tags plan per / tx ed x3 new te n mx)
  (setq tx (sd:bt-texts) n 0 mx 0)
  (foreach t1 tags
    (setq new (cdr (assoc (list (if per (caddr t1) "") (cadddr t1)) plan))
          ed  (entget (car t1) '("SD_REBAR")) x3 (cadr (assoc -3 ed)))
    (if (wcmatch new "*#") (setq mx (max mx (atoi (vl-string-left-trim "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_. " new)))))
    (if (/= new (car (cadr t1)))
      (progn
        (entmod (append (vl-remove (assoc -3 ed) ed)
                        (list (list -3 (cons "SD_REBAR" (cons (cons 1000 new) (cddr x3)))))))
        (if (and (setq te (cdr (assoc (sd:bt-pkey (cond ((cdr (assoc 410 ed))) ("Model")) (cdr (assoc 10 ed))) tx)))
                 (= (cdr (assoc 1 (entget te))) (car (cadr t1))))
          (entmod (subst (cons 1 new) (assoc 1 (entget te)) (entget te))))
        (setq n (1+ n)))))
  (if (> mx 0) (setq *SD:MARK* (1+ mx)))
  n)

(defun c:SDBONGTHEP (/ tags per chk ss plan n ng)
  (sd:begin)
  (if (not (sd:dlg "Danh so hieu thep dong bo (SDBONGTHEP)"
                   (list (list "op" "Thao tac" 'kw "Danhso"
                               '(("Danhso" . "Danh lai so hieu + cap nhat ky hieu, bang") ("Kiemtra" . "Chi kiem tra trung / lech so hieu")))
                         (list "pv" "Pham vi so hieu" 'kw "Toanbo"
                               '(("Toanbo" . "Toan ban ve: cung quy cach = cung so hieu") ("Caukien" . "Theo tung cau kien (moi CK danh tu dau)")))
                         (list "sx" "Thu tu danh so" 'kw "DK"
                               '(("DK" . "Duong kinh lon -> nho, dai -> ngan") ("Caukien" . "Theo cau kien, roi duong kinh")) nil '("pv" "Toanbo"))
                         (list "start" "So bat dau" 'int 1 nil '("op" "Danhso"))
                         (list "pre" "Tien to so hieu (VD D-, de trong = khong)" 'str "" nil '("op" "Danhso")))))
    (exit))
  (sd:tag-sync-all)
  (setq per (= (sd:v "pv") "Caukien") tags (sd:bt-tags))
  (if (null tags)
    (princ "\n[SD] Khong co ky hieu thep nao (SDTHEP / SDTHEPTM / lenh khai trien).")
    (progn
      (setq chk (sd:bt-check tags per))
      (cond
        ((= (sd:v "op") "Kiemtra")
         (foreach m (car chk) (princ (strcat "\n  [!] " m)))
         (princ (strcat "\n[SD] " (itoa (length tags)) " ky hieu thep: "
                        (if (car chk) (strcat (itoa (length (car chk))) " loi trung / lech so hieu (dang chon cac ky hieu loi)."
                                              " Chay lai SDBONGTHEP -> Danhso de danh lai.")
                          "khong co so hieu trung / lech.")))
         (if (cadr chk)
           (progn (setq ss (ssadd))
                  (foreach t1 (cadr chk) (ssadd (car t1) ss))
                  (sssetfirst nil ss))))
        (t
         (setq plan (sd:bt-plan tags per (and (not per) (= (sd:v "sx") "Caukien")) (sd:v "start") (sd:v "pre"))
               n    (sd:bt-apply tags plan per)
               ng   (length plan))
         (princ (strcat "\n[SD] " (itoa (length tags)) " ky hieu -> " (itoa ng) " so hieu"
                        (if per " (theo tung cau kien)" " (cung quy cach = cung so hieu)") "; doi so " (itoa n) " ky hieu."
                        (if (car chk) (strcat " Da sua " (itoa (length (car chk))) " loi trung / lech.") "")
                        (if (vlax-ldata-get "SD" "TKAUTO") " Bang thong ke tu cap nhat se ve lai." " Ve lai bang thong ke (SDTKTHEP) neu can.")))))))
  (sd:finish))

;; ---- SDNHANLK ----------------------------------------------------------------
;; ObjectId dang chuoi cho FIELD (64-bit: GetObjectIdString)
(defun sd:objid-str (o / r)
  (setq r (vl-catch-all-apply 'vla-GetObjectIdString (list (vla-get-Utility (sd:doc)) o :vlax-false)))
  (if (vl-catch-all-error-p r) (itoa (vla-get-ObjectID o)) r))

;; Thuoc tinh dung cho FIELD: kind "Dai" / "Dientich"
(defun sd:nl-prop (o kind)
  (if (= kind "Dai")
    (cond ((vlax-property-available-p o 'Length) "Length")
          ((vlax-property-available-p o 'ArcLength) "ArcLength")
          ((vlax-property-available-p o 'Circumference) "Circumference"))
    (if (and (vlax-property-available-p o 'Area)
             (or (not (vlax-property-available-p o 'Closed)) (eq (vla-get-Closed o) :vlax-true)))
      "Area")))

;; Ma FIELD: %<\AcObjProp Object(%<\_ObjId n>%).Prop \f "dinh-dang">%
(defun sd:nl-field (o prop fmt)
  (strcat "%<\\AcObjProp Object(%<\\_ObjId " (sd:objid-str o) ">%)." prop " \\f \"" fmt "\">%"))
(defun sd:nl-fmt (kind dvm pr)
  (strcat "%lu2%pr" (itoa pr)
          (cond ((not dvm) "") ((= kind "Dai") "%ct8[0.001]") (t "%ct8[1e-006]"))))
(defun sd:nl-tpl (tpl fld / p)
  (if (setq p (vl-string-search "{}" tpl))
    (strcat (substr tpl 1 p) fld (substr tpl (+ p 3)))
    (strcat tpl fld)))

;; Diem dat + goc: giua duong cong (tiep tuyen) / tam khung bao
(defun sd:nl-place (o kind / e p d bb a)
  (setq e (vlax-vla-object->ename o))
  (if (and (= kind "Dai")
           (not (vl-catch-all-error-p (setq p (vl-catch-all-apply
                                                '(lambda ()
                                                   (setq d (/ (vlax-curve-getDistAtParam e (vlax-curve-getEndParam e)) 2.0))
                                                   (list (vlax-curve-getPointAtDist e d)
                                                         (vlax-curve-getFirstDeriv e (vlax-curve-getParamAtDist e d))))
                                                nil))))
           (car p))
    (progn
      (setq a (angle '(0 0 0) (cadr p)))
      (if (and (> a (/ pi 2)) (<= a (* 1.5 pi))) (setq a (- a pi)))
      (list (car p) a))
    (if (setq bb (sd:obj-bbox o))
      (list (mapcar '(lambda (x y) (/ (+ x y) 2.0)) (car bb) (cadr bb)) 0.0))))

(defun sd:nl-make (pt ang str h rot / doc spc mt)
  (setq doc (sd:doc)
        spc (if (and (= (getvar "TILEMODE") 0) (= (getvar "CVPORT") 1)) (vla-get-PaperSpace doc) (vla-get-ModelSpace doc))
        mt  (vla-AddMText spc (vlax-3d-point pt) 0.0 "-"))
  (vla-put-AttachmentPoint mt acAttachmentPointBottomCenter)
  (vla-put-InsertionPoint mt (vlax-3d-point pt))
  (vla-put-Height mt h)
  (vla-put-Layer mt "SD-CHU")
  (vl-catch-all-apply 'vla-put-StyleName (list mt (sd:tstyle)))
  (if rot (vla-put-Rotation mt ang))
  (vla-put-TextString mt str)
  mt)

(defun c:SDNHANLK (/ kind ss i o n sk pl tpl str h dvm pr p)
  (sd:begin)
  (if (not (sd:dlg "Nhan lien ket doi tuong (SDNHANLK)"
                   (list (list "note" "Nhan la FIELD gan voi doi tuong: keo gian / sua -> so tu cap nhat (REGEN, luu, in)" 'note nil)
                         (list "kind" "Noi dung" 'kw "Dai"
                               '(("Dai" . "Chieu dai (line, polyline, cung, tron)") ("Dientich" . "Dien tich (polyline kin, hatch, region)")
                                 ("Ca2" . "Ca chieu dai va dien tich")))
                         (list "dv" "Don vi ban ve" 'kw "mm" '(("mm" . "mm (hien thi m / m2)") ("m" . "m (giu nguyen)")))
                         (list "pr" "So chu so thap phan" 'int0 2)
                         (list "t1" "Mau chieu dai ({} = gia tri)" 'str "L = {} m" nil '("kind" "Dai" "Ca2"))
                         (list "t2" "Mau dien tich ({} = gia tri)" 'str "S = {} m\\U+00B2" nil '("kind" "Dientich" "Ca2"))
                         (list "vt" "Vi tri nhan" 'kw "Tudong" '(("Tudong" . "Tu dong giua doi tuong") ("Chon" . "Chon diem cho tung doi tuong")))
                         (list "rot" "Xoay nhan theo doi tuong (chieu dai)" 'tog t))))
    (exit))
  (setq kind (sd:v "kind") dvm (= (sd:v "dv") "mm") pr (sd:v "pr") h (* 2.5 (sd:sc)) i 0 n 0 sk 0)
  (princ "\nChon doi tuong can gan nhan: ")
  (if (setq ss (ssget '((0 . "LINE,LWPOLYLINE,POLYLINE,ARC,CIRCLE,ELLIPSE,HATCH,REGION"))))
    (progn
      (repeat (sslength ss)
        (setq o (vlax-ename->vla-object (ssname ss i)) i (1+ i) str nil)
        (foreach k (if (= kind "Ca2") '("Dai" "Dientich") (list kind))
          (if (setq p (sd:nl-prop o k))
            (setq tpl (sd:nl-tpl (if (= k "Dai") (sd:v "t1") (sd:v "t2")) (sd:nl-field o p (sd:nl-fmt k dvm pr)))
                  str (if str (strcat str "\\P" tpl) tpl))))
        (cond
          ((null str) (setq sk (1+ sk)))
          ((= (sd:v "vt") "Chon")
           (redraw (vlax-vla-object->ename o) 3)
           (setq p (sd:getpt (strcat "\nVi tri nhan " (itoa i) "/" (itoa (sslength ss)) " <bo qua>: ") nil))
           (redraw (vlax-vla-object->ename o) 4)
           (if p (progn (sd:nl-make p 0.0 str h nil) (setq n (1+ n)))))
          ((setq pl (sd:nl-place o (if (= kind "Dientich") "Dientich" "Dai")))
           (sd:nl-make (car pl) (cadr pl) str h (and (sd:v "rot") (/= kind "Dientich"))) (setq n (1+ n)))))
      (vla-Regen (sd:doc) acActiveViewport)
      (princ (strcat "\n[SD] Da gan " (itoa n) " nhan lien ket"
                     (if (> sk 0) (strcat ", bo qua " (itoa sk) " doi tuong khong co thuoc tinh phu hop (VD polyline ho khi tinh dien tich)") "")
                     ". So cap nhat khi REGEN / luu / in; xoa doi tuong -> nhan hien ####."))))
  (sd:finish))

;; ---- SDTAOLAYOUT ---------------------------------------------------------------
(defun sd:lo-safe (s)
  (foreach c '("<" ">" "/" "\\" "\"" ":" ";" "?" "*" "|" "," "=" "`")
    (while (vl-string-search c s) (setq s (vl-string-subst "-" c s))))
  s)
(defun sd:lo-pad (i w / s) (setq s (itoa i)) (while (< (strlen s) w) (setq s (strcat "0" s))) s)
;; So to theo dinh dang: So "1", So0 "01", SoN "1/12", So0N "01/12"
(defun sd:lo-num (i n fmt / w)
  (setq w (if (wcmatch fmt "So0*") (max 2 (strlen (itoa n))) 1))
  (strcat (sd:lo-pad i w) (if (wcmatch fmt "*N") (strcat "/" (sd:lo-pad n w)) "")))
;; Ghi gia tri vao cac thuoc tinh co tag khop mau (wcmatch) cua block e -> so thuoc tinh da ghi
(defun sd:lo-attr (e tags val / n)
  (setq n 0)
  (if (and e (/= tags "") (= (cdr (assoc 0 (entget e))) "INSERT") (= (cdr (assoc 66 (entget e))) 1))
    (foreach a (sd:sa->list (vla-GetAttributes (vlax-ename->vla-object e)))
      (if (wcmatch (strcase (vla-get-TagString a)) (strcase tags))
        (progn (vla-put-TextString a val) (setq n (1+ n))))))
  n)
;; Gia tri thuoc tinh dau tien khop mau
(defun sd:lo-attr-get (e tags / r)
  (if (and e (/= tags "") (= (cdr (assoc 0 (entget e))) "INSERT") (= (cdr (assoc 66 (entget e))) 1))
    (foreach a (sd:sa->list (vla-GetAttributes (vlax-ename->vla-object e)))
      (if (and (not r) (wcmatch (strcase (vla-get-TagString a)) (strcase tags)) (/= (vla-get-TextString a) ""))
        (setq r (vla-get-TextString a)))))
  r)

;; Tao 1 layout: kho giay tu dong theo khung / ty le, 1 viewport dung bang khung, ty le 1:sc, khoa. T / chuoi loi
(defun sd:lo-make (doc name f dev ctb sc / l blk m w h pw ph vp dl r o)
  (setq r (vl-catch-all-apply
            '(lambda ()
               (setq l (vla-Add (vla-get-Layouts doc) name))
               (vla-put-ConfigName l dev)
               (vla-RefreshPlotDeviceInfo l)
               (setq w (/ (- (car (cadr f)) (car (car f))) sc) h (/ (- (cadr (cadr f)) (cadr (car f))) sc)
                     m (sd:in-autopaper f (mapcar '(lambda (x) (list (car x) (caddr x) (cadddr x))) (sd:in-media l)) sc))
               (if m (vla-put-CanonicalMediaName l (car m)))
               (vla-put-PaperUnits l acMillimeters)
               (vla-GetPaperSize l 'pw 'ph)
               (vla-put-PlotRotation l (if (eq (> w h) (> pw ph)) ac0degrees ac90degrees))
               (vla-put-PlotType l acExtents)
               (vla-put-UseStandardScale l :vlax-true)
               (vla-put-StandardScale l ac1_1)
               (vla-put-CenterPlot l :vlax-true)
               (if ctb (progn (vla-put-PlotWithPlotStyles l :vlax-true) (vla-put-StyleSheet l ctb)))
               (vla-put-ActiveLayout doc l)
               (setq blk (vla-get-Block l))
               (vlax-for o blk (if (= (vla-get-ObjectName o) "AcDbViewport") (setq dl (cons o dl))))
               (foreach o dl (vl-catch-all-apply 'vla-Delete (list o)))
               (setq vp (vla-AddPViewport blk (vlax-3d-point (list (/ w 2.0) (/ h 2.0) 0.0)) w h))
               (vla-put-Layer vp "SD-VP")
               (vl-catch-all-apply 'vla-put-ViewportOn (list vp :vlax-true))
               (vla-put-CustomScale vp (/ 1.0 sc))
               (vla-put-ViewCenter vp (vlax-3d-point (mapcar '(lambda (a b) (/ (+ a b) 2.0)) (car f) (cadr f))))
               (vla-put-DisplayLocked vp :vlax-true)
               (vl-catch-all-apply 'vla-ZoomExtents (list (vlax-get-acad-object))))
            nil))
  (if (vl-catch-all-error-p r) (vl-catch-all-error-message r) t))

(defun c:SDTAOLAYOUT (/ doc old lay devs ctbs dev ctb mode key order lam fr n i e nm r los ok made skip na sc tags fmt)
  (sd:begin)
  (setq doc (sd:doc)
        old (cond ((vlax-ldata-get "SD" "TLO")) ((vlax-ldata-get "SD" "INHL")) ('())))
  (if (= (getvar "TILEMODE") 0) (setvar "TILEMODE" 1))
  (setq lay (vla-get-ActiveLayout doc))
  (vla-RefreshPlotDeviceInfo lay)
  (setq devs (vl-remove "None" (sd:sa->list (vla-GetPlotDeviceNames lay)))
        ctbs (cons "(khong)" (vl-sort (sd:sa->list (vla-GetPlotStyleTableNames lay)) '<)))
  (if (not (sd:dlg "Tao Layout hang loat + danh so to (SDTAOLAYOUT)"
                   (list (list "lam" "Thao tac" 'kw (cond ((cdr (assoc "lam" old))) ("Ca2"))
                               '(("Ca2" . "Tao Layout + danh so to") ("Layout" . "Chi tao Layout") ("Soto" . "Chi danh so to vao khung ten")))
                         (list "mode" "Khung ban ve la" 'kw (cond ((cdr (assoc "mode" old))) ("Block"))
                               '(("Block" . "Block (khung ten)") ("Layer" . "Polyline kin tren layer")))
                         (list "key" "Ten block / layer khung (trong = chon khung mau)" 'str (cond ((cdr (assoc "key" old))) ("")))
                         (list "order" "Thu tu to" 'kw (cond ((cdr (assoc "order" old))) ("Hang"))
                               '(("Hang" . "Hang: tren xuong, trai sang phai") ("Cot" . "Cot: trai sang phai, tren xuong")))
                         (list "dev" "May in cho Layout" 'kw (sd:idx-of (cond ((cdr (assoc "dev" old))) ((car (vl-member-if '(lambda (x) (wcmatch (strcase x) "*PDF*")) devs))) ("")) devs)
                               (sd:idx-choices devs) nil '("lam" "Ca2" "Layout"))
                         (list "ctb" "Net in" 'kw (sd:idx-of (cond ((cdr (assoc "ctb" old))) ("monochrome.ctb")) ctbs) (sd:idx-choices ctbs) nil '("lam" "Ca2" "Layout"))
                         (list "sc" "Ty le khung trong Model 1:" 'int (cond ((numberp (cdr (assoc "sc" old))) (cdr (assoc "sc" old))) ((fix (sd:sc)))) nil '("lam" "Ca2" "Layout"))
                         (list "pre" "Ten Layout = tien to + so to" 'str (cond ((cdr (assoc "pre" old))) ("BV-")) nil '("lam" "Ca2" "Layout"))
                         (list "trung" "Layout trung ten" 'kw (cond ((cdr (assoc "trung" old))) ("Thay")) '(("Thay" . "Xoa layout cu, tao lai") ("Bo" . "Giu layout cu, bo qua")) nil '("lam" "Ca2" "Layout"))
                         (list "tag" "Tag thuoc tinh so to (* ? = mau)" 'str (cond ((cdr (assoc "tag" old))) ("SOTO,SO_TO,SOBV,SHEET*")) nil '("lam" "Ca2" "Soto"))
                         (list "fmt" "Dinh dang so to" 'kw (cond ((cdr (assoc "fmt" old))) ("So0"))
                               '(("So" . "1, 2, 3") ("So0" . "01, 02, 03") ("SoN" . "1/12, 2/12") ("So0N" . "01/12, 02/12")) nil '("lam" "Ca2" "Soto"))
                         (list "tagn" "Tag thuoc tinh tong so to (trong = khong)" 'str (cond ((cdr (assoc "tagn" old))) ("TONGTO,TONG_TO")) nil '("lam" "Ca2" "Soto")))))
    (exit))
  (setq lam (sd:v "lam") mode (sd:v "mode") key (vl-string-trim " " (sd:v "key")) order (sd:v "order")
        dev (sd:idx-get (sd:v "dev") devs) ctb (sd:idx-get (sd:v "ctb") ctbs) sc (float (sd:v "sc"))
        tags (vl-string-trim " " (sd:v "tag")) fmt (sd:v "fmt"))
  (if (= ctb "(khong)") (setq ctb nil))
  (if (= key "")
    (if (setq e (car (entsel "\nChon 1 khung ten mau (block hoac polyline): ")))
      (setq key (if (= mode "Block")
                  (cond ((sd:prop (vlax-ename->vla-object e) 'EffectiveName)) ((cdr (assoc 2 (entget e)))))
                  (cdr (assoc 8 (entget e)))))))
  (setq fr (if (and key (/= key "")) (sd:in-order (sd:in-frames mode key nil) order)) n (length fr))
  (if (null fr)
    (princ (strcat "\n[SD] Khong tim thay khung " (if (= mode "Block") "block " "tren layer ") (cond (key) ("")) " trong Model."))
    (progn
      (vlax-ldata-put "SD" "TLO" (list (cons "lam" lam) (cons "mode" mode) (cons "key" key) (cons "order" order)
                                       (cons "dev" dev) (cons "ctb" (cond (ctb) ("(khong)"))) (cons "sc" (fix sc))
                                       (cons "pre" (sd:v "pre")) (cons "trung" (sd:v "trung"))
                                       (cons "tag" tags) (cons "fmt" fmt) (cons "tagn" (sd:v "tagn"))))
      ;; ---- danh so to vao thuoc tinh khung ten (theo thu tu to)
      (setq i 0 na 0)
      (if (/= lam "Layout")
        (foreach f fr
          (setq i (1+ i)
                na (+ na (sd:lo-attr (nth 3 f) tags (sd:lo-num i n fmt))))
          (sd:lo-attr (nth 3 f) (vl-string-trim " " (sd:v "tagn")) (if (wcmatch fmt "So0*") (sd:lo-pad n 2) (itoa n)))))
      ;; ---- tao layout: moi khung 1 layout, viewport dung khung
      (setq i 0 made 0 skip 0)
      (if (/= lam "Soto")
        (progn
          (if (null dev) (setq dev "DWG To PDF.pc3"))
          (sd:make-layer "SD-VP" 8 "Continuous" 13)
          (setq r (entget (tblobjname "LAYER" "SD-VP")))
          (if (/= (cdr (assoc 290 r)) 0) (entmod (append (vl-remove (assoc 290 r) r) '((290 . 0)))))
          (if (getvar "LAYOUTCREATEVIEWPORT")
            (setq *SD:VARS* (cons (cons "LAYOUTCREATEVIEWPORT" (getvar "LAYOUTCREATEVIEWPORT")) *SD:VARS*)))
          (if (getvar "LAYOUTCREATEVIEWPORT") (setvar "LAYOUTCREATEVIEWPORT" 0))
          (setq los (vla-get-Layouts doc))
          (foreach f fr
            (setq i (1+ i)
                  nm (sd:lo-safe (strcat (sd:v "pre") (sd:lo-pad i (max 2 (strlen (itoa n))))))
                  ok t)
            (if (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-Item (list los nm))))
              (if (= (sd:v "trung") "Thay")
                (if (vl-catch-all-error-p (vl-catch-all-apply 'vla-Delete (list (vla-Item los nm))))
                  (setq ok nil))
                (setq ok nil)))
            (if (not ok)
              (setq skip (1+ skip))
              (if (= (setq r (sd:lo-make doc nm f dev ctb sc)) t)
                (setq made (1+ made))
                (princ (strcat "\n[SD] Loi tao layout " nm ": " r)))))
          (setvar "TILEMODE" 1)))
      (princ (strcat "\n[SD] " (itoa n) " khung"
                     (if (/= lam "Layout") (strcat "; ghi so to vao " (itoa na) " thuoc tinh"
                                                   (if (= na 0) " (khung khong co thuoc tinh khop tag)" "")) "")
                     (if (/= lam "Soto") (strcat "; tao " (itoa made) " layout" (if (> skip 0) (strcat ", bo qua " (itoa skip) " layout trung ten") "")
                                                 " (viewport 1:" (itoa (fix sc)) " khoa, layer SD-VP khong in). In ca bo: SDIN -> In tat ca Layout.") "")))))
  (sd:finish))

;; ---- SDLIENKET -----------------------------------------------------------------
;; Bo ma dinh dang MTEXT -> chu thuong
(defun sd:mt-plain (s / r i c n)
  (setq r "" i 1)
  (while (<= i (strlen s))
    (setq c (substr s i 1))
    (cond
      ((= c "\\")
       (setq n (substr s (1+ i) 1))
       (cond ((member n '("P" "~")) (setq r (strcat r " ") i (+ i 2)))
             ((member n '("\\" "{" "}")) (setq r (strcat r n) i (+ i 2)))
             ((member (strcase n) '("F" "H" "C" "W" "Q" "T" "A" "P" "S"))
              (setq i (1+ i))
              (while (and (<= i (strlen s)) (/= (substr s i 1) ";")) (setq i (1+ i)))
              (setq i (1+ i)))
             (t (setq i (+ i 2)))))
      ((member c '("{" "}")) (setq i (1+ i)))
      (t (setq r (strcat r c) i (1+ i)))))
  r)
;; Ten cau kien = tu dau tien cua chu
(defun sd:lk-name (s / i)
  (setq s (vl-string-trim " \t" s) i 1)
  (while (and (<= i (strlen s)) (not (member (substr s i 1) '(" " "(" "\t" ":" ";" "/" "=")))) (setq i (1+ i)))
  (substr s 1 (1- i)))

(defun sd:lk-mark (p r txt sc)
  (entmake (list '(0 . "CIRCLE") '(8 . "SD-KIEMTRA") (cons 10 p) (cons 40 r)))
  (sd:text (sd:p+ p 0 (+ r sc)) txt (* 2.5 sc) "L" "SD-KIEMTRA"))

(defun c:SDLIENKET (/ old sc ss i e ed s nm p plan det all o rows nok npl ndt bb pt tang r q)
  (sd:begin)
  (setq old (cond ((vlax-ldata-get "SD" "LKT")) ('())) sc (sd:sc))
  (if (not (sd:dlg "Kiem tra mat bang <-> khai trien (SDLIENKET)"
                   (list (list "note" "So ten cau kien ghi tren mat bang voi cau kien da khai trien (du lieu khoi luong SD_KL)" 'note nil)
                         (list "lay" "Layer chu ten cau kien tren MB (trong = chon tren man hinh)" 'str (cond ((cdr (assoc "lay" old))) ("")))
                         (list "pat" "Mau ten cau kien (@ = chu, # = so, * = bat ky)" 'str (cond ((cdr (assoc "pat" old))) ("@*#*")))
                         (list "tang" "Chi so voi cau kien cua tang (trong = tat ca)" 'str (cond ((cdr (assoc "tang" old))) ("")))
                         (list "mark" "Khoanh do cho thieu tren ban ve (layer SD-KIEMTRA)" 'tog t)
                         (list "bang" "Ve bang ket qua" 'tog t))))
    (exit))
  (vlax-ldata-put "SD" "LKT" (list (cons "lay" (sd:v "lay")) (cons "pat" (sd:v "pat")) (cons "tang" (sd:v "tang"))))
  (setq tang (strcase (vl-string-trim " " (sd:v "tang"))))
  (sd:make-layer "SD-KIEMTRA" 1 "Continuous" 35)
  ;; xoa danh dau lan truoc
  (if (setq ss (ssget "_X" '((8 . "SD-KIEMTRA"))))
    (progn (setq i 0) (repeat (sslength ss) (entdel (ssname ss i)) (setq i (1+ i)))))
  ;; ten tren mat bang: ((TEN diem...) ...)
  (setq ss (if (= (vl-string-trim " " (sd:v "lay")) "")
             (progn (princ "\nChon chu ten cau kien tren mat bang: ") (ssget '((0 . "TEXT,MTEXT"))))
             (ssget "_X" (list '(0 . "TEXT,MTEXT") (cons 8 (sd:v "lay"))))))
  (setq i 0)
  (if ss
    (repeat (sslength ss)
      (setq ed (entget (ssname ss i)) i (1+ i)
            s  (if (= (cdr (assoc 0 ed)) "MTEXT") (sd:mt-plain (vla-get-TextString (vlax-ename->vla-object (cdr (assoc -1 ed))))) (cdr (assoc 1 ed)))
            nm (strcase (sd:lk-name s)))
      (if (and (/= nm "") (wcmatch nm (strcase (sd:v "pat"))) (/= (cdr (assoc 8 ed)) "SD-KIEMTRA"))
        (setq plan (sd:bt-add nm (cdr (assoc 10 ed)) plan)))))
  ;; cau kien da khai trien: ((TEN ename...) ...)
  (setq i 0)
  (if (setq ss (ssget "_X" '((-3 ("SD_KL")))))
    (repeat (sslength ss)
      (setq e (ssname ss i) i (1+ i)
            o (mapcar 'cdr (cdadr (assoc -3 (entget e '("SD_KL"))))))
      (if (or (= tang "") (= (strcase (cond ((nth 6 o)) (""))) tang))
        (setq det (sd:bt-add (strcase (car o)) e det)))))
  (foreach x (append plan det) (if (not (member (car x) all)) (setq all (cons (car x) all))))
  (setq all (mapcar '(lambda (k) (nth k all)) (vl-sort-i all 'sd:fl<)) nok 0 npl 0 ndt 0)
  (foreach nm all
    (setq p (cdr (assoc nm plan)) o (cdr (assoc nm det)))
    (cond ((and p o) (setq nok (1+ nok)))
          (p (setq npl (1+ npl))
             (if (sd:v "mark") (foreach q p (sd:lk-mark q (* 6.0 sc) "CHUA KHAI TRIEN" sc))))
          (t (setq ndt (1+ ndt))
             (if (and (sd:v "mark") (setq bb (sd:obj-bbox (vlax-ename->vla-object (car o)))))
               (sd:lk-mark (mapcar '(lambda (a b) (/ (+ a b) 2.0)) (car bb) (cadr bb))
                           (max (* 6.0 sc) (* 0.6 (distance (car bb) (cadr bb)))) "KHONG CO TREN MAT BANG" sc))))
    (setq rows (cons (list "R" (list nm (itoa (length p)) (itoa (length o))
                                     (cond ((and p o) "OK") (p "CH\\U+01AFA KHAI TRI\\U+1EC2N") (t "KH\\U+00D4NG C\\U+00D3 TR\\U+00CAN MB")))
                           nil)
                     rows)))
  (setq rows (reverse rows))
  (princ (strcat "\n[SD] " (itoa (length all)) " cau kien: " (itoa nok) " khop, " (itoa npl) " co tren MB nhung chua khai trien, "
                 (itoa ndt) " da khai trien nhung khong thay tren MB" (if (/= tang "") (strcat " (tang " tang ")") "") "."))
  (foreach r rows (if (/= (nth 3 (cadr r)) "OK") (princ (strcat "\n  [!] " (car (cadr r)) ": " (nth 3 (cadr r))))))
  (if (and rows (sd:v "bang") (setq pt (sd:getpt "\nDiem chen bang ket qua (goc trai tren) <bo qua>: " nil)))
    (sd:table2 pt "KI\\U+1EC2M TRA M\\U+1EB6T B\\U+1EB0NG - KHAI TRI\\U+1EC2N" '(("T\\U+00CAN CK" 22) ("TR\\U+00CAN MB" 18) ("KHAI TRI\\U+1EC2N" 20) ("TR\\U+1EA0NG TH\\U+00C1I" 40)) rows -1 sc))
  (sd:finish))

;;; ==========================================================================
;;;  SDCDE - Phat hanh len CDE (Common Data Environment) theo ISO 19650
;;;    So hieu tai lieu: Du an-Don vi lap-Khu vuc-Tang-Loai-Bo mon-So (VD DA07-RPG-ZZ-02-DR-S-0101)
;;;    Trang thai: S0 (WIP) -> 01_WIP; S1..S4 (chia se) -> 02_SHARED; A1..A3 / CR (phat hanh) -> 03_PUBLISHED;
;;;    ban cu cung so hieu tu dong chuyen sang 04_ARCHIVED. Phien ban: P01.. (S0-S4), C01.. (A / CR).
;;;    Moi to (Layout hoac khung ten trong Model) -> 1 PDF ten <so hieu>_<phien ban>_<trang thai>.pdf;
;;;    ghi so hieu / phien ban / trang thai vao thuoc tinh khung ten; so dang ky CDE_Register.csv + phieu chuyen giao.
;;;  Thu muc CDE: thu muc dong bo cua ACC Docs (Desktop Connector), SharePoint / OneDrive, Trimble Connect... hoac o mang.
;;; ==========================================================================
(setq *SD:CDEST*
  '(("S0" . "S0 - Dang thuc hien (WIP)") ("S1" . "S1 - Phoi hop") ("S2" . "S2 - Tham khao thong tin")
    ("S3" . "S3 - Xem xet va gop y") ("S4" . "S4 - Trinh phe duyet") ("A1" . "A1 - Phat hanh thi cong")
    ("A2" . "A2 - Phat hanh dau thau") ("A3" . "A3 - Phat hanh thiet ke") ("CR" . "CR - Hoan cong")))

;; Thu muc trang thai theo ma
(defun sd:cde-state (st)
  (cond ((= st "S0") "01_WIP") ((wcmatch st "S#") "02_SHARED") (t "03_PUBLISHED")))

;; Kiem tra 1 truong ma: chu / so, do dai lo..hi -> nil (OK) hoac chuoi loi
(defun sd:cde-fchk (lab v lo hi dig)
  (cond ((or (< (strlen v) lo) (> (strlen v) hi)) (strcat lab " '" v "' phai dai " (itoa lo) "-" (itoa hi) " ky tu"))
        ((not (wcmatch v (if dig (sd:cde-rep "#" (strlen v)) (sd:cde-rep "[A-Z0-9]" (strlen v)))))
         (strcat lab " '" v "' chi gom " (if dig "chu so" "chu in hoa / so")))))
(defun sd:cde-rep (s n / r) (setq r "") (repeat n (setq r (strcat r s))) r)

;; Danh sach loi cua cau hinh: cfg = ((khoa . gia tri) ...)
(defun sd:cde-g (cfg k) (strcase (vl-string-trim " " (cond ((cdr (assoc k cfg))) ("")))))
(defun sd:cde-check (cfg / r st rev)
  (setq st (sd:cde-g cfg "st") rev (sd:cde-g cfg "rev"))
  (foreach x (list (sd:cde-fchk "Du an" (sd:cde-g cfg "proj") 2 6 nil) (sd:cde-fchk "Don vi lap" (sd:cde-g cfg "orig") 3 6 nil)
                   (sd:cde-fchk "Khu vuc" (sd:cde-g cfg "vol") 1 3 nil) (sd:cde-fchk "Tang" (sd:cde-g cfg "lev") 2 3 nil)
                   (sd:cde-fchk "Loai" (sd:cde-g cfg "typ") 2 2 nil) (sd:cde-fchk "Bo mon" (sd:cde-g cfg "role") 1 2 nil)
                   (sd:cde-fchk "So bat dau" (sd:cde-g cfg "num") 4 6 t)
                   (if (not (wcmatch rev "[PC]##*")) (strcat "Phien ban '" rev "' phai dang P01 / C01")
                     (if (/= (substr rev 1 1) (if (wcmatch st "S#") "P" "C"))
                       (strcat "Phien ban " rev " khong hop trang thai " st " (S0-S4 dung P.., A / CR dung C..)"))))
    (if x (setq r (cons x r))))
  (reverse r))

;; So hieu tai lieu to thu i (tu 0)
(defun sd:cde-docno (cfg i / n w s)
  (setq n (sd:cde-g cfg "num") w (strlen n) s (itoa (+ (atoi n) i)))
  (while (< (strlen s) w) (setq s (strcat "0" s)))
  (sd:join (list (sd:cde-g cfg "proj") (sd:cde-g cfg "orig") (sd:cde-g cfg "vol") (sd:cde-g cfg "lev") (sd:cde-g cfg "typ") (sd:cde-g cfg "role") s) "-"))

(defun sd:cde-mkdir (d)
  (or (vl-file-directory-p d) (vl-mkdir d) (sd:fso-do 'CreateFolder (list d)))
  d)

;; Chuyen cac ban khac phien ban cua so hieu doc trong cac thu muc chia se / phat hanh sang 04_ARCHIVED -> so file
(defun sd:cde-archive (root doc keep / n dst)
  (setq n 0)
  (foreach st '("01_WIP" "02_SHARED" "03_PUBLISHED")
    (foreach f (vl-directory-files (strcat root "\\" st) (strcat doc "_*.*") 1)
      (if (not (wcmatch (strcase f) (strcat (strcase keep) "*")))
        (progn
          (setq dst (strcat (sd:cde-mkdir (strcat root "\\04_ARCHIVED")) "\\" f))
          (if (sd:fexists dst) (sd:fso-do 'DeleteFile (list dst :vlax-true)))
          (if (sd:fso-do 'MoveFile (list (strcat root "\\" st "\\" f) dst)) (setq n (1+ n)))))))
  n)

;; Ghi thuoc tinh khung ten: so hieu / phien ban / trang thai
(defun sd:cde-attrs (e cfg doc)
  (+ (sd:lo-attr e (cdr (assoc "tdoc" cfg)) doc)
     (sd:lo-attr e (cdr (assoc "trev" cfg)) (strcase (cdr (assoc "rev" cfg))))
     (sd:lo-attr e (cdr (assoc "tst" cfg)) (strcase (cdr (assoc "st" cfg))))))

;; Ghi dong vao CSV (tao tieu de neu file moi)
(defun sd:cde-csv (fn head lines / new f)
  (setq new (not (sd:fexists fn)))
  (if (setq f (sd:open fn (if new "w" "a")))
    (progn (if new (write-line head f))
           (foreach l lines (write-line l f))
           (sd:close f))))
(defun sd:cde-trim (n l) (if (> (length l) n) (sd:head n l) l))
(defun sd:cde-q (s) (strcat "\"" (vl-string-translate "\"" "'" s) "\""))

(defun c:SDCDE (/ doc old cfg op errs root st dir dev lay devs bp i n fn docno files rows ok r ss j e lays fr
                  media m ext stamp who tr nar src title)
  (sd:begin)
  (setq doc (sd:doc)
        old (cond ((vlax-ldata-get "SD" "CDE")) ('())))
  (if (not (sd:dlg "Phat hanh len CDE - ISO 19650 (SDCDE)"
                   (list (list "op" "Thao tac" 'kw (cond ((cdr (assoc "op" old))) ("Phathanh"))
                               '(("Phathanh" . "Phat hanh: xuat PDF vao thu muc trang thai + so dang ky")
                                 ("Kiemtra" . "Kiem tra ma ISO 19650 + lich su phat hanh")))
                         (list "root" "Thu muc CDE (thu muc dong bo ACC / SharePoint / o mang)" 'str
                               (cond ((cdr (assoc "root" old))) ((strcat (getvar "DWGPREFIX") "CDE"))))
                         (list "proj" "Ma du an (2-6)" 'str (cond ((cdr (assoc "proj" old))) ("DA01")))
                         (list "orig" "Ma don vi lap (3-6)" 'str (cond ((cdr (assoc "orig" old))) ("ABC")))
                         (list "vol" "Khu vuc / hang muc (ZZ = toan bo)" 'str (cond ((cdr (assoc "vol" old))) ("ZZ")))
                         (list "lev" "Tang (00, 01, B1, ZZ...)" 'str (cond ((cdr (assoc "lev" old))) ("ZZ")))
                         (list "typ" "Loai tai lieu (DR ban ve, M3 mo hinh, SH bang...)" 'str (cond ((cdr (assoc "typ" old))) ("DR")))
                         (list "role" "Bo mon (S ket cau, A kien truc...)" 'str (cond ((cdr (assoc "role" old))) ("S")))
                         (list "num" "So to bat dau (4-6 chu so)" 'str (cond ((cdr (assoc "num" old))) ("0001")))
                         (list "st" "Trang thai (suitability)" 'kw (cond ((cdr (assoc "st" old))) ("S2")) *SD:CDEST*)
                         (list "rev" "Phien ban (P01.. chia se, C01.. phat hanh)" 'str (cond ((cdr (assoc "rev" old))) ("P01")))
                         (list "src" "To ban ve" 'kw (cond ((cdr (assoc "src" old))) ("Layout"))
                               '(("Layout" . "Moi Layout 1 to (theo thu tu tab)") ("Khung" . "Khung ten trong Model (thiet lap SDIN / SDTAOLAYOUT)"))
                               nil '("op" "Phathanh"))
                         (list "dwg" "Kem ban DWG (ban sao cung phien ban)" 'tog (if (assoc "dwg" old) (cdr (assoc "dwg" old)) t) nil '("op" "Phathanh"))
                         (list "arch" "Chuyen ban cu cung so hieu sang 04_ARCHIVED" 'tog t nil '("op" "Phathanh"))
                         (list "tdoc" "Tag thuoc tinh so hieu" 'str (cond ((cdr (assoc "tdoc" old))) ("SOHIEU*,DOCNO*,DOC_NO*,MA_BV*")) nil '("op" "Phathanh"))
                         (list "trev" "Tag thuoc tinh phien ban" 'str (cond ((cdr (assoc "trev" old))) ("REV*,PHIENBAN*,LANSUA*")) nil '("op" "Phathanh"))
                         (list "tst" "Tag thuoc tinh trang thai" 'str (cond ((cdr (assoc "tst" old))) ("TRANGTHAI*,STATUS*,SUIT*")) nil '("op" "Phathanh")))))
    (exit))
  (setq cfg (mapcar '(lambda (k) (cons k (sd:v k))) '("op" "root" "proj" "orig" "vol" "lev" "typ" "role" "num" "st" "rev" "src" "dwg" "tdoc" "trev" "tst"))
        op (sd:v "op") st (sd:v "st")
        root (vl-string-right-trim "\\/ " (sd:v "root"))
        errs (sd:cde-check cfg))
  (vlax-ldata-put "SD" "CDE" (append cfg (list (cons "hist" (cdr (assoc "hist" old))))))
  (cond
    ;; ---- kiem tra
    ((= op "Kiemtra")
     (princ (strcat "\n[SD] Mau so hieu: " (sd:cde-docno cfg 0) "_" (strcase (sd:v "rev")) "_" st
                    "  -> thu muc " root "\\" (sd:cde-state st)))
     (if errs (foreach x errs (princ (strcat "\n  [!] " x))) (princ "\n  Ma dung quy uoc ISO 19650."))
     (princ "\n[SD] Lich su phat hanh ban ve nay (moi nhat truoc):")
     (setq i 0)
     (foreach h (cdr (assoc "hist" old))
       (if (< i 20) (princ (strcat "\n  " (sd:join h "  "))))
       (setq i (1+ i)))
     (if (= i 0) (princ "\n  (chua phat hanh lan nao)")))
    (errs
     (foreach x errs (princ (strcat "\n  [!] " x)))
     (princ "\n[SD] Ma chua dung quy uoc - sua roi chay lai (khong phat hanh)."))
    ;; ---- phat hanh
    (t
     (sd:cde-mkdir root)
     (setq dir (sd:cde-mkdir (strcat root "\\" (sd:cde-state st)))
           lay (vla-get-ActiveLayout doc))
     (vla-RefreshPlotDeviceInfo lay)
     (setq devs (sd:sa->list (vla-GetPlotDeviceNames lay))
           dev  (cond ((car (vl-member-if '(lambda (x) (wcmatch (strcase x) "DWG TO PDF*")) devs)))
                      ((car (vl-member-if '(lambda (x) (wcmatch (strcase x) "*PDF*")) devs))))
           bp (getvar "BACKGROUNDPLOT")
           *SD:VARS* (cons (cons "BACKGROUNDPLOT" bp) *SD:VARS*)
           stamp (menucmd "M=$(edtime,$(getvar,date),YYYYMODD-HHMMSS)")
           who (cond ((getvar "LOGINNAME")) ("")) i 0 n 0)
     (setvar "BACKGROUNDPLOT" 0)
     (if (null dev) (princ "\n[SD] Khong tim thay may in PDF (DWG To PDF.pc3) - chi ghi thuoc tinh / DWG."))
     (cond
       ((= (sd:v "src") "Layout")
        (vlax-for l (vla-get-Layouts doc) (if (/= (vla-get-ModelType l) :vlax-true) (setq lays (cons l lays))))
        (setq lays (sd:sort lays '(lambda (a b) (< (vla-get-TabOrder a) (vla-get-TabOrder b)))))
        (foreach l lays
          (setq docno (sd:cde-docno cfg i) i (1+ i)
                fn (strcat dir "\\" docno "_" (strcase (sd:v "rev")) "_" st ".pdf")
                title (vla-get-Name l))
          (if (setq ss (ssget "_X" (list '(0 . "INSERT") '(66 . 1) (cons 410 (vla-get-Name l)))))
            (progn (setq j 0) (repeat (sslength ss) (sd:cde-attrs (ssname ss j) cfg docno) (setq j (1+ j)))))
          (vla-put-ActiveLayout doc l)
          (if (and dev (not (wcmatch (strcase (vla-get-ConfigName l)) "*PDF*")))
            (vl-catch-all-apply 'vla-put-ConfigName (list l dev)))
          (setq r (if dev (vl-catch-all-apply '(lambda () (vla-PlotToFile (vla-get-Plot doc) fn)) nil)))
          (if (and dev (not (eq r :vlax-true)))
            (princ (strcat "\n[SD] Loi in " title (if (vl-catch-all-error-p r) (strcat ": " (vl-catch-all-error-message r)) ""))))
          (setq files (cons (list docno title fn (eq r :vlax-true)) files)))
        (setvar "TILEMODE" 1))
       (t
        (setq old (cond ((vlax-ldata-get "SD" "TLO")) ((vlax-ldata-get "SD" "INHL")) ('()))
              fr (if (and (cdr (assoc "key" old)) (/= (cdr (assoc "key" old)) ""))
                   (sd:in-order (sd:in-frames (cond ((cdr (assoc "mode" old))) ("Block")) (cdr (assoc "key" old)) nil)
                                (cond ((cdr (assoc "order" old))) ("Hang")))))
        (if (null fr) (princ "\n[SD] Chua co khung ten: chay SDIN hoac SDTAOLAYOUT mot lan de khai bao block / layer khung."))
        (if (= (getvar "TILEMODE") 0) (setvar "TILEMODE" 1))
        (setq lay (vla-get-ActiveLayout doc))
        (if dev (progn (vla-put-ConfigName lay dev) (setq media (sd:in-media lay))))
        (foreach f fr
          (setq docno (sd:cde-docno cfg i) i (1+ i)
                fn (strcat dir "\\" docno "_" (strcase (sd:v "rev")) "_" st ".pdf")
                title (strcat "Khung " (itoa i)))
          (sd:cde-attrs (nth 3 f) cfg docno)
          (setq m (if dev (sd:in-autopaper f (mapcar '(lambda (x) (list (car x) (caddr x) (cadddr x))) media) (sd:sc)))
                r (if m (sd:in-one doc lay f m (list dev "monochrome.ctb" "Fit" (sd:sc) t) fn)))
          (if (and dev (/= r t)) (princ (strcat "\n[SD] Loi in " title ": " (if (= (type r) 'STR) r "khong co kho giay"))))
          (setq files (cons (list docno title fn (= r t)) files)))))
     (setq files (reverse files))
     ;; ban DWG kem theo (luu truoc)
     (if (and (sd:v "dwg") files)
       (progn
         (vl-catch-all-apply 'vla-Save (list doc))
         (setq fn (strcat dir "\\" (car (car files)) "_" (strcase (sd:v "rev")) "_" st ".dwg"))
         (if (sd:fcopy (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")) fn)
           (setq files (append files (list (list (car (car files)) (strcat "DWG " (getvar "DWGNAME")) fn t))))
           (princ "\n[SD] Khong chep duoc file DWG (luu ban ve truoc)."))))
     ;; luu tru ban cu
     (setq nar 0)
     (if (sd:v "arch")
       (foreach x files
         (if (cadddr x) (setq nar (+ nar (sd:cde-archive root (car x) (strcat (car x) "_" (strcase (sd:v "rev")) "_" st)))))))
     ;; so dang ky + phieu chuyen giao
     (foreach x files
       (if (cadddr x)
         (setq n (1+ n)
               rows (cons (sd:join (list (sd:today) (car x) (sd:cde-q (cadr x)) (strcase (sd:v "rev")) st (sd:cde-state st)
                                         (sd:cde-q (vl-filename-base (caddr x))) (sd:cde-q who) (sd:cde-q (getvar "DWGNAME")))
                                   ",")
                          rows))))
     (setq rows (reverse rows)
           r "Ngay,So hieu tai lieu,Ten to,Phien ban,Trang thai,Thu muc,File,Nguoi phat hanh,Ban ve nguon")
     (if rows
       (progn
         (sd:cde-csv (strcat root "\\CDE_Register.csv") r rows)
         (setq tr (strcat root "\\Transmittal_" stamp ".csv"))
         (sd:cde-csv tr (strcat "PHIEU CHUYEN GIAO " stamp " - trang thai " (cdr (assoc st *SD:CDEST*)) "\n" r) rows)
         (vlax-ldata-put "SD" "CDE"
                         (append cfg (list (cons "hist" (sd:cde-trim 200 (append (reverse (mapcar '(lambda (x) (list (sd:today) (car x) (strcase (sd:v "rev")) st))
                                                                                                (vl-remove-if-not 'cadddr files)))
                                                                               (cdr (assoc "hist" (vlax-ldata-get "SD" "CDE")))))))))))
     (setvar "BACKGROUNDPLOT" bp)
     (princ (strcat "\n[SD] Phat hanh " (itoa n) " file vao " dir
                    (if (> nar 0) (strcat "; chuyen " (itoa nar) " ban cu sang 04_ARCHIVED") "")
                    (if rows (strcat "; so dang ky CDE_Register.csv, phieu " (vl-filename-base tr) ".csv") "")
                    ". Tang phien ban (P02, C02...) cho lan phat hanh sau."))))
  (sd:finish))

