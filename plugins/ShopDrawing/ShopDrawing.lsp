;;; --------------------------------------------------------------------------
;;;  SDLENH - Ra lenh bang cau tieng Viet cho cac o da: "gop o 25+36" (gop 2 hay nhieu o thanh 1), "xoa o 12 13"
;;;  Lenh doc cau, noi lai y hieu, hoi xac nhan roi moi lam; so o la so hieu T.. ghi tren ban ve (SD-CHU). Hoan lai bang UNDO.
;;; --------------------------------------------------------------------------
;; tach cau thanh cac tu (chu thuong ASCII, so); moi ky tu khac ASCII (dau tieng Viet) thanh "~" trong tu, sd:ai-bare bo "~" khi so khop (gop hoac gp)
(defun sd:ai-bare (w / i c r)
  (setq i 1 r "")
  (while (<= i (strlen w)) (setq c (substr w i 1) i (1+ i)) (if (/= c "~") (setq r (strcat r c))))
  r)

(defun sd:ai-tokens (s / i c w r)
  (setq i 1 w "" s (strcase s t))
  (while (<= i (strlen s))
    (setq c (substr s i 1) i (1+ i))
    (cond
      ((>= (ascii c) 128) (setq w (strcat w "~")))
      ((wcmatch c "[a-z0-9]") (setq w (strcat w c)))
      (t (if (/= w "") (setq r (cons w r))) (setq w ""))))
  (if (/= w "") (setq r (cons w r)))
  (reverse r))

;; (y-dinh so-o...): y-dinh = GOP / XOA / nil
(defun sd:ai-parse (s / tk nums act ang prev b)
  (setq tk (sd:ai-tokens s))
  (foreach w tk
    (setq b (sd:ai-bare w))
    (cond ((wcmatch w "[0-9]*")
           (if (vl-every '(lambda (ch) (< 47 ch 58)) (vl-string->list w)) (setq nums (cons (atoi w) nums))))
          ;; "90 do" hoac "90" kem do co dau (chu co dau chi con "~~")
          ((and prev (wcmatch prev "[0-9]*") nums (= (car nums) (atoi prev)) (or (= b "do") (and (= b "") (> (strlen w) 0))))
           (setq ang (car nums) nums (cdr nums)))
          ((member b '("xoay" "quay" "rotate")) (setq act 'XOAY))
          ((member b '("gop" "gp" "ghep" "ghp" "noi" "merge" "join")) (setq act (cond (act) ('GOP))))
          ((member b '("xoa" "xa" "bo" "go" "del" "delete")) (setq act (cond (act) ('XOA)))))
    (setq prev w))
  (list act (reverse nums) ang))

;; xoay van 1 o: xoay anh cua o quanh tam o goc ang (do), cat lai; tra ve nil neu xong, chuoi bao loi
(defun sd:ai-turn (rec ims ang / pts im o c ron xd a)
  (setq pts (sd:curve-pts (caddr rec)) im (if ims (sd:im-find pts ims)) ron (cond (*SD:IRON*) (0.0)) a (* pi (/ ang 180.0)))
  (cond
    ((null im) "khong thay anh cua o (o khong co anh cat, hoac anh cu khong co du lieu SD_ANH)")
    ((null (sd:im-delta im)) "anh dung chung cho nhieu o (luoi chung) nen khong xoay rieng duoc")
    (t
     (setq o (vlax-ename->vla-object im)
           c (list (/ (apply '+ (mapcar 'car pts)) (float (length pts))) (/ (apply '+ (mapcar 'cadr pts)) (float (length pts))) 0.0))
     (vla-Rotate o (vlax-3d-point c) a)
     (if (sd:im-fit (sd:im-geom im) (sd:inset-pts pts (/ ron 2.0)) 10.0)
       (progn
         (setq xd (mapcar 'cdr (cdadr (assoc -3 (entget im '("SD_ANH"))))))
         (vl-catch-all-apply 'sd:put-xd
           (list im (list -3 (list "SD_ANH" (cons 1040 (car xd)) (cons 1040 (cadr xd))
                                   (cons 1040 (rem (+ (nth 2 xd) a) (* 2.0 pi)))))))
         (sd:im-reclip im (sd:inset-pts pts (/ ron 2.0)) 10.0 nil)
         nil)
       (progn (vla-Rotate o (vlax-3d-point c) (- a))
              "xoay xong thi het kho (tam da khong du theo huong do), da tra ve nhu cu")))))

;; chi muc cac o: ((so text polyline) ...) - so hieu T<n> nam trong polyline vien nao thi thuoc o do
(defun sd:ai-index (/ txs pls i e str n c k pl r)
  (setq txs (ssget "_X" '((0 . "TEXT") (8 . "SD-CHU") (1 . "T#*")))
        pls (ssget "_X" '((0 . "LWPOLYLINE") (8 . "SD-GACH,SD-GACH-CAT,SD-GACH-VIEN,SD-GACH-DOC") (-4 . "&") (70 . 1))))
  (if (and txs pls)
    (progn
      (setq i 0)
      (repeat (sslength txs)
        (setq e (ssname txs i) i (1+ i) str (cdr (assoc 1 (entget e))) n (atoi (substr str 2))
              c (cdr (assoc 10 (entget e))) k 0 pl nil)
        (while (and (null pl) (< k (sslength pls)))
          (if (sd:inpoly (list (car c) (cadr c)) (sd:curve-pts (ssname pls k))) (setq pl (ssname pls k)))
          (setq k (1+ k)))
        (if pl (setq r (cons (list n e pl) r))))))
  r)

;; xoa polyline + anh + hatch + so hieu cua mot o; tra ve so doi tuong da xoa
(defun sd:ai-del-tile (rec ims hs / pts k h n x)
  (setq pts (sd:curve-pts (caddr rec)) n 0)
  (foreach x (list (caddr rec) (cadr rec) (if ims (sd:im-find pts ims)))
    (if (and x (entget x)) (progn (entdel x) (setq n (1+ n)))))
  (if hs
    (progn (setq k 0)
           (repeat (sslength hs)
             (setq h (ssname hs k) k (1+ k))
             (if (and (entget h) (sd:inpoly (sd:hatch-center h) pts)) (progn (entdel h) (setq n (1+ n)))))))
  n)

;; thay dinh cua LWPOLYLINE e bang pts (dung nguyen xdata va thuoc tinh khac)
(defun sd:ai-setpts (e pts / ed pre post)
  (setq ed (vl-remove-if '(lambda (g) (member (car g) '(10 40 41 42))) (entget e '("SD_TILE")))
        ed (subst (cons 90 (length pts)) (assoc 90 ed) ed))
  (foreach g ed
    (if (and (null post) (member (car g) '(210 -3))) (setq post (list g)) (if post (setq post (cons g post)) (setq pre (cons g pre)))))
  (entmod (append (reverse pre) (mapcar '(lambda (q) (list 10 (car q) (cadr q))) pts) (reverse post))))

;; gop o b vao o a: bao loi (chuoi) neu khong gop duoc, nil neu xong. a giu so hieu, b bi xoa
(defun sd:ai-merge (ra rb ims hs / pa pb ha a1 a2 ah ia ib im fr xd c ron)
  (setq pa (sd:curve-pts (caddr ra)) pb (sd:curve-pts (caddr rb))
        ha (sd:hull (append pa pb)) a1 (abs (sd:area pa)) a2 (abs (sd:area pb)) ah (abs (sd:area ha))
        ron (cond (*SD:IRON*) (0.0)))
  (cond
    ((> (- ah a1 a2) (* 0.05 (+ a1 a2)))
     "hai o khong tao thanh mot hinh loi (xa nhau hoac lech): chi gop duoc cac o ke nhau tao thanh hinh loi, VD hai o cung ben rong")
    (t
     (setq ia (if ims (sd:im-find pa ims)) ib (if ims (sd:im-find pb ims)))
     (setq im (cond ((and ia (sd:im-fit (sd:im-geom ia) (sd:inset-pts ha (/ ron 2.0)) 10.0)) ia)
                    ((and ib (sd:im-fit (sd:im-geom ib) (sd:inset-pts ha (/ ron 2.0)) 10.0)) ib)))
     (if (and (or ia ib) (null im))
       "o gop lon hon ca tam da (het kho): khong gop duoc, hoac chon xoay van roi chay lai"
       (progn
         (setq xd (mapcar 'cdr (cdadr (assoc -3 (entget (caddr ra) '("SD_TILE"))))))
         (sd:ai-setpts (caddr ra) ha)
         (setq fr (sd:tile-frame ha))
         (if (>= (length xd) 13)
           (sd:put-xd (caddr ra)
             (sd:tile-xd (nth 0 xd) "D" "GOP" (cadr fr) (caddr fr) (/ ah 1e6) 0 (nth 7 xd) (cadr fr) (caddr fr) (nth 10 xd) (nth 11 xd) "G")))
         ;; xoa o b va cac phan cua no; anh khong dung thi xoa luon
         (foreach x (list (caddr rb) (cadr rb) (if (and ia ib) (if (eq im ia) ib ia)))
           (if (and x (entget x)) (entdel x)))
         ;; hatch cua ca hai o bo di (van da hatch phai tao lai bang SDVANDA)
         (if hs
           (progn (setq c 0)
                  (repeat (sslength hs)
                    (if (and (entget (ssname hs c))
                             (or (sd:inpoly (sd:hatch-center (ssname hs c)) ha)))
                      (entdel (ssname hs c)))
                    (setq c (1+ c)))))
         (if im (sd:im-reclip im (sd:inset-pts ha (/ ron 2.0)) 10.0 nil))
         nil)))))

;; lich su cau lenh (toi da 8, moi nhat truoc) va cau truoc (thao tac, goc, so o) luu trong ban ve
(defun sd:ai-his () (sd:cfg "LENH-HIS" nil))
(defun sd:ai-his-add (s) (sd:cfg-put "LENH-HIS" (sd:take (cons s (vl-remove s (sd:ai-his))) 8)))

(defun sd:ai-help (/ h k)
  (princ "\nCau mau: gop o 25+36 | ghep 5 6 7 | xoa o 12 13 | xoay van 90 do o 25 36 | (chon cac o truoc) xoay van 90 do")
  (princ "\nLenh nhanh: ? = tro giup | lai = lam lai cau truoc | lai o 40 41 = cung viec cho o khac | #n = chay lai cau thu n trong lich su | Enter = lai cau truoc")
  (if (setq h (sd:ai-his))
    (progn (princ "\nLich su (moi nhat truoc):") (setq k 0)
           (foreach x h (setq k (1+ k)) (princ (strcat "\n  #" (itoa k) "  " x))))))

;; doc cau lenh: ? hien tro giup roi hoi lai; #n lay cau thu n trong lich su; Enter lay cau truoc
(defun sd:ai-ask (/ s r n his)
  (setq his (sd:ai-his))
  (while (null r)
    (setq s (getstring T "\nGo lenh bang tieng Viet (VD: gop o 25+36; ? = tro giup, Enter = lai cau truoc): "))
    (cond
      ((or (null s) (= s ""))
       (if his (progn (princ (strcat "\n[SD] Dung lai cau truoc: " (car his))) (setq r (car his))) (setq r "")))
      ((member (strcase s t) '("?" "help" "tro giup")) (sd:ai-help))
      ((and (= (substr s 1 1) "#") (> (atoi (substr s 2)) 0))
       (setq n (atoi (substr s 2)))
       (if (nth (1- n) his) (setq r (nth (1- n) his)) (princ "\n[SD] Khong co cau thu do trong lich su.")))
      (t (setq r s))))
  r)

;; xac nhan: hop thoai co tom tat, khong hop thoai thi hoi tren dong lenh
(defun sd:ai-confirm (msg)
  (if (sd:dlg-on)
    (sd:dlg "Xac nhan lenh (SDLENH)" (list (list "tt" msg 'note nil)))
    (progn (initget "Co Khong") (/= "Khong" (getkword "\nThuc hien? [Co/Khong] <Co>: ")))))

(defun c:SDLENH (/ s r act nums ang idx hs ims recs miss ok yn first n err done ss k tk lst msg redo)
  (sd:begin)
  (setq s (sd:ai-ask))
  (setq r (sd:ai-parse (cond (s) (""))) act (car r) nums (cadr r) ang (caddr r)
        tk (sd:ai-tokens (cond (s) (""))))
  ;; "lai" / "lai o 40 41": lam lai viec cua cau truoc (cung thao tac va goc), so o moi neu co
  (if (and (null act) tk (member (sd:ai-bare (car tk)) '("lai" "lap" "again")) (setq lst (sd:cfg "LENH-LAST" nil)))
    (setq act (cdr (assoc (car lst) '(("GOP" . GOP) ("XOA" . XOA) ("XOAY" . XOAY))))
          ang (cond (ang) ((cadr lst))) nums (cond (nums) ((caddr lst))) redo t))
  (cond
    ((null act)
     (princ "\n[SD] Chua hieu cau lenh. Hien biet: GOP (gop / ghep / noi) va XOA (xoa / bo / go), kem so o. VD: gop o 25+36, ghep 5 6 7, xoa o 12 13."))
    ((and (/= act 'XOAY) (null nums)) (princ "\n[SD] Can kem so o. VD: gop o 25+36, xoa o 12 13."))
    ((and (= act 'GOP) (< (length nums) 2)) (princ "\n[SD] Gop can it nhat hai o. VD: gop o 25+36."))
    (t
     (setq idx (sd:ai-index))
     ;; xoay van ma khong neu so o: dung cac o dang chon (pickfirst) hoac hoi chon
     (if (and (= act 'XOAY) (null nums))
       (progn
         (setq ss (cond ((ssget "_I" '((0 . "LWPOLYLINE")))) ((progn (princ "\nChon cac o (polyline vien) can xoay van: ") (ssget '((0 . "LWPOLYLINE")))))) k 0)
         (if ss (repeat (sslength ss) (setq recs (append recs (list (list nil nil (ssname ss k)))) k (1+ k))))))
     (foreach k nums
       (if (assoc k idx) (setq recs (append recs (list (assoc k idx)))) (setq miss (cons k miss))))
     (cond
       (miss (princ (strcat "\n[SD] Khong tim thay o so " (sd:join (mapcar 'itoa (reverse miss)) ", ") " (so hieu T.. tren layer SD-CHU nam trong polyline vien).")))
       (t
        (setq msg (strcat "Hieu: " (cond ((= act 'GOP) "GOP cac o ") ((= act 'XOA) "XOA cac o ")
                                         (t (strcat "XOAY VAN " (itoa (cond (ang) (90))) " do cho " (itoa (length recs)) " o: ")))
                          (if nums (sd:join (mapcar 'itoa nums) ", ") "dang chon")
                          (if (= act 'GOP) (strcat " thanh 1 (giu so hieu T" (itoa (car nums)) ")") "")))
        (princ (strcat "\n[SD] " msg))
        (setq yn (if (sd:ai-confirm msg) "Co" "Khong"))
        (if (and (/= yn "Khong") recs)
          (progn
            (sd:cfg-put "LENH-LAST" (list (cond ((= act 'GOP) "GOP") ((= act 'XOA) "XOA") (t "XOAY")) ang nums))
            (if (and s (not redo) (/= s "")) (sd:ai-his-add s))
            (setq hs (ssget "_X" '((0 . "HATCH") (8 . "SD-GACH-VAN")))
                  ims (ssget "_X" '((0 . "IMAGE") (-3 ("SD_ANH")))) first (car recs))
            (cond
              ((= act 'XOAY)
               (setq n 0)
               (foreach rc recs
                 (if (setq err (sd:ai-turn rc ims (cond (ang) (90))))
                   (princ (strcat "\n[SD] O " (if (car rc) (itoa (car rc)) "dang chon") ": " err))
                   (setq n (1+ n))))
               (princ (strcat "\n[SD] Da xoay van " (itoa n) " / " (itoa (length recs)) " o. Hoan lai bang UNDO.")))
              ((= act 'GOP)
              (progn
                (foreach rb (cdr recs)
                  (if (null err)
                    (if (setq err (sd:ai-merge first rb ims hs))
                      (princ (strcat "\n[SD] Khong gop duoc o " (itoa (car rb)) ": " err))
                      (setq done (1+ (cond (done) (0)))))))
                (princ (strcat "\n[SD] Da gop " (itoa (cond (done) (0))) " o vao o " (itoa (car first)) ". Hatch van (neu co) da bo: chay SDVANDA de tao lai. Hoan lai bang UNDO."))))
              (t
                (setq n 0)
                (foreach rc recs (setq n (+ n (sd:ai-del-tile rc ims hs))))
                (princ (strcat "\n[SD] Da xoa " (itoa (length recs)) " o (" (itoa n) " doi tuong). Hoan lai bang UNDO."))))))))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDBLOCKDA - Block chi tiet da: (Mau) tao block mat cat mui bac 3 bac tu mau co san (Thang / V45 / Roi / CNC, tuy chon hoc LED),
;;;  (Quet) quet hinh bat ky de tao block, (Chen) chen file block .dwg da luu. Tuy chon luu ra .dwg de dung cho ban ve khac
;;;  va mo Block Editor de them thong so dong (Linear + Stretch). Block khong chua polyline vien / anh cat cua SDGACH, SDANHDA...
;;;  (cac lenh quet SDDOCDA, SDANHDA, SDTUDONG, SDRON, SDXOAVIEN khong thay doi tuong nam trong block).
;;; --------------------------------------------------------------------------
(defun sd:bm-since (e0 / e ss)
  (setq e (if e0 (entnext e0) (entnext)))
  (while e (setq ss (cond (ss) ((ssadd))) ss (ssadd e ss) e (entnext e)))
  ss)

(defun sd:bm-name (kieu gd R tm tc nho hoc)
  (strcat "SDCT_" kieu "_" (sd:num gd) "x" (sd:num R) "_t" (sd:num tm) "c" (sd:num tc) "n" (sd:num nho) (if hoc "_LED" "")))

(defun sd:bm-stamp () (substr (vl-string-translate "." "" (rtos (getvar "CDATE") 2 6)) 5))

;; tao block tu ss, goc base; neu ten da co thi hoi ghi de (chi khi hoi = t)
(defun sd:bm-define (name base ss ask / yn)
  (cond
    ((null (tblsearch "BLOCK" name)) (command "_.-BLOCK" name base ss "") t)
    ((and ask (progn (initget "Co Khong")
                     (setq yn (getkword (strcat "\nBlock " name " da co. Ghi de dinh nghia (cac block da chen se doi theo)? [Co/Khong] <Khong>: ")))
                     (= yn "Co")))
     (command "_.-BLOCK" name base ss "_Y" "") t)
    (t nil)))

(defun sd:bm-save (name / f)
  (if (setq f (getfiled "Luu block ra file .dwg (dung cho ban ve khac)" name "dwg" 1))
    (progn
      (if (findfile f) (command "_.-WBLOCK" f "_Y" name) (command "_.-WBLOCK" f name))
      (princ (strcat "\n[SD] Da luu " f)))))

;; Ten cac layer hien co trong ban ve
(defun sd:bm-layers (/ r d)
  (setq d (tblnext "LAYER" T))
  (while d (setq r (cons (cdr (assoc 2 d)) r) d (tblnext "LAYER")))
  r)

;; Don layer cua block vua chen tu file ngoai: dua moi doi tuong trong dinh nghia block (tru layer 0 / DEFPOINTS) ve 1 layer lay,
;; roi xoa cac layer moi do file mang vao (old = danh sach layer truoc khi chen). Tra ve (so-doi-tuong so-layer-xoa)
(defun sd:bm-clean (bn lay old / e ed n nd nm)
  (sd:make-layer lay 7 "Continuous" 18)
  (setq e (cdr (assoc -2 (tblsearch "BLOCK" bn))) n 0 nd 0)
  (while e
    (setq ed (entget e))
    (if (and (assoc 8 ed) (not (member (strcase (cdr (assoc 8 ed))) (list "0" "DEFPOINTS" (strcase lay)))))
      (progn (entmod (subst (cons 8 lay) (assoc 8 ed) ed)) (setq n (1+ n))))
    (setq e (entnext e)))
  (foreach nm (sd:bm-layers)
    (if (and (not (member nm old)) (/= (strcase nm) (strcase lay)))
      (if (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-Delete (list (vla-Item (vla-get-Layers (sd:doc)) nm)))))
        (setq nd (1+ nd)))))
  (list n nd))

;; Mat cat chi tiet op kho (da treo tren khung thep): tuong ben trai, 2 tam da chong len nhau co khe joint, bat treo inox + moc treo inox o cao do khe,
;; thep L, bulong no. Ve 1:1 (mm) tai goc (0,0); tam duoi y 0..hh. t day da, g khe lung da - tuong, j khe joint, c vat canh (0 = thang),
;; la canh thep L, lt day thep L, bd duong kinh bulong, bl chieu dai bulong. So lieu mac dinh chi la mau minh hoa: kiem tra voi phu kien thuc te.
(defun sd:bm-opkho (dd g j c la lt bd bl hh / x1 yj yb yc xc th lbl)
  (sd:make-layer "SD-GACH" 7 "Continuous" 25) (sd:make-layer "SD-GACH-CAT" 4 "Continuous" 25) (sd:make-layer "SD-KHUAT" 8 "Continuous" 13)
  (sd:make-layer "SD-CHU" 7 "Continuous" 18)
  (setq x1 (+ g dd) yj (+ hh (/ j 2.0)) yb (- yj lt (/ la 2.0)) yc (+ yb (/ la 2.0)) xc (+ g (/ dd 2.0)) th 8.0)
  ;; tuong
  (sd:pline (list (list -150.0 -80.0) (list 0.0 -80.0) (list 0.0 (+ (* 2.0 hh) j 80.0)) (list -150.0 (+ (* 2.0 hh) j 80.0))) t "SD-KHUAT")
  ;; tam da duoi va tren (vat canh phia khe joint neu c > 0)
  (sd:pline (if (> c 0.0)
              (list (list g 0.0) (list x1 0.0) (list x1 (- hh c)) (list (- x1 c) hh) (list g hh))
              (list (list g 0.0) (list x1 0.0) (list x1 hh) (list g hh)))
            t "SD-GACH")
  (sd:pline (if (> c 0.0)
              (list (list g (+ hh j)) (list (- x1 c) (+ hh j)) (list x1 (+ hh j c)) (list x1 (+ (* 2.0 hh) j)) (list g (+ (* 2.0 hh) j)))
              (list (list g (+ hh j)) (list x1 (+ hh j)) (list x1 (+ (* 2.0 hh) j)) (list g (+ (* 2.0 hh) j))))
            t "SD-GACH")
  ;; thep L: canh dung sat tuong, canh ngang nam duoi bat treo
  (sd:pline (list (list 0.0 yb) (list la yb) (list la (+ yb lt)) (list lt (+ yb lt)) (list lt (+ yb la)) (list 0.0 (+ yb la))) t "SD-GACH-CAT")
  ;; bulong no xuyen canh dung (dau bulong ben ngoai)
  (sd:pline (list (list (- bl) (- yc (/ bd 2.0))) (list lt (- yc (/ bd 2.0))) (list lt (+ yc (/ bd 2.0))) (list (- bl) (+ yc (/ bd 2.0)))) t "SD-GACH-CAT")
  (sd:pline (list (list lt (- yc (* 0.9 bd))) (list (+ lt 5.0) (- yc (* 0.9 bd))) (list (+ lt 5.0) (+ yc (* 0.9 bd))) (list lt (+ yc (* 0.9 bd)))) t "SD-GACH-CAT")
  ;; bat treo inox: ban dua nam tren canh ngang thep L, voi toi giua day da
  (sd:pline (list (list (/ la 2.0) (+ yb lt)) (list (+ xc 10.0) (+ yb lt)) (list (+ xc 10.0) (+ yb lt 3.0)) (list (/ la 2.0) (+ yb lt 3.0))) t "SD-GACH-CAT")
  ;; moc treo inox: chot dung xuyen ban dua, cam vao canh tam duoi va tam tren
  (sd:pline (list (list (- xc 2.0) (- hh 15.0)) (list (+ xc 2.0) (- hh 15.0)) (list (+ xc 2.0) (+ hh j 15.0)) (list (- xc 2.0) (+ hh j 15.0))) t "SD-GACH-CAT")
  ;; chu thich
  (setq lbl (+ x1 80.0))
  (sd:line (list xc (/ hh 2.0)) (list lbl (/ hh 2.0)) "SD-CHU")
  (sd:text (list (+ lbl 5.0) (/ hh 2.0)) (strcat "\\U+0110\\U+00C1 GRANIT D\\U+00C0Y " (sd:num dd)) th "ML" "SD-CHU")
  (sd:line (list x1 yj) (list lbl yj) "SD-CHU")
  (sd:text (list (+ lbl 5.0) yj) (strcat "KHE JOINT " (sd:num j) (if (> c 0.0) (strcat ", V\\U+00C1T C\\U+1EA0NH " (sd:num c) " x 45\\U+00B0") ", TH\\U+1EB2NG")) th "ML" "SD-CHU")
  (sd:line (list xc (+ hh j 15.0)) (list lbl (+ hh j 45.0)) "SD-CHU")
  (sd:text (list (+ lbl 5.0) (+ hh j 45.0)) "M\\U+00D3C TREO INOX" th "ML" "SD-CHU")
  (setq lbl (- (- bl) 40.0))
  (sd:line (list (- (/ bl 2.0)) yc) (list lbl yc) "SD-CHU")
  (sd:text (list (- lbl 5.0) yc) (strcat "BUL\\U+00D4NG N\\U+1EDE INOX M" (sd:num bd) "x" (sd:num bl)) th "MR" "SD-CHU")
  (sd:line (list (/ la 2.0) (+ yb lt 1.5)) (list lbl (+ yb lt 40.0)) "SD-CHU")
  (sd:text (list (- lbl 5.0) (+ yb lt 40.0)) "B\\U+00C1T TREO INOX" th "MR" "SD-CHU")
  (sd:line (list (/ lt 2.0) (+ yb la)) (list lbl (- yb 40.0)) "SD-CHU")
  (sd:text (list (- lbl 5.0) (- yb 40.0)) (strcat "TH\\U+00C9P L" (sd:num la) "x" (sd:num la) "x" (sd:num lt)) th "MR" "SD-CHU")
  (sd:text (list (- lbl 5.0) (/ hh 2.0)) "T\\U+01AF\\U+1EDCNG / K\\U+1EBET C\\U+1EA4U" th "MR" "SD-CHU")
  t)

(defun c:SDBLOCKDA (/ mode kieu gd R tm tc nho hoc name e0 ss base pt keep wb dyn ok f ents n don laych bn nuevo old ot og oj oc ol olt obd obl ohh)
  (sd:begin)
  (if (sd:dlg "Block chi tiet da (SDBLOCKDA)"
              (list (list "mode" "Viec can lam" 'kw (sd:cfg "BLK-MODE" "Mau")
                          '(("Mau" . "Tao block mat cat mui bac tu mau co san")
                            ("Quet" . "Quet hinh bat ky de tao block")
                            ("Chen" . "Chen file block .dwg da luu")
                            ("Opkho" . "Chi tiet op kho: da treo tren khung thep, joint vat canh")))
                    (list "kieu" "Kieu mui bac" 'kw (sd:cfg "BLK-KIEU" "Thang")
                          '(("Thang" . "Thang (mat chong len co, mui nho ra)") ("V45" . "Ghep vat 45 do") ("Roi" . "Dai mui roi") ("CNC" . "Mui bo / vat CNC"))
                          '("mode" "Mau"))
                    (list "gd" "Mat bac rong (mm)" 'real (sd:cfg "BLK-GD" 300.0) nil '("mode" "Mau"))
                    (list "R" "Cao bac (mm)" 'real (sd:cfg "BLK-R" 150.0) nil '("mode" "Mau"))
                    (list "tm" "Day mat bac (mm)" 'real (sd:cfg "BLK-TM" 20.0) nil '("mode" "Mau"))
                    (list "tc" "Day co bac (mm)" 'real (sd:cfg "BLK-TC" 20.0) nil '("mode" "Mau"))
                    (list "nho" "Mui nho ra (mm)" 'real0 (sd:cfg "BLK-NHO" 20.0) nil '("mode" "Mau"))
                    (list "hoc" "Co hoc LED duoi mep truoc mat bac (17 x 20, cach mep 20)" 'tog nil nil '("mode" "Mau"))
                    (list "ot" "Day da (mm)" 'real (sd:cfg "OK-T" 20.0) nil '("mode" "Opkho"))
                    (list "og" "Khe tu lung da den tuong (mm)" 'real (sd:cfg "OK-G" 40.0) nil '("mode" "Opkho"))
                    (list "oj" "Khe joint giua hai tam (mm)" 'real (sd:cfg "OK-J" 8.0) nil '("mode" "Opkho"))
                    (list "oc" "Vat canh phia mat khe joint (mm, 0 = joint thang)" 'real0 (sd:cfg "OK-C" 3.0) nil '("mode" "Opkho"))
                    (list "ol" "Thep L: canh (mm)" 'real (sd:cfg "OK-L" 30.0) nil '("mode" "Opkho"))
                    (list "olt" "Thep L: day (mm)" 'real (sd:cfg "OK-LT" 3.0) nil '("mode" "Opkho"))
                    (list "obd" "Bulong no: duong kinh (mm)" 'real (sd:cfg "OK-BD" 8.0) nil '("mode" "Opkho"))
                    (list "obl" "Bulong no: chieu dai (mm)" 'real (sd:cfg "OK-BL" 100.0) nil '("mode" "Opkho"))
                    (list "ohh" "Chieu cao moi tam ve (mm)" 'real (sd:cfg "OK-H" 600.0) nil '("mode" "Opkho"))
                    (list "keep" "Giu hinh tren ban ve (chen lai thanh block)" 'tog t nil '("mode" "Quet"))
                    (list "wb" "Luu ra file .dwg de dung cho ban ve khac" 'tog nil nil '("mode" "Mau" "Quet" "Opkho"))
                    (list "dyn" "Mo Block Editor de them thong so dong (Linear + Stretch)" 'tog nil nil '("mode" "Mau" "Quet" "Opkho"))
                    (list "don" "Layer cua block tai tu ngoai" 'kw (sd:cfg "BLK-DON" "Gop")
                          '(("Gop" . "Don: dua moi doi tuong ve 1 layer, xoa layer la file mang vao") ("Giu" . "Giu nguyen layer cua file"))
                          '("mode" "Chen"))
                    (list "laych" "Ten layer chung cho block chen" 'str (sd:cfg "BLK-LAY" "SD-CHITIET") nil '("mode" "Chen"))))
    (progn
      (setq mode (sd:cfg-put "BLK-MODE" (sd:v "mode")))
      (cond
        ;; ---- mau mui bac
        ((= mode "Mau")
         (setq kieu (sd:cfg-put "BLK-KIEU" (sd:v "kieu")) gd (sd:cfg-put "BLK-GD" (sd:v "gd")) R (sd:cfg-put "BLK-R" (sd:v "R"))
               tm (sd:cfg-put "BLK-TM" (sd:v "tm")) tc (sd:cfg-put "BLK-TC" (sd:v "tc")) nho (sd:cfg-put "BLK-NHO" (cond ((sd:v "nho")) (0.0)))
               hoc (sd:v "hoc") wb (sd:v "wb") dyn (sd:v "dyn")
               name (sd:bm-name kieu gd R tm tc nho hoc))
         (if (tblsearch "BLOCK" name)
           (princ (strcat "\n[SD] Block " name " da co: dung lai."))
           (progn
             (sd:make-layer "SD-GACH" 7 "Continuous" 25) (sd:make-layer "SD-GACH-CAT" 4 "Continuous" 25) (sd:make-layer "SD-KHUAT" 8 "Continuous" 13)
             (setq e0 (entlast))
             (sd:st-profile (list 0.0 0.0 0.0) kieu gd R tm tc nho 30.0 0.0 (if hoc "Hoc" "Khong") 17.0 20.0 20.0)
             (if (setq ss (sd:bm-since e0))
               (progn (sd:bm-define name (list 0.0 0.0 0.0) ss nil)
                      (princ (strcat "\n[SD] Da tao block " name " (mat cat 3 bac, goc tai mui bac dau, mat chieu nghi duoi).")))
               (princ "\n[SD] Khong ve duoc mau."))))
         (if (tblsearch "BLOCK" name)
           (progn
             (if (setq pt (sd:getpt "\nDiem chen block <Enter = chi tao khong chen>: " nil))
               (command "_.-INSERT" name (list (car pt) (cadr pt) 0.0) "1" "1" "0"))
             (if wb (sd:bm-save name))
             (if dyn (command "_.BEDIT" name)))))
        ;; ---- chi tiet op kho
        ((= mode "Opkho")
         (setq ot (sd:cfg-put "OK-T" (sd:v "ot")) og (sd:cfg-put "OK-G" (sd:v "og")) oj (sd:cfg-put "OK-J" (sd:v "oj"))
               oc (sd:cfg-put "OK-C" (cond ((sd:v "oc")) (0.0))) ol (sd:cfg-put "OK-L" (sd:v "ol")) olt (sd:cfg-put "OK-LT" (sd:v "olt"))
               obd (sd:cfg-put "OK-BD" (sd:v "obd")) obl (sd:cfg-put "OK-BL" (sd:v "obl")) ohh (sd:cfg-put "OK-H" (sd:v "ohh"))
               wb (sd:v "wb") dyn (sd:v "dyn")
               name (strcat "SDCT_OPKHO_t" (sd:num ot) "g" (sd:num og) "j" (sd:num oj) "c" (sd:num oc) "L" (sd:num ol) "x" (sd:num olt) "M" (sd:num obd) "x" (sd:num obl)))
         (if (tblsearch "BLOCK" name)
           (princ (strcat "\n[SD] Block " name " da co: dung lai."))
           (progn
             (setq e0 (entlast))
             (sd:bm-opkho ot og oj oc ol olt obd obl ohh)
             (if (setq ss (sd:bm-since e0))
               (progn (sd:bm-define name (list 0.0 0.0 0.0) ss nil)
                      (princ (strcat "\n[SD] Da tao block " name " (mat cat 1:1 mm, goc tai mat tuong o duoi tam da duoi). So lieu phu kien la mau minh hoa: doi chieu voi phu kien thuc te truoc khi dung.")))
               (princ "\n[SD] Khong ve duoc chi tiet."))))
         (if (tblsearch "BLOCK" name)
           (progn
             (if (setq pt (sd:getpt "\nDiem chen block <Enter = chi tao khong chen>: " nil))
               (command "_.-INSERT" name (list (car pt) (cadr pt) 0.0) "1" "1" "0"))
             (if wb (sd:bm-save name))
             (if dyn (command "_.BEDIT" name)))))
        ;; ---- quet hinh
        ((= mode "Quet")
         (setq keep (sd:v "keep") wb (sd:v "wb") dyn (sd:v "dyn"))
         (princ "\nQuet chon hinh de tao block (lenh nay khong dung cho cac vien da dung bang SDGACH / SDANHDA: do la nhieu doi tuong lien ket): ")
         (if (setq ss (ssget))
           (if (setq base (getpoint "\nDiem goc (diem chen) cua block: "))
             (progn
               (setq name (getstring T "\nTen block <tu dat>: "))
               (if (or (null name) (= name "")) (setq name (strcat "SDCT_Q" (sd:bm-stamp))))
               (if (sd:bm-define name (list (car base) (cadr base) 0.0) ss t)
                 (progn
                   (if keep (command "_.-INSERT" name (list (car base) (cadr base) 0.0) "1" "1" "0"))
                   (princ (strcat "\n[SD] Da tao block " name "."))
                   (if wb (sd:bm-save name))
                   (if dyn (command "_.BEDIT" name)))
                 (princ "\n[SD] Giu nguyen, khong tao block."))))))
        ;; ---- chen file
        (t
         (setq don (sd:cfg-put "BLK-DON" (sd:v "don")) laych (sd:cfg-put "BLK-LAY" (cond ((sd:v "laych")) ("SD-CHITIET"))))
         (if (setq f (getfiled "Chon file block (.dwg) de chen" "" "dwg" 4))
           (if (setq pt (sd:getpt "\nDiem chen block: " nil))
             (progn
               (setq nuevo (not (tblsearch "BLOCK" (vl-filename-base f))) old (sd:bm-layers))
               (command "_.-INSERT" (vl-string-translate "\\" "/" f) (list (car pt) (cadr pt) 0.0) "1" "1" "0")
               (princ "\n[SD] Da chen block.")
               (if (and nuevo (= don "Gop") (setq e0 (entlast)) (= (cdr (assoc 0 (entget e0))) "INSERT"))
                 (progn
                   (setq bn (cdr (assoc 2 (entget e0))) n (sd:bm-clean bn laych old))
                   (princ (strcat "\n[SD] Don layer: " (itoa (car n)) " doi tuong ve layer " laych ", xoa " (itoa (cadr n)) " layer la.")))))))))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDTUNAP - tu nap ShopDrawing.lsp moi khi mo AutoCAD (khong can APPLOAD lai):
;;;  ghi mot khoi co danh dau vao acaddoc.lsp trong thu muc Support cua nguoi dung; chay lai de go
;;; --------------------------------------------------------------------------
(defun sd:au-file () (strcat (getvar "ROAMABLEROOTPREFIX") "Support\\acaddoc.lsp"))

(defun sd:au-read (f / h l r)
  (if (and (findfile f) (setq h (open f "r")))
    (progn (while (setq l (read-line h)) (setq r (cons l r))) (close h)))
  (reverse r))

;; bo khoi ShopDrawing (giua hai dong danh dau) khoi danh sach dong
(defun sd:au-strip (lines / r in)
  (foreach l lines
    (cond ((wcmatch l ";;; SD-AUTOLOAD-BEGIN*") (setq in t))
          ((wcmatch l ";;; SD-AUTOLOAD-END*") (setq in nil))
          (in)
          (t (setq r (cons l r)))))
  (reverse r))

(defun sd:au-has (lines) (vl-some '(lambda (l) (wcmatch l ";;; SD-AUTOLOAD-BEGIN*")) lines))

(defun sd:au-write (f lines / h)
  (if (setq h (open f "w"))
    (progn (foreach l lines (write-line l h)) (close h) t)))

(defun c:SDTUNAP (/ f lines lsp tp ans)
  (sd:begin)
  (setq f (sd:au-file) lines (sd:au-read f))
  (cond
    ((sd:au-has lines)
     (initget "Giu Go")
     (setq ans (getkword "\nShopDrawing dang tu nap moi khi mo AutoCAD. [Giu/Go] <Giu>: "))
     (if (= ans "Go")
       (if (sd:au-write f (sd:au-strip lines))
         (princ "\n[SD] Da go tu nap. Lan sau mo AutoCAD phai APPLOAD hoac SDMENU.")
         (princ (strcat "\n[SD] Khong ghi duoc " f)))
       (princ "\n[SD] Giu nguyen tu nap.")))
    (t
     (setq lsp (cond ((findfile "ShopDrawing.lsp"))
                     ((getfiled "Chon ShopDrawing.lsp (cho tu nap)" "" "lsp" 4))))
     (if (null lsp)
       (princ "\n[SD] Chua chon file ShopDrawing.lsp.")
       (progn
         (setq lsp (vl-string-translate "\\" "/" lsp))
         (if (sd:au-write f
               (append (sd:au-strip lines)
                       (list ";;; SD-AUTOLOAD-BEGIN - ShopDrawing Tools tu nap (SDTUNAP, go bang SDTUNAP > Go)"
                             (strcat "(if (and (not c:SDHELP) (findfile \"" lsp "\")) (load \"" lsp "\"))")
                             ";;; SD-AUTOLOAD-END")))
           (progn
             ;; thu muc tin cay de AutoCAD khong hoi / chan khi nap
             (setq tp (getvar "TRUSTEDPATHS"))
             (if (and tp (not (vl-string-search (strcase (vl-filename-directory lsp)) (strcase (vl-string-translate "\\" "/" tp)))))
               (vl-catch-all-apply 'setvar (list "TRUSTEDPATHS" (strcat tp ";" (vl-filename-directory lsp)))))
             (princ (strcat "\n[SD] Da bat tu nap: " lsp "\n   Moi lan mo AutoCAD / ban ve moi se tu nap, khong can APPLOAD. Dung doi cho / xoa thu muc ShopDrawing."
                            "\n   Ten thu muc nen la chu khong dau. Go bang SDTUNAP > Go.")))
           (princ (strcat "\n[SD] Khong ghi duoc " f " - chay AutoCAD voi quyen ghi thu muc Support, hoac dung SDMENU.")))))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDMENU / SDMENUXOA - Nap / go menu + toolbar (ShopDrawing.mnu -> .cuix)
;;;  va tab Ribbon (ShopDrawingRibbon.cuix, nhom SHOPDRAWINGRIBBON, sinh boi build_ribbon.py)
;;; --------------------------------------------------------------------------
(defun sd:try (step fn args / r)
  (setq r (vl-catch-all-apply fn args))
  (if (vl-catch-all-error-p r)
    (progn (princ (strcat "\n[SD] Buoc '" step "' loi: " (vl-catch-all-error-message r))) nil)
    (if r r t)))

(defun sd:add-path (dir / fl sp tp)
  (setq fl (vla-get-Files (vla-get-Preferences (vlax-get-acad-object))) sp (vla-get-SupportPath fl))
  (if (not (vl-string-search (strcase dir) (strcase sp)))
    (vla-put-SupportPath fl (strcat sp ";" dir)))
  ;; AutoCAD 2014+: thu muc tin cay de nap LSP/MNL khong bi canh bao
  (if (and (setq tp (vl-catch-all-apply 'getvar '("TRUSTEDPATHS"))) (= (type tp) 'STR)
           (not (vl-string-search (strcase dir) (strcase tp))))
    (vl-catch-all-apply 'setvar (list "TRUSTEDPATHS" (if (= tp "") dir (strcat tp ";" dir))))))

(defun sd:rx-off ()
  (foreach v '(*SD:TM-CR* *SD:TM-LR*)
    (if (and (boundp v) (eval v)) (vl-catch-all-apply 'vlr-remove (list (eval v)))))
  (setq *SD:TM-CR* nil *SD:TM-LR* nil))

;; SDMENU: nap menu / Ribbon bang COM (AcadMenuGroups.Load / Unload): khong qua dong lenh nen duong dan co dau cach,
;; chu co dau van dung (SendCommand tach duong dan tai dau cach). Du phong: SendCommand co dau nhay quanh duong dan.
(defun sd:mg-find (grp / mgs r)
  (setq mgs (vla-get-MenuGroups (vlax-get-acad-object)) r (vl-catch-all-apply 'vla-Item (list mgs grp)))
  (if (vl-catch-all-error-p r) nil r))

(defun sd:mg-load (fn grp / mgs g r)
  (setq mgs (vla-get-MenuGroups (vlax-get-acad-object)))
  (if (setq g (sd:mg-find grp)) (vl-catch-all-apply 'vla-Unload (list g)))
  (setq r (vl-catch-all-apply 'vla-Load (list mgs fn)))
  (if (vl-catch-all-error-p r)
    (progn
      (vla-SendCommand (sd:doc) (strcat "_.CUILOAD\n\"" fn "\"\n"))
      (princ (strcat "\n[SD] Nap '" grp "' bang lenh CUILOAD (COM loi: " (vl-catch-all-error-message r) ")."))
      nil)
    t))

;; Phien ban ghi trong dong dau cua file .mnu ("//  ShopDrawing Tools vX.Y.Z ..."), nil neu khong co (ban cu)
(defun sd:mnu-ver (f / h l r k)
  (if (and f (setq h (open f "r")))
    (progn
      (repeat 8
        (if (and (null r) (setq l (read-line h)) (setq k (vl-string-search "Tools v" l)))
          (setq r (car (sd:split (substr l (+ k 8)) " ")))))
      (close h)))
  r)

;; Moi file ShopDrawing.mnu tren duong dan tim kiem cua AutoCAD (moi thu muc da tung SDMENU / them vao duong dan deu duoc liet ke)
(defun sd:mnu-cands (/ r d)
  (foreach p (append (sd:split (cond ((getenv "ACAD")) ("")) ";") (list (cond ((getvar "DWGPREFIX")) (""))))
    (if (and (/= p "") (setq d (findfile (strcat (vl-string-right-trim "\\" p) "\\ShopDrawing.mnu"))) (not (member d r)))
      (setq r (cons d r))))
  (if (and (setq d (findfile "ShopDrawing.mnu")) (not (member d r))) (setq r (cons d r)))
  (reverse r))

;; Dua pull-down "ShopDrawing" cua nhom menu grp len thanh menu neu chua co (CUILOAD khong luon tu them vao workspace dang dung).
;; Tra ve "them" / "co" / "khong-thay-popup"
(defun sd:menu-bar (grp / mg menus bar pm found)
  (setq mg (sd:mg-find grp))
  (if mg
    (progn
      (setq menus (vla-get-Menus mg) bar (vla-get-MenuBar (vlax-get-acad-object)))
      (vlax-for m menus (if (and (null pm) (wcmatch (strcase (vla-get-Name m)) "*SHOPDRAWING*")) (setq pm m)))
      (if pm
        (progn
          (vlax-for b bar (if (wcmatch (strcase (vla-get-Name b)) "*SHOPDRAWING*") (setq found t)))
          (if found
            "co"
            (progn (vla-InsertInMenuBar pm (vla-get-Count bar)) "them")))
        "khong-thay-popup"))))

(defun c:SDMENU (/ mnu dir rb ok1 ok2 r cands mver f mb)
  (princ (strcat "\n[SD] SDMENU v" *SD:VER*))
  (sd:rx-off)
  (setq r (vl-catch-all-apply
            '(lambda ()
               ;; chon file .mnu dung phien ban dang chay: cac ban cu con nam tren duong dan tim kiem se khong bi nap nham
               (setq cands (sd:mnu-cands))
               (foreach f cands (if (and (null mnu) (= (sd:mnu-ver f) *SD:VER*)) (setq mnu f)))
               (if (null mnu)
                 (progn
                   (if cands
                     (progn
                       (princ (strcat "\n[SD] Khong thay ShopDrawing.mnu phien ban " *SD:VER* " tren duong dan tim kiem. Cac file tim thay:"))
                       (foreach f cands (princ (strcat "\n     " f "  (ban " (cond ((sd:mnu-ver f)) ("cu, khong ghi phien ban")) ")")))
                       (princ "\n     Chon file ShopDrawing.mnu trong thu muc ban vua giai nen (cung thu muc voi ShopDrawing.lsp ban dang nap).")))
                   (setq mnu (getfiled "Chon file ShopDrawing.mnu (thu muc ban moi giai nen)" (cond ((car cands) (vl-filename-directory (car cands))) ((getvar "DWGPREFIX"))) "mnu" 0))))
               (if mnu
                 (progn
                   (setq dir (vl-filename-directory mnu)
                         rb (findfile (strcat dir "\\ShopDrawingRibbon.cuix")))
                   (vl-catch-all-apply 'sd:add-path (list dir))
                   ;; xoa ban .cuix / .mns da chuyen doi tu .mnu cu (de AutoCAD chuyen lai tu .mnu moi)
                   (foreach ext '("cuix" "mns" "mnc" "mnr")
                     (setq f (strcat dir "\\ShopDrawing." ext))
                     (if (findfile f) (vl-catch-all-apply 'vl-file-delete (list f))))
                   (setq mver (sd:mnu-ver mnu))
                   (if (/= mver *SD:VER*)
                     (princ (strcat "\n[!] File menu nap la ban " (cond (mver) ("cu, khong ghi phien ban")) " nhung ShopDrawing.lsp dang chay la ban " *SD:VER*
                                    ": lenh moi co the thieu tren menu. Giai nen ban moi vao thu muc rieng roi chay lai SDMENU.")))
                   (setq ok1 (sd:mg-load mnu "SHOPDRAWING"))
                   (if ok1
                     (progn
                       (setq mb (vl-catch-all-apply 'sd:menu-bar (list "SHOPDRAWING")))
                       (princ (cond ((vl-catch-all-error-p mb)
                                     (strcat "\n[SD] Khong them duoc menu ShopDrawing vao thanh menu (" (vl-catch-all-error-message mb)
                                             "). Them tay: CUI > Workspaces > (workspace dang dung) > Customize Workspace > tich ShopDrawing."))
                                    ((= mb "them") "\n[SD] Da them menu ShopDrawing vao thanh menu.")
                                    ((= mb "co") "\n[SD] Menu ShopDrawing da co tren thanh menu.")
                                    (t "\n[SD] Khong thay pull-down ShopDrawing trong nhom menu da nap.")))))
                   (if rb (setq ok2 (sd:mg-load rb "SHOPDRAWINGRIBBON")))
                   (princ (strcat "\n[SD] " (if ok1 "Da nap menu + toolbar" "Chua nap duoc menu")
                                  (if rb (if ok2 " + Ribbon" ", chua nap duoc Ribbon") ", khong thay file Ribbon") " tu " dir))
                   (if ok2 (princ "\n     Neu khong thay tab Ribbon: nhap phai vung Ribbon -> Show Tabs -> tich ShopDrawing."))))
               nil)
            nil))
  (if (vl-catch-all-error-p r)
    (princ (strcat "\n[SD] Khong nap duoc menu: " (vl-catch-all-error-message r)
                   "\n     Nap tay: CUILOAD -> ShopDrawing.mnu va ShopDrawingRibbon.cuix (thu muc dist).")))
  (vl-catch-all-apply 'sd:tm-init nil)
  (princ))

(defun c:SDMENUXOA (/ yn)
  (initget "Co Khong")
  (setq yn (cond ((getkword "\nGo menu, toolbar va Ribbon ShopDrawing [Co/Khong] <Khong>: ")) ("Khong")))
  (if (= yn "Co") (sd:menu-unload) (princ "\n[SD] Khong go menu."))
  (princ))

(defun sd:menu-unload (/ g)
  (foreach grp '("SHOPDRAWINGRIBBON" "SHOPDRAWING")
    (if (setq g (sd:mg-find grp))
      (progn (vl-catch-all-apply 'vla-Unload (list g))
             (princ (strcat "\n[SD] Da go " grp ".")))
      (princ (strcat "\n[SD] " grp " chua duoc nap.")))))

;;; --------------------------------------------------------------------------
;;;  SDDIMGD (DGD) va SDDIMPOLY (DPK) - tich hop tu DimGiaoDiem_v2.lsp / DimPolyline_v2.lsp (ban goc: ShopDrawing/goc/)
;;;  Ma o duoi giong tools/modules/dgd.lsp + dpk.lsp (goi SDOpLat dung chung).
;;; --------------------------------------------------------------------------
;;; ==========================================================================
;;;  SDDIMGD (lenh tat DGD) - Dim giao diem: ve 1 duong cat, lenh tu dong dim tung doan giua cac giao diem + dim tong
;;;  Tich hop tu DimGiaoDiem v2 theo yeu cau khach hang (UCS xoay van dung, tra lai bien he thong khi loi / Esc).
;;; ==========================================================================
;;; ---- Tuy chon "chu dim canh duong dim" dung chung cho DGD va DPK (luu trong ban ve, mac dinh BAT) ----
;;; BAT: ep DIMATFIT=1 (Text), DIMTIX=0, DIMTMOVE=0 (Beside the dimension line) khi dim, xong tra lai; TAT: giu nguyen kieu dim cua ban.
(defun sd:dimchu-on () (/= (vlax-ldata-get "SD" "DIMCHU") "TAT"))
(defun sd:dimchu-toggle ()
  (vlax-ldata-put "SD" "DIMCHU" (if (sd:dimchu-on) "TAT" "BAT"))
  (princ (strcat "\n[SD] Chu dim canh duong dim (DIMATFIT 1, DIMTIX 0, DIMTMOVE 0): " (if (sd:dimchu-on) "BAT" "TAT"))))
;; Hoi diem, co tu khoa C de doi tuy chon; base = diem co so (nil neu khong co)
(defun sd:dimchu-msg (msg)
  (strcat msg " [Chu dim canh duong dim: " (if (sd:dimchu-on) "BAT" "TAT") " (C) / Kieu dim ShopDrawing: " (if (sd:dimkieu-on) "BAT" "TAT") " (K)]: "))
(defun sd:dimchu-pt (msg0 base / r msg)
  (setq msg (sd:dimchu-msg msg0))
  (initget "Chu Kieu")
  (setq r (if base (getpoint base msg) (getpoint msg)))
  (while (member r '("Chu" "Kieu"))
    (if (= r "Chu") (sd:dimchu-toggle) (sd:dimkieu-toggle))
    (setq msg (sd:dimchu-msg msg0))
    (initget "Chu Kieu")
    (setq r (if base (getpoint base msg) (getpoint msg))))
  r)

;;; Tuy chon "kieu dim ShopDrawing" (mac dinh BAT): dim bang dimstyle SD-1-<ty le> tren layer SD-KICHTHUOC (tick kien truc, chu 2.5, lam tron 0 so le)
;;; giong cac dim khac cua ShopDrawing; TAT: dung kieu dim hien hanh. Chi co tac dung khi co ham sd:use-dimstyle (ShopDrawing / SDOpLat).
(defun sd:dimkieu-on () (/= (vlax-ldata-get "SD" "DIMKIEU") "TAT"))
(defun sd:dimkieu-toggle ()
  (vlax-ldata-put "SD" "DIMKIEU" (if (sd:dimkieu-on) "TAT" "BAT"))
  (princ (strcat "\n[SD] Kieu dim ShopDrawing (dimstyle SD-1-ty le, layer SD-KICHTHUOC): " (if (sd:dimkieu-on) "BAT" "TAT"))))
;; Chuyen sang kieu dim SD; tra ve (dimstyle-cu layer-cu) de tra lai bang sd:dimkieu-end (nil neu khong dung)
(defun sd:dimkieu-begin ( / old)
  (if (and (sd:dimkieu-on) (boundp 'sd:use-dimstyle) (numberp *SD:SCALE*) (> *SD:SCALE* 0))
    (progn
      (if (boundp 'sd:ensure) (sd:ensure))
      (setq old (list (getvar "DIMSTYLE") (getvar "CLAYER")))
      (sd:use-dimstyle *SD:SCALE*)
      (if (tblsearch "LAYER" "SD-KICHTHUOC") (setvar "CLAYER" "SD-KICHTHUOC"))
      old)))
(defun sd:dimkieu-end (old)
  (if old
    (progn
      (if (tblsearch "LAYER" (cadr old)) (setvar "CLAYER" (cadr old)))
      (if (and (tblsearch "DIMSTYLE" (car old)) (/= (strcase (getvar "DIMSTYLE")) (strcase (car old))))
        (command "_.-DIMSTYLE" "_R" (car old))))))


;; Dim doan ngan (chu khong du cho, nhay ra ngoai): thu nho chu 0.6 lan de khong de len doan ke ben (chi khi tuy chon BAT).
;; Goi truoc moi lenh dim, sau do tra DIMTXT ve gia tri cu.
(defun sd:dimchu-small (len / h n)
  (if (sd:dimchu-on)
    (progn
      (setq h (* (getvar "DIMTXT") (if (> (getvar "DIMSCALE") 0) (getvar "DIMSCALE") 1.0))
            n (strlen (rtos len 2 (getvar "DIMDEC"))))
      (if (< len (* (+ n 1) 0.7 h)) (setvar "DIMTXT" (* 0.6 (getvar "DIMTXT")))))))
(defun sd:dimchu-apply ()
  (if (sd:dimchu-on)
    (progn (setvar "DIMATFIT" 1) (setvar "DIMTIX" 0) (setvar "DIMTMOVE" 0))))

(defun c:SDDIMGD ( / *error* old_os old_echo old_fit old_tix old_tmove old_txt txt0 dk undo_on tmp lineobj p1 p2 p3
                     ss i ent r pts uniq p sorted k s ang1 side dirang sp p4)
  (defun *error* (msg)
    (if tmp (progn (entdel tmp) (setq tmp nil)))
    (if undo_on (progn (command "_.UNDO" "_E") (setq undo_on nil)))
    (if old_txt (setvar "DIMTXT" old_txt))
    (if old_fit (setvar "DIMATFIT" old_fit))
    (if old_tix (setvar "DIMTIX" old_tix))
    (if old_tmove (setvar "DIMTMOVE" old_tmove))
    (if dk (progn (sd:dimkieu-end dk) (setq dk nil)))
    (if old_os (setvar "OSMODE" old_os))
    (if old_echo (setvar "CMDECHO" old_echo))
    (if (and msg (not (wcmatch (strcase msg) "*CANCEL*,*QUIT*,*EXIT*")))
      (princ (strcat "\n[SD] Loi: " msg))
    )
    (princ)
  )

  (setq old_os (getvar "OSMODE")
        old_echo (getvar "CMDECHO")
        old_fit (getvar "DIMATFIT")
        old_tix (getvar "DIMTIX")
        old_tmove (getvar "DIMTMOVE")
        old_txt (getvar "DIMTXT"))

  (if (and (setq p1 (sd:dimchu-pt "\nChon diem bat dau cua duong cat" nil))
           (setq p2 (getpoint p1 "\nChon diem ket thuc cua duong cat: "))
           (setq p3 (getpoint p2 "\nChon vi tri dat duong Dim chi tiet: ")))
    (progn
      (setvar "CMDECHO" 0)
      (command "_.UNDO" "_BE")
      (setq undo_on T)
      (setvar "OSMODE" 0)
      ;; Dim ron: chu nam canh duong dim, khong ep vao giua 2 duong dong (tra lai khi xong / loi)
      (setq dk (sd:dimkieu-begin))   ;; kieu dim ShopDrawing (neu BAT)
      (setq txt0 (getvar "DIMTXT"))  ;; chieu cao chu cua kieu dim dang dung (sau khi chuyen kieu)
      (sd:dimchu-apply)       ;; DIMATFIT 1 / DIMTIX 0 / DIMTMOVE 0 neu tuy chon chu dim dang BAT

      ;; Line tam (WCS) de lay giao diem
      (entmake (list '(0 . "LINE") (cons 10 (trans p1 1 0)) (cons 11 (trans p2 1 0))))
      (setq tmp (entlast))
      (setq lineobj (vlax-ename->vla-object tmp))

      ;; Cac doi tuong cat qua duong cat (fence nhan diem UCS)
      (if (setq ss (ssget "_F" (list p1 p2)))
        (repeat (setq i (sslength ss))
          (setq ent (ssname ss (setq i (1- i))))
          (if (/= ent tmp)
            (progn
              (setq r (vl-catch-all-apply 'vlax-invoke
                        (list (vlax-ename->vla-object ent) 'IntersectWith lineobj 0)))
              (if (and r (not (vl-catch-all-error-p r)))
                (while (>= (length r) 3)
                  (setq pts (cons (trans (list (car r) (cadr r) (caddr r)) 0 1) pts)
                        r (cdddr r))
                )
              )
            )
          )
        )
      )

      (entdel tmp)
      (setq tmp nil)

      ;; Loc diem trung (sai so 0.1)
      (foreach p pts
        (if (not (vl-some '(lambda (x) (< (distance p x) 0.1)) uniq))
          (setq uniq (cons p uniq))
        )
      )
      ;; Sap xep doc duong cat
      (setq sorted (vl-sort uniq '(lambda (a b) (< (distance p1 a) (distance p1 b)))))

      (if (< (length sorted) 2)
        (princ "\n[SD] Duong cat chi di qua duoi 2 diem, khong du de tao Dim!")
        (progn
          ;; 1. Dim chi tiet
          (setq k 0 s "")
          (while (< k (1- (length sorted)))
            (sd:dimchu-small (distance (nth k sorted) (nth (1+ k) sorted)))
            (command "_.DIMALIGNED" (nth k sorted) (nth (1+ k) sorted) p3)
            (setvar "DIMTXT" txt0)
            (setq s (strcat s (rtos (distance (nth k sorted) (nth (1+ k) sorted)) 2 2) "  "))
            (setq k (1+ k))
          )
          ;; 2. Dim tong, day ra phia xa duong cat hon dim chi tiet
          (setq ang1 (angle p1 p2)
                side (- (* (- (car p2) (car p1)) (- (cadr p3) (cadr p1)))
                        (* (- (cadr p2) (cadr p1)) (- (car p3) (car p1))))
                dirang (if (< side 0) (- ang1 (/ pi 2)) (+ ang1 (/ pi 2)))
                sp (* 3.5 (getvar "DIMTXT")
                      (if (> (getvar "DIMSCALE") 0) (getvar "DIMSCALE") 1.0))
                p4 (polar p3 dirang sp))
          (command "_.DIMALIGNED" (car sorted) (last sorted) p4)

          (princ (strcat "\n[SD] So doan: " (itoa (1- (length sorted)))
                         " | Tong: " (rtos (distance (car sorted) (last sorted)) 2 2)))
          (princ (strcat "\n[SD] Cac doan: " s))
        )
      )

      (command "_.UNDO" "_E")
      (setq undo_on nil)
      (setvar "DIMTXT" old_txt)
      (setvar "DIMATFIT" old_fit)
      (setvar "DIMTIX" old_tix)
      (setvar "DIMTMOVE" old_tmove)
      (if dk (progn (sd:dimkieu-end dk) (setq dk nil)))
      (setvar "OSMODE" old_os)
      (setvar "CMDECHO" old_echo)
      (princ "\n[SD] Da hoan thanh!")
    )
  )
  (princ)
)

;;; ==========================================================================
;;;  SDDIMPOLY (lenh tat DPK) - Dim tu dong cho polyline kin (co chua cung tron)
;;;  Tich hop tu "LISP DIM TU DONG POLYLINE KIN" v2 theo yeu cau khach hang (ban goc luu o ShopDrawing/goc/DimPolyline_v2.lsp):
;;;  huong ngoai tinh theo dien tich co dau lay mau ca cung, nhan cung bang hinh hoc (chay ca POLYLINE 2D/3D), dung khi UCS xoay,
;;;  *error* tra bien va dong UNDO. Them tuy chon chu dim canh duong dim (sd:dimchu-*, dinh nghia trong dgd.lsp).
;;; ==========================================================================
(defun c:SDDIMPOLY ( / *error* old_vars undo_on ent n i k p1 p2 pm dv ang d_offset
                       ccw pt_dim sum_area pts a b ds r dk e0 nfail nok txt0)
  (defun *error* (msg)
    (if old_vars (foreach x old_vars (setvar (car x) (cdr x))))
    (if dk (progn (sd:dimkieu-end dk) (setq dk nil)))
    (if undo_on (progn (command "_.UNDO" "_E") (setq undo_on nil)))
    (if (and msg (not (wcmatch (strcase msg) "*CANCEL*,*QUIT*,*EXIT*")))
      (princ (strcat "\n[SD] Loi: " msg))
    )
    (princ)
  )

  ;; hoi polyline; go C / K de doi tuy chon
  (setq r (progn (initget "Chu Kieu") (entsel (sd:dimchu-msg "\nChon Polyline kin can Dim tu dong"))))
  (while (member r '("Chu" "Kieu"))
    (if (= r "Chu") (sd:dimchu-toggle) (sd:dimkieu-toggle))
    (initget "Chu Kieu")
    (setq r (entsel (sd:dimchu-msg "\nChon Polyline kin can Dim tu dong"))))
  (setq ent (if (listp r) (car r)))

  (if (and ent (wcmatch (cdr (assoc 0 (entget ent))) "*POLYLINE"))
    (progn
      (setq old_vars (list (cons "DIMATFIT" (getvar "DIMATFIT"))
                           (cons "DIMTIX" (getvar "DIMTIX"))
                           (cons "DIMTMOVE" (getvar "DIMTMOVE"))
                           (cons "DIMTXT" (getvar "DIMTXT"))
                           (cons "OSMODE" (getvar "OSMODE"))
                           (cons "CMDECHO" (getvar "CMDECHO"))))
      (command "_.UNDO" "_BE")
      (setq undo_on T)
      (setq dk (sd:dimkieu-begin))
      (setq txt0 (getvar "DIMTXT"))
      (sd:dimchu-apply)
      (setvar "OSMODE" 0)
      (setvar "CMDECHO" 0)

      ;; Khoang cach dat Dim = 3.5 lan chieu cao chu
      (setq d_offset (* 3.5 (getvar "DIMTXT")
                        (if (> (getvar "DIMSCALE") 0) (getvar "DIMSCALE") 1.0)))

      ;; Chieu ve: dien tich co dau tren cac diem mau (ca diem tren cung)
      (setq n (fix (+ 0.5 (vlax-curve-getEndParam ent))) i 0 pts nil)
      (while (< i n)
        (foreach k '(0.0 0.25 0.5 0.75)
          (setq pts (cons (vlax-curve-getPointAtParam ent (+ i k)) pts)))
        (setq i (1+ i))
      )
      (setq pts (reverse pts) sum_area 0.0 a (last pts))
      (foreach b pts
        (setq sum_area (+ sum_area (* (- (car b) (car a)) (+ (cadr b) (cadr a)))))
        (setq a b)
      )
      (setq ccw (< sum_area 0)) ;; T neu nguoc chieu kim dong ho

      (setq i 0)
      (while (< i n)
        (setq p1 (vlax-curve-getPointAtParam ent i)
              p2 (vlax-curve-getPointAtParam ent (1+ i))
              pm (vlax-curve-getPointAtParam ent (+ i 0.5))
              dv (vlax-curve-getFirstDeriv ent (+ i 0.5))
              ang (angle '(0.0 0.0 0.0) dv)
              pt_dim (polar pm (if ccw (- ang (/ pi 2)) (+ ang (/ pi 2))) d_offset))
        (if (> (distance p1 p2) 1e-6)
          (progn
            ;; Diem giua duong cong lech khoi trung diem day cung => cung tron
            (setq ds (distance pm (mapcar '(lambda (u v) (/ (+ u v) 2.0)) p1 p2)))
            (sd:dimchu-small (distance p1 p2))
            (setq e0 (entlast))
            (if (< ds 1e-4)
              (command "_.DIMALIGNED" "_non" (trans p1 0 1) "_non" (trans p2 0 1)
                       "_non" (trans pt_dim 0 1))
              (command "_.DIMARC" (list ent (trans pm 0 1)) "_non" (trans pt_dim 0 1))
            )
            (while (> (getvar "CMDACTIVE") 0) (command ""))   ;; lenh dim dang do do thi huy
            ;; khong co dim moi (DIMARC that bai...) -> thu lai bang dim day cung; van that bai thi bao canh nao
            (if (eq (entlast) e0)
              (progn
                (command "_.DIMALIGNED" "_non" (trans p1 0 1) "_non" (trans p2 0 1) "_non" (trans pt_dim 0 1))
                (while (> (getvar "CMDACTIVE") 0) (command ""))))
            (if (eq (entlast) e0)
              (setq nfail (cons (1+ i) nfail))
              (setq nok (1+ (if nok nok 0))))
            (setvar "DIMTXT" txt0)
          )
        )
        (setq i (1+ i))
      )
      (princ (strcat "\n[SD] Da tao Dim tu dong: " (itoa (if nok nok 0)) " / " (itoa n) " canh."))
      (if nfail (princ (strcat "\n[SD] Canh KHONG dim duoc (so thu tu tu 1): " (vl-princ-to-string (reverse nfail)))))

      (foreach x old_vars (setvar (car x) (cdr x)))
      (if dk (progn (sd:dimkieu-end dk) (setq dk nil)))
      (command "_.UNDO" "_E")
      (setq undo_on nil old_vars nil)
    )
    (princ "\n[SD] Doi tuong duoc chon khong phai la Polyline!")
  )
  (princ)
)

;; Thep thong minh: gan reactor cho ban ve vua mo
(vl-catch-all-apply 'sd:tm-init nil)
(vl-catch-all-apply 'sd:ud-autoload nil)

(princ (strcat "\n[SD] ShopDrawing Tools v" *SD:VER* " da nap. Go SDPANEL (bang lenh) hoac SDHELP; SDMENU de cai menu + toolbar."))
(if (not (vl-catch-all-error-p (vl-catch-all-apply '(lambda () (sd:au-has (sd:au-read (sd:au-file)))) nil)))
  (if (not (sd:au-has (sd:au-read (sd:au-file))))
    (princ "\n[SD] Chua tu nap moi khi mo AutoCAD: go SDTUNAP mot lan (hoac SDMENU).")))
(princ)
