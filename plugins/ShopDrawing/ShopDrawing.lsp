(defun sd:hook (d) (max 75.0 (* (sd:cfg "HOOK" 10.0) d)))

(defun sd:shape-len (code prm d)
  (cond ((= code "Dai") (+ (* 2.0 (+ (nth 0 prm) (nth 1 prm))) (* 2.0 (sd:hook d))))
        ((= code "Mot") (+ (nth 0 prm) (* 2.0 (sd:hook d))))
        (t (apply '+ prm))))

;; Ve so do hinh dang vao vung chu nhat goc o, rong w, cao h (khong theo ty le)
(defun sd:nmap (p o w h) (sd:p+ o (* w (car p)) (* h (cadr p))))
(defun sd:draw-shape (code prm o w h sc / sh)
  (if (setq sh (assoc code *SD:SHAPES*))
    (progn
      (sd:pline (mapcar '(lambda (p) (sd:nmap p o w h)) (nth 3 sh)) nil "SD-THEP-CHU")
      (foreach s (nth 4 sh)
        (sd:line (sd:nmap (car s) o w h) (sd:nmap (cadr s) o w h) "SD-THEP-CHU"))
      (foreach l (nth 5 sh)
        (if (nth (car l) prm)
          (sd:text (sd:nmap (cdr l) o w h) (sd:num (nth (car l) prm)) (* 1.8 sc) (nth 3 l) "SD-CHU"))))))

(defun sd:measure (/ ss i len)
  (setq len 0.0)
  (princ "\nChon cac doan the hien thanh thep: ")
  (if (setq ss (ssget '((0 . "LINE,LWPOLYLINE,POLYLINE,ARC,SPLINE"))))
    (progn (setq i 0)
           (repeat (sslength ss) (setq len (+ len (sd:len (ssname ss i))) i (1+ i)))))
  (princ (strcat "\nChieu dai do duoc: " (sd:rtos len 0) " mm"))
  len)

;;; --------------------------------------------------------------------------
;;;  SDTHEP - Ghi chu thanh thep: hinh dang, noi chong tu dong, luu XDATA
;;;  XDATA "SD_REBAR": so hieu, SL/CK, d, L, so CK, hinh dang, kich thuoc, doan cat
;;; --------------------------------------------------------------------------
(defun c:SDTHEP (/ sc mk n d shp prm len pcs lap k ls p1 p2 sg r c txt tl)
  (sd:begin)
  (setq sc (sd:sc) r (* 3.0 sc) ls (sd:cfg "STOCK" 11700.0))
  (setq shp (cond (*SD:LSHP*) ("Thang"))
        prm (cond ((cdr (assoc shp *SD:PRMS*))) ((nth 7 (assoc shp *SD:SHAPES*)))))
  (if (not (sd:dlg "Ghi chu thanh thep (SDTHEP)"
                   (list (list "mk" "So hieu thanh thep" 'str (itoa *SD:MARK*))
                         (list "n" "So thanh trong 1 cau kien" 'int (cond (*SD:LN*) (2)))
                         (list "d" "Duong kinh (mm)" 'real (cond (*SD:LD*) (16.0)))
                         (list "shp" "Hinh dang" 'kw shp
                               '(("Thang" . "Thang") ("L" . "Chu L") ("U" . "Chu U / thep mu") ("Z" . "Co de")
                                 ("Dai" . "Dai kin") ("Mot" . "Dai 1 nhanh / moc C")))
                         (list "note" "A = doan dau / ngang / be rong dai; B, C = cac doan tiep" 'note nil)
                         (list "A" "Kich thuoc A (mm)" 'real (cond ((car prm)) (6000.0)))
                         (list "B" "Kich thuoc B (mm)" 'real (cond ((cadr prm)) (300.0)) nil '("shp" "L" "U" "Z" "Dai"))
                         (list "C" "Kich thuoc C (mm)" 'real (cond ((caddr prm)) (300.0)) nil '("shp" "U" "Z"))
                         (list "do" "Do A tu doi tuong tren ban ve" 'tog nil nil '("shp" "Thang"))
                         (list "k" "So cau kien" 'int 1)
                         (list "ck" "Thuoc cau kien (de trong = khong)" 'str (cond (*SD:LCK*) (""))))))
    (exit))
  (setq *SD:LCK* (sd:v "ck"))
  (setq mk (sd:v "mk") n (sd:v "n") d (sd:v "d") shp (sd:v "shp")
        prm (sd:head (length (nth 2 (assoc shp *SD:SHAPES*))) (list (sd:v "A") (sd:v "B") (sd:v "C"))))
  (if (and (= shp "Thang") (sd:v "do")) (setq prm (list (sd:measure))))
  (setq *SD:PRMS* (cons (cons shp prm) (vl-remove (assoc shp *SD:PRMS*) *SD:PRMS*))
        len (sd:shape-len shp prm d))
  (setq *SD:LN* n *SD:LD* d *SD:LSHP* shp)
  (princ (strcat "\nChieu dai trien khai 1 thanh: L = " (sd:rtos len 0) " mm"))
  (cond ((and (= shp "Thang") (setq pcs (sd:splice len d)))
         (setq lap (sd:lap d))
         (princ (strcat "\nL > " (sd:num ls) " mm: noi chong, lap = " (sd:num lap) " mm ("
                        (sd:lapinfo) ")\n  -> doan cat: " (sd:pcs-str pcs "x")
                        "\n  Luu y: bo tri so le, khong qua 50% so thanh noi tai 1 tiet dien.")))
        ((> len ls)
         (princ (strcat "\n[!] L > chieu dai cay thep " (sd:num ls)
                        " mm. Nen tach thanh 2 so hieu (doan uon + doan thang) de noi."))))
  (setq k (sd:v "k"))
  (if (and (> len 0)
           (setq p1 (sd:getpt "\nDiem tren thanh thep: " nil))
           (setq p2 (sd:getpt "\nVi tri ghi chu: " p1)))
    (progn
      ;; co ky hieu theo ty le vung ve (mat cat chi tiet / mat bang)
      (if (setq sg (sd:sc-pt p1 500.0)) (setq sc sg r (* 3.0 sc)))
      (setq sg (if (>= (car p2) (car p1)) 1.0 -1.0)
            c  (sd:p+ p2 (* sg r) 0)
            txt (strcat (itoa n) "%%c" (sd:num d) " L=" (sd:rtos len 0)
                        (if (> k 1) (strcat " (\\U+00D7" (itoa k) " CK)") ""))
            tl (* sc (max 20.0 (* 1.9 (strlen txt)))))
      (sd:dot p1 (* 0.8 sc) "SD-KYHIEU")
      (sd:line p1 p2 "SD-KYHIEU")
      (entmake (list '(0 . "CIRCLE") '(8 . "SD-KYHIEU") (cons 10 c) (cons 40 r)
                     (list -3 (list "SD_REBAR" (cons 1000 mk) (cons 1070 n)
                                    (cons 1040 d) (cons 1040 len) (cons 1070 k)
                                    (cons 1000 shp) (cons 1000 (sd:nums->str prm))
                                    (cons 1000 (sd:nums->str pcs))))))
      (sd:ck-tag (entlast) *SD:LCK*)
      (sd:text c mk (* 2.5 sc) "MC" "SD-CHU")
      (sd:line (sd:p+ c (* sg r) 0) (sd:p+ c (* sg (+ r tl)) 0) "SD-KYHIEU")
      (sd:text (sd:p+ c (* sg (+ r sc)) (* 0.8 sc)) txt (* 2.5 sc) (if (> sg 0) "L" "R") "SD-CHU")
      (if pcs
        (sd:text (sd:p+ c (* sg (+ r sc)) (* -3.3 sc))
                 (strcat "N\\U+1ED1i: " (sd:pcs-str pcs "\\U+00D7") " (lap " (sd:num lap) ")")
                 (* 2.0 sc) (if (> sg 0) "L" "R") "SD-CHU"))
      (if (wcmatch mk "#*") (setq *SD:MARK* (1+ (atoi mk))))))
  (sd:finish))

