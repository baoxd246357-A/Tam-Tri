(defun sd:positions (L e n / dx i r)
  (if (= n 1)
    (list (/ L 2.0))
    (progn
      (setq dx (/ (- L e e) (1- n)) i 0)
      (repeat n (setq r (cons (+ e (* i dx)) r) i (1+ i)))
      (reverse r))))

(defun c:SDBANMA (/ ts name B H tk nx ny ex ey d0 c o xs ys kl k)
  (sd:begin)
  (setq ts (float *SD:DETSCALE*))
  (if (not (sd:dlg "Ban ma / ban de (SDBANMA)"
                   (list (list "name" "Ten ban ma" 'str (cond (*SD:BNAME*) ("BM1")))
                         (list "B" "Chieu rong B - theo X (mm)" 'real (cond (*SD:BB*) (300.0)))
                         (list "H" "Chieu cao H - theo Y (mm)" 'real (cond (*SD:BH*) (400.0)))
                         (list "t" "Chieu day t (mm)" 'real (cond (*SD:BT*) (20.0)))
                         (list "nx" "So cot lo theo X" 'int 2)
                         (list "ny" "So hang lo theo Y" 'int 2)
                         (list "ex" "Tam lo den mep theo X (mm)" 'real 50.0)
                         (list "ey" "Tam lo den mep theo Y (mm)" 'real 50.0)
                         (list "d0" "Duong kinh lo (mm)" 'real 22.0))))
    (exit))
  (setq name (sd:v "name") B (sd:v "B") H (sd:v "H") tk (sd:v "t") nx (sd:v "nx") ny (sd:v "ny")
        ex (sd:v "ex") ey (sd:v "ey") d0 (sd:v "d0"))
  (setq *SD:BNAME* name *SD:BB* B *SD:BH* H *SD:BT* tk)
  (if (setq c (sd:getpt "\nTam ban ma: " nil))
    (progn
      (setq o  (sd:p+ c (/ B -2.0) (/ H -2.0))
            xs (sd:positions B ex nx)
            ys (sd:positions H ey ny)
            k  (+ (/ d0 2.0) (* 2 ts)))
      (sd:rect o B H "SD-THEP-HINH")
      (foreach x xs
        (foreach y ys
          (sd:circle (sd:p+ o x y) (/ d0 2.0) "SD-BULONG")
          (sd:line (sd:p+ o (- x k) y) (sd:p+ o (+ x k) y) "SD-TRUC")
          (sd:line (sd:p+ o x (- y k)) (sd:p+ o x (+ y k)) "SD-TRUC")))
      (sd:use-dimstyle ts)
      (sd:dimchain (mapcar '(lambda (x) (sd:p+ o x 0)) (append '(0.0) xs (list B))) "H" (sd:p+ o 0 (* -6 ts)))
      (sd:dim o (sd:p+ o B 0) "H" (sd:p+ o 0 (* -13 ts)))
      (sd:dimchain (mapcar '(lambda (y) (sd:p+ o 0 y)) (append '(0.0) ys (list H))) "V" (sd:p+ o (* -6 ts) 0))
      (sd:dim o (sd:p+ o 0 H) "V" (sd:p+ o (* -13 ts) 0))
      (setq kl (* B H tk 7.85e-6))
      (sd:text (sd:p+ o (/ B 2.0) (* -20 ts))
               (strcat name ": PL" (sd:num tk) "\\U+00D7" (sd:num B) "\\U+00D7" (sd:num H))
               (* 3.0 ts) "MC" "SD-CHU")
      (sd:text (sd:p+ o (/ B 2.0) (* -25 ts))
               (strcat (itoa (* nx ny)) " l\\U+1ED7 %%c" (sd:num d0) " - KL = " (sd:rtos kl 2) " kg")
               (* 2.5 ts) "MC" "SD-CHU")
      (sd:use-dimstyle *SD:SCALE*)
      (princ (strcat "\n[SD] " name ": khoi luong " (sd:rtos kl 2) " kg."))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDIH - Tiet dien thep hinh I / H (to hop hoac can nong)
;;; --------------------------------------------------------------------------
(defun c:SDIH (/ ts typ h b tw tf c o A g)
  (sd:begin)
  (setq ts (float *SD:DETSCALE*))
  (if (not (sd:dlg "Tiet dien thep I / H (SDIH)"
                   (list (list "typ" "Loai tiet dien" 'kw "H" '("H" "I"))
                         (list "h" "Chieu cao h (mm)" 'real (cond (*SD:IH*) (300.0)))
                         (list "b" "Be rong canh b (mm)" 'real (cond (*SD:IB*) (150.0)))
                         (list "tw" "Chieu day bung tw (mm)" 'real (cond (*SD:ITW*) (6.5)))
                         (list "tf" "Chieu day canh tf (mm)" 'real (cond (*SD:ITF*) (9.0))))))
    (exit))
  (setq typ (sd:v "typ") h (sd:v "h") b (sd:v "b") tw (sd:v "tw") tf (sd:v "tf"))
  (setq *SD:IH* h *SD:IB* b *SD:ITW* tw *SD:ITF* tf)
  (if (setq c (sd:getpt "\nTam tiet dien: " nil))
    (progn
      (sd:pline (mapcar '(lambda (p) (sd:p+ c (car p) (cadr p)))
                        (list (list (/ b -2) (/ h -2)) (list (/ b 2) (/ h -2))
                              (list (/ b 2) (+ (/ h -2) tf)) (list (/ tw 2) (+ (/ h -2) tf))
                              (list (/ tw 2) (- (/ h 2) tf)) (list (/ b 2) (- (/ h 2) tf))
                              (list (/ b 2) (/ h 2)) (list (/ b -2) (/ h 2))
                              (list (/ b -2) (- (/ h 2) tf)) (list (/ tw -2) (- (/ h 2) tf))
                              (list (/ tw -2) (+ (/ h -2) tf)) (list (/ b -2) (+ (/ h -2) tf))))
                t "SD-THEP-HINH")
      (setq o (sd:p+ c (/ b -2) (/ h -2))
            A (+ (* 2 b tf) (* (- h tf tf) tw))
            g (* A 0.00785))
      (sd:use-dimstyle ts)
      (sd:dim o (sd:p+ o b 0) "H" (sd:p+ o 0 (* -8 ts)))
      (sd:dim (sd:p+ o b 0) (sd:p+ o b h) "V" (sd:p+ o (+ b (* 8 ts)) 0))
      (sd:text (sd:p+ c 0 (- (/ h -2) (* 16 ts)))
               (strcat typ (sd:num h) "\\U+00D7" (sd:num b) "\\U+00D7" (sd:num tw) "\\U+00D7" (sd:num tf))
               (* 3.0 ts) "MC" "SD-CHU")
      (sd:text (sd:p+ c 0 (- (/ h -2) (* 21 ts)))
               (strcat "A = " (sd:rtos (/ A 100.0) 2) " cm\\U+00B2; g = " (sd:rtos g 2) " kg/m")
               (* 2.5 ts) "MC" "SD-CHU")
      (sd:use-dimstyle *SD:SCALE*)))
  (sd:finish))

