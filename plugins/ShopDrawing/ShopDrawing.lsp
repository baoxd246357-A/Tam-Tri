(defun sd:ascii-name (s / i c r e)
  (setq r "" i 1)
  (while (<= i (strlen s))
    (setq c (ascii (substr s i 1))
          r (strcat r (cond ((< c 128) (chr c)) ((setq e (assoc c *SD:VNMAP*)) (cdr e)) ("_")))
          i (1+ i)))
  r)
(defun sd:non-ascii-p (s / i r)
  (setq i 1)
  (while (and (not r) (<= i (strlen s)))
    (if (> (ascii (substr s i 1)) 127) (setq r t))
    (setq i (1+ i)))
  r)
;; Ten file xuat canh ban ve. Duong dan co chu co dau (AutoLISP open khong ghi duoc) ->
;; thu muc khong dau <o dia>:\ShopDrawing_Xuat\ + ten ban ve bo dau
(defun sd:csv-name (suffix / pre nm dir)
  (setq pre (getvar "DWGPREFIX") nm (vl-filename-base (getvar "DWGNAME")))
  (if (not (sd:non-ascii-p (strcat pre nm)))
    (strcat pre nm suffix)
    (progn
      (setq dir (if (wcmatch pre "?:\\*") (strcat (substr pre 1 3) "ShopDrawing_Xuat") (strcat (getenv "TEMP") "\\ShopDrawing_Xuat")))
      (vl-mkdir dir)
      (if (not *SD:XUATNOTE*)
        (progn (setq *SD:XUATNOTE* t)
               (princ (strcat "\n[SD] Thu muc / ten ban ve co chu co dau: AutoCAD khong ghi file vao do duoc, file xuat luu tai " dir "\\"))))
      (strcat dir "\\" (sd:ascii-name nm) suffix))))

;;; --------------------------------------------------------------------------
;;;  Bang thong ke cot thep: du lieu, ve bang, CSV, bang tu cap nhat
;;; --------------------------------------------------------------------------
;; Du lieu bang tu cac ban ghi thep -> (rows dsum tot spliced)
;; row: (SH hinh-dang kich-thuoc DK L SL/CK soCK tongSL tongdai KL (kich-thuoc-so))
(defun sd:tk-data (data / rows tot w tl dsum rec spliced)
  (setq tot 0.0)
  (foreach r data
    (if (nth 7 r) (setq spliced t))
    ;; x = (so-hieu hinh-dang (kich-thuoc) d L SL/CK soCK)
    (foreach x (sd:rec-rows r)
      (setq tl  (/ (* (nth 4 x) (nth 5 x) (nth 6 x)) 1000.0)
            w   (* tl 0.00617 (nth 3 x) (nth 3 x))
            tot (+ tot w))
      (setq rows (cons (list (nth 0 x) (nth 1 x) (sd:join (mapcar 'sd:num (nth 2 x)) "/")
                             (sd:num (nth 3 x)) (sd:rtos (nth 4 x) 0) (itoa (nth 5 x))
                             (itoa (nth 6 x)) (itoa (* (nth 5 x) (nth 6 x)))
                             (sd:rtos tl 2) (sd:rtos w 2) (nth 2 x))
                       rows))
      (if (setq rec (assoc (nth 3 x) dsum))
        (setq dsum (subst (cons (car rec) (+ (cdr rec) w)) rec dsum))
        (setq dsum (cons (cons (nth 3 x) w) dsum)))))
  (list (reverse rows) (sd:sort dsum '(lambda (a b) (< (car a) (car b)))) tot spliced))

;; Ve bang thong ke tai pt (goc trai tren)
(defun sd:tk-table (pt tk sc / trows)
  (setq trows (mapcar '(lambda (r) (list "R" (list (nth 0 r) "" (nth 3 r) (nth 4 r) (nth 5 r)
                                                   (nth 6 r) (nth 7 r) (nth 8 r) (nth 9 r))
                                         (list (nth 1 r) (nth 10 r))))
                      (car tk)))
  (foreach x (cadr tk)
    (setq trows (append trows (list (list "S" (strcat "T\\U+1ED5ng %%c" (sd:num (car x))) (sd:rtos (cdr x) 2))))))
  (setq trows (append trows (list (list "S" "T\\U+1ED4NG C\\U+1ED8NG" (sd:rtos (caddr tk) 2)))))
  (if (cadddr tk)
    (setq trows (append trows (list (list "W" (strcat "Thanh 1a, 1b...: \\U+0111o\\U+1EA1n c\\U+1EAFt c\\U+1EE7a thanh n\\U+1ED1i ch\\U+1ED3ng; lap theo "
                                                      (sd:lapinfo) "; n\\U+1ED1i so le, <= 50% thanh / ti\\U+1EBFt di\\U+1EC7n."))))))
  (sd:table2 pt "B\\U+1EA2NG TH\\U+1ED0NG K\\U+00CA C\\U+1ED0T TH\\U+00C9P"
             '(("SH" 12) ("H\\U+00CCNH D\\U+1EA0NG" 46) ("\\U+0110K" 12) ("D\\U+00C0I (mm)" 18) ("SL/CK" 13)
               ("S\\U+1ED0 CK" 13) ("T\\U+1ED4NG SL" 16) ("T\\U+1ED4NG D\\U+00C0I (m)" 22) ("KL (kg)" 18))
             trows 1 sc))

(defun sd:tk-csv (tk / fn f)
  (setq fn (sd:csv-name "_ThongKeThep.csv"))
  (if (setq f (sd:open fn "w"))
    (progn
      (write-line "SH,Hinh dang,Kich thuoc (mm),DK(mm),Dai 1 thanh(mm),SL/CK,So CK,Tong SL,Tong dai(m),KL(kg)" f)
      (foreach r (car tk) (write-line (sd:join (reverse (cdr (reverse r))) ",") f))
      (foreach x (cadr tk) (write-line (strcat "Tong D" (sd:num (car x)) ",,,,,,,,," (sd:rtos (cdr x) 2)) f))
      (write-line (strcat "TONG CONG,,,,,,,,," (sd:rtos (caddr tk) 2)) f)
      (setq fn (sd:close f))
      (princ (strcat "\n[SD] Da xuat: " fn)))))

;; Ve bang va tra ve danh sach handle cac doi tuong vua tao
(defun sd:tk-draw (pt tk sc / e0 e hs)
  (setq e0 (entlast))
  (sd:tk-table pt tk sc)
  (setq e (if e0 (entnext e0) (entnext)))
  (while e (setq hs (cons (cdr (assoc 5 (entget e))) hs) e (entnext e)))
  hs)

;; Bang tu cap nhat: ldata "SD" "TKAUTO" = (diem ty-le layout (handle...) chu-ky)
;; chu-ky = noi dung cac dong bang; chi ve lai khi noi dung thay doi (hoac force)
(defun sd:tk-all (/ ss) (if (setq ss (ssget "_X" '((0 . "CIRCLE") (-3 ("SD_REBAR"))))) (sd:tk-data (sd:read-rebars ss))))
(defun sd:tk-sig (tk) (vl-prin1-to-string (list (car tk) (cadr tk))))

(defun sd:tk-refresh (force / a e tk sig)
  (if (and (setq a (vlax-ldata-get "SD" "TKAUTO")) (= (caddr a) (getvar "CTAB")))
    (progn
      (setq tk (sd:tk-all) sig (sd:tk-sig tk))
      (if (or force (/= sig (nth 4 a)))
        (progn
          (foreach h (cadddr a) (if (and (setq e (handent h)) (entget e)) (entdel e)))
          (vlax-ldata-put "SD" "TKAUTO"
                          (list (car a) (cadr a) (caddr a) (if (car tk) (sd:tk-draw (car a) tk (cadr a))) sig))
          t)))))

;;; --------------------------------------------------------------------------
;;;  SDTKTHEP - Bang thong ke cot thep (co hinh dang) + xuat CSV
;;;  Pham vi "Toan ban ve" + tu cap nhat: bang ve lai khi thep thong minh (SDTHEPTM) thay doi
;;; --------------------------------------------------------------------------
(defun c:SDTKTHEP (/ ss tk pt flt all)
  (sd:begin)
  (sd:tag-sync-all)
  (sd:tm-dup-report)
  (if (not (sd:dlg "Bang thong ke cot thep (SDTKTHEP)"
                   (list (list "pv" "Pham vi thong ke" 'kw "Tatca"
                               '(("Tatca" . "Toan ban ve") ("Chon" . "Chon ky hieu tren ban ve")))
                         (list "auto" "Tu cap nhat khi thep thong minh thay doi" 'tog t nil '("pv" "Tatca"))
                         (list "csv" "Xuat file CSV canh file ban ve" 'tog t))))
    (exit))
  (setq flt '((0 . "CIRCLE") (-3 ("SD_REBAR"))) all (= (sd:v "pv") "Tatca"))
  (if (not (setq ss (if all
                      (ssget "_X" flt)
                      (progn (princ "\nChon cac ky hieu thep (SDTHEP / SDTHEPTM): ") (ssget flt)))))
    (princ "\n[SD] Khong tim thay ky hieu thep nao (dung lenh SDTHEP hoac SDTHEPTM de tao).")
    (progn
      (setq tk (sd:tk-data (sd:read-rebars ss)))
      (if (setq pt (sd:getpt "\nDiem chen bang (goc trai tren): " nil))
        (progn
          (setq pt (sd:w pt))
          (if (and all (sd:v "auto"))
            (progn
              (setq tk (sd:tk-all))
              (vlax-ldata-put "SD" "TKAUTO" (list pt (sd:sc) (getvar "CTAB") (sd:tk-draw pt tk (sd:sc)) (sd:tk-sig tk)))
              (princ "\n[SD] Bang tu cap nhat: ve lai khi thep thong minh thay doi (bang tu cap nhat cu, neu co, thanh bang tinh)."))
            (sd:tk-table pt tk (sd:sc)))))
      (if (sd:v "csv") (sd:tk-csv tk))
      (princ (strcat "\n[SD] " (itoa (length (car tk))) " dong thep, tong khoi luong = "
                     (sd:rtos (caddr tk) 2) " kg."))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDTHEPTM - Thep thong minh (AutoRebar): polyline -> thanh thep tu cap nhat
;;;  Ky hieu (CIRCLE) giu XDATA "SD_REBAR" nhu SDTHEP, them:
;;;    "TM", handle thanh thep, handle chu ghi chu, kieu SL (0 co dinh / 1 rai), a, [handle duong phan bo]
;;;  Reactor: polyline / duong phan bo thay doi (STRETCH, grip, MOVE dinh...) -> cuoi lenh tinh lai
;;;  hinh dang, L, noi chong, so thanh; sua chu ghi chu va ve lai bang thong ke tu cap nhat.
;;; --------------------------------------------------------------------------
;; Dinh cua thanh thep -> (diem... ) va co khep kin
(defun sd:tm-pts (e / ed typ pts cl)
  (setq ed (entget e) typ (cdr (assoc 0 ed)))
  (cond ((= typ "LWPOLYLINE")
         (foreach g ed (if (= (car g) 10) (setq pts (cons (cdr g) pts))))
         (setq pts (reverse pts) cl (= 1 (logand 1 (cdr (assoc 70 ed))))))
        ((= typ "LINE") (setq pts (list (cdr (assoc 10 ed)) (cdr (assoc 11 ed))))))
  (if (and (not cl) (> (length pts) 3) (< (distance (car pts) (last pts)) 1e-3))
    (setq cl t pts (reverse (cdr (reverse pts)))))
  (list pts cl))

;; z cua tich co huong (b - a) x (c - b)
(defun sd:turn (a b c)
  (- (* (- (car b) (car a)) (- (cadr c) (cadr b))) (* (- (cadr b) (cadr a)) (- (car c) (car b)))))

;; Nhan dang hinh dang tu polyline -> (ma (kich-thuoc))
(defun sd:tm-shape (e / pl pts sg xs ys)
  (setq pl (sd:tm-pts e) pts (car pl))
  (setq sg (mapcar 'distance pts (append (cdr pts) (if (cadr pl) (list (car pts))))))
  (if (not (cadr pl)) (setq sg (sd:head (1- (length pts)) sg)))
  (cond
    ((cadr pl)                                         ; khep kin -> dai
     (if (= (length pts) 4)
       (list "Dai" (list (nth 0 sg) (nth 1 sg)))
       (progn (setq xs (mapcar 'car pts) ys (mapcar 'cadr pts))
              (list "Dai" (list (- (apply 'max xs) (apply 'min xs)) (- (apply 'max ys) (apply 'min ys)))))))
    ((= (length pts) 3) (list "L" (list (max (car sg) (cadr sg)) (min (car sg) (cadr sg)))))
    ((= (length pts) 4)
     (list (if (> (* (sd:turn (nth 0 pts) (nth 1 pts) (nth 2 pts)) (sd:turn (nth 1 pts) (nth 2 pts) (nth 3 pts))) 0)
             "U" "Z")
           sg))
    (t (list "Thang" (list (sd:len e))))))          ; thang, cung, nhieu doan: chieu dai trien khai

;; Hinh dang + kich thuoc lam tron mm (thong ke)
(defun sd:tm-shape-r (e / sp)
  (setq sp (sd:tm-shape e))
  (list (car sp) (mapcar '(lambda (x) (float (fix (+ x 0.5)))) (cadr sp))))

;; nm: 0 co dinh, 1 rai deu (a), 2 dai theo vung (spec "LOAI|so lieu|ghi chu")
(defun sd:tm-label (n d a nm len pcs k / sp)
  (strcat (itoa n) "%%c" (sd:num d)
          (cond ((= nm 1) (strcat " a" (sd:num a)))
                ((and (= nm 2) (= (type a) 'STR) (setq sp (sd:split a "|")) (caddr sp)) (strcat " " (caddr sp)))
                (""))
          " L=" (sd:rtos len 0)
          (if pcs " (n\\U+1ED1i)" "") (if (> k 1) (strcat " (\\U+00D7" (itoa k) " CK)") "")))

;; handle -> ename neu doi tuong con (AutoLISP: and chi tra ve T, nen dung if)
(defun sd:ent-ok (h / e) (if (and h (setq e (handent h)) (entget e)) e))

;; Bo n phan tu dau danh sach
(defun sd:drop (n l) (repeat n (setq l (cdr l))) l)

;; Vi tri dai cot (tu cao do san): vung toi han lz chan / dinh buoc a1, giua a2, trong nut dam (cao hd) buoc a1
(defun sd:col-zone-ys (hn hd c a1 a2 lz / ys y so)
  (setq y 50.0)
  (while (<= y lz) (setq ys (cons y ys) y (+ y a1)))
  (setq so (car ys) y (- hn 50.0))
  (while (and (>= y (- hn lz)) (> y (+ so (* 0.5 a1)))) (setq ys (cons y ys) y (- y a1)))
  (setq y (+ so a2))
  (while (< y (- hn lz (* 0.5 a2))) (setq ys (cons y ys) y (+ y a2)))
  (setq y (+ hn 50.0))
  (while (< y (- (+ hn hd) c)) (setq ys (cons y ys) y (+ y a1)))
  ys)
(defun sd:col-lz (b h hn) (sd:ceil (max b h (/ hn 6.0) 450.0) 50.0))

;; Vi tri dai 1 nhip dam (tinh tu mep goi trai, nhip thong thuy ln): Ln/4 hai dau buoc a1, giua a2
;; -> (trai giua phai)
(defun sd:beam-zone-ys (ln a1 a2 / lz x left right mid)
  (setq lz (* 0.25 ln) x 50.0)
  (while (<= x lz) (setq left (cons x left) x (+ x a1)))
  (setq x (- ln 50.0))
  (while (and (>= x (- ln lz)) (> x (+ (car left) (* 0.5 a1)))) (setq right (cons x right) x (- x a1)))
  (setq x (+ (car left) a2))
  (while (< x (- (car right) (* 0.5 a2))) (setq mid (cons x mid) x (+ x a2)))
  (list left mid right))

;; So dai theo vung tu chieu dai cac duong phan bo. spec "COT|m,hd,c,a1,a2,b,h|ghi chu" (lens = (hn))
;; hoac "DAM|m,a1,a2|ghi chu" (lens = nhip thong thuy tung nhip); m = so dai moi lop
(defun sd:zone-n (spec lens / sp v n)
  (setq sp (sd:split spec "|") v (sd:str->nums (cadr sp)))
  (cond
    ((= (car sp) "COT")
     (* (fix (nth 0 v))
        (length (sd:col-zone-ys (car lens) (nth 1 v) (nth 2 v) (nth 3 v) (nth 4 v) (sd:col-lz (nth 5 v) (nth 6 v) (car lens))))))
    ((= (car sp) "DAM")
     (setq n 0)
     (foreach ln lens (setq n (+ n (length (apply 'append (sd:beam-zone-ys ln (nth 1 v) (nth 2 v)))))))
     (* (fix (nth 0 v)) n))))

;; Tinh lai 1 ky hieu thong minh; tra ve T neu co thay doi
;; XDATA thong minh: 8 "TM", 9 handle thanh ("" = khong gan hinh, giu hinh dang da luu), 10 chu, 11 nm, 12 a,
;; 13 handle duong phan bo, 14 spec (nm = 2), 15.. handle duong phan bo them (nhieu nhip)
(defun sd:tm-update (tag / ed xd raw bar dist d n k nm a sp len pcs new txt te dl lens)
  (setq ed (entget tag '("SD_REBAR")) raw (cdadr (assoc -3 ed)) xd (mapcar 'cdr raw))
  (if (and (= (nth 8 xd) "TM") (or (= (nth 9 xd) "") (setq bar (sd:ent-ok (nth 9 xd)))))
    (progn
      (setq d (nth 2 xd) k (nth 4 xd) nm (nth 11 xd) a (nth 12 xd) dist (sd:ent-ok (nth 13 xd))
            dl (if (nth 13 xd) (mapcar 'sd:ent-ok (cons (nth 13 xd) (sd:drop 15 xd))))
            n (cond ((and (= nm 1) dist (> a 0)) (1+ (fix (+ (/ (sd:len dist) a) 1e-6))))
                    ((and (= nm 2) dl (not (member nil dl)) (nth 14 xd))
                     (sd:zone-n (nth 14 xd) (mapcar 'sd:len dl)))
                    ((nth 1 xd)))
            sp (if bar (sd:tm-shape-r bar) (list (nth 5 xd) (sd:str->nums (nth 6 xd))))
            len (sd:shape-len (car sp) (cadr sp) d)
            pcs (if (= (car sp) "Thang") (sd:splice len d)))
      (setq new (append (list (cons 1000 (nth 0 xd)) (cons 1070 n) (cons 1040 d) (cons 1040 len) (cons 1070 k)
                              (cons 1000 (car sp)) (cons 1000 (sd:nums->str (cadr sp))) (cons 1000 (sd:nums->str pcs))
                              (cons 1000 "TM") (nth 9 raw) (cons 1005 (nth 10 xd))
                              (cons 1070 nm) (cons 1040 a))
                        (if (nth 13 xd) (sd:drop 13 raw))))
      (if (not (equal (mapcar 'cdr new) xd 1e-6))
        (progn
          (entmod (append (vl-remove (assoc -3 ed) ed) (list (list -3 (cons "SD_REBAR" new)))))
          (setq txt (sd:tm-label n d (if (= nm 2) (nth 14 xd) a) nm len pcs k))
          (if (setq te (sd:ent-ok (nth 10 xd)))
            (entmod (subst (cons 1 txt) (assoc 1 (entget te)) (entget te))))
          t)))))

;; ---- Dong bo chu sua tay -> du lieu thep -------------------------------------------
;; Nguoi dung sua truc tiep chu so hieu trong vong tron (13 -> 13a) hoac chu ghi chu ("2%%c18 L=3700" -> "2%%c20 ...")
;; -> cap nhat XDATA SD_REBAR de bang thong ke / SDKL / toi uu cat dung theo chu tren ban ve.
;; Phan tich chu ghi chu: (n d L) (nil neu khong doc duoc), chap nhan %%c, O gach (Unicode), \U+00D8, \U+2205
(defun sd:num-at (s i / r c)
  (setq r "")
  (while (and (<= i (strlen s)) (or (wcmatch (setq c (substr s i 1)) "#") (and (= c ".") (/= r ""))))
    (setq r (strcat r c) i (1+ i)))
  (if (/= r "") (atof r)))
(defun sd:tag-parse (s / u p n d l)
  (setq u (strcase s))
  (foreach k (list "\\U+00D8" "\\U+2205" (chr 216) (chr 248)) (while (vl-string-search k u) (setq u (vl-string-subst "%%C" k u))))
  (setq n (sd:num-at (vl-string-left-trim " " u) 1))
  (if (setq p (vl-string-search "%%C" u)) (setq d (sd:num-at u (+ p 4))))
  (if (setq p (vl-string-search "L=" u)) (setq l (sd:num-at (vl-string-left-trim " " (substr u (+ p 3))) 1)))
  (if (and n d) (list (fix n) d l)))

;; Dong bo 1 ky hieu tu chu; tx = chi muc chu can giua (sd:bt-texts). Tra ve nil / T (da sua) / chuoi canh bao
(defun sd:tag-sync (tag tx / ed raw xd te mk lb new w ch)
  (setq ed (entget tag '("SD_REBAR")) raw (cdadr (assoc -3 ed)) xd (mapcar 'cdr raw) new raw)
  ;; so hieu trong vong tron
  (if (and (setq te (cdr (assoc (sd:bt-pkey (cond ((cdr (assoc 410 ed))) ("Model")) (cdr (assoc 10 ed))) tx)))
           (setq mk (vl-string-trim " " (cdr (assoc 1 (entget te)))))
           (/= mk "") (/= mk (nth 0 xd)))
    (setq new (cons (cons 1000 mk) (cdr new)) ch t))
  ;; chu ghi chu (thep thong minh: handle chu o vi tri 10)
  (if (and (= (nth 8 xd) "TM") (setq te (sd:ent-ok (nth 10 xd))) (setq lb (sd:tag-parse (cdr (assoc 1 (entget te))))))
    (progn
      (if (not (equal (cadr lb) (nth 2 xd) 1e-6))
        (setq new (sd:replace-nth 2 (cons 1040 (float (cadr lb))) new) ch t))
      (if (and (/= (car lb) (nth 1 xd)) (= (nth 11 xd) 0))
        (setq new (sd:replace-nth 1 (cons 1070 (car lb)) new) ch t))
      (if (and (caddr lb) (> (abs (- (caddr lb) (nth 3 xd))) 1.0) (equal (cadr lb) (nth 2 xd) 1e-6))
        (setq w (strcat "so hieu " (cdr (car new)) ": L=" (sd:num (caddr lb)) " sua tay khac chieu dai thanh ve ("
                        (sd:rtos (nth 3 xd) 0) ") - keo gian thanh thep tren ban ve thay vi sua chu")))))
  (if ch
    (progn
      (entmod (append (vl-remove (assoc -3 ed) ed) (list (list -3 (cons "SD_REBAR" new)))))
      (if (= (nth 8 xd) "TM") (sd:tm-update tag))))
  (cond (w) (ch)))

;; Dong bo moi ky hieu -> so ky hieu da sua; in canh bao
(defun sd:tag-sync-all (/ ss i tx n r)
  (setq n 0 i 0)
  (if (setq ss (ssget "_X" '((0 . "CIRCLE") (-3 ("SD_REBAR")))))
    (progn
      (setq tx (sd:bt-texts))
      (repeat (sslength ss)
        (setq r (sd:tag-sync (ssname ss i) tx) i (1+ i))
        (cond ((= r t) (setq n (1+ n)))
              ((= (type r) 'STR) (princ (strcat "\n[SD] Luu y " r ".")))))))
  (if (> n 0) (princ (strcat "\n[SD] Dong bo " (itoa n) " ky hieu thep theo chu sua tay tren ban ve.")))
  n)

;; Cac ky hieu thep thong minh dang gan vao thanh co handle h
(defun sd:tm-tags-of (h / r xd)
  (foreach tag (sd:tm-scan)
    (setq xd (mapcar 'cdr (cdadr (assoc -3 (entget tag '("SD_REBAR"))))))
    (if (= (nth 9 xd) h) (setq r (cons tag r))))
  r)
;; Canh bao thanh co nhieu ky hieu (moi ky hieu tinh 1 lan): ve trung bang SDTHEPTM tren thanh da co ky hieu
(defun sd:tm-dup-report (/ g xd o n)
  (foreach tag (sd:tm-scan)
    (setq xd (mapcar 'cdr (cdadr (assoc -3 (entget tag '("SD_REBAR"))))))
    (if (/= (nth 9 xd) "")
      (if (setq o (assoc (nth 9 xd) g))
        (setq g (subst (append o (list xd)) o g))
        (setq g (cons (list (nth 9 xd) xd) g)))))
  (setq n 0)
  (foreach x g
    (if (cddr x)
      (progn
        (setq n (1+ n))
        (princ (strcat "\n[!] 1 thanh thep co " (itoa (length (cdr x))) " ky hieu: "
                       (sd:join (mapcar '(lambda (y) (strcat (nth 0 y) " (" (itoa (nth 1 y)) "%%c" (sd:num (nth 2 y)) ")")) (cdr x)) ", ")
                       " -> dang tinh " (itoa (length (cdr x))) " lan. Neu khong phai cau kien dung chung thanh, xoa vong tron ky hieu thua.")))))
  n)

;; Gan reactor cho thanh thep / duong phan bo
(defun sd:tm-attach (e / o)
  (if (and e (not (member (cdr (assoc 5 (entget e))) *SD:TM-OWNED*)))
    (progn
      (setq o (vlax-ename->vla-object e) *SD:TM-OWNED* (cons (cdr (assoc 5 (entget e))) *SD:TM-OWNED*))
      (if *SD:TM-OR*
        (vlr-owner-add *SD:TM-OR* o)
        (setq *SD:TM-OR* (vlr-object-reactor (list o) "SD-TM"
                                             '((:vlr-modified . sd:tm-mod) (:vlr-erased . sd:tm-mod)
                                               (:vlr-unerased . sd:tm-mod))))))))

;; Quet ban ve: ban do handle (thanh / duong phan bo) -> ky hieu; tra ve danh sach ky hieu
(defun sd:tm-scan (/ ss i tag xd tags)
  (setq *SD:TM-MAP* nil i 0)
  (if (setq ss (ssget "_X" '((0 . "CIRCLE") (-3 ("SD_REBAR")))))
    (repeat (sslength ss)
      (setq tag (ssname ss i) i (1+ i) xd (mapcar 'cdr (cdadr (assoc -3 (entget tag '("SD_REBAR"))))))
      (if (= (nth 8 xd) "TM")
        (progn
          (setq tags (cons tag tags))
          (foreach h (append (list (nth 9 xd) (nth 13 xd)) (sd:drop 15 xd))
            (if (and h (/= h ""))
              (progn (setq *SD:TM-MAP* (cons (cons h tag) *SD:TM-MAP*))
                     (sd:tm-attach (sd:ent-ok h)))))))))
  tags)

;; Callback reactor (chi ghi nhan, khong sua doi tuong trong luc nay)
(defun sd:tm-mod (owner r p / h)
  (if (= (type (setq h (vl-catch-all-apply 'vla-get-Handle (list owner)))) 'STR)
    (setq *SD:TM-DIRTY* (cons h *SD:TM-DIRTY*))))

;; Cuoi lenh: cap nhat ky hieu bi anh huong + bang thong ke tu cap nhat
(defun sd:tm-flush (all / tags)
  (if all
    (setq tags (sd:tm-scan))
    (foreach h *SD:TM-DIRTY*
      (foreach m *SD:TM-MAP*
        (if (and (= (car m) h) (not (member (cdr m) tags))) (setq tags (cons (cdr m) tags))))))
  (setq *SD:TM-DIRTY* nil)
  (foreach tag tags (if (entget tag) (sd:tm-update tag)))
  ;; bang tu cap nhat: ve lai neu noi dung thong ke doi (ke ca sao chep / xoa ky hieu thuong)
  (sd:tk-refresh nil))

(defun sd:tm-cmd (r p / c)
  (setq c (strcase (car p)))
  (if (wcmatch c "*TEXTEDIT,DDEDIT,MTEDIT,*ATTEDIT,PROPERTIES*,MATCHPROP,FIND")
    (vl-catch-all-apply '(lambda () (if (> (sd:tag-sync-all) 0) (setq *SD:TM-DIRTY* (cons "SYNC" *SD:TM-DIRTY*)))) nil))
  (vl-catch-all-apply 'sd:tm-flush
                      (list (wcmatch c "*COPY*,*MIRROR*,*ARRAY*,PASTE*,U,UNDO,REDO,MREDO,OOPS,*INSERT*,EXPLODE,CHANGE"))))

(defun sd:tm-lisp (r p) (if *SD:TM-DIRTY* (vl-catch-all-apply 'sd:tm-flush (list nil))))

(defun sd:tm-init ()
  (if (not *SD:TM-CR*)
    (setq *SD:TM-CR* (vlr-command-reactor "SD-TM" '((:vlr-commandEnded . sd:tm-cmd) (:vlr-commandCancelled . sd:tm-cmd)
                                                   (:vlr-commandFailed . sd:tm-cmd)))))
  (if (not *SD:TM-LR*)
    (setq *SD:TM-LR* (vlr-lisp-reactor "SD-TM" '((:vlr-lispEnded . sd:tm-lisp)))))
  (sd:tm-scan))

;; Ve ky hieu thong minh: cham tren thanh, duong dan, vong tron so hieu, chu ghi chu
(defun sd:tm-tag (p1 p2 mk txt xd sc / r sg c tl te)
  (setq r (* 3.0 sc) sg (if (>= (car p2) (car p1)) 1.0 -1.0) c (sd:p+ p2 (* sg r) 0)
        tl (* sc (max 20.0 (* 1.9 (strlen txt)))))
  (sd:dot p1 (* 0.8 sc) "SD-KYHIEU")
  (sd:line p1 p2 "SD-KYHIEU")
  (sd:line (sd:p+ c (* sg r) 0) (sd:p+ c (* sg (+ r tl)) 0) "SD-KYHIEU")
  (sd:text (sd:p+ c (* sg (+ r sc)) (* 0.8 sc)) txt (* 2.5 sc) (if (> sg 0) "L" "R") "SD-CHU")
  (setq te (cdr (assoc 5 (entget (entlast)))))
  (entmake (list '(0 . "CIRCLE") '(8 . "SD-KYHIEU") (cons 10 c) (cons 40 r)
                 (list -3 (cons "SD_REBAR" (subst (cons 1005 te) '(1005 . "TXT") xd)))))
  (setq c (list (entlast) c))
  (sd:ck-tag (car c) *SD:CKNAME*)
  (sd:text (cadr c) mk (* 2.5 sc) "MC" "SD-CHU")
  (car c))

;; Ty le vung ve quanh diem c (mat cat 1/25 hay mat dung 1/100...): lay tu ky hieu thep SD gan nhat (r = 3.ty le)
;; hoac kich thuoc gan nhat (dimstyle SD-1-n / DIMSCALE cua dimstyle) trong o vuong +-dx. nil neu khong thay.
(defun sd:sc-pt (c dx / a b best d s ss i ed st)
  (setq a (list (- (car c) dx) (- (cadr c) dx) 0.0) b (list (+ (car c) dx) (+ (cadr c) dx) 0.0))
  (foreach flt (list '((0 . "CIRCLE") (-3 ("SD_REBAR"))) '((0 . "DIMENSION")))
    (if (setq ss (ssget "_C" (trans a 0 1) (trans b 0 1) flt))
      (progn
        (setq i 0)
        (repeat (sslength ss)
          (setq ed (entget (ssname ss i)) i (1+ i)
                s (if (= (cdr (assoc 0 ed)) "CIRCLE")
                    (/ (cdr (assoc 40 ed)) 3.0)
                    (progn (setq st (cdr (assoc 3 ed)))
                           (cond ((and st (wcmatch (strcase st) "SD-1-#*")) (atof (substr st 6)))
                                 ((and st (setq st (tblsearch "DIMSTYLE" st)) (cdr (assoc 40 st)))))))
                d (distance (list (car c) (cadr c)) (list (cadr (assoc 10 ed)) (caddr (assoc 10 ed)))))
          (if (and s (> s 0) (or (null best) (< d (car best)))) (setq best (list d s)))))))
  (if best (float (fix (+ (cadr best) 0.5)))))
;; Ty le vung ve quanh doi tuong e
(defun sd:sc-near (e / bb)
  (if (setq bb (sd:obj-bbox (vlax-ename->vla-object e)))
    (sd:sc-pt (mapcar '(lambda (p q) (/ (+ p q) 2.0)) (car bb) (cadr bb)) (max 500.0 (distance (car bb) (cadr bb))))))

(defun c:SDTHEPTM (/ op sc es bar de dist p1 p2 mk d nm n a k xd tag cnt ss i old kw ed)
  (sd:begin)
  (sd:tm-init)
  (if (not (sd:dlg "Thep thong minh (SDTHEPTM)"
                   (list (list "op" "Thao tac" 'kw "Tao"
                               '(("Tao" . "Tao thep thong minh tu polyline") ("Capnhat" . "Cap nhat tat ca + bang thong ke")
                                 ("Bo" . "Bo lien ket (thanh ky hieu thuong)")))
                         (list "mk" "So hieu thanh thep (tu tang)" 'str (itoa *SD:MARK*) nil '("op" "Tao"))
                         (list "d" "Duong kinh (mm)" 'real (cond (*SD:LD*) (16.0)) nil '("op" "Tao"))
                         (list "nm" "So thanh" 'kw (cond (*SD:TMNM*) ("Codinh"))
                               '(("Codinh" . "Co dinh") ("Rai" . "Rai theo khoang cach tren duong phan bo")) '("op" "Tao"))
                         (list "n" "So thanh trong 1 cau kien" 'int (cond (*SD:LN*) (2)) nil '("nm" "Codinh"))
                         (list "a" "Khoang cach rai a (mm)" 'real (cond (*SD:TMA*) (200.0)) nil '("nm" "Rai"))
                         (list "k" "So cau kien" 'int 1 nil '("op" "Tao"))
                         (list "ck" "Thuoc cau kien (de trong = khong)" 'str (cond (*SD:LCK*) ("")) nil '("op" "Tao"))
                         (list "tl" "Co ky hieu (ty le)" 'kw (cond (*SD:TMTL*) ("Tudong"))
                               (list '("Tudong" . "Tu dong theo vung ve (ky hieu / kich thuoc gan thanh thep)")
                                     (cons "Chinh" (strcat "Ty le chinh 1/" (itoa (fix (sd:sc)))))
                                     (cons "Chitiet" (strcat "Ty le chi tiet 1/" (itoa (fix *SD:DETSCALE*)))))
                               nil '("op" "Tao")))))
    (exit))
  (setq op (sd:v "op") sc (sd:sc) *SD:LCK* (sd:v "ck") *SD:CKNAME* (sd:v "ck") *SD:TMTL* (sd:v "tl"))
  (cond
    ((= op "Capnhat")
     (setq cnt 0)
     (foreach tag (sd:tm-scan) (if (sd:tm-update tag) (setq cnt (1+ cnt))))
     (sd:tk-refresh t)
     (princ (strcat "\n[SD] Da cap nhat " (itoa cnt) " ky hieu thep thong minh"
                    (if (vlax-ldata-get "SD" "TKAUTO") " va bang thong ke tu cap nhat." "."))))
    ((= op "Bo")
     (princ "\nChon ky hieu thep thong minh can bo lien ket: ")
     (if (setq ss (ssget '((0 . "CIRCLE") (-3 ("SD_REBAR")))))
       (progn
         (setq i 0 cnt 0)
         (repeat (sslength ss)
           (setq tag (entget (ssname ss i) '("SD_REBAR")) i (1+ i) xd (cdadr (assoc -3 tag)))
           (if (= (cdr (nth 8 xd)) "TM")
             (progn (entmod (append (vl-remove (assoc -3 tag) tag) (list (list -3 (cons "SD_REBAR" (sd:head 8 xd))))))
                    (setq cnt (1+ cnt)))))
         (sd:tm-scan)
         (princ (strcat "\n[SD] " (itoa cnt) " ky hieu da thanh ky hieu thuong (khong tu cap nhat).")))))
    (t
     (setq mk (sd:v "mk") d (sd:v "d") nm (if (= (sd:v "nm") "Rai") 1 0) n (sd:v "n") a (sd:v "a") k (sd:v "k")
           *SD:LD* d *SD:LN* n *SD:TMA* a *SD:TMNM* (sd:v "nm"))
     (while (setq es (entsel (strcat "\nChon polyline / line the hien thanh thep [" mk "] <Enter ket thuc>: ")))
       (setq bar (car es) dist nil)
       (cond
         ((not (member (cdr (assoc 0 (entget bar))) '("LWPOLYLINE" "LINE" "ARC")))
          (princ "\n[SD] Chi nhan LWPOLYLINE, LINE, ARC."))
         ((and (= nm 1)
               (not (and (setq de (entsel "\nChon duong phan bo (doan rai thep, vd truc dam): "))
                         (setq dist (car de)))))
          (princ "\n[SD] Can duong phan bo de rai thep."))
         ;; thanh da co ky hieu (SDDAMDUNG / lan truoc): cap nhat ky hieu cu thay vi tao them (tranh tinh trung)
         ((and (setq old (sd:tm-tags-of (cdr (assoc 5 (entget bar)))))
               (/= (setq kw (progn (initget "Capnhat Them Bo")
                                   (cond ((getkword (strcat "\nThanh nay da co ky hieu "
                                                            (sd:join (mapcar '(lambda (g) (cdr (cadr (cadr (assoc -3 (entget g '("SD_REBAR"))))))) old) ", ")
                                                            ". [Capnhat (doi D, so thanh)/Them ky hieu (cau kien dung chung)/Bo] <Capnhat>: ")))
                                         ("Capnhat"))))
                   "Them"))
          (if (= kw "Capnhat")
            (foreach g old
              (setq ed (entget g '("SD_REBAR")) xd (cdadr (assoc -3 ed)))
              (setq xd (sd:replace-nth 2 (cons 1040 d) xd))
              (if (and (= nm 0) (= (cdr (nth 11 xd)) 0)) (setq xd (sd:replace-nth 1 (cons 1070 n) xd)))
              (entmod (append (vl-remove (assoc -3 ed) ed) (list (list -3 (cons "SD_REBAR" xd)))))
              (sd:tm-update g)
              (princ (strcat "\n[SD] Da cap nhat ky hieu " (cdr (car xd)) ": "
                             (cdr (assoc 1 (entget (handent (cdr (nth 10 (cdadr (assoc -3 (entget g '("SD_REBAR")))))))))))))))
         ((setq p1 (vlax-curve-getClosestPointTo bar (sd:w (cadr es)))
                p2 (sd:getpt "\nVi tri ghi chu: " (trans p1 0 1)))
          (setq xd (list (cons 1000 mk) (cons 1070 n) (cons 1040 d) (cons 1040 0.0) (cons 1070 k)
                         '(1000 . "Thang") '(1000 . "") '(1000 . "") '(1000 . "TM")
                         (cons 1005 (cdr (assoc 5 (entget bar)))) '(1005 . "TXT") (cons 1070 nm) (cons 1040 a)))
          (if dist (setq xd (append xd (list (cons 1005 (cdr (assoc 5 (entget dist))))))))
          ;; co ky hieu theo ty le vung ve: mat cat 1/25 khong dung co cua mat bang 1/100
          (setq sc (cond ((= *SD:TMTL* "Chinh") (sd:sc))
                         ((= *SD:TMTL* "Chitiet") (float *SD:DETSCALE*))
                         ((sd:sc-near bar))
                         ((float *SD:DETSCALE*))))
          (setq tag (sd:tm-tag p1 (sd:w p2) mk "..." xd sc))
          (sd:tm-update tag)
          (sd:tm-attach bar)
          (if dist (sd:tm-attach dist))
          (princ (strcat "\n[SD] " mk ": " (cdr (assoc 1 (entget (handent (cdr (nth 10 (cdadr (assoc -3 (entget tag '("SD_REBAR"))))))))))
                         "  (co ky hieu 1/" (itoa (fix sc)) ")"))
          (setq mk (if (wcmatch mk "#*") (itoa (1+ (atoi mk))) mk))
          (if (wcmatch mk "#*") (setq *SD:MARK* (atoi mk))))))
     (sd:tm-scan)
     (sd:tk-refresh nil)))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDDAMDUNG - Mat dung thep dam lien tuc (trien khai thep theo chieu dai dam)
;;;  Cot + truc + kich thuoc, thep tren / duoi chay suot (neo moc 15d hoac thang vao cot bien),
;;;  thep mu goi (Ln/3 hoac Ln/4 tu mep goi), thep duoi tang cuong giua nhip (cach mep goi 0.15Ln),
;;;  dai: vung goi Ln/4 buoc a1, giua nhip buoc a2, dai dau cach mep goi 50 mm.
;;;  Thep doc = thep thong minh (SDTHEPTM): co keo dam -> L, ghi chu, bang thong ke tu cap nhat.
;;; --------------------------------------------------------------------------
;; So hieu theo hinh dang + kich thuoc + d + n: thanh giong nhau dung chung so hieu
(defun sd:dd-mark (key / e)
  (if (setq e (assoc key *SD:DD-KEYS*))
    (cdr e)
    (progn (setq e (itoa *SD:DD-NEXT*) *SD:DD-NEXT* (1+ *SD:DD-NEXT*)
                 *SD:DD-KEYS* (cons (cons key e) *SD:DD-KEYS*))
           e)))

;; Ve 1 thanh thep doc (polyline) + ky hieu; hx = toa do x goi y de dat ghi chu, ly = cao do ghi chu
(defun sd:dd-bar (o pts n d hx ly k tm sc / bar sp mk xd tag p1)
  (sd:pline (mapcar '(lambda (p) (sd:p+ o (car p) (cadr p))) pts) nil "SD-THEP-CHU")
  (setq bar (entlast) sp (sd:tm-shape bar)
        mk (sd:dd-mark (vl-prin1-to-string (list (car sp) (mapcar '(lambda (x) (fix (+ x 0.5))) (cadr sp)) d n)))
        p1 (vlax-curve-getClosestPointTo bar (sd:p+ o hx (cadr (cadr pts))))
        xd (list (cons 1000 mk) (cons 1070 n) (cons 1040 d) (cons 1040 0.0) (cons 1070 k)
                 '(1000 . "Thang") '(1000 . "") '(1000 . "") '(1000 . "TM")
                 (cons 1005 (cdr (assoc 5 (entget bar)))) '(1005 . "TXT") (cons 1070 0) (cons 1040 0.0)))
  (setq tag (sd:tm-tag p1 (sd:p+ o (+ hx (* 4 sc)) ly) mk "..." xd sc))
  (sd:tm-update tag)
  (if tm
    (sd:tm-attach bar)
    (progn (setq xd (entget tag '("SD_REBAR")))
           (entmod (append (vl-remove (assoc -3 xd) xd)
                           (list (list -3 (cons "SD_REBAR" (sd:head 8 (cdadr (assoc -3 xd))))))))))
  tag)

;; Dien tich van khuon thanh dam bi tru tai cho dam phu gac vao (mm2):
;; "220x400*4;300x500*2" -> moi cho giao tru b2 x (h2 - ts)
(defun sd:dp-tru (s ts / tot sz p n)
  (setq tot 0.0)
  (foreach it (sd:split (vl-string-translate "," ";" s) ";")
    (if (setq sz (sd:parse-size it))
      (setq p (vl-string-position (ascii "*") it nil t)
            n (if p (max 1 (atoi (substr it (+ p 2)))) 1)
            tot (+ tot (* n (car sz) (max 0.0 (- (cadr sz) ts)))))))
  tot)

;; Doan moc 90 do neo vao cot bien: 15d, lam tron 10 mm
(defun sd:hk15 (d) (sd:ceil (* 15.0 d) 10.0))

;; Duong cat ngang cot (zigzag) tu x1 den x2 tai y
(defun sd:zig (o x1 x2 y sc / m)
  (setq m (/ (+ x1 x2) 2.0))
  (sd:pline (list (sd:p+ o (- x1 (* 2 sc)) y) (sd:p+ o (- m (* 1.5 sc)) y) (sd:p+ o (- m (* 0.5 sc)) (+ y (* 2 sc)))
                  (sd:p+ o (+ m (* 0.5 sc)) (- y (* 2 sc))) (sd:p+ o (+ m (* 1.5 sc)) y) (sd:p+ o (+ x2 (* 2 sc)) y))
            nil "SD-BETONG"))

;; Ten truc thu i tinh tu ten truc dau
(defun sd:ax-name (a0 i / p)
  (cond ((wcmatch a0 "#,##,###") (itoa (+ (atoi a0) i)))
        ((setq p (vl-string-position (ascii (strcase a0)) "ABCDEFGHJKLMNPQRSTUVWXYZ")) (sd:axis-letter (+ p i)))
        (t (strcat a0 (itoa i)))))

;; Ky hieu mat cat tren mat dung: 2 vach dam tren / duoi dam + so
(defun sd:dd-cut (o x h lab sc)
  (sd:plinew (list (sd:p+ o x (+ h sc)) (sd:p+ o x (+ h (* 4 sc)))) nil (* 0.5 sc) "SD-KYHIEU")
  (sd:plinew (list (sd:p+ o x (- sc)) (sd:p+ o x (* -4 sc))) nil (* 0.5 sc) "SD-KYHIEU")
  (sd:text (sd:p+ o (+ x (* 1.5 sc)) (+ h (* 3 sc))) lab (* 2.5 sc) "ML" "SD-CHU")
  (sd:text (sd:p+ o (+ x (* 1.5 sc)) (* -3 sc)) lab (* 2.5 sc) "ML" "SD-CHU"))

(defun c:SDDAMDUNG (/ ts sides tru name sp cws b h c top bot tsup bmid kt moc ds a1 a2 k sc tm mc o ns xs fl fr ln dls
                     i j x y yt yb yt2 yb2 xeL xeR ext lt pts left right mid st nst stx zone lz s1 s2 s1o s2o
                     dt db r ax tagtxt slen pd)
  (sd:begin)
  (if (not (sd:dlg "Mat dung thep dam (SDDAMDUNG)"
                   (list (list "name" "Ten dam" 'str (cond (*SD:DNAME*) ("D1")))
                         (list "sp" "Cac nhip truc - truc (mm), vd 6000,2*4500" 'str (cond (*SD:DDL*) ("6000,4500")))
                         (list "cw" "Be rong cot tai cac goi (mm), vd 400 hoac 400,300,400" 'str (cond (*SD:DDC*) ("400")))
                         (list "ax" "Ten truc dau tien" 'str (cond (*SD:DDAX*) ("1")))
                         (list "b" "Be rong dam b (mm)" 'real (cond (*SD:DB*) (220.0)))
                         (list "h" "Chieu cao dam h (mm)" 'real (cond (*SD:DH*) (500.0)))
                         (list "c" "Lop bao ve (mm)" 'real 25.0)
                         (list "vt" "Vi tri dam (tinh van khuon)" 'kw (cond (*SD:DDVT*) ("Giua"))
                               '(("Giua" . "Dam giua - san 2 ben") ("Bien" . "Dam bien - san 1 ben") ("Doclap" . "Khong co san")))
                         (list "ts" "Chieu day san lien khoi (mm)" 'real0 (cond (*SD:SLT*) (120.0)) nil '("vt" "Giua" "Bien"))
                         (list "dp" "Dam phu gac vao bxh*so cho (vd 220x400*4)" 'str "")
                         (list "top" "Thep tren chay suot (vd 2d18)" 'bar "2d18")
                         (list "bot" "Thep duoi chay suot (vd 2d20)" 'bar "2d20")
                         (list "tsup" "Thep mu goi (vd 2d18; trong = khong)" 'str "2d18")
                         (list "bmid" "Thep duoi tang cuong giua nhip (trong = khong)" 'str "")
                         (list "lt" "Thep mu vuon tu mep goi" 'kw "1/3" '(("1/3" . "Ln/3") ("1/4" . "Ln/4")))
                         (list "neo" "Neo thep vao cot bien" 'kw "Moc"
                               '(("Moc" . "Uon 90 do, doan moc 15d") ("Thang" . "Thang den mep cot (tu chia noi)")))
                         (list "ds" "Duong kinh dai (mm)" 'real 8.0)
                         (list "a1" "Buoc dai vung goi Ln/4 (mm)" 'real 100.0)
                         (list "a2" "Buoc dai giua nhip (mm)" 'real 200.0)
                         (sd:tang-field)
                         (list "mk" "So hieu thep bat dau" 'int *SD:MARK*)
                         (list "k" "So cau kien (dam giong nhau)" 'int 1)
                         (list "sc" "Ty le ve 1/" 'int (fix *SD:DETSCALE*))
                         (list "mc" "Ve mat cat goi (1-1) va giua nhip (2-2)" 'tog t)
                         (list "tm" "Thep thong minh (tu cap nhat khi co keo)" 'tog t))))
    (exit))
  (setq name (sd:v "name") b (sd:v "b") h (sd:v "h") c (sd:v "c") top (sd:v "top") bot (sd:v "bot")
        ds (sd:v "ds") a1 (sd:v "a1") a2 (sd:v "a2") k (sd:v "k") sc (float (sd:v "sc")) tm (sd:v "tm") mc (sd:v "mc")
        moc (= (sd:v "neo") "Moc") kt (if (= (sd:v "lt") "1/3") (/ 1.0 3.0) 0.25)
        sp (sd:parse-spacing (sd:v "sp")) cws (sd:parse-spacing (sd:v "cw"))
        tsup (if (/= (vl-string-trim " " (sd:v "tsup")) "") (sd:parse-bar (sd:v "tsup")) "")
        bmid (if (/= (vl-string-trim " " (sd:v "bmid")) "") (sd:parse-bar (sd:v "bmid")) ""))
  (setq *SD:DNAME* name *SD:DB* b *SD:DH* h *SD:DDL* (sd:v "sp") *SD:DDC* (sd:v "cw") *SD:DDAX* (sd:v "ax")
        *SD:DDVT* (sd:v "vt"))
  ;; van khuon thanh dam: tru phan san lien khoi (h - ts) va cho dam phu gac vao
  (setq ts (if (= (sd:v "vt") "Doclap") 0.0 (min (sd:v "ts") h))
        sides (cond ((= (sd:v "vt") "Giua") (* 2 (- h ts))) ((= (sd:v "vt") "Bien") (- (* 2 h) ts)) (t (* 2 h)))
        tru (sd:dp-tru (sd:v "dp") ts))
  (cond
    ((or (null sp) (null cws)) (princ "\n[SD] Nhip / be rong cot khong hop le."))
    ((or (null tsup) (null bmid)) (princ "\n[SD] Thep mu / thep tang cuong sai dinh dang (vd 2d18)."))
    (t
     (if (= tsup "") (setq tsup nil))
     (if (= bmid "") (setq bmid nil))
     (setq ns (length sp) xs (sd:cumul sp) i 0)
     (foreach x xs
       (setq r (cond ((nth i cws)) ((last cws)))
             fl (append fl (list (- x (/ r 2.0)))) fr (append fr (list (+ x (/ r 2.0)))) i (1+ i)))
     (setq j 0)
     (repeat ns (setq ln (append ln (list (- (nth (1+ j) fl) (nth j fr)))) j (1+ j)))
     (if (vl-some '(lambda (x) (<= x (* 4 a1))) ln)
       (princ "\n[SD] Nhip thong thuy qua ngan so voi cot / buoc dai.")
       (if (setq o (sd:getpt "\nDiem chen (giao truc dau voi day dam): " nil))
         (progn
           (setq o (sd:w o) dt (cadr top) db (cadr bot)
                 ext (max 300.0 (* 12 sc)) yt (- h c ds (/ dt 2.0)) yb (+ c ds (/ db 2.0))
                 yt2 (- yt 25.0 (/ dt 2.0) (if tsup (/ (cadr tsup) 2.0) 0.0))
                 yb2 (+ yb 25.0 (/ db 2.0) (if bmid (/ (cadr bmid) 2.0) 0.0))
                 xeL (+ (car fl) c) xeR (- (last fr) c))
           (sd:kt-begin (sd:v "mk") name)
           ;; ---- be tong: cot (2 dau cat zigzag), dam giua cac mep cot
           (setq i 0)
           (foreach x xs
             (if (= i 0)
               (sd:line (sd:p+ o (nth i fl) (- ext)) (sd:p+ o (nth i fl) (+ h ext)) "SD-BETONG")
               (progn (sd:line (sd:p+ o (nth i fl) (- ext)) (sd:p+ o (nth i fl) 0) "SD-BETONG")
                      (sd:line (sd:p+ o (nth i fl) h) (sd:p+ o (nth i fl) (+ h ext)) "SD-BETONG")))
             (if (= i ns)
               (sd:line (sd:p+ o (nth i fr) (- ext)) (sd:p+ o (nth i fr) (+ h ext)) "SD-BETONG")
               (progn (sd:line (sd:p+ o (nth i fr) (- ext)) (sd:p+ o (nth i fr) 0) "SD-BETONG")
                      (sd:line (sd:p+ o (nth i fr) h) (sd:p+ o (nth i fr) (+ h ext)) "SD-BETONG")))
             (sd:zig o (nth i fl) (nth i fr) (- ext) sc)
             (sd:zig o (nth i fl) (nth i fr) (+ h ext) sc)
             ;; truc
             (sd:line (sd:p+ o x (- (+ ext (* 4 sc)))) (sd:p+ o x (+ h ext (* 4 sc))) "SD-TRUC")
             (sd:bubble (sd:p+ o x (+ h ext (* 8 sc))) (* 4 sc) (sd:ax-name (sd:v "ax") i))
             (setq i (1+ i)))
           (setq j 0)
           (repeat ns
             (sd:line (sd:p+ o (nth j fr) 0) (sd:p+ o (nth (1+ j) fl) 0) "SD-BETONG")
             (sd:line (sd:p+ o (nth j fr) h) (sd:p+ o (nth (1+ j) fl) h) "SD-BETONG")
             (setq j (1+ j)))
           ;; ---- dai: vung goi Ln/4 buoc a1, giua nhip buoc a2
           (setq j 0 nst 0)
           (repeat ns
             (setq lz (* 0.25 (nth j ln)) zone (sd:beam-zone-ys (nth j ln) a1 a2) x (nth j fr)
                   left (mapcar '(lambda (y) (+ x y)) (car zone)) mid (mapcar '(lambda (y) (+ x y)) (cadr zone))
                   right (mapcar '(lambda (y) (+ x y)) (caddr zone))
                   ;; duong phan bo dai = nhip thong thuy (co keo goi -> so dai theo vung tu tinh lai)
                   dls (append dls (list (sd:kt-dline (sd:p+ o (nth j fr) (+ c ds 30)) (sd:p+ o (nth (1+ j) fl) (+ c ds 30)) sc))))
             (foreach x (append left mid right)
               (sd:line (sd:p+ o x c) (sd:p+ o x (- h c)) "SD-THEP-DAI"))
             (setq nst (+ nst (length left) (length mid) (length right)))
             (if (and (= j 0) mid) (setq stx (nth (/ (length mid) 2) mid)))
             (foreach zone (list (list (+ (nth j fr) (/ lz 2.0)) a1) (list (/ (+ (nth j fr) (nth (1+ j) fl)) 2.0) a2)
                                 (list (- (nth (1+ j) fl) (/ lz 2.0)) a1))
               (sd:text (sd:p+ o (car zone) (/ h 2.0)) (strcat "%%c" (sd:num ds) "a" (sd:num (cadr zone)))
                        (* 2.0 sc) "MC" "SD-CHU"))
             (setq pd (append pd (list (nth j fr) (+ (nth j fr) lz) (- (nth (1+ j) fl) lz) (nth (1+ j) fl))) j (1+ j)))
           ;; ---- thep doc (thong minh)
           (setq pts (if moc
                       (list (list xeL (- yt (sd:hk15 dt))) (list xeL yt) (list xeR yt) (list xeR (- yt (sd:hk15 dt))))
                       (list (list xeL yt) (list xeR yt))))
           (sd:dd-bar o pts (car top) dt (+ (car fr) (* 0.3 (car ln))) (+ h (* 16 sc)) k tm sc)
           (setq pts (if moc
                       (list (list xeL (+ yb (sd:hk15 db))) (list xeL yb) (list xeR yb) (list xeR (+ yb (sd:hk15 db))))
                       (list (list xeL yb) (list xeR yb))))
           (sd:dd-bar o pts (car bot) db (+ (car fr) (* 0.3 (car ln))) (* -16 sc) k tm sc)
           (if tsup
             (progn
               (setq i 0)
               (foreach x xs
                 (setq left  (if (> i 0) (sd:ceil (* kt (nth (1- i) ln)) 50.0))
                       right (if (< i ns) (sd:ceil (* kt (nth i ln)) 50.0)))
                 (cond
                   ((= i 0)
                    (setq pts (append (if moc (list (list xeL (- yt2 (sd:hk15 (cadr tsup))))))
                                      (list (list xeL yt2) (list (+ (nth i fr) right) yt2)))
                          lt (+ (nth i fr) (/ right 2.0))))
                   ((= i ns)
                    (setq pts (append (list (list (- (nth i fl) left) yt2) (list xeR yt2))
                                      (if moc (list (list xeR (- yt2 (sd:hk15 (cadr tsup)))))))
                          lt (- (nth i fl) (/ left 2.0))))
                   (t (setq pts (list (list (- (nth i fl) left) yt2) (list (+ (nth i fr) right) yt2))
                            lt (+ (nth i fr) (/ right 2.0)))))
                 (sd:dd-bar o pts (car tsup) (cadr tsup) lt (+ h (* 8 sc)) k tm sc)
                 (setq i (1+ i)))))
           (if bmid
             (progn
               (setq j 0)
               (repeat ns
                 (setq x (sd:ceil (* 0.15 (nth j ln)) 50.0))
                 (sd:dd-bar o (list (list (+ (nth j fr) x) yb2) (list (- (nth (1+ j) fl) x) yb2))
                            (car bmid) (cadr bmid) (/ (+ (nth j fr) (nth (1+ j) fl)) 2.0) (* -8 sc) k tm sc)
                 (setq j (1+ j)))))
           ;; ---- dai: 1 ky hieu cho ca dam, so dai theo vung tinh tu cac duong phan bo tung nhip
           (if (null stx) (setq stx (+ (car fr) (/ (car ln) 2.0))))
           (sd:kt-dist o (list stx (- h c)) (list (+ stx (* 4 sc)) (+ h (* 24 sc))) ds "Dai" (list (- b c c) (- h c c)) k sc tm
                       2 0.0 (strcat "DAM|1," (sd:num a1) "," (sd:num a2) "|a" (sd:num a1) "/" (sd:num a2)) dls)
           ;; ---- kich thuoc: vung dai, nhip truc, tong
           (sd:use-dimstyle sc)
           (sd:dimchain (mapcar '(lambda (x) (sd:p+ o x (- ext))) pd) "H" (sd:p+ o 0 (- (+ ext (* 10 sc)))))
           (sd:dimchain (mapcar '(lambda (x) (sd:p+ o x (- ext))) xs) "H" (sd:p+ o 0 (- (+ ext (* 18 sc)))))
           (if (> ns 1) (sd:dim (sd:p+ o 0 (- ext)) (sd:p+ o (last xs) (- ext)) "H" (sd:p+ o 0 (- (+ ext (* 26 sc))))))
           (sd:dim (sd:p+ o (car fl) 0) (sd:p+ o (car fl) h) "V" (sd:p+ o (- (car fl) (* 8 sc)) 0))
           (sd:ck-title (sd:p+ o (/ (last xs) 2.0) (- (+ ext (* 36 sc))))
                        (strcat "M\\U+1EB6T \\U+0110\\U+1EE8NG TH\\U+00C9P D\\U+1EA6M " name " (" (sd:num b) "\\U+00D7" (sd:num h) ")  TL 1/" (itoa (fix sc)))
                        sc name "Dam" k (/ (* b h (apply '+ ln)) 1e9) (/ (- (* (+ b sides) (apply '+ ln)) tru) 1e6)
                        (strcat (sd:num b) "x" (sd:num h) ", Ln=" (sd:num (apply '+ ln))
                                (cond ((= (sd:v "vt") "Giua") ", VK tru san 2 ben") ((= (sd:v "vt") "Bien") ", VK tru san 1 ben") (""))
                                (if (> tru 0) (strcat ", tru dam phu " (sd:rtos (/ tru 1e6) 2) "m2") "")))
           ;; du lieu cho SDNOITHEP (doc hang loat): nhip, goi, dau thanh tinh tu truc, thep tren / duoi
           (sd:noi-reg (entlast)
                       (list "DAM" name (sd:v "sp") (sd:v "cw")
                             (- (/ (car cws) 2.0) c) (- (/ (cond ((nth ns cws)) ((last cws))) 2.0) c) (if moc 1 0)
                             (car top) (cadr top) (car bot) (cadr bot) k (cond (*SD:TANG*) (""))))
           ;; ---- mat cat 1-1 (goi) va 2-2 (giua nhip 1)
           (if mc
             (progn
               (setq s1 (if (> ns 1) (+ (nth 1 fr) 150.0) (+ (car fr) 150.0))
                     s2 (/ (+ (car fr) (nth 1 fl)) 2.0)
                     s1o (sd:p+ o (+ (last fr) (* 40 sc)) 0) s2o (sd:p+ s1o (+ b (* 40 sc)) 0))
               (sd:dd-cut o s1 h "1" sc)
               (sd:dd-cut o s2 h "2" sc)
               (foreach s (list (list s1o "1-1" a1 tsup nil) (list s2o "2-2" a2 nil bmid))
                 (sd:sec-common (car s) b h c ds (caddr s) sc (strcat "M\\U+1EB6T C\\U+1EAET " (cadr s)))
                 (sd:tagL (sd:barrow (car s) b c ds (car top) dt yt) (sd:p+ (car s) (* -6 sc) (+ h (* 6 sc)))
                          (strcat (itoa (car top)) "%%c" (sd:num dt)
                                  (if (nth 3 s) (strcat " + " (itoa (car tsup)) "%%c" (sd:num (cadr tsup))) ""))
                          sc)
                 (if (nth 3 s) (sd:barrow (car s) b c ds (car tsup) (cadr tsup) yt2))
                 (sd:tagL (sd:barrow (car s) b c ds (car bot) db yb) (sd:p+ (car s) (* -6 sc) (* -4 sc))
                          (strcat (itoa (car bot)) "%%c" (sd:num db)
                                  (if (nth 4 s) (strcat " + " (itoa (car bmid)) "%%c" (sd:num (cadr bmid))) ""))
                          sc)
                 (if (nth 4 s) (sd:barrow (car s) b c ds (car bmid) (cadr bmid) yb2)))))
           (sd:use-dimstyle *SD:SCALE*)
           (sd:kt-end)
           (if (and moc (> (+ (last xs) (* 2 (sd:hk15 dt))) (sd:cfg "STOCK" 11700.0)))
             (princ "\n[SD] Luu y: thanh chay suot co moc dai hon cay thep, khong tu chia noi. Nen chon neo Thang hoac tach thanh."))
           (princ (strcat "\n[SD] Da ve mat dung dam " name ": " (itoa ns) " nhip, " (itoa nst) " dai, so hieu "
                          (itoa (sd:v "mk")) "-" (itoa (1- *SD:DD-NEXT*))
                          (if tm ". Thep doc la thep thong minh (co keo tu cap nhat)." "."))))))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  KHAI TRIEN BTCT + KHOI LUONG
;;;  - Moi cau kien do lenh khai trien ve co 1 "nhan cau kien" (chu tieu de) mang XDATA "SD_KL":
;;;      ten, loai, so CK, be tong 1 CK (m3), van khuon 1 CK (m2), ghi chu kich thuoc
;;;  - Ky hieu thep cua cau kien mang XDATA "SD_CK" = ten cau kien (thong ke thep theo cau kien)
;;;  - SDKL doc toan ban ve -> file Excel (be tong, van khuon, thep theo duong kinh, chi tiet thep)
;;; --------------------------------------------------------------------------
;; Gan ten cau kien cho ky hieu thep
(defun sd:ck-tag (e name)
  (if (and e name (/= name ""))
    (entmod (append (entget e) (list (list -3 (list "SD_CK" (cons 1000 name))))))))

;; Dang ky khoi luong cau kien len doi tuong e (v: m3 / 1 CK, s: m2 / 1 CK)
(defun sd:ck-reg (e name typ k v s info)
  (entmod (append (entget e)
                  (list (list -3 (list "SD_KL" (cons 1000 name) (cons 1000 typ) (cons 1070 k)
                                       (cons 1040 v) (cons 1040 s) (cons 1000 info) (cons 1000 (cond (*SD:TANG*) ("")))))))))

;; Du lieu hinh hoc thep cho SDNOITHEP (XDATA "SD_NOI"): chuoi -> 1000, so nguyen -> 1070, so thuc -> 1040
(defun sd:noi-reg (e lst)
  (entmod (append (entget e)
                  (list (list -3 (cons "SD_NOI" (mapcar '(lambda (v) (cond ((= (type v) 'STR) (cons 1000 v)) ((= (type v) 'INT) (cons 1070 v))
                                                                            (t (cons 1040 (float v)))))
                                                        lst)))))))

;; Chu tieu de cau kien + dang ky khoi luong (kich thuoc mm -> m3, m2 da tinh truoc)
(defun sd:ck-title (pt str sc name typ k v s info)
  (sd:text pt str (* 3.5 sc) "MC" "SD-CHU")
  (sd:ck-reg (entlast) name typ k v s info)
  (princ (strcat "\n[SD] " name " (" typ "): be tong " (sd:rtos v 3) " m3, van khuon " (sd:rtos s 2)
                 " m2 / 1 CK" (if (> k 1) (strcat " x " (itoa k) " CK") "") ".")))

;; Duong phan bo thep (doan thang co 2 vach dau); tra ve ename doan thang
(defun sd:kt-dline (p q sc / a e)
  (sd:line p q "SD-KYHIEU")
  (setq e (entlast) a (+ (angle p q) (/ pi 2)))
  (foreach x (list p q)
    (sd:line (polar x a (* 1.5 sc)) (polar x (+ a pi) (* 1.5 sc)) "SD-KYHIEU"))
  e)

;; Thanh thep thong minh tong quat
;;  o: goc toa do cuc bo; pts: dinh polyline (cuc bo); hint: diem gan thanh (cuc bo) cho dau ghi chu;
;;  p2: vi tri ky hieu (cuc bo); dist: (p q) duong phan bo (cuc bo) + a buoc rai -> so thanh tu tinh
(defun sd:kt-bar (o pts n d hint p2 k tm sc dist a / bar sp mk xd tag p1 de)
  (sd:pline (mapcar '(lambda (p) (sd:p+ o (car p) (cadr p))) pts) nil "SD-THEP-CHU")
  (setq bar (entlast) sp (sd:tm-shape bar))
  (if dist (setq de (sd:kt-dline (sd:p+ o (car (car dist)) (cadr (car dist)))
                                 (sd:p+ o (car (cadr dist)) (cadr (cadr dist))) sc)))
  (setq mk (sd:dd-mark (vl-prin1-to-string
                         (list (car sp) (mapcar '(lambda (x) (fix (+ x 0.5))) (cadr sp)) d
                               (if dist (list a (fix (+ 0.5 (distance (car dist) (cadr dist))))) n))))
        p1 (vlax-curve-getClosestPointTo bar (sd:p+ o (car hint) (cadr hint)))
        xd (append (list (cons 1000 mk) (cons 1070 n) (cons 1040 d) (cons 1040 0.0) (cons 1070 k)
                         '(1000 . "Thang") '(1000 . "") '(1000 . "") '(1000 . "TM")
                         (cons 1005 (cdr (assoc 5 (entget bar)))) '(1005 . "TXT")
                         (cons 1070 (if dist 1 0)) (cons 1040 (if dist a 0.0)))
                   (if de (list (cons 1005 (cdr (assoc 5 (entget de))))))))
  (setq tag (sd:tm-tag p1 (sd:p+ o (car p2) (cadr p2)) mk "..." xd sc))
  (sd:tm-update tag)
  (if tm
    (progn (sd:tm-attach bar) (if de (sd:tm-attach de)))
    (progn (setq xd (entget tag '("SD_REBAR")))
           (entmod (append (vl-remove (assoc -3 xd) xd)
                           (list (list -3 (cons "SD_REBAR" (sd:head 8 (cdadr (assoc -3 xd))))))))))
  tag)

;; Ky hieu thep so luong co dinh (khong gan hinh ve): dai, thep phan bo, thep cho doi xung...
(defun sd:kt-fixed (o hint p2 n d shp prm k sc note / len mk)
  (setq len (sd:shape-len shp prm d)
        mk  (sd:dd-mark (vl-prin1-to-string (list shp (mapcar '(lambda (x) (fix (+ x 0.5))) prm) d n))))
  (sd:tm-tag (sd:p+ o (car hint) (cadr hint)) (sd:p+ o (car p2) (cadr p2)) mk
             (strcat (itoa n) "%%c" (sd:num d) note " L=" (sd:rtos len 0) (if (> k 1) (strcat " (\\U+00D7" (itoa k) " CK)") ""))
             (list (cons 1000 mk) (cons 1070 n) (cons 1040 d) (cons 1040 len) (cons 1070 k)
                   (cons 1000 shp) (cons 1000 (sd:nums->str prm)) '(1000 . ""))
             sc))

;; Ky hieu thong minh khong gan hinh thanh: so luong theo duong phan bo da ve (dl = cac ename)
;;  nm 1: rai deu buoc a tren (car dl); nm 2: theo vung spec (xem sd:zone-n), dl = 1 hoac nhieu nhip
;;  tm nil -> chuyen thanh ky hieu co dinh (so luong luc ve)
(defun sd:kt-dist (o hint p2 d shp prm k sc tm nm a spec dl / mk xd tag)
  (setq mk (sd:dd-mark (vl-prin1-to-string (list shp (mapcar '(lambda (x) (fix (+ x 0.5))) prm) d nm a spec
                                                 (mapcar '(lambda (e) (fix (+ 0.5 (sd:len e)))) dl))))
        xd (append (list (cons 1000 mk) (cons 1070 0) (cons 1040 d) (cons 1040 0.0) (cons 1070 k)
                         (cons 1000 shp) (cons 1000 (sd:nums->str prm)) '(1000 . "") '(1000 . "TM")
                         '(1000 . "") '(1005 . "TXT") (cons 1070 nm) (cons 1040 a)
                         (cons 1005 (cdr (assoc 5 (entget (car dl))))))
                   (if (= nm 2)
                     (cons (cons 1000 spec) (mapcar '(lambda (e) (cons 1005 (cdr (assoc 5 (entget e))))) (cdr dl))))))
  (setq tag (sd:tm-tag (sd:p+ o (car hint) (cadr hint)) (sd:p+ o (car p2) (cadr p2)) mk "..." xd sc))
  (sd:tm-update tag)
  (if tm
    (foreach e dl (sd:tm-attach e))
    (progn (setq xd (entget tag '("SD_REBAR")))
           (entmod (append (vl-remove (assoc -3 xd) xd)
                           (list (list -3 (cons "SD_REBAR" (sd:head 8 (cdadr (assoc -3 xd))))))))))
  tag)

;; Bat dau / ket thuc danh so thep cho 1 lenh khai trien
(defun sd:kt-begin (mk name)
  (sd:tm-init)
  (if (assoc "tang" *SD:FV*) (setq *SD:TANG* (vl-string-trim " " (sd:v "tang"))))
  (setq *SD:DD-KEYS* nil *SD:DD-NEXT* mk *SD:CKNAME* name))
(defun sd:kt-end () (setq *SD:MARK* *SD:DD-NEXT* *SD:CKNAME* nil))

;; Ky hieu mat cat A-A: 2 vach day + chu, tai p (huong vach theo goc ang)
(defun sd:kt-cutmark (p ang lab sc)
  (sd:plinew (list p (polar p ang (* 4 sc))) nil (* 0.6 sc) "SD-KYHIEU")
  (sd:text (polar p ang (* 6 sc)) lab (* 3.0 sc) "MC" "SD-CHU"))

;; Truong dung chung cua cac lenh khai trien
(defun sd:tang-field () (list "tang" "Tang / khu vuc (nhom khi xuat Excel, vd T1)" 'str (cond (*SD:TANG*) (""))))
(defun sd:kt-fields ()
  (list (sd:tang-field)
        (list "mk" "So hieu thep bat dau" 'int *SD:MARK*)
        (list "k" "So cau kien giong nhau" 'int 1)
        (list "sc" "Ty le ve 1/" 'int (fix *SD:DETSCALE*))
        (list "tm" "Thep thong minh (tu cap nhat khi co keo)" 'tog t)))

;; "8d18" -> (8 18.0); trong -> "" ; sai -> nil
(defun sd:opt-bar (s) (if (= (vl-string-trim " " s) "") "" (sd:parse-bar s)))

;;; --------------------------------------------------------------------------
;;;  SDMONGTHEP - Khai trien mong don: mat bang + mat cat A-A, B-B
;;;  Luoi thep day 2 phuong (uon moc len 10d), thep cho cot co chan, dai cot trong mong
;;; --------------------------------------------------------------------------
;; Co cot tren mong / dai: canh cot, thep cho (chan nam tren luoi yb, vuon len lap), dai cot trong mong.
;; e: goc mat cat; x: be rong mat cat; w: canh cot trong mat cat; main: mat cat chinh (ghi ky hieu);
;; ylow: cao do dai duoi cung.
(defun sd:kt-colstub (e x w H yb ylow lap cot dsc bc hc main k tm sc / cc foot xs ys y)
  (setq cc 40.0)
  (sd:line (sd:p+ e (/ (- x w) 2.0) H) (sd:p+ e (/ (- x w) 2.0) (+ H lap 300)) "SD-BETONG")
  (sd:line (sd:p+ e (/ (+ x w) 2.0) H) (sd:p+ e (/ (+ x w) 2.0) (+ H lap 300)) "SD-BETONG")
  (sd:zig e (/ (- x w) 2.0) (/ (+ x w) 2.0) (+ H lap 300) sc)
  (if (listp cot)
    (progn
      (setq foot (sd:ceil (max (* 15 (cadr cot)) 200.0) 10.0)
            xs (+ (/ (- x w) 2.0) cc (/ (cadr cot) 2.0))
            ys (- (/ (+ x w) 2.0) cc (/ (cadr cot) 2.0)))
      (sd:pline (list (sd:p+ e (+ ys foot) (+ yb (/ (cadr cot) 2.0))) (sd:p+ e ys (+ yb (/ (cadr cot) 2.0)))
                      (sd:p+ e ys (+ H lap))) nil "SD-THEP-CHU")
      (if main
        (sd:kt-bar e (list (list (- xs foot) (+ yb (/ (cadr cot) 2.0))) (list xs (+ yb (/ (cadr cot) 2.0))) (list xs (+ H lap)))
                   (car cot) (cadr cot) (list xs (+ H (/ lap 2.0))) (list (- xs (* 30 sc)) (+ H lap (* 4 sc))) k tm sc nil 0.0)
        (sd:pline (list (sd:p+ e (- xs foot) (+ yb (/ (cadr cot) 2.0))) (sd:p+ e xs (+ yb (/ (cadr cot) 2.0)))
                        (sd:p+ e xs (+ H lap))) nil "SD-THEP-CHU"))))
  (if (listp dsc)
    (progn
      (setq y (- H 100.0))
      (repeat (car dsc)
        (sd:line (sd:p+ e (+ (/ (- x w) 2.0) 25) y) (sd:p+ e (- (/ (+ x w) 2.0) 25) y) "SD-THEP-DAI")
        (setq y (- y (/ (- H 100.0 ylow) (max 1 (1- (car dsc)))))))
      (if main
        (sd:kt-fixed e (list (- (/ (+ x w) 2.0) 25) (- H 100.0)) (list (+ x (* 4 sc)) (+ H (* 2 sc)))
                     (car dsc) (cadr dsc) "Dai" (list (- bc 50) (- hc 50)) k sc "")))))

(defun c:SDMONGTHEP (/ name A B H hv h1 a2 b2 bc hc lot c dx ax dy ay moc cot dsc k sc tm o oa ob x y hkx hky
                       xs lap yb yt v s e)
  (sd:begin)
  (if (not (sd:dlg "Khai trien mong don (SDMONGTHEP)"
                   (append
                     (list (list "name" "Ten mong" 'str (cond (*SD:FMN*) ("M1")))
                           (list "A" "Canh A - theo X (mm)" 'real (cond (*SD:FMX*) (2000.0)))
                           (list "B" "Canh B - theo Y (mm)" 'real (cond (*SD:FMY*) (1600.0)))
                           (list "H" "Chieu cao mong (mm)" 'real (cond (*SD:FMH*) (500.0)))
                           (list "hv" "Chieu cao phan vat (mm, 0 = mong hop)" 'real0 (cond (*SD:FMHV*) (0.0)))
                           (list "vkv" "Tinh van khuon mat vat" 'tog nil)
                           (list "bc" "Cot - canh theo X (mm)" 'real 400.0)
                           (list "hc" "Cot - canh theo Y (mm)" 'real 400.0)
                           (list "lot" "Be tong lot day (mm, 0 = khong)" 'real0 100.0)
                           (list "c" "Lop bao ve day mong (mm)" 'real 50.0)
                           (list "dx" "Thep day phuong X - duong kinh (mm)" 'real 14.0)
                           (list "ax" "Thep day phuong X - buoc (mm)" 'real 150.0)
                           (list "dy" "Thep day phuong Y - duong kinh (mm)" 'real 14.0)
                           (list "ay" "Thep day phuong Y - buoc (mm)" 'real 150.0)
                           (list "moc" "Thep day uon moc len 2 dau (10d)" 'tog t)
                           (list "cot" "Thep cho cot (vd 8d18; trong = khong)" 'str "8d18")
                           (list "dsc" "Dai cot trong mong (vd 3d8; trong = khong)" 'str "3d8"))
                     (sd:kt-fields))))
    (exit))
  (setq name (sd:v "name") A (sd:v "A") B (sd:v "B") H (sd:v "H") bc (sd:v "bc") hc (sd:v "hc") lot (sd:v "lot")
        c (sd:v "c") dx (sd:v "dx") ax (sd:v "ax") dy (sd:v "dy") ay (sd:v "ay") moc (sd:v "moc")
        cot (sd:opt-bar (sd:v "cot")) dsc (sd:opt-bar (sd:v "dsc"))
        k (sd:v "k") sc (float (sd:v "sc")) tm (sd:v "tm")
        *SD:FMN* name *SD:FMX* A *SD:FMY* B *SD:FMH* H
        hv (min (sd:v "hv") (- H c c)) *SD:FMHV* hv h1 (- H hv) a2 (+ bc 100.0) b2 (+ hc 100.0))
  (cond
    ((or (null cot) (null dsc)) (princ "\n[SD] Thep cho / dai cot sai dinh dang (vd 8d18)."))
    ((or (>= bc A) (>= hc B) (<= H (* 2 c))) (princ "\n[SD] Kich thuoc mong / cot khong hop le."))
    ((setq o (sd:getpt "\nDiem chen mat bang (goc trai duoi mong): " nil))
     (sd:kt-begin (sd:v "mk") name)
     (setq o (sd:w o)
           oa (sd:p+ o (+ A (* 40 sc)) 0) ob (sd:p+ oa (+ A (* 40 sc)) 0)
           hkx (if moc (min (- h1 c c) (sd:ceil (max (* 10 dx) 100.0) 10.0)) 0.0)
           hky (if moc (min (- h1 c c) (sd:ceil (max (* 10 dy) 100.0) 10.0)) 0.0)
           yb (+ c dx dy))
     ;; ---- mat bang
     (sd:rect o A B "SD-BETONG")
     (sd:rect (sd:p+ o (/ (- A bc) 2.0) (/ (- B hc) 2.0)) bc hc "SD-BETONG")
     ;; mong vat: mat tren a2 x b2 (go 50 quanh cot) + 4 duong mep vat
     (if (> hv 0)
       (progn
         (sd:rect (sd:p+ o (/ (- A a2) 2.0) (/ (- B b2) 2.0)) a2 b2 "SD-BETONG")
         (foreach q (list (list 0.0 0.0 -1 -1) (list A 0.0 1 -1) (list A B 1 1) (list 0.0 B -1 1))
           (sd:line (sd:p+ o (car q) (cadr q)) (sd:p+ o (+ (/ A 2.0) (* (caddr q) (/ a2 2.0))) (+ (/ B 2.0) (* (cadddr q) (/ b2 2.0))))
                    "SD-BETONG"))))
     (if (> lot 0) (sd:rect (sd:p+ o -100 -100) (+ A 200) (+ B 200) "SD-KHUAT"))
     (setq y (+ c (/ dx 2.0)))
     (while (<= y (- B c -1)) (sd:line (sd:p+ o c y) (sd:p+ o (- A c) y) "SD-THEP-DAI") (setq y (+ y ax)))
     (setq x (+ c (/ dy 2.0)))
     (while (<= x (- A c -1)) (sd:line (sd:p+ o x c) (sd:p+ o x (- B c)) "SD-THEP-DAI") (setq x (+ x ay)))
     (sd:use-dimstyle sc)
     (sd:dim o (sd:p+ o A 0) "H" (sd:p+ o 0 (* -10 sc)))
     (sd:dim o (sd:p+ o 0 B) "V" (sd:p+ o (* -10 sc) 0))
     (sd:kt-cutmark (sd:p+ o -150 (/ B 2.0)) pi "A" sc)
     (sd:kt-cutmark (sd:p+ o (+ A 150) (/ B 2.0)) 0.0 "A" sc)
     (sd:kt-cutmark (sd:p+ o (/ A 2.0) -150) (* 1.5 pi) "B" sc)
     (sd:kt-cutmark (sd:p+ o (/ A 2.0) (+ B 150)) (/ pi 2) "B" sc)
     ;; be tong: phan hop A.B.h1 + phan vat (lang tru cut, cong thuc prismoid); van khuon thanh dung (+ mat vat)
     (setq v (/ (+ (* A B h1) (* (/ hv 6.0) (+ (* A B) (* a2 b2) (* 4.0 (/ (+ A a2) 2.0) (/ (+ B b2) 2.0))))) 1e9)
           s (/ (+ (* 2.0 (+ A B) h1)
                   (if (and (> hv 0) (sd:v "vkv"))
                     (+ (* (+ A a2) (sqrt (+ (* hv hv) (expt (/ (- B b2) 2.0) 2))))
                        (* (+ B b2) (sqrt (+ (* hv hv) (expt (/ (- A a2) 2.0) 2)))))
                     0.0))
                1e6))
     (sd:ck-title (sd:p+ o (/ A 2.0) (* -22 sc)) (strcat "M\\U+1EB6T B\\U+1EB0NG M\\U+00D3NG " name " (" (sd:num A) "\\U+00D7" (sd:num B) "\\U+00D7" (sd:num H)
                                                          (if (> hv 0) (strcat ", v\\U+00E1t " (sd:num hv)) "") ")")
                  sc name "Mong" k v s (strcat (sd:num A) "x" (sd:num B) "x" (sd:num H) (if (> hv 0) (strcat " vat " (sd:num hv)) "")))
     (if (> lot 0)
       (sd:ck-title (sd:p+ o (/ A 2.0) (* -28 sc)) (strcat "B\\U+00EA t\\U+00F4ng l\\U+00F3t d\\U+00E0y " (sd:num lot))
                    sc (strcat name "-LOT") "Be tong lot" k (/ (* (+ A 200) (+ B 200) lot) 1e9) 0.0
                    (strcat (sd:num (+ A 200)) "x" (sd:num (+ B 200)) "x" (sd:num lot))))
     ;; ---- mat cat A-A (doc theo X) va B-B (doc theo Y)
     (setq lap (if (listp cot) (sd:lap (cadr cot)) 0.0))
     (foreach sec (list (list oa A bc "A-A" dx ax hkx dy ay (list (* 0.35 A) (+ c (/ dx 2.0)) (* 0.35 A) (- B c (/ dx 2.0))))
                        (list ob B hc "B-B" dy ay hky dx ax (list (+ c (/ dy 2.0)) (* 0.35 B) (- A c (/ dy 2.0)) (* 0.35 B))))
       (setq e (car sec) x (cadr sec))
       ;; be tong: mong, lot, co cot
       (if (> hv 0)
         (sd:pline (mapcar '(lambda (p) (sd:p+ e (car p) (cadr p)))
                           (list (list 0.0 0.0) (list x 0.0) (list x h1) (list (/ (+ x (caddr sec) 100.0) 2.0) H)
                                 (list (/ (- x (caddr sec) 100.0) 2.0) H) (list 0.0 h1)))
                   t "SD-BETONG")
         (sd:rect e x H "SD-BETONG"))
       (if (> lot 0) (sd:rect (sd:p+ e -100 (- lot)) (+ x 200) lot "SD-BETONG"))
       ;; thanh chinh cua mat cat (thong minh, rai theo duong phan bo tren mat bang)
       (setq yt (if (= (cadddr sec) "A-A") (+ c (/ dx 2.0)) (+ c dx (/ dy 2.0))))
       (sd:kt-bar e (if moc
                      (list (list c (+ yt (nth 6 sec))) (list c yt) (list (- x c) yt) (list (- x c) (+ yt (nth 6 sec))))
                      (list (list c yt) (list (- x c) yt)))
                  0 (nth 4 sec) (list (* 0.25 x) yt) (list (+ (* 0.25 x) (* 4 sc)) (+ H (* 8 sc))) k tm sc
                  (list (mapcar '- (list (car (nth 9 sec)) (cadr (nth 9 sec))) (list (car (mapcar '- e o)) (cadr (mapcar '- e o))))
                        (mapcar '- (list (caddr (nth 9 sec)) (cadddr (nth 9 sec))) (list (car (mapcar '- e o)) (cadr (mapcar '- e o)))))
                  (nth 5 sec))
       ;; thanh phuong kia: cham
       (setq y (if (= (cadddr sec) "A-A") (+ c dx (/ dy 2.0)) (+ c (/ dx 2.0))) xs (+ c (/ (nth 7 sec) 2.0)))
       (while (<= xs (- x c -1)) (sd:dot (sd:p+ e xs y) (nth 7 sec) "SD-THEP-CHU") (setq xs (+ xs (nth 8 sec))))
       ;; co cot: thep cho + dai cot trong mong
       (sd:kt-colstub e x (caddr sec) H yb (+ c 50.0) lap cot dsc bc hc (= (cadddr sec) "A-A") k tm sc)
       ;; kich thuoc + ten mat cat
       (sd:dim e (sd:p+ e x 0) "H" (sd:p+ e 0 (- (+ lot (* 8 sc)))))
       (sd:dim (sd:p+ e x 0) (sd:p+ e x H) "V" (sd:p+ e (+ x (* 8 sc)) 0))
       (if (> hv 0) (sd:dim e (sd:p+ e 0 h1) "V" (sd:p+ e (* -8 sc) 0)))
       (sd:text (sd:p+ e (/ x 2.0) (- (+ lot (* 20 sc)))) (strcat "M\\U+1EB6T C\\U+1EAET " (cadddr sec)) (* 3.5 sc) "MC" "SD-CHU"))
     (sd:use-dimstyle *SD:SCALE*)
     (sd:kt-end)))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDMONGBANG - Khai trien mong bang (tiet dien chu T nguoc): ban mong co vat + suon (dam mong)
;;;  Mat bang doan mong + mat cat ngang. Thep ngang ban (chiu luc, moc 10d) rai doc mong theo duong phan bo;
;;;  thep doc ban (phan bo), thep suon tren / duoi, dai suon.
;;; --------------------------------------------------------------------------
(defun c:SDMONGBANG (/ name L B hb hv bs hs lot c dn an dd ad st sb ds as k sc tm o e x y hk yb ytop sec ar v s
                       xl xr nd ns n)
  (sd:begin)
  (if (not (sd:dlg "Khai trien mong bang (SDMONGBANG)"
                   (append
                     (list (list "name" "Ten mong bang" 'str (cond (*SD:MBN*) ("MB1")))
                           (list "L" "Chieu dai doan mong (mm)" 'real (cond (*SD:MBL*) (6000.0)))
                           (list "B" "Be rong ban mong (mm)" 'real (cond (*SD:MBB*) (1400.0)))
                           (list "hb" "Chieu day ban tai mep (mm)" 'real 300.0)
                           (list "hv" "Chieu cao phan vat ban (mm, 0 = khong)" 'real0 150.0)
                           (list "bs" "Be rong suon / dam mong (mm)" 'real 400.0)
                           (list "hs" "Chieu cao suon tu day mong (mm, 0 = khong suon)" 'real0 900.0)
                           (list "lot" "Be tong lot day (mm, 0 = khong)" 'real0 100.0)
                           (list "c" "Lop bao ve (mm)" 'real 50.0)
                           (list "dn" "Thep ngang ban (chiu luc) - d (mm)" 'real 14.0)
                           (list "an" "Thep ngang ban - buoc (mm)" 'real 150.0)
                           (list "dd" "Thep doc ban (phan bo) - d (mm)" 'real 10.0)
                           (list "ad" "Thep doc ban - buoc (mm)" 'real 200.0)
                           (list "st" "Thep suon tren (vd 4d20; trong = khong)" 'str "4d20")
                           (list "sb" "Thep suon duoi (vd 4d20; trong = khong)" 'str "4d20")
                           (list "ds" "Dai suon - d (mm)" 'real 8.0)
                           (list "as" "Dai suon - buoc (mm)" 'real 200.0)
                           (list "vkv" "Tinh van khuon mat vat" 'tog nil))
                     (sd:kt-fields))))
    (exit))
  (setq name (sd:v "name") L (sd:v "L") B (sd:v "B") hb (sd:v "hb") hv (sd:v "hv") bs (sd:v "bs") hs (sd:v "hs")
        lot (sd:v "lot") c (sd:v "c") dn (sd:v "dn") an (sd:v "an") dd (sd:v "dd") ad (sd:v "ad")
        st (sd:opt-bar (sd:v "st")) sb (sd:opt-bar (sd:v "sb")) ds (sd:v "ds") as (sd:v "as")
        k (sd:v "k") sc (float (sd:v "sc")) tm (sd:v "tm")
        *SD:MBN* name *SD:MBL* L *SD:MBB* B)
  (cond
    ((or (null st) (null sb)) (princ "\n[SD] Thep suon sai dinh dang (vd 4d20)."))
    ((or (>= bs B) (<= hb (* 2 c)) (and (> hs 0) (< hs (+ hb hv 100)))) (princ "\n[SD] Kich thuoc mong bang khong hop le."))
    ((setq o (sd:getpt "\nDiem chen mat bang (goc trai duoi doan mong): " nil))
     (sd:kt-begin (sd:v "mk") name)
     (setq o (sd:w o) e (sd:p+ o (+ L (* 40 sc)) 0)
           ytop (if (> hs 0) hs (+ hb hv)) xl (/ (- B bs) 2.0) xr (/ (+ B bs) 2.0)
           hk (min (- hb c c) (sd:ceil (max (* 10 dn) 100.0) 10.0))
           sec (list (list 0.0 0.0) (list B 0.0) (list B hb) (list xr (+ hb hv)) (list xr ytop) (list xl ytop) (list xl (+ hb hv)) (list 0.0 hb))
           ar (sd:poly-area sec)
           yb (+ c dn dd))
     ;; ---- mat bang: ban, suon (net khuat), luoi thep
     (sd:rect o L B "SD-BETONG")
     (sd:line (sd:p+ o 0 xl) (sd:p+ o L xl) "SD-KHUAT")
     (sd:line (sd:p+ o 0 xr) (sd:p+ o L xr) "SD-KHUAT")
     (if (> lot 0) (sd:rect (sd:p+ o 0 -100) L (+ B 200) "SD-KHUAT"))
     (setq x (+ c (/ dn 2.0)))
     (while (<= x (- L c -1)) (sd:line (sd:p+ o x c) (sd:p+ o x (- B c)) "SD-THEP-DAI") (setq x (+ x an)))
     ;; thep doc ban: 1 thanh dai dien (so thanh = so cham tren mat cat)
     (setq nd (1+ (fix (/ (- B c c dd) ad))))
     (sd:kt-bar o (list (list c (+ c dn (/ dd 2.0))) (list (- L c) (+ c dn (/ dd 2.0)))) nd dd
                (list (* 0.6 L) (+ c dn (/ dd 2.0))) (list (+ (* 0.6 L) (* 4 sc)) (* -8 sc)) k tm sc nil 0.0)
     ;; thep suon tren / duoi (doc mong)
     (if (and (> hs 0) (listp st))
       (sd:kt-bar o (list (list c (+ xl c ds (/ (cadr st) 2.0))) (list (- L c) (+ xl c ds (/ (cadr st) 2.0)))) (car st) (cadr st)
                  (list (* 0.75 L) (+ xl c ds)) (list (+ (* 0.75 L) (* 4 sc)) (+ B (* 6 sc))) k tm sc nil 0.0))
     (if (and (> hs 0) (listp sb))
       (sd:kt-bar o (list (list c (- xr c ds (/ (cadr sb) 2.0))) (list (- L c) (- xr c ds (/ (cadr sb) 2.0)))) (car sb) (cadr sb)
                  (list (* 0.45 L) (- xr c ds)) (list (+ (* 0.45 L) (* 4 sc)) (+ B (* 12 sc))) k tm sc nil 0.0))
     (sd:use-dimstyle sc)
     (sd:dim o (sd:p+ o L 0) "H" (sd:p+ o 0 (- (+ 100 (* 16 sc)))))
     (sd:dim o (sd:p+ o 0 B) "V" (sd:p+ o (* -10 sc) 0))
     (sd:kt-cutmark (sd:p+ o (* 0.2 L) -150) (* 1.5 pi) "A" sc)
     (sd:kt-cutmark (sd:p+ o (* 0.2 L) (+ B 150)) (/ pi 2) "A" sc)
     ;; ---- khoi luong: mat cat x L; van khuon 2 thanh ban + 2 thanh suon + 2 dau doan (+ mat vat)
     (setq v (/ (* ar L) 1e9)
           s (/ (+ (* 2.0 L (+ hb (if (> hs 0) (- hs hb hv) 0.0))) (* 2.0 ar)
                   (if (and (> hv 0) (sd:v "vkv")) (* 2.0 L (sqrt (+ (* hv hv) (* xl xl)))) 0.0))
                1e6))
     (sd:ck-title (sd:p+ o (/ L 2.0) (- (+ 100 (* 28 sc))))
                  (strcat "M\\U+1EB6T B\\U+1EB0NG M\\U+00D3NG B\\U+0102NG " name " (L=" (sd:num L) ", B=" (sd:num B) ")")
                  sc name "Mong" k v s (strcat "bang L=" (sd:num L) ", B=" (sd:num B) ", h=" (sd:num ytop)))
     (if (> lot 0)
       (sd:ck-title (sd:p+ o (/ L 2.0) (- (+ 100 (* 34 sc)))) (strcat "B\\U+00EA t\\U+00F4ng l\\U+00F3t d\\U+00E0y " (sd:num lot))
                    sc (strcat name "-LOT") "Be tong lot" k (/ (* L (+ B 200) lot) 1e9) 0.0
                    (strcat (sd:num L) "x" (sd:num (+ B 200)) "x" (sd:num lot))))
     ;; ---- mat cat A-A
     (sd:pline (mapcar '(lambda (p) (sd:p+ e (car p) (cadr p))) sec) t "SD-BETONG")
     (if (> lot 0) (sd:rect (sd:p+ e -100 (- lot)) (+ B 200) lot "SD-BETONG"))
     ;; thep ngang ban (thong minh, rai doc mong theo duong phan bo tren mat bang)
     (setq y (+ c (/ dn 2.0)))
     (sd:kt-bar e (list (list c (+ y hk)) (list c y) (list (- B c) y) (list (- B c) (+ y hk))) 0 dn
                (list (* 0.2 B) y) (list (+ (* 0.2 B) (* 4 sc)) (+ ytop (* 8 sc))) k tm sc
                (list (list (- (+ c (/ dn 2.0)) (+ L (* 40 sc))) (* 0.85 B)) (list (- (- L c (/ dn 2.0)) (+ L (* 40 sc))) (* 0.85 B)))
                an)
     ;; thep doc ban: cham
     (setq x (+ c (/ dd 2.0)))
     (while (<= x (- B c -1)) (sd:dot (sd:p+ e x (+ c dn (/ dd 2.0))) dd "SD-THEP-CHU") (setq x (+ x ad)))
     ;; suon: dai + thep tren / duoi
     (if (> hs 0)
       (progn
         (sd:plinew (list (sd:p+ e (+ xl c) (+ c dn)) (sd:p+ e (- xr c) (+ c dn)) (sd:p+ e (- xr c) (- hs c)) (sd:p+ e (+ xl c) (- hs c)))
                    t ds "SD-THEP-DAI")
         (if (listp st) (sd:barrow (sd:p+ e xl 0) bs c ds (car st) (cadr st) (- hs c ds (/ (cadr st) 2.0))))
         (if (listp sb) (sd:barrow (sd:p+ e xl 0) bs c ds (car sb) (cadr sb) (+ yb (/ (cadr sb) 2.0))))
         ;; duong phan bo dai suon tren mat bang (50 .. L-50): keo dai doan mong -> so dai tu tinh lai
         (sd:kt-dist e (list (- xr c) (/ (+ hs hb) 2.0)) (list (+ B (* 4 sc)) (/ (+ hs hb) 2.0)) ds "Dai"
                     (list (- bs c c) (- hs c c dn)) k sc tm 1 as nil
                     (list (sd:kt-dline (sd:p+ o 50.0 (/ B 2.0)) (sd:p+ o (- L 50.0) (/ B 2.0)) sc)))))
     (sd:dim e (sd:p+ e B 0) "H" (sd:p+ e 0 (- (+ lot (* 8 sc)))))
     (sd:dim (sd:p+ e B 0) (sd:p+ e B hb) "V" (sd:p+ e (+ B (* 8 sc)) 0))
     (sd:dim e (sd:p+ e 0 ytop) "V" (sd:p+ e (* -8 sc) 0))
     (if (> hs 0) (sd:dim (sd:p+ e xl ytop) (sd:p+ e xr ytop) "H" (sd:p+ e 0 (+ ytop (* 4 sc)))))
     (sd:text (sd:p+ e (/ B 2.0) (- (+ lot (* 20 sc)))) "M\\U+1EB6T C\\U+1EAET A-A" (* 3.5 sc) "MC" "SD-CHU")
     (sd:use-dimstyle *SD:SCALE*)
     (sd:kt-end)))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDDAICOC - Khai trien dai coc: mat bang (luoi coc, luoi thep) + mat cat A-A, B-B
;;;  Luoi day dat tren dau coc (doan coc ngam + lop bao ve), moc len 10d hoac het chieu cao;
;;;  luoi tren tuy chon; thep cho + dai cot dung chung voi mong don.
;;; --------------------------------------------------------------------------
(defun c:SDDAICOC (/ name A B H bc hc nx ny sx sy dc tron hn lot c dx ax dy ay moc trn dt at cot dsc k sc tm o oa ob
                     xs ys x y e sec hkx hky y0 yb lap v s np)
  (sd:begin)
  (if (not (sd:dlg "Khai trien dai coc (SDDAICOC)"
                   (append
                     (list (list "name" "Ten dai coc" 'str (cond (*SD:DCN*) ("DC1")))
                           (list "A" "Canh A - theo X (mm)" 'real (cond (*SD:DCA*) (2000.0)))
                           (list "B" "Canh B - theo Y (mm)" 'real (cond (*SD:DCB*) (2000.0)))
                           (list "H" "Chieu cao dai (mm)" 'real (cond (*SD:DCH*) (1000.0)))
                           (list "bc" "Cot - canh theo X (mm)" 'real 400.0)
                           (list "hc" "Cot - canh theo Y (mm)" 'real 400.0)
                           (list "nx" "So coc theo X" 'int 2)
                           (list "ny" "So coc theo Y" 'int 2)
                           (list "sx" "Khoang cach coc theo X (mm)" 'real 1200.0)
                           (list "sy" "Khoang cach coc theo Y (mm)" 'real 1200.0)
                           (list "dc" "Canh / duong kinh coc (mm)" 'real 300.0)
                           (list "hinh" "Tiet dien coc" 'kw "Vuong" '(("Vuong" . "Vuong") ("Tron" . "Tron")))
                           (list "hn" "Doan coc ngam vao dai (mm)" 'real0 100.0)
                           (list "tru" "Tru the tich dau coc ngam khoi be tong dai" 'tog t)
                           (list "lot" "Be tong lot day (mm, 0 = khong)" 'real0 100.0)
                           (list "c" "Lop bao ve (tren dau coc / mat tren) (mm)" 'real 50.0)
                           (list "dx" "Luoi day phuong X - d (mm)" 'real 16.0)
                           (list "ax" "Luoi day phuong X - buoc (mm)" 'real 150.0)
                           (list "dy" "Luoi day phuong Y - d (mm)" 'real 16.0)
                           (list "ay" "Luoi day phuong Y - buoc (mm)" 'real 150.0)
                           (list "moc" "Luoi day uon len" 'kw "10d" '(("10d" . "Moc 10d") ("Het" . "Het chieu cao dai")))
                           (list "trn" "Co luoi thep tren" 'tog nil)
                           (list "dt" "Luoi tren - d (mm)" 'real 12.0)
                           (list "at" "Luoi tren - buoc (mm)" 'real 200.0)
                           (list "cot" "Thep cho cot (vd 8d18; trong = khong)" 'str "8d18")
                           (list "dsc" "Dai cot trong dai (vd 3d8; trong = khong)" 'str "3d8"))
                     (sd:kt-fields))))
    (exit))
  (setq name (sd:v "name") A (sd:v "A") B (sd:v "B") H (sd:v "H") bc (sd:v "bc") hc (sd:v "hc")
        nx (max 1 (sd:v "nx")) ny (max 1 (sd:v "ny")) sx (sd:v "sx") sy (sd:v "sy") dc (sd:v "dc")
        tron (= (sd:v "hinh") "Tron") hn (sd:v "hn") lot (sd:v "lot") c (sd:v "c")
        dx (sd:v "dx") ax (sd:v "ax") dy (sd:v "dy") ay (sd:v "ay") moc (sd:v "moc") trn (sd:v "trn")
        dt (sd:v "dt") at (sd:v "at") cot (sd:opt-bar (sd:v "cot")) dsc (sd:opt-bar (sd:v "dsc"))
        k (sd:v "k") sc (float (sd:v "sc")) tm (sd:v "tm")
        *SD:DCN* name *SD:DCA* A *SD:DCB* B *SD:DCH* H)
  ;; vi tri tim coc (doi xung quanh tam dai)
  (setq xs (mapcar '(lambda (i) (+ (/ A 2.0) (* (- i (/ (1- nx) 2.0)) sx))) (sd:range 0 (1- nx)))
        ys (mapcar '(lambda (i) (+ (/ B 2.0) (* (- i (/ (1- ny) 2.0)) sy))) (sd:range 0 (1- ny))))
  (cond
    ((or (null cot) (null dsc)) (princ "\n[SD] Thep cho / dai cot sai dinh dang (vd 8d18)."))
    ((or (< (- (car xs) (/ dc 2.0)) 0) (< (- (car ys) (/ dc 2.0)) 0) (>= (+ hn c c dx dy) H))
     (princ "\n[SD] Luoi coc vuot ra ngoai dai hoac dai qua thap."))
    ((setq o (sd:getpt "\nDiem chen mat bang (goc trai duoi dai): " nil))
     (sd:kt-begin (sd:v "mk") name)
     (setq o (sd:w o) oa (sd:p+ o (+ A (* 40 sc)) 0) ob (sd:p+ oa (+ A (* 40 sc)) 0)
           y0 (+ hn c) yb (+ y0 dx dy) np (* nx ny)
           hkx (if (= moc "Het") (- H y0 c (/ dx 2.0)) (min (- H y0 c) (sd:ceil (max (* 10 dx) 100.0) 10.0)))
           hky (if (= moc "Het") (- H y0 dx c (/ dy 2.0)) (min (- H y0 c) (sd:ceil (max (* 10 dy) 100.0) 10.0)))
           lap (if (listp cot) (sd:lap (cadr cot)) 0.0))
     ;; ---- mat bang
     (sd:rect o A B "SD-BETONG")
     (sd:rect (sd:p+ o (/ (- A bc) 2.0) (/ (- B hc) 2.0)) bc hc "SD-BETONG")
     (if (> lot 0) (sd:rect (sd:p+ o -100 -100) (+ A 200) (+ B 200) "SD-KHUAT"))
     (foreach px xs
       (foreach py ys
         (if tron
           (sd:circle (sd:p+ o px py) (/ dc 2.0) "SD-KHUAT")
           (sd:rect (sd:p+ o (- px (/ dc 2.0)) (- py (/ dc 2.0))) dc dc "SD-KHUAT"))
         (sd:line (sd:p+ o (- px 100) py) (sd:p+ o (+ px 100) py) "SD-TRUC")
         (sd:line (sd:p+ o px (- py 100)) (sd:p+ o px (+ py 100)) "SD-TRUC")))
     (setq y (+ c (/ dx 2.0)))
     (while (<= y (- B c -1)) (sd:line (sd:p+ o c y) (sd:p+ o (- A c) y) "SD-THEP-DAI") (setq y (+ y ax)))
     (setq x (+ c (/ dy 2.0)))
     (while (<= x (- A c -1)) (sd:line (sd:p+ o x c) (sd:p+ o x (- B c)) "SD-THEP-DAI") (setq x (+ x ay)))
     (sd:use-dimstyle sc)
     (sd:dim o (sd:p+ o A 0) "H" (sd:p+ o 0 (* -10 sc)))
     (sd:dim o (sd:p+ o 0 B) "V" (sd:p+ o (* -10 sc) 0))
     (if (> nx 1) (sd:dimchain (mapcar '(lambda (px) (sd:p+ o px 0)) (append (list 0.0) xs (list A))) "H" (sd:p+ o 0 (* -5 sc))))
     (if (> ny 1) (sd:dimchain (mapcar '(lambda (py) (sd:p+ o 0 py)) (append (list 0.0) ys (list B))) "V" (sd:p+ o (* -5 sc) 0)))
     (sd:kt-cutmark (sd:p+ o -150 (car ys)) pi "A" sc)
     (sd:kt-cutmark (sd:p+ o (+ A 150) (car ys)) 0.0 "A" sc)
     (sd:kt-cutmark (sd:p+ o (car xs) -150) (* 1.5 pi) "B" sc)
     (sd:kt-cutmark (sd:p+ o (car xs) (+ B 150)) (/ pi 2) "B" sc)
     ;; ---- khoi luong
     (setq v (/ (- (* A B H) (if (sd:v "tru") (* np hn (if tron (* pi 0.25 dc dc) (* dc dc))) 0.0)) 1e9)
           s (/ (* 2.0 (+ A B) H) 1e6))
     (sd:ck-title (sd:p+ o (/ A 2.0) (* -22 sc))
                  (strcat "M\\U+1EB6T B\\U+1EB0NG \\U+0110\\U+00C0I C\\U+1ECCC " name " (" (sd:num A) "\\U+00D7" (sd:num B) "\\U+00D7" (sd:num H) ", " (itoa np) " c\\U+1ECDc)")
                  sc name "Mong" k v s (strcat "dai " (sd:num A) "x" (sd:num B) "x" (sd:num H) ", " (itoa np) " coc"
                                               (if (sd:v "tru") " (tru dau coc)" "")))
     (if (> lot 0)
       (sd:ck-title (sd:p+ o (/ A 2.0) (* -28 sc)) (strcat "B\\U+00EA t\\U+00F4ng l\\U+00F3t d\\U+00E0y " (sd:num lot))
                    sc (strcat name "-LOT") "Be tong lot" k (/ (* (+ A 200) (+ B 200) lot) 1e9) 0.0
                    (strcat (sd:num (+ A 200)) "x" (sd:num (+ B 200)) "x" (sd:num lot))))
     ;; ---- mat cat A-A (doc X, qua hang coc dau) va B-B (doc Y)
     (foreach sec (list (list oa A bc "A-A" dx ax hkx dy ay xs (list (* 0.5 A) (+ c (/ dx 2.0)) (* 0.5 A) (- B c (/ dx 2.0))) y0)
                        (list ob B hc "B-B" dy ay hky dx ax ys (list (+ c (/ dy 2.0)) (* 0.5 B) (- A c (/ dy 2.0)) (* 0.5 B)) (+ y0 dx)))
       (setq e (car sec) x (cadr sec))
       (sd:rect e x H "SD-BETONG")
       (if (> lot 0) (sd:rect (sd:p+ e -100 (- lot)) (+ x 200) lot "SD-BETONG"))
       ;; coc: ngam hn vao dai, cat net duoi day
       (foreach p (nth 9 sec)
         (sd:line (sd:p+ e (- p (/ dc 2.0)) hn) (sd:p+ e (- p (/ dc 2.0)) (- (+ lot 600))) "SD-BETONG")
         (sd:line (sd:p+ e (+ p (/ dc 2.0)) hn) (sd:p+ e (+ p (/ dc 2.0)) (- (+ lot 600))) "SD-BETONG")
         (sd:line (sd:p+ e (- p (/ dc 2.0)) hn) (sd:p+ e (+ p (/ dc 2.0)) hn) "SD-BETONG")
         (sd:zig e (- p (/ dc 2.0)) (+ p (/ dc 2.0)) (- (+ lot 600)) sc))
       ;; luoi day (thong minh, rai theo duong phan bo tren mat bang)
       (setq y (+ (nth 11 sec) (/ (nth 4 sec) 2.0)))
       (sd:kt-bar e (list (list c (+ y (nth 6 sec))) (list c y) (list (- x c) y) (list (- x c) (+ y (nth 6 sec)))) 0 (nth 4 sec)
                  (list (* 0.3 x) y) (list (+ (* 0.3 x) (* 4 sc)) (+ H (* 8 sc))) k tm sc
                  (list (mapcar '- (list (car (nth 10 sec)) (cadr (nth 10 sec))) (list (car (mapcar '- e o)) (cadr (mapcar '- e o))))
                        (mapcar '- (list (caddr (nth 10 sec)) (cadddr (nth 10 sec))) (list (car (mapcar '- e o)) (cadr (mapcar '- e o)))))
                  (nth 5 sec))
       ;; luoi day phuong kia: cham
       (setq y (if (= (cadddr sec) "A-A") (+ y0 dx (/ dy 2.0)) (+ y0 (/ dx 2.0))) x (+ c (/ (nth 7 sec) 2.0)))
       (while (<= x (- (cadr sec) c -1)) (sd:dot (sd:p+ e x y) (nth 7 sec) "SD-THEP-CHU") (setq x (+ x (nth 8 sec))))
       (setq x (cadr sec))
       ;; luoi tren: thanh thang (thong minh, so thanh co dinh theo be rong)
       (if trn
         (sd:kt-bar e (list (list c (- H c (/ dt 2.0))) (list (- x c) (- H c (/ dt 2.0))))
                    (1+ (fix (/ (- (if (= (cadddr sec) "A-A") B A) c c) at))) dt
                    (list (* 0.75 x) (- H c (/ dt 2.0))) (list (+ (* 0.75 x) (* 4 sc)) (+ H (* 14 sc))) k tm sc nil 0.0))
       ;; co cot: thep cho dat tren luoi day + dai
       (sd:kt-colstub e x (caddr sec) H yb (+ yb 50.0) lap cot dsc bc hc (= (cadddr sec) "A-A") k tm sc)
       (sd:dim e (sd:p+ e x 0) "H" (sd:p+ e 0 (- (+ lot 600 (* 8 sc)))))
       (sd:dim (sd:p+ e x 0) (sd:p+ e x H) "V" (sd:p+ e (+ x (* 8 sc)) 0))
       (sd:text (sd:p+ e (/ x 2.0) (- (+ lot 600 (* 20 sc)))) (strcat "M\\U+1EB6T C\\U+1EAET " (cadddr sec)) (* 3.5 sc) "MC" "SD-CHU"))
     (sd:use-dimstyle *SD:SCALE*)
     (sd:kt-end)))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDCOTTHEP - Khai trien thep cot 1 tang: mat dung + mat cat
;;;  Thep doc vuon len noi chong voi cot tang tren; dai day vung toi han max(b, h, Hn/6, 450)
;;;  o chan / dinh cot va trong nut dam, giua cot buoc thua.
;;; --------------------------------------------------------------------------
(defun c:SDCOTTHEP (/ name b h Hf hd c nb nh d noi ds a1 a2 k sc tm mc o hn lz x1 x2 yt lap y ys nst n so i g dl zs)
  (sd:begin)
  (if (not (sd:dlg "Khai trien thep cot (SDCOTTHEP)"
                   (append
                     (list (list "name" "Ten cot" 'str (cond (*SD:CNAME*) ("C1")))
                           (list "b" "Canh b - mat dung (mm)" 'real (cond (*SD:CB*) (300.0)))
                           (list "h" "Canh h - vuong goc (mm)" 'real (cond (*SD:CH*) (400.0)))
                           (list "Hf" "Chieu cao tang (san - san) (mm)" 'real (cond (*SD:CHF*) (3600.0)))
                           (list "hd" "Chieu cao dam tai dinh cot (mm)" 'real 500.0)
                           (list "c" "Lop bao ve (mm)" 'real 25.0)
                           (list "nb" "So thanh canh b (ke ca goc)" 'int 3)
                           (list "nh" "So thanh canh h (ke ca goc)" 'int 3)
                           (list "d" "Duong kinh thep doc (mm)" 'real 18.0)
                           (list "noi" "Thep vuon len noi chong voi cot tang tren" 'tog t)
                           (list "ds" "Duong kinh dai (mm)" 'real 8.0)
                           (list "a1" "Buoc dai vung toi han / nut (mm)" 'real 100.0)
                           (list "a2" "Buoc dai giua cot (mm)" 'real 200.0)
                           (list "vtc" "Vi tri cot (van khuon nut dam)" 'kw "Giua"
                                 '(("Giua" . "Cot giua - dam 4 phia") ("Bien" . "Cot bien - dam 3 phia") ("Goc" . "Cot goc - dam 2 phia")))
                           (list "mc" "Ve mat cat cot" 'tog t))
                     (sd:tie-fields)
                     (sd:kt-fields))))
    (exit))
  (setq name (sd:v "name") b (sd:v "b") h (sd:v "h") Hf (sd:v "Hf") hd (sd:v "hd") c (sd:v "c")
        nb (max 2 (sd:v "nb")) nh (max 2 (sd:v "nh")) d (sd:v "d") noi (sd:v "noi") ds (sd:v "ds")
        a1 (sd:v "a1") a2 (sd:v "a2") k (sd:v "k") sc (float (sd:v "sc")) tm (sd:v "tm") mc (sd:v "mc")
        *SD:CNAME* name *SD:CB* b *SD:CH* h *SD:CHF* Hf)
  (cond
    ((<= (- Hf hd) (* 4 a1)) (princ "\n[SD] Chieu cao cot thong thuy qua nho."))
    ((setq o (sd:getpt "\nDiem chen mat dung (chan cot, mep trai, cao do san): " nil))
     (sd:kt-begin (sd:v "mk") name)
     (setq o (sd:w o) hn (- Hf hd) lz (sd:col-lz b h hn)
           lap (if noi (sd:lap d) 0.0) x1 (+ c ds (/ d 2.0)) x2 (- b x1)
           yt (if noi (+ Hf lap) (- Hf c)) n (+ (* 2 nb) (* 2 (- nh 2))))
     ;; ---- be tong: cot duoi, san, cot, dam dinh, cot tren
     (sd:line (sd:p+ o 0 -500) (sd:p+ o 0 hn) "SD-BETONG")
     (sd:line (sd:p+ o b -500) (sd:p+ o b hn) "SD-BETONG")
     (sd:zig o 0 b -500 sc)
     (foreach y (list 0.0 -120.0)
       (sd:line (sd:p+ o -400 y) (sd:p+ o 0 y) "SD-BETONG")
       (sd:line (sd:p+ o b y) (sd:p+ o (+ b 400) y) "SD-BETONG"))
     (foreach y (list hn Hf)
       (sd:line (sd:p+ o -400 y) (sd:p+ o 0 y) "SD-BETONG")
       (sd:line (sd:p+ o b y) (sd:p+ o (+ b 400) y) "SD-BETONG"))
     (sd:line (sd:p+ o 0 Hf) (sd:p+ o 0 (+ yt 300)) "SD-BETONG")
     (sd:line (sd:p+ o b Hf) (sd:p+ o b (+ yt 300)) "SD-BETONG")
     (sd:zig o 0 b (+ yt 300) sc)
     ;; ---- thep doc tang duoi (vuon len noi) - chi the hien
     (sd:pline (list (sd:p+ o (+ x1 d) -500) (sd:p+ o (+ x1 d) lap)) nil "SD-THEP-CHU")
     (sd:pline (list (sd:p+ o (- x2 d) -500) (sd:p+ o (- x2 d) lap)) nil "SD-THEP-CHU")
     ;; ---- thep doc tang nay (thong minh) + thanh doi xung
     (sd:kt-bar o (list (list x1 0.0) (list x1 yt)) n d (list x1 (* 0.55 hn)) (list (* -30 sc) (* 0.6 hn)) k tm sc nil 0.0)
     (sd:pline (list (sd:p+ o x2 0) (sd:p+ o x2 yt)) nil "SD-THEP-CHU")
     ;; ---- dai: vung toi han chan / dinh, giua, nut dam
     (setq ys (sd:col-zone-ys hn hd c a1 a2 lz))
     (foreach y ys (sd:line (sd:p+ o c y) (sd:p+ o (- b c) y) "SD-THEP-DAI"))
     (setq nst (length ys)
           ;; duong phan bo dai = chieu cao thong thuy cot (STRETCH dinh / chan cot -> so dai theo vung tu tinh lai)
           dl (sd:kt-dline (sd:p+ o (/ b 2.0) 0) (sd:p+ o (/ b 2.0) hn) sc)
           zs (strcat (sd:nums->str (list hd c a1 a2 b h)) "|a" (sd:num a1) "/" (sd:num a2)))
     (sd:kt-dist o (list (- b c) (/ hn 2.0)) (list (+ b (* 6 sc)) (* 0.42 hn)) ds "Dai" (list (- b c c) (- h c c)) k sc tm
                 2 0.0 (strcat "COT|1," zs) (list dl))
     (foreach z (list (list (/ lz 2.0) a1) (list (/ hn 2.0) a2) (list (- hn (/ lz 2.0)) a1) (list (/ (+ hn Hf) 2.0) a1))
       (sd:text (sd:p+ o (+ b (* 3 sc)) (car z)) (strcat "%%c" (sd:num ds) "a" (sd:num (cadr z))) (* 2.0 sc) "ML" "SD-CHU"))
     ;; ---- kich thuoc
     (sd:use-dimstyle sc)
     (sd:dimchain (mapcar '(lambda (y) (sd:p+ o b y)) (list 0.0 lz (- hn lz) hn Hf)) "V" (sd:p+ o (+ b (* 24 sc)) 0))
     (sd:dim (sd:p+ o b 0) (sd:p+ o b Hf) "V" (sd:p+ o (+ b (* 32 sc)) 0))
     (if noi (sd:dim (sd:p+ o 0 Hf) (sd:p+ o 0 yt) "V" (sd:p+ o (* -10 sc) 0)))
     (sd:dim o (sd:p+ o b 0) "H" (sd:p+ o 0 (* -24 sc)))
     (sd:ck-title (sd:p+ o (/ b 2.0) (* -36 sc))
                  (strcat "M\\U+1EB6T \\U+0110\\U+1EE8NG TH\\U+00C9P C\\U+1ED8T " name " (" (sd:num b) "\\U+00D7" (sd:num h) ", H=" (sd:num Hf) ")")
                  ;; be tong: ca nut giao dam (b.h.H); van khuon: than cot den day dam + mat nut khong co dam
                  sc name "Cot" k (/ (* b h Hf) 1e9)
                  (/ (+ (* 2.0 (+ b h) hn) (cond ((= (sd:v "vtc") "Bien") (* b hd)) ((= (sd:v "vtc") "Goc") (* (+ b h) hd)) (0.0))) 1e6)
                  (strcat (sd:num b) "x" (sd:num h) "x" (sd:num Hf) " (gom nut dam)"
                          (cond ((= (sd:v "vtc") "Bien") ", VK nut 1 mat") ((= (sd:v "vtc") "Goc") ", VK nut 2 mat") (""))))
     ;; du lieu cho SDNOITHEP: chieu cao tang, dam dinh, thep doc (cot cung ten cac tang ghep thanh chong cot)
     (sd:noi-reg (entlast) (list "COT" name (float Hf) (float hd) n d c (if noi 1 0) k (cond (*SD:TANG*) (""))))
     ;; ---- mat cat
     (if mc
       (progn
         (setq so (sd:p+ o (+ b (* 50 sc)) (/ hn 2.0)))
         (sd:sec-common so b h c ds a2 sc (strcat "M\\U+1EB6T C\\U+1EAET " name))
         (setq x1 (+ c ds (/ d 2.0)))
         (sd:barrow so b c ds nb d x1)
         (sd:barrow so b c ds nb d (- h x1))
         (if (> nh 2)
           (progn (setq y 1)
                  (repeat (- nh 2)
                    (sd:dot (sd:p+ so x1 (+ x1 (* y (/ (- h x1 x1) (1- nh))))) d "SD-THEP-CHU")
                    (sd:dot (sd:p+ so (- b x1) (+ x1 (* y (/ (- h x1 x1) (1- nh))))) d "SD-THEP-CHU")
                    (setq y (1+ y)))))
         (sd:tagL (sd:p+ so x1 (- h x1)) (sd:p+ so (* -6 sc) (+ h (* 6 sc))) (strcat (itoa n) "%%c" (sd:num d)) sc)))
     ;; ---- dai phu / moc C: cung so lop voi dai chinh; ky hieu canh mat cat (hoac mat dung neu khong ve mat cat)
     (setq i 0)
     (foreach g (sd:col-ties (if mc so o) b h c ds nb nh d (sd:v "dp") (sd:v "lp") mc)
       (sd:kt-dist (if mc so o)
                   (if mc (nth 3 g) (list (/ b 2.0) (* 0.3 hn)))
                   (if mc (list (+ b (* 16 sc)) (- (* 0.3 h) (* i 7 sc))) (list (+ b (* 6 sc)) (- (* 0.3 hn) (* i 7 sc))))
                   ds (car g) (cadr g) k sc tm 2 0.0
                   (strcat "COT|" (itoa (nth 2 g)) "," zs (if (= (car g) "Mot") " moc C" " dai phu")) (list dl))
       (setq i (1+ i)))
     (sd:use-dimstyle *SD:SCALE*)
     (sd:kt-end)))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDSANTHEP - Khai trien thep o san (mat bang): thep lop duoi 2 phuong, thep mu 4 canh
;;;  Thanh dai dien ve tren mat bang (thep mu ve ca chan gap vao mat bang) + duong phan bo:
;;;  so thanh = chieu dai duong phan bo / a + 1, tu cap nhat khi co keo.
;;; --------------------------------------------------------------------------
(defun sd:san-mu (o edge typ L bw lt leg pos d a k tm sc / s f in out pts dist hint)
  ;; edge: "T" trai (x=0), "P" phai (x=L), "D" duoi (y=0), "N" tren (y=L); pos = vi tri doc canh
  (setq s (if (member edge '("T" "D")) 1.0 -1.0)            ; huong vao o san
        f (if (member edge '("T" "D")) 0.0 L)                ; toa do truc dam
        in (+ f (* s (+ (/ bw 2.0) lt)))
        out (if (= typ "Bien") (- f (* s (- (/ bw 2.0) 25.0))) (- f (* s (+ (/ bw 2.0) lt)))))
  (if (member edge '("T" "P"))
    (setq pts (list (list out (- pos leg)) (list out pos) (list in pos) (list in (- pos leg)))
          hint (list (/ (+ f in) 2.0) pos))
    (setq pts (list (list (- pos leg) out) (list pos out) (list pos in) (list (- pos leg) in))
          hint (list pos (/ (+ f in) 2.0))))
  (list pts hint (+ f (* s (+ (/ bw 2.0) (* 0.6 lt))))))

;; ---- Phat hien thep mu trung giua cac o san ke nhau
;; Moi o san luu XDATA "SD_SAN" tren tieu de: ten + moi canh "canh|huong|truc|a|b|trang thai|lt" (toa do WCS):
;;  huong V (canh T/P, truc x = const, khoang theo y) / H (canh D/N, truc y = const, khoang theo x);
;;  a..b = khoang thep mu da rai doc canh; trang thai Lientuc (vat qua dam sang o ben) / Bien / Khong.
(defun sd:san-recs (/ ss i xd nm r)
  (setq i 0)
  (if (setq ss (ssget "_X" '((0 . "TEXT") (-3 ("SD_SAN")))))
    (repeat (sslength ss)
      (setq xd (mapcar 'cdr (cdadr (assoc -3 (entget (ssname ss i) '("SD_SAN"))))) i (1+ i) nm (car xd))
      (foreach e (cdr xd)
        (setq e (sd:split e "|")
              r (cons (list (nth 0 e) (nth 1 e) (atof (nth 2 e)) (atof (nth 3 e)) (atof (nth 4 e)) (nth 5 e) (atof (nth 6 e)) nm) r)))))
  r)

;; Cac doan [lo hi] cua canh (huong dir, truc ax, khoang a..b) da co thep mu vat sang tu canh doi dien cua o ke ben
;; -> ((lo hi lt ten) ...)
(defun sd:san-cover (edge dir ax a b recs / opp r lo hi)
  (setq opp (cdr (assoc edge '(("T" . "P") ("P" . "T") ("D" . "N") ("N" . "D")))))
  (foreach q recs
    (if (and (= (car q) opp) (= (cadr q) dir) (equal (caddr q) ax 1.0) (= (nth 5 q) "Lientuc")
             (< (setq lo (max a (nth 3 q))) (setq hi (min b (nth 4 q)))))
      (setq r (cons (list lo hi (nth 6 q) (nth 7 q)) r))))
  r)

;; Doan con trong [a b] khong bi phu boi cov -> doan dai nhat (lo hi) hoac nil
(defun sd:iv-free (a b cov / x best)
  (setq x a cov (sd:sort cov '(lambda (p q) (< (car p) (car q)))))
  (foreach c cov
    (if (> (- (car c) x) (if best (- (cadr best) (car best)) 0.0)) (setq best (list x (car c))))
    (setq x (max x (cadr c))))
  (if (> (- b x) (if best (- (cadr best) (car best)) 0.0)) (setq best (list x b)))
  best)

(defun c:SDSANTHEP (/ name Lx Ly bw t1 c dbx abx dby aby dt at kt k sc tm o x0 x1 y0 y1 lnx lny leg yb xb r e lt q
                      recs ed dir ax a b cov fr st mode pos sts)
  (sd:begin)
  (if (not (sd:dlg "Khai trien thep san (SDSANTHEP)"
                   (append
                     (list (list "name" "Ten o san" 'str (cond (*SD:SNAME*) ("S1")))
                           (list "Lx" "Nhip truc - truc theo X (mm)" 'real (cond (*SD:SLX*) (6000.0)))
                           (list "Ly" "Nhip truc - truc theo Y (mm)" 'real (cond (*SD:SLY*) (4500.0)))
                           (list "bw" "Be rong dam bao quanh (mm)" 'real 220.0)
                           (list "t" "Chieu day san (mm)" 'real 120.0)
                           (list "c" "Lop bao ve (mm)" 'real 20.0)
                           (list "dbx" "Thep duoi phuong X - d (mm)" 'real 8.0)
                           (list "abx" "Thep duoi phuong X - buoc (mm)" 'real 200.0)
                           (list "dby" "Thep duoi phuong Y - d (mm)" 'real 8.0)
                           (list "aby" "Thep duoi phuong Y - buoc (mm)" 'real 200.0)
                           (list "dt" "Thep mu - d (mm)" 'real 8.0)
                           (list "at" "Thep mu - buoc (mm)" 'real 200.0)
                           (list "lt" "Thep mu vuon tu mep dam" 'kw "1/4" '(("1/4" . "Ln/4") ("1/3" . "Ln/3")))
                           (list "eT" "Canh trai (truc dau X)" 'kw "Tudong"
                                 '(("Tudong" . "Tu dong - bo qua phan o ke ben da co thep mu") ("Lientuc" . "Lien tuc - vat qua dam")
                                   ("Bien" . "Bien - neo vao dam") ("Khong" . "Khong ve")))
                           (list "eP" "Canh phai" 'kw "Tudong"
                                 '(("Tudong" . "Tu dong - bo qua phan o ke ben da co thep mu") ("Lientuc" . "Lien tuc - vat qua dam")
                                   ("Bien" . "Bien - neo vao dam") ("Khong" . "Khong ve")))
                           (list "eD" "Canh duoi (truc dau Y)" 'kw "Tudong"
                                 '(("Tudong" . "Tu dong - bo qua phan o ke ben da co thep mu") ("Lientuc" . "Lien tuc - vat qua dam")
                                   ("Bien" . "Bien - neo vao dam") ("Khong" . "Khong ve")))
                           (list "eN" "Canh tren" 'kw "Tudong"
                                 '(("Tudong" . "Tu dong - bo qua phan o ke ben da co thep mu") ("Lientuc" . "Lien tuc - vat qua dam")
                                   ("Bien" . "Bien - neo vao dam") ("Khong" . "Khong ve"))))
                     (sd:kt-fields))))
    (exit))
  (setq name (sd:v "name") Lx (sd:v "Lx") Ly (sd:v "Ly") bw (sd:v "bw") t1 (sd:v "t") c (sd:v "c")
        dbx (sd:v "dbx") abx (sd:v "abx") dby (sd:v "dby") aby (sd:v "aby") dt (sd:v "dt") at (sd:v "at")
        kt (if (= (sd:v "lt") "1/3") (/ 1.0 3.0) 0.25) k (sd:v "k") sc (float (sd:v "sc")) tm (sd:v "tm")
        *SD:SNAME* name *SD:SLX* Lx *SD:SLY* Ly)
  (setq x0 (/ bw 2.0) x1 (- Lx (/ bw 2.0)) y0 (/ bw 2.0) y1 (- Ly (/ bw 2.0)) lnx (- x1 x0) lny (- y1 y0)
        leg (max 50.0 (- t1 c c)))
  (cond
    ((or (<= lnx 500) (<= lny 500)) (princ "\n[SD] O san qua nho so voi be rong dam."))
    ((setq o (sd:getpt "\nDiem chen (giao truc trai - duoi): " nil))
     (sd:kt-begin (sd:v "mk") name)
     (setq o (sd:w o) r (* 4 sc))
     ;; ---- truc + dam (net khuat)
     (foreach x (list 0.0 Lx)
       (sd:line (sd:p+ o x (- (+ x0 (* 4 sc)))) (sd:p+ o x (+ Ly x0 (* 12 sc))) "SD-TRUC")
       (sd:bubble (sd:p+ o x (+ Ly x0 (* 12 sc) r)) r (if (= x 0.0) "1" "2"))
       (sd:line (sd:p+ o (- x x0) (- y0)) (sd:p+ o (- x x0) (+ Ly y0)) "SD-KHUAT")
       (sd:line (sd:p+ o (+ x x0) (- y0)) (sd:p+ o (+ x x0) (+ Ly y0)) "SD-KHUAT"))
     (foreach y (list 0.0 Ly)
       (sd:line (sd:p+ o (- (+ x0 (* 4 sc))) y) (sd:p+ o (+ Lx x0 (* 12 sc)) y) "SD-TRUC")
       (sd:bubble (sd:p+ o (+ Lx x0 (* 12 sc) r) y) r (if (= y 0.0) "A" "B"))
       (sd:line (sd:p+ o (- x0) (- y y0)) (sd:p+ o (+ Lx x0) (- y y0)) "SD-KHUAT")
       (sd:line (sd:p+ o (- x0) (+ y y0)) (sd:p+ o (+ Lx x0) (+ y y0)) "SD-KHUAT"))
     ;; ---- thep lop duoi
     (setq yb (* 0.42 Ly) xb (* 0.58 Lx))
     (sd:kt-bar o (list (list 0.0 yb) (list Lx yb)) 0 dbx (list (* 0.5 Lx) yb) (list (+ (* 0.5 Lx) (* 4 sc)) (+ yb (* 6 sc)))
                k tm sc (list (list (* 0.3 Lx) (+ y0 50)) (list (* 0.3 Lx) (- y1 50))) abx)
     (sd:kt-bar o (list (list xb 0.0) (list xb Ly)) 0 dby (list xb (* 0.75 Ly)) (list (+ xb (* 4 sc)) (+ (* 0.75 Ly) (* 4 sc)))
                k tm sc (list (list (+ x0 50) (* 0.25 Ly)) (list (- x1 50) (* 0.25 Ly))) aby)
     ;; ---- thep mu 4 canh: doi chieu voi cac o san da ve (canh chung truc) de khong rai trung
     (setq recs (sd:san-recs))
     (foreach e (list (list "T" (sd:v "eT") Lx lnx (* 0.62 Ly)) (list "P" (sd:v "eP") Lx lnx (* 0.62 Ly))
                      (list "D" (sd:v "eD") Ly lny (* 0.3 Lx)) (list "N" (sd:v "eN") Ly lny (* 0.3 Lx)))
       (setq ed (car e) mode (cadr e) dir (if (member ed '("T" "P")) "V" "H")
             ax (if (= dir "V") (+ (car o) (if (= ed "T") 0.0 Lx)) (+ (cadr o) (if (= ed "D") 0.0 Ly)))
             a (if (= dir "V") (+ (cadr o) y0) (+ (car o) x0)) b (if (= dir "V") (+ (cadr o) y1) (+ (car o) x1))
             cov (sd:san-cover ed dir ax a b recs) fr (list a b) st mode
             lt (sd:ceil (* kt (nth 3 e)) 50.0))
       (cond
         ((and (= mode "Tudong") cov)
          (setq fr (sd:iv-free a b cov))
          (if (or (null fr) (< (- (cadr fr) (car fr)) 300.0))
            (setq st "Khong")
            (setq st "Lientuc"))
          (princ (strcat "\n[SD] Canh " ed ": o " (nth 3 (car cov)) " da co thep mu vat qua dam"
                         (if (= st "Khong") " -> khong ve lai." " -> chi rai phan con lai.")))
          (foreach c cov
            (if (> lt (+ (caddr c) 50.0))
              (princ (strcat "\n[SD]   Luu y: thep mu o " (nth 3 c) " vuon " (sd:num (caddr c)) " < Ln/" (if (= kt 0.25) "4" "3")
                             " cua o nay (" (sd:num lt) "), kiem tra lai.")))))
         ((= mode "Tudong") (setq st "Lientuc"))
         ((and cov (/= mode "Khong"))
          (princ (strcat "\n[SD] Canh " ed ": TRUNG thep mu voi o " (nth 3 (car cov)) " (da ve Lien tuc). Chon Tudong / Khong de bo."))))
       (if (null fr) (setq fr (list a a)))
       (setq sts (append sts (list (list ed st dir ax (car fr) (cadr fr) lt))))
       (if (/= st "Khong")
         (progn
           ;; doan rai (cuc bo doc canh) + vi tri thanh dai dien nam trong doan
           (setq a (- (car fr) (if (= dir "V") (cadr o) (car o))) b (- (cadr fr) (if (= dir "V") (cadr o) (car o)))
                 pos (if (and (> (nth 4 e) (+ a 100)) (< (nth 4 e) (- b 100))) (nth 4 e) (/ (+ a b) 2.0))
                 q (sd:san-mu o ed st (caddr e) bw lt leg pos dt at k tm sc))
           (sd:kt-bar o (car q) 0 dt (cadr q) (list (+ (car (cadr q)) (* 4 sc)) (+ (cadr (cadr q)) (* 5 sc))) k tm sc
                      (if (= dir "V")
                        (list (list (caddr q) (+ a 50)) (list (caddr q) (- b 50)))
                        (list (list (+ a 50) (caddr q)) (list (- b 50) (caddr q))))
                      at))))
     ;; ---- kich thuoc + tieu de
     ;; kich thuoc / tieu de nam ngoai phan thep mu vuon sang o ben
     (setq xb (if (= (cadr (assoc "T" sts)) "Lientuc") (+ x0 (sd:ceil (* kt lnx) 50.0)) x0)
           yb (if (= (cadr (assoc "D" sts)) "Lientuc") (+ y0 (sd:ceil (* kt lny) 50.0)) y0))
     (sd:use-dimstyle sc)
     (sd:dim o (sd:p+ o Lx 0) "H" (sd:p+ o 0 (- (+ yb (* 10 sc)))))
     (sd:dim o (sd:p+ o 0 Ly) "V" (sd:p+ o (- (+ xb (* 10 sc))) 0))
     (sd:ck-title (sd:p+ o (/ Lx 2.0) (- (+ yb (* 24 sc))))
                  (strcat "M\\U+1EB6T B\\U+1EB0NG TH\\U+00C9P S\\U+00C0N " name " (" (sd:num Lx) "\\U+00D7" (sd:num Ly) ", t=" (sd:num t1) ")")
                  sc name "San" k (/ (* lnx lny t1) 1e9) (/ (* lnx lny) 1e6)
                  (strcat (sd:num lnx) "x" (sd:num lny) "x" (sd:num t1)))
     ;; dang ky canh / thep mu cua o nay cho cac o ve sau
     (setq e (entlast))
     (entmod (append (entget e) (list (list -3 (cons "SD_SAN" (cons (cons 1000 name)
                       (mapcar '(lambda (x) (cons 1000 (sd:join (list (nth 0 x) (nth 2 x) (sd:rtos (nth 3 x) 1) (sd:rtos (nth 4 x) 1)
                                                                      (sd:rtos (nth 5 x) 1) (nth 1 x) (sd:rtos (nth 6 x) 0)) "|")))
                               sts)))))))
     (sd:use-dimstyle *SD:SCALE*)
     (sd:kt-end)))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDTHANGTHEP - Khai trien thep ban thang (mat cat doc ve thang)
;;;  Chieu nghi duoi - ban thang nghieng - chieu nghi tren; thep chiu luc duoi chay suot (co de),
;;;  thep mu tai 2 cho gay khuc (Ltong/4 moi phia), thep phan bo vuong goc.
;;; --------------------------------------------------------------------------
;; Dien tich da giac (cong thuc Gauss)
(defun sd:poly-area (pts / s)
  (setq s 0.0)
  (mapcar '(lambda (p q) (setq s (+ s (- (* (car p) (cadr q)) (* (car q) (cadr p))))))
          pts (append (cdr pts) (list (car pts))))
  (abs (/ s 2.0)))

;; Chieu dai duong gap khuc
(defun sd:path-len (pts) (apply '+ (mapcar 'distance pts (cdr pts))))

;; Cac diem cach deu step tren duong gap khuc (bat dau tu step/2)
(defun sd:path-pts (pts step / r s p q d u)
  (setq s (/ step 2.0))
  (while (cdr pts)
    (setq p (car pts) q (cadr pts) d (distance p q))
    (while (<= s d)
      (setq u (/ s d) r (cons (list (+ (car p) (* u (- (car q) (car p)))) (+ (cadr p) (* u (- (cadr q) (cadr p))))) r)
            s (+ s step)))
    (setq s (- s d) pts (cdr pts)))
  (reverse r))

;; Bien dang be tong cau thang nhieu ve noi tiep (cuc bo): fl = ((X Y n La Lb) ...) goc moi ve tai mui bac dau
;; -> (top bot): top = mat bac + chieu nghi, bot = mat duoi ban (chieu nghi - ban nghieng - chieu nghi ...)
(defun sd:thang-prof (fl r g t1 / tn cs xs1 f X Y n run rise top bot i)
  (setq tn (/ r g) cs (cos (atan r g)) xs1 (/ (- (/ t1 cs) t1) tn)
        f (car fl) top (list (list (- (car f) (nth 3 f)) (cadr f))) bot (list (list (- (car f) (nth 3 f)) (- (cadr f) t1))))
  (foreach f fl
    (setq X (car f) Y (cadr f) n (nth 2 f) run (* (1- n) g) rise (* n r) top (append top (list (list X Y))) i 0)
    (repeat n
      (setq top (append top (list (list (+ X (* i g)) (+ Y (* (1+ i) r))))))
      (if (< i (1- n)) (setq top (append top (list (list (+ X (* (1+ i) g)) (+ Y (* (1+ i) r)))))))
      (setq i (1+ i)))
    (setq bot (append bot (list (list (+ X xs1) (- Y t1))
                                (list (+ X (/ (+ (- rise t1) (/ t1 cs)) tn)) (- (+ Y rise) t1))))))
  (setq f (last fl) run (* (1- (nth 2 f)) g) rise (* (nth 2 f) r))
  (list (append top (list (list (+ (car f) run (nth 4 f)) (+ (cadr f) rise))))
        (append bot (list (list (+ (car f) run (nth 4 f)) (- (+ (cadr f) rise) t1))))))

;; Thep 1 ve (goc of = mui bac dau, mat chieu nghi duoi): chiu luc co de, mu 2 cho gay, phan bo
;; La / Lb chieu nghi duoi / tren; shA / shB: chieu nghi dung chung voi ve ke ben -> thep phan bo chi rai nua chieu nghi
(defun sd:thang-ve (of n r g t1 B La Lb shA shB c d1 a1 d2 a2 d3 a3 k sc tm
                    / tn cs sn run rise cb xm1 xm2 main n1 n2 e lf lt xk1 xk2 xs1 xs2 dp)
  (setq tn (/ r g) cs (cos (atan r g)) sn (sin (atan r g)) run (* (1- n) g) rise (* n r)
        xs1 (/ (- (/ t1 cs) t1) tn) xs2 (/ (+ (- rise t1) (/ t1 cs)) tn)
        cb (+ c (/ d1 2.0))
        xm1 (/ (- (/ (- t1 cb) cs) (- t1 cb)) tn) xm2 (/ (+ (- rise (- t1 cb)) (/ (- t1 cb) cs)) tn)
        main (list (list (+ (- La) c) (+ (- t1) cb)) (list xm1 (+ (- t1) cb)) (list xm2 (+ (- rise t1) cb))
                   (list (- (+ run Lb) c) (+ (- rise t1) cb)))
        n1 (1+ (fix (/ (- B c c) a1))) n2 (1+ (fix (/ (- B c c) a2))))
  (sd:kt-bar of main n1 d1 (list (/ (+ xm1 xm2) 2.0) (/ (- rise t1) 2.0))
             (list (+ (/ (+ xm1 xm2) 2.0) (* 6 sc)) (- (/ (- rise t1) 2.0) (* 14 sc))) k tm sc nil 0.0)
  ;; thep mu tai 2 gay khuc (duoi mat bac, cach c + d2/2)
  (setq e (+ c (/ d2 2.0)) lf (/ (- xs2 xs1) cs) lt (sd:ceil (* 0.25 lf) 50.0)
        xk1 (/ (- (/ e cs) e) tn) xk2 (/ (+ (- rise e) (/ e cs)) tn))
  (sd:kt-bar of (list (list (max (+ (- La) c) (- xk1 lt)) (- e)) (list xk1 (- e)) (list (+ xk1 (* lt cs)) (+ (- e) (* lt sn))))
             n2 d2 (list (- xk1 (/ lt 2.0)) (- e)) (list (- xk1 (/ lt 2.0) (* 10 sc)) (* 8 sc)) k tm sc nil 0.0)
  (sd:kt-bar of (list (list (- xk2 (* lt cs)) (- rise e (* lt sn))) (list xk2 (- rise e)) (list (min (- (+ run Lb) c) (+ xk2 lt)) (- rise e)))
             n2 d2 (list (+ xk2 (/ lt 2.0)) (- rise e)) (list (+ xk2 (/ lt 2.0) (* 4 sc)) (+ rise (* 8 sc))) k tm sc nil 0.0)
  ;; thep phan bo: cham tren thanh chiu luc; duong phan bo (thong minh) cat o giua chieu nghi dung chung
  (setq dp main)
  (if shA (setq dp (cons (list (/ La -2.0) (cadr (car dp))) (cdr dp))))
  (if shB (setq dp (append (sd:head 3 dp) (list (list (+ run (/ Lb 2.0)) (cadr (last dp)))))))
  (foreach p (sd:path-pts dp a3)
    (sd:dot (sd:p+ of (car p) (+ (cadr p) (/ (+ d1 d3) 2.0))) d3 "SD-THEP-CHU"))
  (sd:pline (mapcar '(lambda (p) (sd:p+ of (car p) (- (cadr p) (/ (+ d1 d3) 2.0) (* 3 sc)))) dp) nil "SD-KYHIEU")
  (sd:kt-dist of (list (* 0.3 run) (+ (- (* 0.3 run tn) (/ (- t1 cb) cs)) (/ (+ d1 d3) 2.0)))
              (list (+ (* 0.3 run) (* 4 sc)) (- (* 0.3 run tn) (* 18 sc))) d3 "Thang" (list (- B c c)) k sc tm
              1 a3 nil (list (entlast))))

;; Kich thuoc + ghi chu bac 1 ve (goc of)
(defun sd:thang-dim (of n r g t1 La Lb sc vd / run rise)
  (setq run (* (1- n) g) rise (* n r))
  (sd:dimchain (mapcar '(lambda (x) (sd:p+ of x (- t1))) (list (- La) 0.0 run (+ run Lb))) "H" (sd:p+ of 0 (- (+ t1 (* 26 sc)))))
  (if vd (sd:dim (sd:p+ of (+ run Lb) 0) (sd:p+ of (+ run Lb) rise) "V" (sd:p+ of (+ run Lb (* 10 sc)) 0)))
  (sd:text (sd:p+ of (/ run 2.0) (- (+ t1 (* 32 sc))))
           (strcat (itoa (1- n)) "\\U+00D7" (sd:num g) " = " (sd:num run) ";  " (itoa n) "\\U+00D7" (sd:num r) " = " (sd:num rise))
           (* 2.5 sc) "MC" "SD-CHU"))

(defun c:SDTHANGTHEP (/ name ns r g t1 B L1 L2 Lm gap Bcn c d1 a1 d2 a2 d3 a3 k sc tm o nf fl px py f i al tn cs xs1 bad
                        pr poly area sof rtot sa ss of La Lb nm v s info sx)
  (sd:begin)
  (if (not (sd:dlg "Khai trien thep cau thang (SDTHANGTHEP)"
                   (append
                     (list (list "name" "Ten cau thang / ve" 'str (cond (*SD:TNAME*) ("TB1")))
                           (list "nv" "So bac tung ve (vd 10 hoac 11,10 hoac 3*8)" 'str (cond (*SD:TNV*) ("10")))
                           (list "kieu" "Bo tri cac ve" 'kw (cond (*SD:TKIEU*) ("Thang"))
                                 '(("Thang" . "Thang - cac ve noi tiep, 1 mat cat") ("Gap" . "Gap chu U - moi ve 1 mat cat")))
                           (list "r" "Chieu cao bac (mm)" 'real 150.0)
                           (list "g" "Be rong mat bac (mm)" 'real 300.0)
                           (list "t" "Chieu day ban thang / chieu nghi (mm)" 'real 120.0)
                           (list "B" "Be rong ve thang (mm)" 'real 1200.0)
                           (list "L1" "Chieu nghi / san duoi - dai (mm, >= 300)" 'real 1200.0)
                           (list "L2" "Chieu nghi / san tren - dai (mm, >= 300)" 'real 1200.0)
                           (list "Lm" "Chieu nghi giua - dai theo ve (mm)" 'real 1200.0)
                           (list "Bcn" "Chieu nghi giua - be rong (mm; 0 = 2B + 100)" 'real0 0.0 nil '("kieu" "Gap"))
                           (list "c" "Lop bao ve (mm)" 'real 20.0)
                           (list "d1" "Thep chiu luc duoi - d (mm)" 'real 10.0)
                           (list "a1" "Thep chiu luc duoi - buoc (mm)" 'real 150.0)
                           (list "d2" "Thep mu tai gay khuc - d (mm)" 'real 10.0)
                           (list "a2" "Thep mu tai gay khuc - buoc (mm)" 'real 150.0)
                           (list "d3" "Thep phan bo - d (mm)" 'real 6.0)
                           (list "a3" "Thep phan bo - buoc (mm)" 'real 250.0))
                     (sd:kt-fields))))
    (exit))
  (setq name (sd:v "name") ns (mapcar '(lambda (x) (max 2 (fix x))) (sd:parse-spacing (sd:v "nv")))
        r (sd:v "r") g (sd:v "g") t1 (sd:v "t") B (sd:v "B") L1 (sd:v "L1") L2 (sd:v "L2") Lm (sd:v "Lm")
        c (sd:v "c") d1 (sd:v "d1") a1 (sd:v "a1") d2 (sd:v "d2") a2 (sd:v "a2") d3 (sd:v "d3") a3 (sd:v "a3")
        k (sd:v "k") sc (float (sd:v "sc")) tm (sd:v "tm") gap (and (= (sd:v "kieu") "Gap") (cdr ns))
        Bcn (if (> (sd:v "Bcn") 0) (sd:v "Bcn") (+ B B 100.0)) nf (length ns)
        *SD:TNAME* name *SD:TNV* (sd:v "nv") *SD:TKIEU* (sd:v "kieu"))
  (setq al (atan r g) tn (/ r g) cs (cos al) xs1 (/ (- (/ t1 cs) t1) tn))
  ;; kiem tra: ban nghieng moi ve phai ket thuc truoc dau chieu nghi tren 100 mm
  (setq i 0)
  (foreach n ns
    (setq Lb (if (= i (1- nf)) L2 Lm))
    (if (> (/ (+ (- (* n r) t1) (/ t1 cs)) tn) (- (+ (* (1- n) g) Lb) 100 (if (and (< i (1- nf)) (not gap)) (- xs1) 0)))
      (setq bad t))
    (setq i (1+ i)))
  (cond
    ((null ns) (princ "\n[SD] So bac tung ve khong hop le (vd 10 hoac 11,10)."))
    ((or (< L1 300) (< L2 300) (and (cdr ns) (< Lm 300))) (princ "\n[SD] Cac chieu nghi phai >= 300 mm."))
    (bad (princ "\n[SD] Chieu nghi qua ngan so voi chieu day ban thang."))
    ((setq o (sd:getpt "\nDiem chen (mui bac dau tien, mat chieu nghi duoi): " nil))
     (sd:kt-begin (sd:v "mk") name)
     (setq o (sd:w o) px 0.0 py 0.0 i 0 sx 0.0 area 0.0 sof 0.0 rtot 0.0)
     ;; ---- goc tung ve: Thang = noi tiep (px += run + Lm, py += rise); Gap = tach mat cat sang phai, cao do tang dan
     (foreach n ns
       (setq La (if (= i 0) L1 Lm) Lb (if (= i (1- nf)) L2 Lm)
             fl (append fl (list (list (if gap (+ sx La) px) py n La Lb))))
       (setq px (+ px (* (1- n) g) Lm) sx (+ sx La (* (1- n) g) Lb (* 40 sc)) py (+ py (* n r)) rtot (+ rtot (* n r)) i (1+ i)))
     ;; ---- be tong + thep tung ve
     (setq i 0)
     (foreach f (if gap fl (list nil))
       (setq pr (sd:thang-prof (if gap (list f) fl) r g t1)
             poly (append (car pr) (reverse (cadr pr))))
       (sd:pline (mapcar '(lambda (p) (sd:p+ o (car p) (cadr p))) poly) t "SD-BETONG")
       (setq area (+ area (sd:poly-area poly)) sof (+ sof (sd:path-len (cadr pr)))))
     (foreach f fl
       (setq of (sd:p+ o (car f) (cadr f)))
       (sd:thang-ve of (nth 2 f) r g t1 B (nth 3 f) (nth 4 f) (> i 0) (< i (1- nf)) c d1 a1 d2 a2 d3 a3 k sc tm)
       (sd:use-dimstyle sc)
       (sd:thang-dim of (nth 2 f) r g t1 (nth 3 f) (nth 4 f) sc (or gap (null (cdr fl))))
       (if (cdr fl)
         (sd:text (sd:p+ of (/ (* (1- (nth 2 f)) g) 2.0) (+ (* (nth 2 f) r) (* 20 sc))) (strcat "V\\U+1EBE " (itoa (1+ i)))
                  (* 3.0 sc) "MC" "SD-CHU"))
       (setq i (1+ i)))
     ;; ve noi tiep: 1 kich thuoc tong chieu cao o dau tren
     (if (and (cdr fl) (not gap))
       (sd:dim (sd:p+ o (- (+ px L2) Lm) 0) (sd:p+ o (- (+ px L2) Lm) rtot) "V" (sd:p+ o (+ (- (+ px L2) Lm) (* 10 sc)) 0)))
     ;; ---- khoi luong: Thang = mat cat lien tuc x B; Gap = tru chieu nghi giua lap o 2 ve, cong chieu nghi rong Bcn
     (setq nm (1- nf) sa (* 2 nm Lm t1))
     (if gap
       (setq v (/ (+ (* (- area sa) B) (* nm Lm t1 Bcn)) 1e9)
             s (/ (+ (* B (- sof (* 2 nm Lm))) (* nm Lm Bcn) (* B rtot) (* 2.0 (- area sa)) (* nm 2.0 Lm t1)) 1e6))
       (setq v (/ (* area B) 1e9)
             s (/ (+ (* B sof) (* B rtot) (* 2.0 area)) 1e6)))
     (setq info (strcat (if (cdr ns) (strcat (itoa nf) " ve " (sd:join (mapcar 'itoa ns) "+")) (itoa (car ns)))
                        "x" (sd:num r) "/" (sd:num g) ", t=" (sd:num t1) ", B=" (sd:num B)
                        (if (cdr ns) (strcat ", CN giua " (sd:num Lm) (if gap (strcat "x" (sd:num Bcn)) "")) "")))
     (sd:ck-title (sd:p+ o (/ (if gap sx (- (+ px L2) Lm L1)) 2.0) (- (+ t1 (* 40 sc))))
                  (strcat "M\\U+1EB6T C\\U+1EAET TH\\U+00C9P " (if (cdr ns) "C\\U+1EA6U THANG " "V\\U+1EBE THANG ") name " (B=" (sd:num B)
                          (if (cdr ns) (strcat ", " (itoa nf) " v\\U+1EBF" (if gap " g\\U+1EA5p" "")) "") ")")
                  sc name "Thang" k v s info)
     (sd:use-dimstyle *SD:SCALE*)
     (sd:kt-end)))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDCK - Khai bao khoi luong cau kien bat ky (kich thuoc hoac polyline kin)
;;; --------------------------------------------------------------------------
(defun c:SDCK (/ name typ L1 L2 Hh sv k e ar pe v s pt)
  (sd:begin)
  (if (not (sd:dlg "Khoi luong cau kien (SDCK)"
                   (list (list "name" "Ten cau kien" 'str (cond (*SD:CKN*) ("CK1")))
                         (list "typ" "Loai" 'kw (cond (*SD:CKT*) ("San"))
                               '(("Mong" . "Mong") ("Cot" . "Cot") ("Dam" . "Dam") ("San" . "San") ("Vach" . "Vach / tuong")
                                 ("Thang" . "Cau thang") ("Khac" . "Khac")))
                         (list "cach" "Cach tinh" 'kw "Kichthuoc"
                               '(("Kichthuoc" . "Nhap kich thuoc") ("Polyline" . "Chon polyline kin (dien tich x chieu day)")))
                         (list "L1" "Kich thuoc 1: dai / canh (mm)" 'real 1000.0 nil '("cach" "Kichthuoc"))
                         (list "L2" "Kich thuoc 2: rong / be day (mm)" 'real 1000.0 nil '("cach" "Kichthuoc"))
                         (list "Hh" "Chieu cao / chieu day (mm)" 'real 500.0)
                         (list "sv" "Van khuon 1 CK (m2; -1 = tu tinh)" 'real0 -1.0)
                         (list "tru" "Tru van khuon cho giao (m2 / 1 CK)" 'real0 0.0)
                         (list "k" "So cau kien" 'int 1)
                         (sd:tang-field))))
    (exit))
  (setq name (sd:v "name") typ (sd:v "typ") L1 (sd:v "L1") L2 (sd:v "L2") Hh (sd:v "Hh") sv (sd:v "sv") k (sd:v "k")
        *SD:CKN* name *SD:CKT* typ *SD:TANG* (vl-string-trim " " (sd:v "tang")))
  (if (= (sd:v "cach") "Polyline")
    (if (and (setq e (car (entsel "\nChon polyline kin (mat bang / mat cat cau kien): ")))
             (= (cdr (assoc 0 (entget e))) "LWPOLYLINE"))
      (setq ar (vlax-curve-getArea e) pe (sd:len e)
            v (/ (* ar Hh) 1e9)
            s (cond ((= typ "San") (/ ar 1e6)) (t (/ (* pe Hh) 1e6))))
      (setq v nil))
    (setq v (/ (* L1 L2 Hh) 1e9)
          s (cond ((= typ "Dam") (/ (* L1 (+ L2 Hh Hh)) 1e6))
                  ((= typ "San") (/ (* L1 L2) 1e6))
                  ((= typ "Vach") (/ (* 2.0 L1 Hh) 1e6))
                  (t (/ (* 2.0 (+ L1 L2) Hh) 1e6)))))
  (cond
    ((null v) (princ "\n[SD] Chua chon polyline."))
    ((setq pt (sd:getpt "\nVi tri ghi nhan cau kien: " nil))
     (if (>= sv 0) (setq s sv))
     (setq s (max 0.0 (- s (sd:v "tru"))))
     (sd:ck-title (sd:w pt) (strcat "[" name "] " typ ": V=" (sd:rtos v 3) " m\\U+00B3, VK=" (sd:rtos s 2) " m\\U+00B2")
                  (/ (sd:sc) 2.0) name typ k v s
                  (if ar (strcat "A=" (sd:rtos (/ ar 1e6) 3) "m2 x " (sd:num Hh)) (strcat (sd:num L1) "x" (sd:num L2) "x" (sd:num Hh))))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDKL - Xuat khoi luong be tong, van khuon, cot thep sang Excel
;;;  File Excel XML (SpreadsheetML) 3 sheet co cong thuc; neu may co Excel: mo va luu .xlsx
;;; --------------------------------------------------------------------------
;; Chuoi -> XML: ky tu dac biet, \U+XXXX (chu tieng Viet trong LISP) -> &#xXXXX;
(defun sd:xml-esc (s / r i ch)
  (setq r "" i 1)
  (while (<= i (strlen s))
    (setq ch (substr s i 1))
    (cond
      ((and (= ch "\\") (= (strcase (substr s (1+ i) 2)) "U+") (>= (strlen s) (+ i 6)))
       (setq r (strcat r "&#x" (substr s (+ i 3) 4) ";") i (+ i 6)))
      ((= ch "&") (setq r (strcat r "&amp;")))
      ((= ch "<") (setq r (strcat r "&lt;")))
      ((= ch ">") (setq r (strcat r "&gt;")))
      ((= ch "\"") (setq r (strcat r "&quot;")))
      ((> (ascii ch) 127) (setq r (strcat r "&#" (itoa (ascii ch)) ";")))
      (t (setq r (strcat r ch))))
    (setq i (1+ i)))
  r)

;; O Excel: so, chuoi, cong thuc ("=..."), hoac (gia-tri kieu-dinh-dang [gia-tri-tinh-san cua cong thuc])
(defun sd:xcell (v / st cv)
  (if (and v (listp v)) (setq st (cadr v) cv (caddr v) v (car v)))
  (strcat "<Cell" (if st (strcat " ss:StyleID=\"" st "\"") "")
          ;; luon ghi <Data> (ke ca o cong thuc / o trong) de moi trinh doc dem dung cot
          (cond ((and (= (type v) 'STR) (= (substr v 1 1) "="))
                 (strcat " ss:Formula=\"" (sd:xml-esc v) "\"><Data ss:Type=\"Number\">"
                         (if (numberp cv) (rtos cv 2 6) "0") "</Data></Cell>"))
                ((numberp v) (strcat "><Data ss:Type=\"Number\">" (rtos v 2 6) "</Data></Cell>"))
                ((null v) "><Data ss:Type=\"String\"></Data></Cell>")
                (t (strcat "><Data ss:Type=\"String\">" (sd:xml-esc v) "</Data></Cell>")))))

(defun sd:xrow (f cells / s)
  (setq s "<Row>")
  (foreach c cells (setq s (strcat s (sd:xcell c))))
  (write-line (strcat s "</Row>") f))

(defun sd:xsheet (f name widths title rows)
  (write-line (strcat "<Worksheet ss:Name=\"" name "\"><Table>") f)
  (foreach w widths (write-line (strcat "<Column ss:Width=\"" (itoa w) "\"/>") f))
  (sd:xrow f (list (list (car title) "t")))
  (sd:xrow f (list (cadr title)))
  (foreach r rows (sd:xrow f r))
  (write-line "</Table><WorksheetOptions xmlns=\"urn:schemas-microsoft-com:office:excel\"><PageSetup><Layout x:Orientation=\"Landscape\"/></PageSetup><FitToPage/><Print><FitHeight>0</FitHeight><PaperSizeIndex>9</PaperSizeIndex></Print><FreezePanes/><SplitHorizontal>3</SplitHorizontal><TopRowBottomPane>3</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet>" f))

;; Cau kien da khai bao: ((ten loai k v s ghi-chu tang) ...)
(defun sd:kl-cks (/ ss i x r)
  (setq i 0)
  (if (setq ss (ssget "_X" '((-3 ("SD_KL")))))
    (repeat (sslength ss)
      (setq x (mapcar 'cdr (cdadr (assoc -3 (entget (ssname ss i) '("SD_KL"))))) i (1+ i)
            x (append (sd:head 6 x) (list (cond ((nth 6 x)) ("")))))
      (if (not (assoc (car x) r)) (setq r (cons x r)))))
  (reverse r))

;; Dong thep theo cau kien: ((ck so-hieu hinh-dang (kich-thuoc) d L SL/CK soCK) ...), gop dong trung
(defun sd:kl-steel (/ ss i e xd ck rec key old rows)
  (setq i 0)
  (if (setq ss (ssget "_X" '((0 . "CIRCLE") (-3 ("SD_REBAR")))))
    (repeat (sslength ss)
      (setq e (ssname ss i) i (1+ i) xd (mapcar 'cdr (cdadr (assoc -3 (entget e '("SD_REBAR"))))))
      (if (not (sd:tm-orphan-p xd))
        (progn
          (setq ck (cdr (cadr (cadr (assoc -3 (entget e '("SD_CK")))))))
          (if (not ck) (setq ck "(ch\\U+01B0a g\\U+00E1n)"))
          ;; x = (so-hieu hinh-dang (kich-thuoc) d L SL/CK soCK); gop cung so hieu + so CK: cong so thanh
          (foreach x (sd:rec-rows (sd:xd->rec xd))
            (setq key (list ck (nth 0 x) (nth 1 x) (nth 2 x) (nth 3 x) (nth 4 x) (nth 6 x)))
            (if (setq old (assoc key rows))
              (setq rows (subst (cons key (+ (cdr old) (nth 5 x))) old rows))
              (setq rows (cons (cons key (nth 5 x)) rows))))))))
  ;; dong: (ck so-hieu hinh-dang (kich-thuoc) d L SL/CK soCK)
  (sd:sort (mapcar '(lambda (r) (append (sd:head 6 (car r)) (list (cdr r) (nth 6 (car r))))) rows)
           '(lambda (a b) (if (= (car a) (car b)) (sd:mk< (cadr a) (cadr b)) (< (car a) (car b))))))

;; Khoi luong coffa da dang ky (SD_VK): ((ten loai lenh dien-tich-m2 be-tong-m3 (dong...) handle) ...)
;; Cung ten + cung lenh dang ky nhieu lan (ve lai) -> lay lan moi nhat (handle lon nhat).
(defun sd:hex> (a b) (if (= (strlen a) (strlen b)) (> a b) (> (strlen a) (strlen b))))
(defun sd:kl-vk (/ ss i e x x0 h r old)
  (setq i 0)
  (if (setq ss (ssget "_X" '((-3 ("SD_VK")))))
    (repeat (sslength ss)
      (setq e (ssname ss i) i (1+ i) h (cdr (assoc 5 (entget e)))
            x0 (mapcar 'cdr (cdadr (assoc -3 (entget e '("SD_VK")))))
            x x0)
      (setq x (mapcar '(lambda (s) (sd:split s "|")) (cdr (cddddr x)))
            x (list (nth 0 x0) (nth 1 x0) (nth 2 x0) (nth 3 x0) (nth 4 x0)
                    (vl-remove-if '(lambda (r) (= (car r) "@T")) x) h
                    (cond ((cadr (vl-some '(lambda (r) (if (= (car r) "@T") r)) x))) (""))))
      (if (setq old (vl-some '(lambda (y) (if (and (= (car y) (car x)) (= (caddr y) (caddr x))) y)) r))
        (if (sd:hex> h (last old)) (setq r (subst x old r)))
        (setq r (cons x r)))))
  (reverse r))

(defun sd:kg (r) (/ (* (nth 5 r) (nth 6 r) (nth 7 r) 0.00617 (nth 4 r) (nth 4 r)) 1000.0))
(defun sd:dgrp (d) (cond ((<= d 10.0) 0) ((<= d 18.0) 1) (t 2)))

;; Ten loai cau kien hien thi (co dau)
(defun sd:kl-typname (typ)
  (cond ((cdr (assoc typ '(("Mong" . "M\\U+00F3ng") ("Be tong lot" . "B\\U+00EA t\\U+00F4ng l\\U+00F3t") ("Cot" . "C\\U+1ED9t") ("Dam" . "D\\U+1EA7m") ("San" . "S\\U+00E0n")
                           ("Thang" . "C\\U+1EA7u thang") ("Vach" . "V\\U+00E1ch / t\\U+01B0\\U+1EDDng") ("Khac" . "Kh\\U+00E1c")))))
        (typ)))

(defun sd:kl-order (typ) (cond ((vl-position typ '("Mong" "Be tong lot" "Cot" "Dam" "San" "Thang" "Vach" "Khac"))) (99)))

;; Mo file XML bang Excel va luu .xlsx (tra ve T neu duoc)
;; Mo file XML bang Excel, luu .xlsx; tra ve T, hoac chuoi ly do loi
(defun sd:xl-open (xml xlsx / r xl)
  (setq r (vl-catch-all-apply
            '(lambda (/ wb)
               (if (null (setq xl (vlax-get-or-create-object "Excel.Application")))
                 (exit))
               (vlax-put-property xl 'DisplayAlerts :vlax-false)
               (setq wb (vlax-invoke-method (vlax-get-property xl 'Workbooks) 'Open xml))
               (vl-catch-all-apply 'vlax-invoke-method (list wb 'SaveAs xlsx 51))
               (vlax-put-property xl 'DisplayAlerts :vlax-true)
               (vlax-put-property xl 'Visible :vlax-true)
               t)
            nil))
  (if xl (vl-catch-all-apply 'vlax-release-object (list xl)))
  (cond ((null xl) "may khong co Excel (hoac khong tao duoc doi tuong Excel.Application)")
        ((vl-catch-all-error-p r) (vl-catch-all-error-message r))
        (r t)
        ("loi khong ro")))

;; Dong cong (SUBTOTAL) cho bang TongHop: n = so dong du lieu phia tren ("*" = tu R4, khong cong trung dong Cong)
(defun sd:kl-subrow (lab n v st / rg)
  (setq rg (cond ((null n) "=SUM(R4C:R[-1]C)") ((= n "*") "=SUBTOTAL(9,R4C:R[-1]C)") ((strcat "=SUBTOTAL(9,R[-" n "]C:R[-1]C)"))))
  (list (list lab st) nil nil nil nil (list rg st (nth 0 v)) nil (list rg st (nth 1 v))
        (list rg st (nth 2 v)) (list rg st (nth 3 v)) (list rg st (nth 4 v)) (list rg st (nth 5 v))
        (list "=IF(RC6>0,RC12/RC6,0)" st (if (> (car v) 0) (/ (nth 5 v) (car v)) 0.0))))

