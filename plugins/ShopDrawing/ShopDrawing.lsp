(defun sd:pic-thep (v / sh pts l c)
  (setq sh (assoc (cond ((sd:pv v "shp")) ("Thang")) *SD:SHAPES*))
  (setq pts (mapcar '(lambda (p) (list (+ 15 (* 70 (car p))) (+ 15 (* 45 (cadr p))))) (nth 3 sh)))
  (setq l (list (list "P" 1 nil (apply 'append pts))))
  (foreach s (nth 4 sh)
    (setq l (cons (list "L" (+ 15 (* 70 (car (car s)))) (+ 15 (* 45 (cadr (car s))))
                        (+ 15 (* 70 (car (cadr s)))) (+ 15 (* 45 (cadr (cadr s)))) 1)
                  l)))
