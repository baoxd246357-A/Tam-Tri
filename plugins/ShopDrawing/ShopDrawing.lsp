(defun sd:circle (c r lay)
  (entmake (list '(0 . "CIRCLE") (cons 8 lay) (cons 10 c) (cons 40 r))))

(defun sd:clean-pts (pts closed / r p)
  ;; bo diem hong (nil / khong phai so), diem trung lien tiep va diem dong trung diem dau
  (foreach p pts
    (if (and (listp p) (numberp (car p)) (numberp (cadr p))
             (not (and r (< (distance (list (car p) (cadr p) 0.0) (list (car (car r)) (cadr (car r)) 0.0)) 1e-6))))
      (setq r (cons (list (car p) (cadr p)) r))))
  (setq r (reverse r))
  (if (and closed (cdr r) (< (distance (list (car (car r)) (cadr (car r)) 0.0) (list (car (last r)) (cadr (last r)) 0.0)) 1e-6))
    (setq r (reverse (cdr (reverse r)))))
  r)

(defun sd:plinew (pts closed w lay / q)
  (setq q (sd:clean-pts pts closed))
  (cond
    ((< (length q) (if closed 3 2))
     (princ "\n[SD] Bo qua polyline suy bien (it hon 2-3 dinh sau khi loai diem trung).") nil)
    ((entmake (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay)
                            '(100 . "AcDbPolyline") (cons 90 (length q))
                            (cons 70 (if closed 1 0)) (cons 43 w))
                      (mapcar '(lambda (p) (list 10 (car p) (cadr p))) q))))
    (t (princ "\n[SD] Khong tao duoc polyline (entmake loi).") nil)))
;; Polyline vien/tam kem du lieu mo rong xd; tra nil neu hinh suy bien
(defun sd:mk-tile-poly (lay cs xd / q)
  (setq q (sd:clean-pts cs t))
  (if (>= (length q) 3)
    (entmake (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay)
                           '(100 . "AcDbPolyline") (cons 90 (length q)) '(70 . 1))
                     (mapcar '(lambda (p) (list 10 (car p) (cadr p))) q)
                     (list xd)))
    (progn (princ "\n[SD] Bo qua vien suy bien (dien tich bang 0).") nil)))
(defun sd:pline (pts closed lay) (sd:plinew pts closed 0.0 lay))

(defun sd:rect (o w h lay)
  (sd:pline (list o (sd:p+ o w 0) (sd:p+ o w h) (sd:p+ o 0 h)) t lay))

;; Cham tron dac (thanh thep) duong kinh d
(defun sd:dot (c d lay / r)
  (setq r (/ d 4.0))
  (entmake (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay)
                 '(100 . "AcDbPolyline") '(90 . 2) '(70 . 1) (cons 43 (/ d 2.0))
                 (list 10 (- (car c) r) (cadr c)) '(42 . 1.0)
                 (list 10 (+ (car c) r) (cadr c)) '(42 . 1.0))))

(defun sd:solid3 (a b c lay)
  (entmake (list '(0 . "SOLID") (cons 8 lay) (cons 10 a) (cons 11 b)
                 (cons 12 c) (cons 13 c))))

;; Text: j = L C R ML MC MR TL TC TR
(defun sd:text (pt str h j lay / h72 v73)
  (setq h72 (cond ((wcmatch j "*C") 1) ((wcmatch j "*R") 2) (t 0))
        v73 (cond ((wcmatch j "M?") 2) ((wcmatch j "T?") 3) (t 0)))
  (entmake (list '(0 . "TEXT") (cons 8 lay) (cons 7 (sd:tstyle)) (cons 10 pt)
                 (cons 11 pt) (cons 40 h) (cons 1 str) (cons 72 h72) (cons 73 v73))))

;; Kich thuoc thang: dir "H" ngang / "V" dung; pd = vi tri duong kich thuoc
(defun sd:dim (p1 p2 dir pd / os cl df dx dm)
  (if (> (abs (if (= dir "V") (- (cadr p2) (cadr p1)) (- (car p2) (car p1)))) 1e-6)
    (progn
      (setq os (getvar "OSMODE") cl (getvar "CLAYER") df (getvar "DIMATFIT") dx (getvar "DIMTIX") dm (getvar "DIMTMOVE"))
      (setvar "OSMODE" 0)
      (setvar "CLAYER" "SD-KICHTHUOC")
      (sd:dimchu-apply)   ;; quy tac dim ron: chu canh duong dim (tuy chon chu dim, goc/DGD)
      (command "_.DIMLINEAR" (trans p1 0 1) (trans p2 0 1)
               (if (= dir "V") "_V" "_H") (trans pd 0 1))
      (setvar "DIMATFIT" df) (setvar "DIMTIX" dx) (setvar "DIMTMOVE" dm)
      (setvar "CLAYER" cl)
      (setvar "OSMODE" os))))

(defun sd:dimchain (pts dir pd)
  (while (cadr pts)
    (sd:dim (car pts) (cadr pts) dir pd)
    (setq pts (cdr pts))))

;; Ghi chu dang duong dan sang trai: p (diem tren doi tuong) -> q (goi) -> duoi ngang
(defun sd:tagL (p q txt ts / tl)
  (setq tl (* ts (max 12.0 (* 1.8 (strlen txt)))))
  (sd:line p q "SD-KYHIEU")
  (sd:line q (sd:p+ q (- tl) 0.0) "SD-KYHIEU")
  (sd:text (sd:p+ q (- tl) (* 0.8 ts)) txt (* 2.5 ts) "L" "SD-CHU"))

;;; --------------------------------------------------------------------------
;;;  SDSET - Thiet lap ty le, layer, text style, dimstyle
;;; --------------------------------------------------------------------------
(defun c:SDSET (/ sc)
  (sd:begin)
  (if (not (sd:dlg "Thiet lap ban ve (SDSET)"
                   (list (list "sc" "Ty le ban ve chinh 1/" 'int *SD:SCALE*)
                         (list "ds" "Ty le chi tiet (mat cat, ban ma...) 1/" 'int *SD:DETSCALE*))))
    (exit))
  (setq sc (sd:v "sc"))
  (setq *SD:SCALE* sc)
  (setq *SD:DETSCALE* (sd:v "ds"))
  (vlax-ldata-put "SD" "SCALE" *SD:SCALE*)
  (vlax-ldata-put "SD" "DETSCALE" *SD:DETSCALE*)
  (sd:use-dimstyle *SD:DETSCALE*)
  (sd:use-dimstyle sc)
  (setvar "LTSCALE" (* sc 0.25))
  (princ (strcat "\n[SD] Da thiet lap: ty le 1/" (itoa sc)
                 ", chi tiet 1/" (itoa *SD:DETSCALE*)
                 ", layer SD-*, text style SD-TEXT, dimstyle SD-1-" (itoa sc) "."))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDKHUNG - Khung ban ve + khung ten (block co thuoc tinh)
;;; --------------------------------------------------------------------------
(defun sd:def-frame (bname w h m / x0 y0 x1 y1 tb)
  (entmake (list '(0 . "BLOCK") (cons 2 bname) '(70 . 2) '(10 0.0 0.0 0.0)))
  (sd:pline (list '(0 0) (list w 0) (list w h) (list 0 h)) t "SD-KHUNG")
  (setq x0 25.0 y0 m x1 (- w m) y1 (- h m))
  (sd:plinew (list (list x0 y0) (list x1 y0) (list x1 y1) (list x0 y1)) t 0.7 "SD-KHUNG")
  ;; Khung ten 180 x 56 o goc phai duoi
  (setq tb (list (- x1 180.0) y0 0.0))
  (sd:plinew (list tb (sd:p+ tb 180 0) (sd:p+ tb 180 56) (sd:p+ tb 0 56)) t 0.5 "SD-KHUNG")
  (foreach l '((0 8 180 8) (0 16 180 16) (0 32 180 32) (0 40 180 40) (0 48 180 48)
               (35 0 35 56) (90 0 90 16) (115 0 115 16) (140 8 140 16)
               (155 8 155 16) (150 0 150 8) (160 0 160 8))
    (sd:line (sd:p+ tb (nth 0 l) (nth 1 l)) (sd:p+ tb (nth 2 l) (nth 3 l)) "SD-BANG"))
  (foreach s '((2 51 "\\U+0110\\U+01A0N V\\U+1ECA THI C\\U+00D4NG") (2 43 "C\\U+00D4NG TR\\U+00CCNH") (2 35 "H\\U+1EA0NG M\\U+1EE4C")
               (2 23 "T\\U+00CAN B\\U+1EA2N V\\U+1EBC") (2 11 "NG\\U+01AF\\U+1EDCI V\\U+1EBC") (2 3 "KI\\U+1EC2M TRA")
               (92 11 "T\\U+1EF6 L\\U+1EC6") (142 11 "NG\\U+00C0Y") (92 3 "S\\U+1ED0 B\\U+1EA2N V\\U+1EBC") (152 3 "REV"))
    (sd:text (sd:p+ tb (nth 0 s) (nth 1 s)) (nth 2 s) 2.0 "L" "SD-CHU"))
  ;; Thuoc tinh: (tag prompt default x y h)
  (foreach a '(("COMPANY" "Don vi thi cong" "C\\U+00D4NG TY ..." 37 50.8 3.0)
               ("PROJECT" "Cong trinh" "C\\U+00D4NG TR\\U+00CCNH ..." 37 42.8 3.0)
               ("ITEM" "Hang muc" "H\\U+1EA0NG M\\U+1EE4C ..." 37 34.8 3.0)
               ("TITLE" "Ten ban ve" "T\\U+00CAN B\\U+1EA2N V\\U+1EBC" 37 22.0 4.0)
               ("DRAWN" "Nguoi ve" "" 37 11 2.5)
               ("CHECKED" "Kiem tra" "" 37 3 2.5)
               ("SCALE" "Ty le" "1/100" 117 11 2.5)
               ("DATE" "Ngay" "" 157 11 2.5)
               ("SHEET" "So ban ve" "SD-01" 117 3 2.5)
               ("REV" "Lan sua" "0" 162 3 2.5))
    (entmake (list '(0 . "ATTDEF") '(8 . "SD-CHU")
                   (cons 10 (sd:p+ tb (nth 3 a) (nth 4 a))) (cons 40 (nth 5 a))
                   (cons 1 (nth 2 a)) (cons 3 (nth 1 a)) (cons 2 (nth 0 a))
                   '(70 . 0) (cons 7 (sd:tstyle)) '(72 . 0) '(74 . 0))))
  (entmake '((0 . "ENDBLK"))))

;; Chen block co thuoc tinh; vals = ((TAG . gia tri) ...)
(defun sd:insert-attr (bname pt sc lay vals / e ed tag p)
  (entmake (list '(0 . "INSERT") (cons 8 lay) '(66 . 1) (cons 2 bname) (cons 10 pt)
                 (cons 41 sc) (cons 42 sc) (cons 43 sc) '(50 . 0.0)))
  (setq e (tblobjname "BLOCK" bname))
  (while (setq e (entnext e))
    (setq ed (entget e))
    (if (= (cdr (assoc 0 ed)) "ATTDEF")
      (progn
        (setq tag (cdr (assoc 2 ed))
              p   (cdr (assoc 10 ed)))
        (entmake (list '(0 . "ATTRIB") (cons 8 (cdr (assoc 8 ed)))
                       (cons 10 (sd:p+ pt (* sc (car p)) (* sc (cadr p))))
                       (cons 40 (* sc (cdr (assoc 40 ed))))
                       (cons 1 (cond ((cdr (assoc tag vals))) ((cdr (assoc 1 ed)))))
                       (cons 2 tag) '(70 . 0) (cons 7 (cdr (assoc 7 ed))))))))
  (entmake '((0 . "SEQEND")))
  (entlast))

(defun c:SDKHUNG (/ sz ori sc paper w h bname pt)
  (sd:begin)
  (if (not (sd:dlg "Khung ban ve (SDKHUNG)"
                   (list (list "sz" "Kho giay" 'kw "A1" '("A0" "A1" "A2" "A3" "A4"))
                         (list "ori" "Huong giay" 'kw "Ngang" '("Ngang" "Dung"))
                         (list "sc" "Ty le khung 1/" 'int *SD:SCALE*))))
    (exit))
  (setq sz (sd:v "sz") ori (sd:v "ori") sc (sd:v "sc"))
  (setq paper (cdr (assoc sz '(("A0" 1189 841) ("A1" 841 594) ("A2" 594 420)
                               ("A3" 420 297) ("A4" 297 210)))))
  (if (= ori "Dung")
    (setq w (float (cadr paper)) h (float (car paper)))
    (setq w (float (car paper)) h (float (cadr paper))))
  (setq bname (strcat "SD-KHUNG-" sz (if (= ori "Dung") "D" "")))
  (if (not (tblsearch "BLOCK" bname))
    (sd:def-frame bname w h (if (member sz '("A3" "A4")) 5.0 10.0)))
  (if (setq pt (sd:getpt "\nDiem chen (goc trai duoi khung): " nil))
    (progn
      (sd:insert-attr bname pt (float sc) "SD-KHUNG"
                      (list (cons "SCALE" (strcat "1/" (itoa sc)))
                            (cons "DATE" (sd:today))))
      (princ (strcat "\n[SD] Da chen khung " sz " ty le 1/" (itoa sc)
                     ". Nhap dup vao khung ten de sua thong tin."))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDTRUC - Luoi truc (so 1,2,3... theo X; chu A,B,C... theo Y) + kich thuoc
;;; --------------------------------------------------------------------------
(defun sd:axis-letter (i / L)
  (setq L "ABCDEFGHJKLMNPQRSTUVWXYZ")
  (if (< i 24)
    (substr L (1+ i) 1)
    (strcat (substr L (1+ (rem i 24)) 1) (itoa (/ i 24)))))

(defun sd:bubble (c r lab)
  (sd:circle c r "SD-KYHIEU")
  (sd:text c lab (* 0.9 r) "MC" "SD-CHU"))

(defun c:SDTRUC (/ sc o xs ys ext r xmax ymax i lab yb xl)
  (sd:begin)
  (setq sc (sd:sc))
  (if (not (sd:dlg "Luoi truc (SDTRUC)"
                   (list (list "gx" "Khoang cach truc X (mm), vd 3*6000,4500" 'str (cond (*SD:GX*) ("3*6000")))
                         (list "gy" "Khoang cach truc Y (mm), vd 2*7200" 'str (cond (*SD:GY*) ("2*7200"))))))
    (exit))
  (setq *SD:GX* (sd:v "gx") *SD:GY* (sd:v "gy"))
  (setq xs (sd:cumul (sd:parse-spacing *SD:GX*))
        ys (sd:cumul (sd:parse-spacing *SD:GY*)))
  (if (setq o (sd:getpt "\nDiem goc (giao truc 1-A): " nil))
    (progn
      (setq ext (* 12.0 sc) r (* 4.0 sc) xmax (last xs) ymax (last ys) i 0)
      (foreach x xs
        (setq i (1+ i) lab (itoa i))
        (sd:line (sd:p+ o x (- ext)) (sd:p+ o x (+ ymax ext)) "SD-TRUC")
        (sd:bubble (sd:p+ o x (- (+ ext r))) r lab)
        (sd:bubble (sd:p+ o x (+ ymax ext r)) r lab))
      (setq i 0)
      (foreach y ys
        (setq lab (sd:axis-letter i) i (1+ i))
        (sd:line (sd:p+ o (- ext) y) (sd:p+ o (+ xmax ext) y) "SD-TRUC")
        (sd:bubble (sd:p+ o (- (+ ext r)) y) r lab)
        (sd:bubble (sd:p+ o (+ xmax ext r) y) r lab))
      ;; Kich thuoc: chuoi khoang truc + tong
      (sd:use-dimstyle sc)
      (setq yb (- (+ ext r r)) xl (- (+ ext r r)))
      (if (cdr xs)
        (progn
          (sd:dimchain (mapcar '(lambda (x) (sd:p+ o x yb)) xs) "H" (sd:p+ o 0 (- yb (* 8 sc))))
          (if (cddr xs)
            (sd:dim (sd:p+ o 0 yb) (sd:p+ o xmax yb) "H" (sd:p+ o 0 (- yb (* 16 sc)))))))
      (if (cdr ys)
        (progn
          (sd:dimchain (mapcar '(lambda (y) (sd:p+ o xl y)) ys) "V" (sd:p+ o (- xl (* 8 sc)) 0))
          (if (cddr ys)
            (sd:dim (sd:p+ o xl 0) (sd:p+ o xl ymax) "V" (sd:p+ o (- xl (* 16 sc)) 0)))))
      (princ (strcat "\n[SD] Da ve " (itoa (length xs)) " x " (itoa (length ys)) " truc."))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDCAODO - Ky hieu cao do (tu dong tinh theo diem goc hoac nhap tay), co hop thoai
;;; --------------------------------------------------------------------------
(defun sd:fmtlevel (v)
  (cond ((< (abs v) 0.0005) "%%p0.000")
        ((> v 0) (strcat "+" (sd:rtos v 3)))
        (t (sd:rtos v 3))))

(defun sd:levelmark (pt v sc)
  (sd:pline (list pt (sd:p+ pt (* -1.5 sc) (* 2.5 sc)) (sd:p+ pt (* 1.5 sc) (* 2.5 sc))) t "SD-KYHIEU")
  (sd:solid3 pt (sd:p+ pt 0 (* 2.5 sc)) (sd:p+ pt (* 1.5 sc) (* 2.5 sc)) "SD-KYHIEU")
  (sd:line (sd:p+ pt (* -1.5 sc) (* 2.5 sc)) (sd:p+ pt (* 14.0 sc) (* 2.5 sc)) "SD-KYHIEU")
  (sd:text (sd:p+ pt (* 1.0 sc) (* 3.3 sc)) (sd:fmtlevel v) (* 2.5 sc) "L" "SD-CHU"))

;; Chon diem goc: *SD:YB* = toa do Y cua diem co cao do da biet
(defun sd:caodo-base (/ b)
  (if (setq b (sd:getpt "\nChon diem co cao do da biet (diem goc): " nil))
    (setq *SD:YB* (cadr b))))

(defun c:SDCAODO (/ sc pt v mode y0)
  (sd:begin)
  (setq sc (sd:sc))
  (if (not (sd:dlg "Ky hieu cao do (SDCAODO)"
                   (list (list "mode" "Cach ghi cao do" 'kw (cond (*SD:CDMODE*) ("Goc"))
                               '(("Goc" . "Tu tinh theo diem goc (toa do Y)") ("Tay" . "Nhap gia tri tung diem")))
                         (list "setb" "Chon lai diem goc tren ban ve" 'tog (null *SD:YB*) nil '("mode" "Goc"))
                         (list "v0" "Cao do tai diem goc (m)" 'real0 (cond (*SD:Y0V*) (0.0)) nil '("mode" "Goc"))
                         (list "vt" "Gia tri cao do dau tien (m)" 'real0 (cond (*SD:CDV*) (0.0)) nil '("mode" "Tay")))))
    (exit))
  (setq mode (sd:v "mode") *SD:CDMODE* mode *SD:Y0V* (sd:v "v0") v (sd:v "vt"))
  (if (and (= mode "Goc") (or (sd:v "setb") (null *SD:YB*)))
    (sd:caodo-base))
  (if (and (= mode "Goc") (null *SD:YB*))
    (princ "\n[SD] Chua co diem goc.")
    (while (progn (if (= mode "Goc") (initget "G"))
                  (setq pt (getpoint (if (= mode "Goc")
                                       "\nDiem dat cao do [G = chon lai diem goc] <Enter ket thuc>: "
                                       "\nDiem dat cao do <Enter ket thuc>: "))))
      (if (= pt "G")
        (sd:caodo-base)
        (progn
          (setq pt (sd:w pt))
          (if (= mode "Goc")
            (setq y0 (- *SD:YB* (* 1000.0 *SD:Y0V*)) v (/ (- (cadr pt) y0) 1000.0))
            (setq v (cond ((getreal (strcat "\nGia tri cao do (m) <" (sd:rtos v 3) ">: "))) (v))
                  *SD:CDV* v))
          (sd:levelmark pt v sc)))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  SDMC - Ky hieu mat cat
;;; --------------------------------------------------------------------------
(defun c:SDMC (/ sc p1 p2 ps lab ang n pp dir bp tp)
  (sd:begin)
  (setq sc (sd:sc))
  (if (not (sd:dlg "Ky hieu mat cat (SDMC)" (list (list "lab" "Ten mat cat" 'str (cond (*SD:MCLAB*) ("1"))))))
    (exit))
  (if (and (setq p1 (sd:getpt "\nDiem dau duong cat: " nil))
           (setq p2 (sd:getpt "\nDiem cuoi duong cat: " p1))
           (setq ps (sd:getpt "\nChon phia nhin: " p2)))
    (progn
      (setq lab (sd:v "lab"))
      (if (wcmatch lab "#*") (setq *SD:MCLAB* (itoa (1+ (atoi lab)))))
      (setq ang (angle p1 p2))
      ;; huong nhin vuong goc, ve phia diem ps
      (setq n (if (> (- (* (- (car p2) (car p1)) (- (cadr ps) (cadr p1)))
                        (* (- (cadr p2) (cadr p1)) (- (car ps) (car p1)))) 0)
                (+ ang (/ pi 2)) (- ang (/ pi 2))))
      (foreach e (list (list p1 ang) (list p2 (+ ang pi)))
        (setq pp (car e) dir (cadr e))
        (sd:plinew (list pp (polar pp dir (* 8 sc))) nil (* 0.6 sc) "SD-KYHIEU")
        (setq tp (polar pp n (* 7 sc)) bp (polar pp n (* 4.5 sc)))
        (sd:line pp bp "SD-KYHIEU")
        (sd:solid3 tp (polar bp dir (* 1.0 sc)) (polar bp (+ dir pi) (* 1.0 sc)) "SD-KYHIEU")
        (sd:text (polar (polar pp n (* 4 sc)) (+ dir pi) (* 3.5 sc)) lab (* 3.5 sc) "MC" "SD-CHU"))))
  (sd:finish))

;;; --------------------------------------------------------------------------
;;;  Mat cat BTCT: dam (SDDAM) va cot (SDCOT)
;;; --------------------------------------------------------------------------
;; Dai: duong tim cach mep (a + ds/2), co moc 135 do o goc trai tren
(defun sd:stirrup (o b h a ds / c k)
  (setq c (+ a (/ ds 2.0)))
  (sd:plinew (list (sd:p+ o c c) (sd:p+ o (- b c) c) (sd:p+ o (- b c) (- h c)) (sd:p+ o c (- h c)))
             t ds "SD-THEP-DAI")
  (setq k (sd:p+ o c (- h c)))
  (sd:plinew (list (sd:p+ k 0 (* -2 ds)) (sd:p+ k (* 5 ds) (* -7 ds))) nil ds "SD-THEP-DAI")
  (sd:plinew (list (sd:p+ k (* 2 ds) 0) (sd:p+ k (* 7 ds) (* -5 ds))) nil ds "SD-THEP-DAI"))

;; Hang thanh thep n thanh, duong kinh d, tai cao do y. Tra ve diem thanh dau tien.
(defun sd:barrow (o b a ds n d y / x0 dx i)
  (setq x0 (+ a ds (/ d 2.0)))
  (if (= n 1)
    (progn (sd:dot (sd:p+ o (/ b 2.0) y) d "SD-THEP-CHU") (sd:p+ o (/ b 2.0) y))
    (progn
      (setq dx (/ (- b x0 x0) (1- n)) i 0)
      (repeat n
        (sd:dot (sd:p+ o (+ x0 (* i dx)) y) d "SD-THEP-CHU")
        (setq i (1+ i)))
      (sd:p+ o x0 y))))

(defun sd:sec-common (o b h a ds s ts title)
  (sd:rect o b h "SD-BETONG")
  (sd:stirrup o b h a ds)
  (sd:use-dimstyle ts)
  (sd:dim o (sd:p+ o b 0) "H" (sd:p+ o 0 (* -8 ts)))
  (sd:dim (sd:p+ o b 0) (sd:p+ o b h) "V" (sd:p+ o (+ b (* 8 ts)) 0))
  (sd:tagL (sd:p+ o (+ a (/ ds 2.0)) (/ h 2.0)) (sd:p+ o (* -6 ts) (/ h 2.0))
           (strcat "%%c" (sd:num ds) "a" (sd:num s)) ts)
  (sd:text (sd:p+ o (/ b 2.0) (* -17 ts)) title (* 3.5 ts) "MC" "SD-CHU")
  (sd:text (sd:p+ o (/ b 2.0) (* -22 ts)) (strcat (sd:num b) "\\U+00D7" (sd:num h)) (* 2.5 ts) "MC" "SD-CHU"))

(defun c:SDDAM (/ ts name b h a top bot ds s o p)
  (sd:begin)
  (setq ts (float *SD:DETSCALE*))
  (if (not (sd:dlg "Mat cat dam BTCT (SDDAM)"
                   (list (list "name" "Ten dam" 'str (cond (*SD:DNAME*) ("D1")))
                         (list "b" "Be rong b (mm)" 'real (cond (*SD:DB*) (220.0)))
                         (list "h" "Chieu cao h (mm)" 'real (cond (*SD:DH*) (500.0)))
                         (list "a" "Lop bao ve (mm)" 'real 25.0)
                         (list "top" "Thep tren (vd 2d18)" 'bar "2d18")
                         (list "bot" "Thep duoi (vd 3d20)" 'bar "3d20")
                         (list "ds" "Duong kinh dai (mm)" 'real 8.0)
                         (list "s" "Buoc dai (mm)" 'real 150.0))))
    (exit))
  (setq name (sd:v "name") b (sd:v "b") h (sd:v "h") a (sd:v "a") top (sd:v "top") bot (sd:v "bot")
        ds (sd:v "ds") s (sd:v "s"))
  (setq *SD:DNAME* name *SD:DB* b *SD:DH* h)
  (if (setq o (sd:getpt "\nDiem chen (goc trai duoi): " nil))
    (progn
      (sd:sec-common o b h a ds s ts (strcat "M\\U+1EB6T C\\U+1EAET " name))
      (setq p (sd:barrow o b a ds (car top) (cadr top) (- h a ds (/ (cadr top) 2.0))))
      (sd:tagL p (sd:p+ o (* -6 ts) (+ h (* 6 ts)))
               (strcat (itoa (car top)) "%%c" (sd:num (cadr top))) ts)
      (setq p (sd:barrow o b a ds (car bot) (cadr bot) (+ a ds (/ (cadr bot) 2.0))))
      (sd:tagL p (sd:p+ o (* -6 ts) (* -4 ts))
               (strcat (itoa (car bot)) "%%c" (sd:num (cadr bot))) ts)
      (sd:use-dimstyle *SD:SCALE*)))
  (sd:finish))

;; Dai phu cot: chon thanh giua can giu (TCVN 5574 / ACI: thanh goc + thanh xen ke duoc giu,
;; thanh khong giu cach thanh duoc giu <= 150 mm thong thuy). Tra ve chi so thanh giua (1..n-2).
(defun sd:tie-pick (n s d mode / i r prev)
  (setq prev t i 1)
  (if (/= mode "Khong")
    (repeat (max 0 (- n 2))
      (if (or (= mode "Tatca") (not prev) (> (- s d) 150.0))
        (setq r (cons i r) prev t)
        (setq prev nil))
      (setq i (1+ i))))
  (reverse r))

;; Gom dai phu giong nhau: grp = (((shp prm) so-luong hint) ...)
(defun sd:tie-add (grp shp prm hint / k e)
  (setq k (list shp (mapcar '(lambda (x) (fix (+ x 0.5))) prm)))
  (if (setq e (assoc k grp))
    (subst (list k (1+ (cadr e)) (caddr e)) e grp)
    (append grp (list (list k 1 hint)))))

;; Ve (draw = T) dai phu trong mat cat cot goc o; tra ve cac nhom ((shp prm so-dai-1-lop hint) ...)
;; mode: Tudong / Tatca / Khong; typ: MocC (dai 1 nhanh, moc 135) / Kin (dai kin trong, ghep cap doi xung)
(defun sd:col-ties (o b h a ds nb nh d mode typ draw / x0 grp dir n side span s idx pos q i j w c1 hk p1 p2)
  (setq x0 (+ a ds (/ d 2.0)) c1 (+ a (* 1.5 ds)) hk (* 4 ds))
  ;; dir "X": thanh giua tren 2 hang canh b, dai di theo Y; dir "Y": thanh giua 2 cot canh h, dai theo X
  (foreach dir (list (list "X" nb b h) (list "Y" nh h b))
    (setq n (cadr dir) side (caddr dir) span (cadddr dir))
    (if (> n 2)
      (progn
        (setq s (/ (- side x0 x0) (1- n))
              idx (sd:tie-pick n s d mode)
              pos (mapcar '(lambda (i) (+ x0 (* i s))) idx))
        (while pos
          (if (and (= typ "Kin") (cdr pos))
            (progn
              (setq i (car pos) j (last pos) w (+ (- j i) d ds ds)
                    pos (cdr (reverse (cdr (reverse pos)))))
              (setq grp (sd:tie-add grp "Dai" (list w (- span a a)) (if (= (car dir) "X") (list (- i (/ d 2.0) ds) (/ span 2.0)) (list (/ span 2.0) (- i (/ d 2.0) ds)))))
              (if draw
                (sd:plinew (mapcar '(lambda (q) (if (= (car dir) "X") (sd:p+ o (car q) (cadr q)) (sd:p+ o (cadr q) (car q))))
                                   (list (list (- i (/ d 2.0) (/ ds 2.0)) c1) (list (+ j (/ d 2.0) (/ ds 2.0)) c1)
                                         (list (+ j (/ d 2.0) (/ ds 2.0)) (- span c1)) (list (- i (/ d 2.0) (/ ds 2.0)) (- span c1))))
                           t ds "SD-THEP-DAI")))
            (progn
              (setq i (car pos) pos (cdr pos))
              (setq grp (sd:tie-add grp "Mot" (list (- span a a)) (if (= (car dir) "X") (list i (/ span 2.0)) (list (/ span 2.0) i))))
              (if draw
                (sd:plinew (mapcar '(lambda (q) (if (= (car dir) "X") (sd:p+ o (car q) (cadr q)) (sd:p+ o (cadr q) (car q))))
                                   (list (list (+ i hk) (+ c1 hk)) (list i c1) (list i (- span c1)) (list (- i hk) (- span c1 hk))))
                           nil ds "SD-THEP-DAI"))))))))
  (mapcar '(lambda (g) (list (car (car g)) (cadr (car g)) (cadr g) (caddr g))) grp))

;; Truong hop thoai dai phu (dung chung SDCOT, SDCOTTHEP)
(defun sd:tie-fields ()
