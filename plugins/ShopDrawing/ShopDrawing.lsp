                   (list (list "STOCK" "Chieu dai cay thep thuong pham (mm)" 'real (sd:cfg "STOCK" 11700.0))
                         (list "BETONG" "Cap do ben be tong" 'kw (sd:cfg "BETONG" "B25") '("B15" "B20" "B25" "B30" "B35" "B40"))
                         (list "THEP" "Mac thep" 'kw (sd:cfg "THEP" "CB400-V") '("CB240-T" "CB300-V" "CB400-V" "CB500-V"))
                         (list "VUNG" "Vung noi chong" 'kw (sd:cfg "VUNG" "Keo") '(("Keo" . "Vung keo") ("Nen" . "Vung nen")))
                         (list "LAPK" "He so noi k (lap = k.d), 0 = theo TCVN" 'real0 (sd:cfg "LAPK" 0.0))
                         (list "NOIKIEU" "Chia doan noi" 'kw (sd:cfg "NOIKIEU" "Cay")
                               '(("Cay" . "Cay nguyen + doan le") ("Deu" . "Chia deu")))
                         (list "HOOK" "Moc dai 135 do = k.d (>= 75 mm), k" 'real (sd:cfg "HOOK" 10.0))
                         (list "KERF" "Be rong mach cat (mm)" 'real0 (sd:cfg "KERF" 0.0))
                         (list "REUSE" "Doan thua tai su dung toi thieu (mm)" 'real (sd:cfg "REUSE" 1000.0)))))
    (exit))
  (foreach k '("STOCK" "BETONG" "THEP" "VUNG" "LAPK" "NOIKIEU" "HOOK" "KERF" "REUSE")
    (sd:cfg-put k (if (numberp (sd:v k)) (float (sd:v k)) (sd:v k))))
  (princ (strcat "\n[SD] Chieu dai noi chong (" (sd:lapinfo) "):"))
  (foreach d '(10.0 12.0 14.0 16.0 18.0 20.0 22.0 25.0 28.0 32.0)
    (princ (strcat "\n   D" (sd:num d) ": " (sd:num (sd:lap d)) " mm (" (sd:rtos (/ (sd:lap d) d) 1) "d)")))
  (sd:finish))

