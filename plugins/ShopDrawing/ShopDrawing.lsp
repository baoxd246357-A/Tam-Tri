;;; --------------------------------------------------------------------------
;;;  SDTOIUU - Toi uu cat thep tu cay thuong pham (Best Fit Decreasing)
;;; --------------------------------------------------------------------------
;; items: ((chieu-dai . so-luong) ...) giam dan. Moi doan chiem (L + kerf),
;; suc chua 1 cay = cap + kerf (doan cuoi khong can mach cat).
;; Tra ve danh sach cay: (con-lai doan1 doan2 ...)
(defun sd:bfd (items cap kerf / bins need q best bidx i m)
  (foreach it items
    (setq need (+ (car it) kerf) q (cdr it))
    (while (> q 0)
      (setq best nil bidx nil i 0)
      (foreach b bins
        (if (and (>= (car b) (- need 1e-6)) (or (null best) (< (car b) (car best))))
          (setq best b bidx i))
        (setq i (1+ i)))
      (if (null best)
        (setq best (list (+ cap kerf))
              bins (append bins (list best))
              bidx (1- (length bins))))
      ;; cay tot nhat van la tot nhat sau khi them doan cung loai -> them 1 lan nhieu doan
      (setq m (min q (fix (/ (+ (car best) 1e-6) need))))
      (setq bins (sd:replace-nth bidx (cons (- (car best) (* m need))
                                            (append (cdr best) (sd:repeat (car it) m)))
                                 bins)
            q (- q m))))
  bins)

(defun c:SDTOIUU (/ ss data cap kerf reuse byd e items bins pats left nb req
                    stock waste nre lre kgbuy tbuy treq rows lines over pt fn f d key)
  (sd:begin)
  (if (not (sd:dlg "Toi uu cat thep (SDTOIUU)"
                   (list (list "cap" "Chieu dai cay thep thuong pham (mm)" 'real (sd:cfg "STOCK" 11700.0))
                         (list "kerf" "Be rong mach cat (mm)" 'real0 (sd:cfg "KERF" 0.0))
                         (list "reuse" "Doan thua tai su dung toi thieu (mm)" 'real (sd:cfg "REUSE" 1000.0)))))
    (exit))
  (setq cap   (sd:v "cap")
        kerf  (sd:v "kerf")
        reuse (sd:v "reuse"))
  (if (not (setq ss (sd:select-rebars)))
    (princ "\n[SD] Khong tim thay ky hieu thep nao (dung lenh SDTHEP de tao).")
    (progn
      (setq data (sd:read-rebars ss))
      ;; gom doan cat theo duong kinh: byd = ((d (L . sl) ...) ...)
      (foreach r data
        (foreach L (cond ((nth 7 r)) ((list (nth 3 r))))
          (if (> L (+ cap 1e-6))
            (setq over (cons (strcat (car r) " (D" (sd:num (nth 2 r)) ", L=" (sd:rtos L 0) ")") over))
            (progn
              (if (not (setq e (assoc (nth 2 r) byd)))
                (setq e (list (nth 2 r)) byd (cons e byd)))
              (setq items (cdr e)
                    items (if (assoc L items)
                            (subst (cons L (+ (cdr (assoc L items)) (* (nth 1 r) (nth 4 r))))
                                   (assoc L items) items)
                            (cons (cons L (* (nth 1 r) (nth 4 r))) items)))
              (setq byd (subst (cons (car e) items) e byd))))))
      (setq byd (sd:sort byd '(lambda (a b) (< (car a) (car b))))
            tbuy 0.0 treq 0.0)
      (foreach e byd
        (setq d     (car e)
              items (sd:sort (cdr e) '(lambda (a b) (> (car a) (car b))))
              bins  (sd:bfd items cap kerf)
              pats  nil nre 0 lre 0.0
              req   (apply '+ (mapcar '(lambda (x) (* (car x) (cdr x))) items)))
        ;; gom so do cat giong nhau
        (foreach b bins
          (setq left (if (> (car b) 1e-6) (max 0.0 (- (car b) kerf)) 0.0)
                key  (sd:pcs-str (cdr b) "\\U+00D7"))   ; doan trong cay da giam dan
          (if (>= left reuse) (setq nre (1+ nre) lre (+ lre left)))
          (if (assoc key pats)
            (setq pats (subst (list key (1+ (cadr (assoc key pats))) left (cadddr (assoc key pats)))
                              (assoc key pats) pats))
            (setq pats (cons (list key 1 left (sd:pcs-str (cdr b) "x")) pats))))
        (setq pats  (sd:sort pats '(lambda (a b) (> (cadr a) (cadr b))))
              nb    (length bins)
              stock (* nb cap)
              waste (- stock req)
              kgbuy (* (/ stock 1000.0) 0.00617 d d)
              tbuy  (+ tbuy kgbuy)
              treq  (+ treq (* (/ req 1000.0) 0.00617 d d)))
        (foreach p pats
          (setq rows (cons (list "R" (list (strcat "%%c" (sd:num d)) (car p) (itoa (cadr p))
                                           (sd:rtos (caddr p) 0)) nil)
                           rows)
                lines (cons (sd:join (list (sd:num d) (cadddr p)
                                           (itoa (cadr p)) (sd:rtos (caddr p) 0)) ";")
                            lines)))
        (setq rows (cons (list "W" (strcat "%%c" (sd:num d) ": " (itoa nb) " c\\U+00E2y \\U+00D7 " (sd:num (/ cap 1000.0))
                                           " m; c\\U+1EA7n " (sd:rtos (/ req 1000.0) 2) " m; d\\U+01B0 "
                                           (sd:rtos (/ waste 1000.0) 2) " m ("
                                           (sd:rtos (if (> stock 0) (/ (* 100.0 waste) stock) 0.0) 1)
                                           "%), trong \\U+0111\\U+00F3 " (itoa nre) " \\U+0111o\\U+1EA1n >= " (sd:num reuse)
                                           " t\\U+00E1i s\\U+1EED d\\U+1EE5ng = " (sd:rtos (/ lre 1000.0) 2) " m; KL mua "
                                           (sd:rtos kgbuy 1) " kg"))
                         rows))
        (princ (strcat "\n D" (sd:num d) ": " (itoa nb) " cay, can " (sd:rtos (/ req 1000.0) 2)
                       " m, hao hut " (sd:rtos (if (> stock 0) (/ (* 100.0 waste) stock) 0.0) 1) "%")))
      (setq rows (reverse rows)
            rows (append rows (list (list "W" (strcat "T\\U+1ED4NG: KL mua " (sd:rtos tbuy 1) " kg; KL c\\U+1EA7n "
                                                      (sd:rtos treq 1) " kg; hao h\\U+1EE5t "
                                                      (sd:rtos (if (> tbuy 0) (/ (* 100.0 (- tbuy treq)) tbuy) 0.0) 1)
                                                      "% (m\\U+1EA1ch c\\U+1EAFt " (sd:num kerf) " mm)")))))
      (princ (strcat "\n TONG: KL mua " (sd:rtos tbuy 1) " kg, KL can " (sd:rtos treq 1) " kg"))
      (if over
        (princ (strcat "\n[!] Doan dai hon cay thep, khong dua vao toi uu: " (sd:join (reverse over) "; "))))
      (if (and byd (setq pt (sd:getpt "\nDiem chen bang toi uu (goc trai tren): " nil)))
        (sd:table2 pt (strcat "B\\U+1EA2NG T\\U+1ED0I \\U+01AFU C\\U+1EAET TH\\U+00C9P (C\\U+00C2Y " (sd:num (/ cap 1000.0)) " m)")
                   '(("\\U+0110K" 12) ("S\\U+01A0 \\U+0110\\U+1ED2 C\\U+1EAET 1 C\\U+00C2Y (mm)" 100) ("S\\U+1ED0 C\\U+00C2Y" 16) ("D\\U+01AF/C\\U+00C2Y (mm)" 22))
                   rows -1 (sd:sc)))
      (setq fn (sd:csv-name "_ToiUuCatThep.csv"))
      (if (setq f (sd:open fn "w"))
        (progn
          (write-line "DK(mm);So do cat 1 cay (mm);So cay;Du/cay (mm)" f)
          (foreach l (reverse lines) (write-line l f))
          (setq fn (sd:close f))
          (princ (strcat "\n[SD] Da xuat: " fn))))))
  (sd:finish))

;;; --------------------------------------------------------------------------
