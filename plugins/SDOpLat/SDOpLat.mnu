//
//  Op Lat Tools v1.0.0 - menu + toolbars (sinh tu dong boi build_menu.py)
//  Nap: lenh SDMENU, hoac CUILOAD -> chon file nay (AutoCAD tu chuyen sang .cuix)
//
***MENUGROUP=SDOPLAT

***POP1
**SD_POP
ID_SD_POP [&SDOpLat]
ID_SD_G1 [->Thiet lap va ban ve]
ID_SD_SDSET [Thiet lap ty le, layer, text style, dimstyle (SDSET / TYLE)]^C^CSDSET
ID_SD_SDDIMGD [Dim giao diem: ve duong cat, tu dong dim tung doan + dim tong (SDDIMGD / DGD)]^C^CSDDIMGD
ID_SD_SDDIMPOLY [<-Dim polyline kin (co cung tron): tu dong dim tung canh (SDDIMPOLY / DPK)]^C^CSDDIMPOLY
ID_SD_G4 [->Op lat da granite / gach]
ID_SD_SDGACH [Chia vien: thang/so le/xuong ca/chevron, vien, khe (SDGACH / CHV)]^C^CSDGACH
ID_SD_SDCHANTUONG [Len chan tuong + trien khai mat dung (SDCHANTUONG / LCT)]^C^CSDCHANTUONG
ID_SD_SDRAITAM [Rai panel / da lat theo kho: tam lon tu goc, tam di hinh mep bien, go bu, huong van (SDRAITAM / RTA)]^C^CSDRAITAM
ID_SD_SDVANDA [Hatch van da (file .pat) len vien: tiep noi / doi guong / xoay 4 chieu (SDVANDA / VDA)]^C^CSDVANDA
ID_SD_SDQUYTRINH [Hop thoai quy trinh da lat: goi y buoc tiep theo, chay tung buoc hoac lien hoan (SDQUYTRINH / QTR)]^C^CSDQUYTRINH
ID_SD_SDDOCDA [Doc mat bang op lat: dung lai o kin tu net roi, ghi bang CSV de soat / bo sung, ve polyline kin, chay SDANHDA (SDDOCDA / DOD)]^C^CSDDOCDA
ID_SD_SDMOANH [Mo bien anh da: bien vien moi vuot anh nhung tam con du kho thi tu dich anh va cat lai (SDMOANH / MOA)]^C^CSDMOANH
ID_SD_SDRON [Doi ron giua cac vien: thu phong polyline vien, cap nhat hatch lien ket va cat lai anh, khong sua tay (SDRON / DRN)]^C^CSDRON
ID_SD_SDVAN [Kiem tra van da lien tuc giua cac vien ke nhau (dua vao vi tri cat tren tam), khoanh moi noi dut van (SDVAN / LTV)]^C^CSDVAN
ID_SD_SDKTLAT [Kiem tra ban ve lat: vien cat hep / nho, ron khong deu, o thieu ma vat lieu (SDKTLAT / KLT)]^C^CSDKTLAT
ID_SD_SDDIEMBD [So sanh diem bat dau rai luoi vien: so vien cat, vien cat hep, hao hut; goi y diem tot nhat (SDDIEMBD / DBT)]^C^CSDDIEMBD
ID_SD_SDKHEGIAN [Khe co gian: khe sat tuong va khe phan vung vung lat, chong chiu dai toi da giua cac khe (SDKHEGIAN / KCG)]^C^CSDKHEGIAN
ID_SD_SDTHOATNUOC [Pheu thu nuoc + doc san: chenh cao den cac goc, khoanh vung vien cat quanh pheu (SDTHOATNUOC / PTN)]^C^CSDTHOATNUOC
ID_SD_SDTUDONG [Bat / tat tu dong: sua bien vien (grip, stretch...) thi anh IMAGECLIP tu cat lai theo bien moi (SDTUDONG / TDO)]^C^CSDTUDONG
ID_SD_SDLOT [Chay lo nhieu phong: rai vien cho tung khu vuc, diem bat dau tot nhat, thong ke tung vung + tong, tuy chon cat anh / hatch (SDLOT / NPH)]^C^CSDLOT
ID_SD_SDRONIN [Cho ron / duong vien hien ra khi in: doi mau trang + net, dua duong vien len tren anh (SDRONIN / IRN)]^C^CSDRONIN
ID_SD_SDVATLIEU [Danh sach vat lieu da dung (ma, kich thuoc, ron, khe): xem va xoa muc; SDGACH / SDLOT hien danh sach de chon lai nhanh (SDVATLIEU / VLI)]^C^CSDVATLIEU
ID_SD_SDXOAVIEN [Go bo vien trong vung chon: xoa polyline vien + anh + hatch + so hieu, lo ra chi tiet nam duoi (mat cat mui bac) (SDXOAVIEN / GOV)]^C^CSDXOAVIEN
ID_SD_SDANHDA [Cat anh tam da (imageclip) vao cac vien da quet chon: chieu van, xep it hao (SDANHDA / ADA)]^C^CSDANHDA
ID_SD_SDTKDA [Quet polyline vien da cat: bang thong ke theo nhom kich thuoc, chi tiet tung vien, CSV (SDTKDA / TKD)]^C^CSDTKDA
ID_SD_SDDOCDATK [Thong ke vien da sau SDDOCDA: bang nhom kich thuoc, dat tam da, CSV (SDDOCDATK / DTK)]^C^CSDDOCDATK
ID_SD_SDANHDATK [Thong ke tam da sau SDANHDA: so vien, hao hut tung tam, dat tam, CSV (SDANHDATK / ATK)]^C^CSDANHDATK
ID_SD_SDGACHTK [Thong ke vien + du tru dat hang (SDGACHTK / TKV)]^C^CSDGACHTK
ID_SD_SDKHODA [Kho da tho nhieu kich thuoc (SDKHODA / KHO)]^C^CSDKHODA
ID_SD_SDDATHO [Cat vien tu da tho: so do cat, hieu suat (SDDATHO / DTH)]^C^CSDDATHO
ID_SD_SDTHANGDA [Cau thang da: mat bac, co bac, mui bac (thang / vat 45 / roi / CNC), khe LED, len, ra da kieu ABF (SDTHANGDA / TDA)]^C^CSDTHANGDA
ID_SD_SDGIACONG [Ban ve gia cong tung ma vien (SDGIACONG / GCV)]^C^CSDGIACONG
ID_SD_SDLOP [Chi tiet cau tao lop op / lat (SDLOP / CTL)]^C^CSDLOP
ID_SD_SDBLOCKDA [Block chi tiet da: tao block mat cat mui bac tu mau, quet hinh tao block, chen file .dwg, luu ra .dwg, mo Block Editor them thong so dong (SDBLOCKDA / KCD)]^C^CSDBLOCKDA
ID_SD_SDTRINH [Ban trinh khach: bang chu thich vat lieu co o mau anh da (A1 1:50) va che do trinh khach lam mo nen kien truc, an layer nhan (SDTRINH / BTK)]^C^CSDTRINH
ID_SD_SDKHUNGIN [Khung in A1 / A3 tu dung: khung ten, huong Bac, thuoc ty le, dat san cai dat in cho SDIN / SDTAOLAYOUT (SDKHUNGIN / KIN)]^C^CSDKHUNGIN
ID_SD_SDKHAOSAT [Dung phong tu file so do khao sat (room,ab,bc,cd,da,ac,bd): 4 canh + cheo, xep hang tin cay A / B / C / X / D, ve polyline phong lam bien cho SDGACH / SDLOT (SDKHAOSAT / KSH)]^C^CSDKHAOSAT
ID_SD_SDCHIABAC [Chia bac thang tu cao do (so voi +-0.000): chieu cao bac, lam tron don phan lech, bang cao do hoan thien / ket cau tung bac va chieu nghi, dat san SDTHANGDA (SDCHIABAC / CHB)]^C^CSDCHIABAC
ID_SD_SDMAVIEN [Ma vien theo hinh dang: cung vat lieu va hinh dang cung ma (VD G1-01), nho trong ban ve, ghi len vien, bang + CSV (SDMAVIEN / SMV)]^C^CSDMAVIEN
ID_SD_SDKIEMTONG [Luot kiem tong: ho so so lieu, vien hep / nho, ron khong deu, luoi ron lech, chuoi cao do; bao cao + CSV (SDKIEMTONG / KTO)]^C^CSDKIEMTONG
ID_SD_SDHOSO [Ho so so lieu du an: ron, cao do, doc, du...; danh dau da xac nhan / chua xac nhan, canh bao khi lenh dung so chua xac nhan, bang ra ban ve (SDHOSO / SLD)]^C^CSDHOSO
ID_SD_SDDIMVIEN [Dim tu dong theo hang vien: chuoi tung vien + tong, ngang / dung, ngoai phong hoac trong phong (SDDIMVIEN / DVI)]^C^CSDDIMVIEN
ID_SD_SDOPTUONG [Op tuong trung ron san: mat dung trai phang, ron dung theo ron san, kiem tra trung ron (SDOPTUONG / OPTU)]^C^CSDOPTUONG
ID_SD_SDTRUNGRON [Kiem tra luoi ron lien tuc xuyen cac phong: nhom vien lech luoi chinh, khoanh may, goi y dich (SDTRUNGRON / RLE)]^C^CSDTRUNGRON
ID_SD_SDBACCAODO [Cho doi cao do (nguong WC, mep ho, chan thanh): gan du mm, SDCATDU tu nhan (SDBACCAODO / CDB)]^C^CSDBACCAODO
ID_SD_SDLIENCAODO [Chuoi cao do: san chinh, san WC (ha cot, doc ve pheu thu), san ho, muc nuoc, day ho; chenh cao tung muc, canh bao, so do (SDLIENCAODO / LKD)]^C^CSDLIENCAODO
ID_SD_SDHOBOI [Ho boi: doc day dau nong - dau sau, duong dong muc day, khe co gian, mat cat doc + bang cao do day theo vien, doi chieu TCVN 4260:2012 / ISPSC 2015 (SDHOBOI / HOB)]^C^CSDHOBOI
ID_SD_SDMAP [Thu vien map (anh) da granite co san: chen anh tam da dung kich thuoc that de SDANHDA cat vao vien; tha them .jpg / .png vao thu muc Maps (SDMAP / TVM)]^C^CSDMAP
ID_SD_SDDICHVAN [Dich van da tung buoc: nhich anh tam da duoi bien vien (trai / phai / len / xuong, buoc mm), bien dung yen, co hoan buoc (SDDICHVAN / DCV)]^C^CSDDICHVAN
ID_SD_SDCATDU [Cat du sat tuong: vien cat nao, canh nao phai cat dai ra (+du mm) de be lai khi thi cong; gach do tren ban ve, bang kich thuoc cat, CSV (SDCATDU / CTD)]^C^CSDCATDU
ID_SD_SDDUTOAN [Du toan tien da theo don gia m2 tung ma vat lieu (nho lai), hao hut, cong lat, VAT; bang + CSV (SDDUTOAN / DTD)]^C^CSDDUTOAN
ID_SD_SDPHUONGAN [<-Phuong an lat A / B tren mot to: nhan + bang ngan (so vien, nguyen / cat, hao hut) + khung in bao ca hai (SDPHUONGAN / PHA)]^C^CSDPHUONGAN
ID_SD_G7 [->Tien ich]
ID_SD_SDHANDINH [Han dinh: gop dinh polyline lech nhau, chen dinh nut chu T (SDHANDINH / HDI)]^C^CSDHANDINH
ID_SD_SDPANEL [Bang lenh SDOpLat (hop thoai) (SDPANEL / BLN)]^C^CSDPANEL
ID_SD_SDHELP [Danh sach lenh (SDHELP / HDL)]^C^CSDHELP
ID_SD_SDTUNAP [Bat / tat tu nap SDOpLat moi khi mo AutoCAD (khong can APPLOAD lai) (SDTUNAP / AUL)]^C^CSDTUNAP
ID_SD_SDMENU [Cai menu + toolbar + Ribbon (SDMENU / CMN)]^C^CSDMENU
ID_SD_SDDLG [<-Bat / tat hop thoai nhap lieu (SDDLG / HTN)]^C^CSDDLG
[--]
ID_SD_POP_PANEL [Bang lenh (SDPANEL)]^C^CSDPANEL
ID_SD_POP_UNLOAD [Go menu SDOpLat (SDMENUXOA)]^C^CSDMENUXOA


